---
/**
 * The landing page (11 November 2026, the canvas "Verve on the web,
 * rethought", boards 01, 03, 04 and 11). Light, in the order a first-time
 * visitor needs things:
 *
 *   the name, what Verve is in three words, one sentence, one action;
 *   beside it the action itself: Find your number, a working tool that
 *   asks for nothing and sends nothing, showing the sheet's worked example
 *   until the visitor puts in their own;
 *   what the studies found, three figures, each with its source, in the
 *   studies' own terms;
 *   what Verve reads: the four tabs as four dark frames, the product as it
 *   is, inside the light page;
 *   every threshold named, with one marker's bands as the proof;
 *   who it is for; what you come back for; the plans. (The line on who
 *   built it came out on 11 November 2026, at the founder's word.)
 *
 * Start here is folded in: the first number, who it is for and what you
 * come back for used to be a page of their own. No line on this page, or
 * on the site, promises anything about how long a person will live; the
 * two cohort findings are cited as findings.
 *
 * Nothing here is typed that the Science page counts. The citation count
 * and the ApoB card come from the data the Science page is built from, so
 * the two pages cannot disagree.
 */
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
import FirstNumber from "../components/FirstNumber.astro";
import LandingGlimpses from "../components/LandingGlimpses.astro";
import { COUNTS } from "../data/scienceTopics";
import { BODY_MARKERS } from "../data/bodyMarkers";
import { GET_APP_PATH, PRO_PAGES } from "../data/site";
import { RETURNS } from "../data/returns";
import { planOf, isPriced, priceText } from "../data/plans";

/** The name line and the one sentence, as board 11 sets them. The title and the cards for X and iMessage read the same. */
const NAME_LINE = "Verve · Evidence-based fitness tracking";
const SENTENCE = "Verve reads your fitness, movement, sleep, heart and body against the thresholds clinicians use, and names the study behind every line.";

/**
 * The two cited findings. Both studies are in CRF_SECTION (data/science.ts),
 * where the Fitness pages cite them; the figures are the studies' own, and
 * each line says what the study found, not what a reader will get.
 */
const findings = [
  {
    value: "13%",
    claim: "lower risk of death from any cause with each extra MET of fitness",
    source: "Kodama et al., JAMA 2009 · 33 studies · 102,980 people",
  },
  {
    value: "5×",
    claim: "the risk of death from any cause in the lowest fitness tier, against the elite tier",
    source: "Mandsager et al., JAMA Netw Open 2018 · 122,007 patients",
  },
];

const who = [
  { title: "Starting again", line: "Told to get fitter. Verve shows it happening, in plain words." },
  { title: "Already tracking", line: "Your watch’s number, set against the published line." },
  { title: "Coaches and clinicians", line: "The pages people share with you, in one place. Reading is free.", doors: true },
];

/** The proof card: one marker, exactly as the Body page prints it. */
const apoB = BODY_MARKERS.find((m) => m.label === "ApoB");
if (!apoB) throw new Error("index: the ApoB card needs the marker");
const apoBands = apoB.bands.map((b) => {
  const [name, range] = b.split(": ");
  return { name, range };
});
const apoSource = apoB.citation.split(". ")[0];

const pro = planOf("pro");
const priceLine = isPriced(pro) ? `Then ${priceText(pro, "monthly", pro.monthly.usd != null ? "usd" : "inr")} a month.` : "Price to be set.";

const h2 = "text-[28px] font-semibold leading-[1.15] tracking-[-0.02em] text-text-primary sm:text-[34px]";
const eyebrow = "font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-text-3";
const cite = "font-mono text-[10.5px] uppercase leading-[1.6] tracking-[0.04em] text-text-3";
const quiet = "inline-flex min-h-11 items-center text-[15px] font-semibold text-accent-text underline-offset-4 hover:underline";
---

<Layout title={NAME_LINE} description={SENTENCE}>
  <SiteHeader />

  <!-- ── The hero: the name, three words, one sentence, one action; and the action itself beside it ── -->
  <section class="px-6 py-12 sm:px-10 lg:py-16">
    <div class="mx-auto grid max-w-6xl items-start gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-14">
      <div class="flex flex-col items-start lg:pt-16">
        <p class:list={[eyebrow, "text-accent-text"]}>Verve</p>
        <h1 class="mt-4 text-[40px] font-semibold leading-[1.04] tracking-[-0.03em] text-text-primary sm:text-[52px] lg:text-[60px]">Evidence-based fitness tracking.</h1>
        <p class="mt-5 max-w-[500px] text-[17px] leading-[1.55] text-text-secondary sm:text-[18px]">{SENTENCE}</p>
        <div class="mt-7 flex flex-wrap items-center gap-x-[22px] gap-y-2">
          <a href="#find-your-number" class="inline-flex min-h-12 items-center justify-center rounded-full bg-accent px-6 text-[15px] font-semibold text-canvas transition-colors hover:bg-accent-text">Find your number</a>
          <a href={GET_APP_PATH} target="_blank" rel="noopener" class={quiet}>Get the app</a>
        </div>
        <p class="mt-3.5 text-[13px] leading-[1.5] text-text-3">Six minutes of walking. No app, no email.</p>
      </div>

      <FirstNumber />
    </div>
  </section>

  <!-- ── What the studies found: three figures, each with its source ── -->
  <section aria-labelledby="found" class="border-y border-border bg-card px-6 py-10 sm:px-10">
    <div class="mx-auto flex max-w-6xl flex-col gap-5">
      <h2 id="found" class={eyebrow}>What the studies found</h2>
      <div class="grid gap-8 sm:grid-cols-3 sm:gap-10">
        {findings.map((f) => (
          <div class="flex flex-col gap-2">
            <p class="t-figure text-text-primary">{f.value}</p>
            <p class="text-[15px] leading-[1.5] text-text-primary">{f.claim}</p>
            <p class={cite}>{f.source}</p>
          </div>
        ))}
        <div class="flex flex-col gap-2">
          <p class="t-figure text-text-primary">{COUNTS.citations}</p>
          <p class="text-[15px] leading-[1.5] text-text-primary">citations behind {COUNTS.topics} topics and {COUNTS.markers} body markers, all in the open</p>
          <a href="/science" class="inline-flex min-h-6 items-center self-start text-[14px] font-semibold text-accent-text underline-offset-4 hover:underline">Read the evidence base</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── What Verve reads: the four tabs, shown as they are ── -->
  <section class="px-6 py-14 sm:px-10 lg:py-16">
    <div class="mx-auto flex max-w-6xl flex-col gap-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="flex flex-col gap-2.5">
          <h2 class={h2}>What Verve reads</h2>
          <p class="text-[17px] leading-[1.55] text-text-secondary">Four tabs. Each answers one question.</p>
        </div>
        <span class="inline-flex h-[22px] items-center rounded-full border border-border-strong bg-alt px-[9px] font-mono text-[10.5px] font-semibold uppercase tracking-[0.04em] text-text-2">Sample figures</span>
      </div>
      <LandingGlimpses />
      <a href="/how-it-works" class:list={[quiet, "self-start"]}>See every screen in How it works</a>
    </div>
  </section>

  <!-- ── Every threshold, named: one marker as the proof ── -->
  <section class="border-t border-border bg-card px-6 py-14 sm:px-10">
    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-14">
      <div class="flex flex-col items-start gap-3.5">
        <h2 class={h2}>Every threshold, named.</h2>
        <p class="text-[17px] leading-[1.55] text-text-secondary">Each line Verve draws links to the paper it came from. Nothing you cannot check.</p>
        <a href="/science" class={quiet}>Read the evidence base</a>
      </div>
      <div class="flex flex-col gap-4 rounded-2xl border border-border bg-canvas p-5 sm:p-6">
        <div class="flex items-baseline justify-between">
          <h3 class="text-[18px] font-semibold text-text-primary">{apoB.label}</h3>
          <span class="font-mono text-[12px] text-text-3">{apoB.units[0]}</span>
        </div>
        <dl class="grid grid-cols-3 gap-2.5">
          {apoBands.map((b) => (
            <div class="flex flex-col gap-1.5 rounded-[10px] border border-border bg-card p-3.5">
              <dt class="text-[13px] text-text-2">{b.name}</dt>
              <dd class="t-figure text-[18px] text-text-primary sm:text-[22px]">{b.range}</dd>
            </div>
          ))}
        </dl>
        <p class="text-[13px] leading-[1.55] text-text-2">{apoSource}.</p>
      </div>
    </div>
  </section>

  <!-- ── Who it is for ── -->
  <section id="who-it-is-for" class="scroll-mt-6 border-t border-border px-6 py-14 sm:px-10">
    <div class="mx-auto flex max-w-6xl flex-col gap-7">
      <h2 class={h2}>Who it is for</h2>
      <ul class="grid gap-5 sm:grid-cols-3" role="list">
        {who.map((w) => (
          <li class="flex flex-col gap-2 rounded-2xl border border-border bg-card p-[22px]">
            <h3 class="text-[17px] font-semibold text-text-primary">{w.title}</h3>
            <p class="text-[15px] leading-[1.5] text-text-secondary">{w.line}</p>
            {w.doors && (
              <p class="mt-1 flex flex-wrap gap-x-4 text-[14px] font-semibold">
                {PRO_PAGES.map((p) => <a href={p.href} class="inline-flex min-h-9 items-center text-accent-text underline-offset-4 hover:underline">For a {p.label.toLowerCase()}</a>)}
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── What you come back for: the four returns, one per cadence ── -->
  <section id="what-you-come-back-for" class="scroll-mt-6 border-t border-border bg-card px-6 py-14 sm:px-10">
    <div class="mx-auto flex max-w-6xl flex-col gap-7">
      <h2 class={h2}>What you come back for</h2>
      <ul class="grid gap-x-5 gap-y-7 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {RETURNS.map((r) => (
          <li class="flex flex-col gap-2 border-t-2 border-text pt-4">
            <span class={eyebrow}>{r.cadence}</span>
            <h3 class="text-[17px] font-semibold text-text-primary">{r.title}</h3>
            <p class="text-[15px] leading-[1.5] text-text-secondary">{r.line}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── The plans, in one line ── -->
  <section class="border-t border-border px-6 py-14 sm:px-10">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-5 rounded-2xl border border-accent-border bg-accent-fill px-6 py-7 sm:px-9 sm:py-8">
        <div class="flex flex-col gap-2">
          <p class="text-[21px] font-semibold leading-[1.25] tracking-[-0.015em] text-text-primary sm:text-[24px]">Free shows your numbers. Pro reads them.</p>
          <p class="text-[15px] leading-[1.5] text-accent-text">14 days of Pro on the website, no card. {priceLine}</p>
        </div>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
          <a href="#find-your-number" class="inline-flex min-h-12 items-center justify-center rounded-full bg-accent px-6 text-[15px] font-semibold text-canvas transition-colors hover:bg-accent-text">Find your number</a>
          <a href="/plans" class={quiet}>See the plans</a>
        </div>
      </div>
    </div>
  </section>

  <Footer showHome={false} />
</Layout>
