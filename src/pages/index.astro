---
/**
 * The landing page, in the order a first-time visitor needs things:
 *
 *   the promise in one line, with the Today card beside it at its real
 *   size: this morning's read, the thing the app shows first;
 *   what the evidence says, three figures on one line: the two cited
 *   claims and the count of the evidence base behind them;
 *   where the numbers land, three cards, one figure each with a sparkline
 *   and one plain sentence;
 *   every number named, with one marker's card as the proof.
 *
 * Rebuilt 24 October 2026 for air: one figure a card, one kicker a section,
 * margins up a third, type up a step. The dark ground, the two fonts and the
 * colours are unchanged; density was the problem, not the palette. The
 * sample chart with three thresholds and a legend left the fold, and the
 * five "what Verve tracks" lines went with it: the three cards say it.
 *
 * Nothing here is typed that the Science page counts. The citation count
 * and the ApoB card come from the data the Science page is built from, so
 * the two pages cannot disagree.
 */
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
import TodayCard from "../components/TodayCard.astro";
import { COUNTS } from "../data/scienceTopics";
import { BODY_MARKERS } from "../data/bodyMarkers";
import { GET_APP_PATH } from "../data/site";

/**
 * The two cited claims. Both studies are in CRF_SECTION (data/science.ts),
 * where the Fitness pages cite them; the figures are the studies' own.
 */
const evidence = [
  {
    value: "13%",
    claim: "lower all-cause mortality for every extra MET of capacity",
    source: "Kodama et al, JAMA 2009 · 33 studies, 102,980 people",
  },
  {
    value: "5×",
    claim: "the difference in all-cause mortality from the Low fitness tier to Elite",
    source: "Mandsager et al, JAMA Network Open 2018 · 122,007 patients",
  },
];

/**
 * Where the numbers land: one figure a page, a sparkline of how it moved,
 * one sentence. Sample figures; the section says so.
 */
const pages = [
  {
    label: "Activity", dot: "#f97316",
    value: "8.7", beside: "METs · Below average for your age",
    spark: [40, 44, 42, 50, 54, 52, 58, 62, 60, 66],
    line: "Your fitness as a number, the week's climb, and the morning read above it.",
  },
  {
    label: "Body", dot: "#FBBF24",
    value: "6", small: "of 8", beside: "metabolic markers in range",
    spark: [30, 30, 45, 45, 45, 60, 60, 75, 75, 75],
    line: "Blood pressure, lipids, waist and muscle, each against its band, with when to repeat the test.",
  },
  {
    label: "Trends", dot: "#818cf8",
    value: "6h 29", beside: "a night this week · 25 min under your usual",
    spark: [70, 76, 64, 72, 80, 68, 58],
    line: "Weeks, months and years against your own usual, and a guide that says what moved.",
  },
];

/** The proof card: one marker, exactly as the Body page prints it. */
const apoB = BODY_MARKERS.find((m) => m.label === "ApoB");
if (!apoB || !apoB.retest?.interval) throw new Error("index: the ApoB card needs the marker and its retest interval");
const apoBands = apoB.bands.map((b) => {
  const [name, range] = b.split(": ");
  return { name, range };
});
const apoSource = apoB.citation.split(". ")[0];
const bandTone = ["text-success-light", "text-warning", "text-danger"];
---

<Layout
  title="Verve — Evidence-based fitness tracking"
  description="Verve reads your fitness, movement, sleep and heart, and body against the thresholds clinicians use, shows how each one moves over weeks and months, and names the study behind every line it draws."
>
  <SiteHeader />

  <!-- ── Hero: the promise in one line, and this morning's read beside it ── -->
  <section class="vrv-glow relative overflow-hidden px-6 pt-14 pb-14 sm:px-10 lg:pt-24 lg:pb-[88px]">
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[minmax(0,1.05fr)_390px] lg:gap-[72px]">
      <div class="flex flex-col gap-6">
        <h1 class="vrv-rise text-[40px] font-extrabold leading-[1.04] tracking-[-0.03em] text-text-primary sm:text-5xl lg:text-[58px] lg:leading-[1.04]">
          Track the number that predicts how long you live.
        </h1>
        <p class="vrv-rise max-w-[560px] text-[16px] leading-[1.6] text-text-secondary sm:text-[18px]" style="--i: 1">
          Verve reads your fitness, movement, sleep and heart, and body against
          the thresholds clinicians use, and names the study behind every line
          it draws.
        </p>
        <div class="vrv-rise flex flex-wrap gap-3" style="--i: 2">
          <a href={GET_APP_PATH} class="inline-flex min-h-11 items-center justify-center rounded-xl bg-accent px-5 text-sm font-bold text-canvas transition-opacity hover:opacity-90">Get the app</a>
          <a href="/start" class="inline-flex min-h-11 items-center justify-center rounded-xl border border-white/14 px-5 text-sm font-bold text-text-primary transition-colors hover:border-white/25">No number yet? Start here</a>
        </div>
        <p class="vrv-rise text-[13px] text-text-tertiary" style="--i: 3">Six minutes on flat ground, no app needed.</p>
      </div>

      <div class="vrv-rise mx-auto w-full max-w-[390px]" style="--i: 2">
        <TodayCard />
      </div>
    </div>
  </section>

  <!-- ── What the evidence says: three figures on one line, set below the hero with room ── -->
  <section class="px-6 sm:px-10">
    <div class="mx-auto grid max-w-6xl gap-10 border-y border-white/[0.07] py-10 sm:grid-cols-3 sm:gap-12">
      {evidence.map((e) => (
        <div>
          <p class="text-[44px] font-extrabold leading-none tracking-[-0.03em] text-text-primary sm:text-[52px]">{e.value}</p>
          <p class="mt-3 text-[14px] leading-[1.55] text-text-secondary sm:text-[15px]">{e.claim}</p>
          <p class="mt-3 font-mono text-[10.5px] uppercase tracking-[0.04em] text-text-tertiary">{e.source}</p>
        </div>
      ))}
      <div>
        <p class="text-[44px] font-extrabold leading-none tracking-[-0.03em] text-accent-light sm:text-[52px]">{COUNTS.citations}</p>
        <p class="mt-3 text-[14px] leading-[1.55] text-text-secondary sm:text-[15px]">
          citations behind {COUNTS.topics} topics and {COUNTS.markers} body markers, the whole evidence base in the open
        </p>
        <a href="/science" class="mt-3 inline-block text-[13.5px] font-bold text-accent-light transition-colors hover:text-text-primary">Read the evidence base &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ── Where the numbers land: three pages, one figure each ─────────────── -->
  <section class="px-6 pt-16 sm:px-10 lg:pt-[88px]">
    <div class="mx-auto flex max-w-6xl flex-col gap-7">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <span class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-text-tertiary">Where the numbers land</span>
          <h2 class="mt-2 text-[28px] font-extrabold leading-[1.1] tracking-[-0.03em] text-text-primary sm:text-[34px]">
            Three pages. One figure each, and the line behind it.
          </h2>
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <span class="rounded-xl border border-white/14 px-4 py-2 text-xs font-bold text-text-primary">iPhone</span>
          <span class="rounded-xl border border-white/8 px-4 py-2 text-xs font-bold text-text-tertiary">Android &middot; soon</span>
        </div>
      </div>

      <ul class="grid gap-5 sm:grid-cols-3">
        {pages.map((p) => (
          <li class="flex flex-col gap-4 rounded-[20px] border border-white/10 bg-white/[0.03] p-6">
            <span class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full" style={`background: ${p.dot}`}></span>
              <span class="font-mono text-[10.5px] font-semibold uppercase tracking-[0.14em] text-text-tertiary">{p.label}</span>
            </span>
            <span class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
              <span class="font-mono text-[44px] font-bold leading-none tracking-[-0.02em]" style={`color: ${p.dot}`}>
                {p.value}{p.small && <span class="text-[18px] text-text-tertiary"> {p.small}</span>}
              </span>
              <span class="text-sm text-text-secondary">{p.beside}</span>
            </span>
            <span class="flex h-[34px] items-end gap-[3px]" aria-hidden="true">
              {p.spark.map((h, i) => (
                <span class="flex-1 rounded-t-[2px]" style={`height: ${h}%; background: ${p.dot}; opacity: ${i === p.spark.length - 1 ? 1 : 0.55}`}></span>
              ))}
            </span>
            <span class="text-sm leading-[1.55] text-text-secondary">{p.line}</span>
          </li>
        ))}
      </ul>
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <p class="font-mono text-[11px] text-text-muted">Sample figures throughout.</p>
        <a href="/videos" class="text-sm font-bold text-accent-light transition-colors hover:text-text-primary">Watch how Verve works, in short videos &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ── Every number named: the promise, kept, with one marker as the proof ── -->
  <section class="px-6 pt-16 pb-20 sm:px-10 lg:pt-[88px] sm:pb-28">
    <div class="mx-auto grid max-w-6xl items-center gap-10 border-t border-white/[0.07] pt-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-16">
      <div class="flex flex-col gap-3.5">
        <span class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-text-tertiary">Every number named</span>
        <h2 class="text-[28px] font-extrabold leading-[1.1] tracking-[-0.03em] text-text-primary sm:text-[34px]">
          Every threshold, traced to its source.
        </h2>
        <p class="max-w-[520px] text-[16px] leading-[1.6] text-text-secondary">
          Every line Verve draws links to the paper it came from. No scores, no
          colours without a cut-point, nothing you cannot check.
        </p>
        <a href="/science" class="text-sm font-bold text-accent-light transition-colors hover:text-text-primary">
          Read the full evidence base &rarr;
        </a>
      </div>
      <div class="rounded-[20px] border border-white/10 bg-white/[0.03] p-6">
        <div class="flex items-baseline justify-between">
          <span class="text-lg font-extrabold text-text-primary">{apoB.label}</span>
          <span class="font-mono text-[11px] text-text-tertiary">{apoB.units[0]}</span>
        </div>
        <dl class="mt-3 space-y-2.5 text-sm">
          {apoBands.map((b, i) => (
            <div class="flex justify-between">
              <dt class="text-text-secondary">{b.name}</dt>
              <dd class:list={["font-mono", bandTone[Math.min(i, bandTone.length - 1)]]}>{b.range}</dd>
            </div>
          ))}
          <div class="flex justify-between border-t border-white/[0.07] pt-2.5">
            <dt class="text-text-secondary">Repeat</dt>
            <dd class="font-mono text-accent-light">{apoB.retest.interval}</dd>
          </div>
        </dl>
        <p class="mt-3.5 text-[11.5px] leading-relaxed text-text-tertiary">{apoSource}.</p>
      </div>
    </div>
  </section>

  <Footer showHome={false} />
</Layout>
