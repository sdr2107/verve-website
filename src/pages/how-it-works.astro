---
/**
 * /how-it-works — the app, section by section, kept in step with the code.
 *
 * The founder asked (4 Nov 2026) for one page on the site where each part
 * of the app is explained and can be added to section by section: the four
 * tabs, the Guide's logic (breadth and depth), what is free and what Pro
 * opens, how Verve counts (the weekly dose, the Ascent's minutes, the
 * resting-MET correction), and what each wearable writes. Every section has
 * an id so a later addition slots in; the wearables table is the same data
 * the science topic draws (src/data/wearables.ts).
 */
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
import { topicHref } from "../data/scienceTopics";
import { WEARABLE_ROWS, WEARABLE_COLS, WEARABLE_COL_IDS } from "../data/wearables";
import { GET_APP_PATH } from "../data/site";

const weeklyVolume = topicHref("weekly-volume");
const crf = topicHref("crf");
const heartHealth = topicHref("heart-health");
const wearablesTopic = topicHref("wearables");

// Average percent of heart rate reserve by activity, as the two studies
// report it (Caballero 2019, PMID 31892255; Nakanishi 2018, PMID 30055617).
// A null activity is the row that marks where Verve's 15% line falls; a dash
// is a figure not taken from that paper (not a claim it was not measured). The
// same figures, with their spreads, are in the app's
// data/met-thresholds.json#backgroundMovement.gateEvidence.
const BACKGROUND_HRR_ROWS: [string | null, string, string][] = [
  ["Standing desk work", "10%", "—"],
  ["Washing dishes", "12%", "—"],
  [null, "", ""],
  ["Vacuuming", "18%", "—"],
  ["Slow walking", "22%", "19%"],
  ["Normal walking", "26%", "23%"],
  ["Brisk walking", "37%", "34%"],
  ["Climbing stairs", "54%", "51%"],
];

const sections = [
  { id: "tabs", label: "The four tabs" },
  { id: "guide", label: "The Guide" },
  { id: "free-and-pro", label: "Free and Pro" },
  { id: "counting", label: "How Verve counts" },
  { id: "wearables", label: "What each wearable writes" },
];

const tabs = [
  { name: "Activity", q: "What did the week ask of you, and how did the body answer?", body: "Five cards. Cardiorespiratory fitness, your latest test in METs against the tier for your age and sex, with the retest in the corner. Vitals, last night's readings against your own last 30 nights, each figure's colour the verdict. Sleep, the hours with the usual night, the bedtime's spread, the regularity index and efficiency. Exertion: the week's workouts, the one-minute heart rate recovery after the last, the physical activity level, the hours sat so far. Movement: the week's climb of moderate and vigorous minutes, then the weekly dose against the goal, Zone 1, Zone 2 and Zone 3 for logged sessions, strength, background movement outside them, steps and cadence. Every card opens a full page with the back row at the top." },
  { name: "Body", q: "What do the markers say?", body: "Every biomarker as a row, in three sections: Metabolic, Heart, Muscle. A row is the name, where the value sits in its range, and the value. A sentence over the list counts what is recorded, what to watch and what is still to add; three filters and a search narrow it. A row opens the biomarker's own page: the latest result, the range with the result on it, what it means, and the prior tests. Your readings as a row with the count and since when; the report for your doctor one row below. One button files a reading; a whole lab report is the first row of the sheet it opens." },
  { name: "Trends", q: "Is it moving?", body: "The Route, your fitness tests as one line across the tier bands, with the gap to the next tier in METs. This month against last, every row a figure, an arrow and what it was, as weekly rates so a month four days in sits fairly beside a finished one. Twelve prior weeks as a strip, the goal weeks lit." },
  { name: "Guide", q: "What changed last week, and what to do?", body: "One read a week, five sections, depth on demand. The section below says how it is built." },
];

const guideRows: [string, string, string, string][] = [
  ["The Monday read", "all five ledgers: sessions, zones, dose · nights, bedtimes, regularity · resting heart rate, night HRV, recovery · labs, waist, weight · steps, cadence, sitting", "WIN · five sections, one sentence with one figure each · NEXT", "every Monday, on its own; the first one is the account's one sample"],
  ["Training, deeper", "the sessions one by one, the intensity mix, Zone 2 and strength days, the dose against the goal", "what each session did, where the minutes went, one session to add or change", "the dose moved by more than a fifth, or a flag was crossed"],
  ["Sleep, deeper", "night by night: hours, bedtime, wakes, spread, regularity, sleeping heart rate and breathing", "the pattern across the nights, one bedtime to hold", "regularity or spread moved; two nights outside the band"],
  ["Recovery, deeper", "resting heart rate and night HRV against their 30-night bands, recovery after each workout", "the baseline and the departures, one easy day or none", "resting heart rate or HRV left the band; recovery under the line"],
  ["Body, deeper", "the markers filed, each against its band, the retest calendar", "what moved since the last panel, one test to book", "a reading was filed, or one came due"],
  ["Movement, deeper", "steps and cadence by day, sitting by hour, physical activity level where a watch wrote the day", "the shape of the days, one hour to move", "sitting rose or steps fell for three days"],
];

const gates: [string, string, string][] = [
  ["The Guide", "the figures and arrows on every period, and one sample read", "every written read: the Monday read, the depth reads, the questions, the memory of past reads"],
  ["Fitness tests", "the first test, with your tier and the Route it starts", "every retest, eight weeks apart"],
  ["Prior weeks", "the last four weeks", "twelve weeks, and the month and year lenses over the full history"],
  ["Body assessment", "the first full assessment, and every single value you file", "the repeat assessment, every eight weeks with the body check-in, and the history of every marker"],
  ["Your data", "backup, and the report on this site", "export"],
];
---

<Layout
  title="How it works — Verve"
  description="The app section by section: the four tabs, how the Guide reads your week, what is free and what Pro opens, how Verve counts the weekly dose and the resting MET, and what each wearable writes."
  cardType="summary"
>
  <SiteHeader current="how" />

  <main class="mx-auto flex w-full max-w-[1080px] flex-col gap-20 px-4 pb-20 pt-14 sm:px-6 lg:gap-24 lg:pt-16">

    <section class="flex flex-col gap-6">
      <div class="flex max-w-[820px] flex-col gap-4">
        <span class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-accent-light">How it works</span>
        <h1 class="text-[34px] font-extrabold leading-[1.08] tracking-[-0.03em] text-text-primary sm:text-[44px]">The app, section by section.</h1>
        <p class="text-[17px] leading-[1.6] text-text-secondary">Verve reads the phone's health store and nothing else, from whatever you wear, and says what the numbers mean against the thresholds clinicians use. This page is how each part does that, kept in step with the code. New sections are added here as the app grows.</p>
      </div>
      <nav aria-label="Sections" class="flex flex-wrap gap-2">
        {sections.map((s) => (
          <a href={`#${s.id}`} class="rounded-xl border border-white/10 bg-white/[0.03] px-3.5 py-2 text-[13px] font-semibold text-text-secondary transition-colors hover:border-white/20 hover:text-text-primary">{s.label}</a>
        ))}
      </nav>
    </section>

    <!-- ── 1 · the four tabs ── -->
    <section id="tabs" class="scroll-mt-24 flex flex-col gap-6">
      <h2 class="text-[28px] font-extrabold tracking-[-0.02em] text-text-primary sm:text-[32px]">The four tabs</h2>
      <p class="max-w-[820px] text-[15.5px] leading-[1.6] text-text-secondary">Each tab answers one question. Each card on it is a door to a full page with the back row at the top, and every figure on a page carries the device that wrote it.</p>
      <ul class="grid gap-4 sm:grid-cols-2">
        {tabs.map((t) => (
          <li class="flex flex-col gap-2.5 rounded-[18px] border border-white/[0.08] bg-white/[0.04] p-6">
            <span class="font-mono text-[11px] tracking-[0.1em] text-accent-light">{t.name.toUpperCase()}</span>
            <p class="text-[18px] font-bold leading-[1.25] text-text-primary">{t.q}</p>
            <p class="text-[14.5px] leading-[1.6] text-text-secondary">{t.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── 2 · the Guide ── -->
    <section id="guide" class="scroll-mt-24 flex flex-col gap-6">
      <h2 class="text-[28px] font-extrabold tracking-[-0.02em] text-text-primary sm:text-[32px]">The Guide: breadth, then depth</h2>
      <div class="flex max-w-[820px] flex-col gap-4 text-[15.5px] leading-[1.6] text-text-secondary">
        <p>If the Monday read reads everything, why read Training, Sleep or Recovery on their own? The answer is depth, not scope. The Monday read is <strong class="text-text-primary">breadth</strong>: every ledger, one sentence each with its figure, one WIN at the top and one NEXT at the bottom. A deeper read is <strong class="text-text-primary">depth</strong>: one ledger, day by day or session by session, with a narrower next step. A deeper read never contradicts the Monday read; it continues one of its sentences.</p>
        <p>Four rules hold it together. A section earns its line only with data in both periods; otherwise it says so in five words. The app offers one deeper read a week, the section whose numbers moved most, never all five. Every sentence carries its figure inline, so the read can be checked against the numbers beneath it. And the numbers are free on every period, while the written reads are what Pro buys, after one sample read per account.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-white/10 bg-black/20">
        <table class="w-full min-w-[820px] text-[13px]">
          <thead>
            <tr class="text-left font-mono text-[10.5px] uppercase tracking-[0.1em] text-text-tertiary">
              <th class="px-4 py-3 font-semibold">Read</th><th class="px-4 py-3 font-semibold">Reads from</th><th class="px-4 py-3 font-semibold">Says</th><th class="px-4 py-3 font-semibold">Earns a tap when</th>
            </tr>
          </thead>
          <tbody>
            {guideRows.map(([r, from, says, when]) => (
              <tr class="border-t border-white/[0.07] align-top text-text-secondary">
                <td class="px-4 py-3 font-semibold text-text-primary">{r}</td><td class="px-4 py-3">{from}</td><td class="px-4 py-3">{says}</td><td class="px-4 py-3">{when}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── 3 · free and Pro ── -->
    <section id="free-and-pro" class="scroll-mt-24 flex flex-col gap-6">
      <h2 class="text-[28px] font-extrabold tracking-[-0.02em] text-text-primary sm:text-[32px]">Free and Pro</h2>
      <p class="max-w-[820px] text-[15.5px] leading-[1.6] text-text-secondary">One rule on every page: free shows your numbers, Pro reads them. Nothing free is taken away when a trial ends. Where a free account meets a Pro door, the app says in one line what Pro adds there, offers the 14-day trial when the App Store says your Apple ID may take it, and shows the store's prices. See <a href="/plans" class="font-semibold text-accent-light hover:text-text-primary">Plans</a> for the prices.</p>
      <div class="overflow-x-auto rounded-xl border border-white/10 bg-black/20">
        <table class="w-full min-w-[640px] text-[13px]">
          <thead>
            <tr class="text-left font-mono text-[10.5px] uppercase tracking-[0.1em] text-text-tertiary">
              <th class="px-4 py-3 font-semibold">Where</th><th class="px-4 py-3 font-semibold">Free</th><th class="px-4 py-3 font-semibold">Pro adds</th>
            </tr>
          </thead>
          <tbody>
            {gates.map(([w, f, p]) => (
              <tr class="border-t border-white/[0.07] align-top text-text-secondary">
                <td class="px-4 py-3 font-semibold text-text-primary">{w}</td><td class="px-4 py-3">{f}</td><td class="px-4 py-3">{p}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── 4 · how Verve counts ── -->
    <section id="counting" class="scroll-mt-24 flex flex-col gap-6">
      <h2 class="text-[28px] font-extrabold tracking-[-0.02em] text-text-primary sm:text-[32px]">How Verve counts</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="flex flex-col gap-2.5 rounded-[18px] border border-white/[0.08] bg-white/[0.04] p-6">
          <span class="font-mono text-[11px] tracking-[0.1em] text-accent-light">THE WEEKLY DOSE</span>
          <p class="text-[14.5px] leading-[1.6] text-text-secondary">MET-minutes of your logged moderate and vigorous aerobic sessions, each session's MET times its minutes, summed over the ISO week. The goal is the ACC's 500 to 1,000. One ledger computes it, so the Activity card, Prior Weeks, the Monday note and the Guide show the same number.</p>
          <a href={`${weeklyVolume}#weekly-dose`} class="text-[13.5px] font-bold text-accent-light hover:text-text-primary">The dose, with its evidence &rarr;</a>
        </div>
        <div class="flex flex-col gap-2.5 rounded-[18px] border border-white/[0.08] bg-white/[0.04] p-6">
          <span class="font-mono text-[11px] tracking-[0.1em] text-accent-light">THE ASCENT'S MINUTES</span>
          <p class="text-[14.5px] leading-[1.6] text-text-secondary">The climb on the Activity tab counts measured moderate and vigorous minutes, a minute classed by the MET it was done at. They are not the moderate-equivalent minutes the WHO and AHA publish, which credit a vigorous minute twice, so the flags on the climb carry no organisation's name. Two rulers, kept apart on purpose.</p>
          <a href={`${weeklyVolume}#two-rulers`} class="text-[13.5px] font-bold text-accent-light hover:text-text-primary">Two rulers &rarr;</a>
        </div>
        <div class="flex flex-col gap-2.5 rounded-[18px] border border-white/[0.08] bg-white/[0.04] p-6">
          <span class="font-mono text-[11px] tracking-[0.1em] text-accent-light">THE RESTING MET</span>
          <p class="text-[14.5px] leading-[1.6] text-text-secondary">A watch's active energy is energy above rest. A MET derived from it is one MET short, so Verve adds the resting MET before a session meets the moderate and vigorous cut-points. One exception, by writer: WHOOP's figure already holds the resting burn and is read as it is. Synced sessions from before this rule were repaired once.</p>
          <a href={`${weeklyVolume}#energy-with-rest`} class="text-[13.5px] font-bold text-accent-light hover:text-text-primary">Energy, with rest &rarr;</a>
        </div>
        <div class="flex flex-col gap-2.5 rounded-[18px] border border-white/[0.08] bg-white/[0.04] p-6">
          <span class="font-mono text-[11px] tracking-[0.1em] text-accent-light">REMNANT CHOLESTEROL</span>
          <p class="text-[14.5px] leading-[1.6] text-text-secondary">Total cholesterol minus HDL minus LDL, the three printed on one report. The LDL's method is read off the report and labels the number: a directly measured LDL makes the remnant a measurement; a calculated LDL makes it the share of triglycerides the equation set aside, triglycerides &divide; 5 under Friedewald. Thirty mg/dL and above reads elevated, the same line on the LDL card in the app and in the Labs tab on My health.</p>
          <a href={`${heartHealth}#remnant-cholesterol`} class="text-[13.5px] font-bold text-accent-light hover:text-text-primary">Remnant cholesterol, with its evidence &rarr;</a>
        </div>
      </div>
      <p class="max-w-[820px] text-[14px] leading-[1.6] text-text-tertiary">Fitness itself is graded the other way round: the test gives METs directly, and the tier comes from the table for your age and sex. <a href={crf} class="font-semibold text-accent-light hover:text-text-primary">How fitness is graded &rarr;</a></p>
    </section>

    <!-- ── 5 · what each wearable writes ── -->
    <section id="wearables" class="scroll-mt-24 flex flex-col gap-6">
      <h2 class="text-[28px] font-extrabold tracking-[-0.02em] text-text-primary sm:text-[32px]">What each wearable writes</h2>
      <p class="max-w-[820px] text-[15.5px] leading-[1.6] text-text-secondary">Verve reads Apple Health on an iPhone and Health Connect on Android. A reading reaches it only when the wearable's own app has written it there. The table is each maker's published list, reading by reading, against what Verve does with it. The notes on how to read it, and how to connect each device, are on the <a href={wearablesTopic} class="font-semibold text-accent-light hover:text-text-primary">science topic</a>; Settings &rarr; Data sources in the app names every writer it has actually seen on your phone.</p>
      <div class="overflow-x-auto rounded-xl border border-white/10 bg-black/20">
        <table class="w-full min-w-[1180px] text-[12px]">
          <thead>
            <tr class="text-left font-mono text-[10.5px] uppercase tracking-[0.1em] text-text-tertiary">
              {WEARABLE_COLS.map((c, i) => (
                <th id={WEARABLE_COL_IDS[i] ? `w-${WEARABLE_COL_IDS[i]}` : undefined} class="px-3 py-2.5 font-semibold">{c}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {WEARABLE_ROWS.map((cells) => (
              <tr class="border-t border-white/[0.07] align-top text-text-secondary">
                {cells.map((c, i) => (
                  <td class={`px-3 py-2.5 ${i === 0 ? "font-semibold text-text-primary" : i === cells.length - 1 ? "text-accent-light" : ""}`}>{c}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Background movement: what fills it and when to look. The app's row
           links here (6 Nov 2026). -->
      <div id="background-movement" class="scroll-mt-24 flex max-w-[820px] flex-col gap-3 rounded-[18px] border border-white/[0.08] bg-white/[0.04] p-6">
        <span class="font-mono text-[11px] tracking-[0.1em] text-accent-light">BACKGROUND MOVEMENT</span>
        <p class="text-[14.5px] leading-[1.6] text-text-secondary">Background movement is the moving you do outside logged sessions: the commute, errands, stairs. Verve reads it from heart rate shared through the day. A stretch counts when heart rate is at or above 15% of your heart rate reserve and the same five minutes hold at least 200 steps. There is no daily limit. Its moderate and vigorous minutes join the weekly climb. None of it counts toward the weekly dose.</p>
        <p class="text-[14.5px] leading-[1.6] text-text-secondary"><span class="font-semibold text-text-primary">What fills it.</span> A wearable that shares heart rate between sessions, not only inside them, with steps fine enough to place in five-minute windows. The row in the table says which do. On an iPhone, the phone's own step count serves when it is carried. A wearable that shares heart rate inside sessions only leaves the row empty, and so does a day whose only steps arrive as one block. Verve estimates nothing in its place.</p>
        <p class="text-[14.5px] leading-[1.6] text-text-secondary"><span class="font-semibold text-text-primary">When to look.</span> The next day. A day is counted once it is complete, so today's figure is never there today. Yesterday is counted again each time the app opens during the following day, which lets a ring or watch that synced late catch up. After that the figure is fixed. Open the wearable's own app first, then Verve.</p>
        <p class="text-[14.5px] leading-[1.6] text-text-secondary"><span class="font-semibold text-text-primary">Why 15%.</span> Two studies measured how much of their heart rate reserve adults used in everyday activities. Standing tasks sat near 10%, slow walking near 20%. The line is drawn between them.</p>
        <div class="overflow-x-auto rounded-xl border border-white/10 bg-black/20">
          <table class="w-full min-w-[420px] text-[12.5px]">
            <thead>
              <tr class="text-left font-mono text-[10.5px] uppercase tracking-[0.1em] text-text-tertiary">
                <th class="px-3 py-2.5 font-semibold">Activity</th>
                <th class="px-3 py-2.5 text-right font-semibold">Caballero 2019</th>
                <th class="px-3 py-2.5 text-right font-semibold">Nakanishi 2018</th>
              </tr>
            </thead>
            <tbody>
              {BACKGROUND_HRR_ROWS.map(([activity, a, b]) => (
                activity === null ? (
                  <tr class="border-t border-accent/40 bg-accent/[0.08] text-accent-light">
                    <td class="px-3 py-2 font-semibold" colspan="3">Verve's line: 15% of heart rate reserve</td>
                  </tr>
                ) : (
                  <tr class="border-t border-white/[0.07] text-text-secondary">
                    <td class="px-3 py-2 font-semibold text-text-primary">{activity}</td>
                    <td class="px-3 py-2 text-right font-mono">{a}</td>
                    <td class="px-3 py-2 text-right font-mono">{b}</td>
                  </tr>
                )
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-[13px] leading-[1.6] text-text-tertiary">Average percent of heart rate reserve during each activity. <a href="https://pubmed.ncbi.nlm.nih.gov/31892255/" class="font-semibold text-accent-light hover:text-text-primary">Caballero and colleagues, 2019</a>: 40 adults, 20 activities. <a href="https://pubmed.ncbi.nlm.nih.gov/30055617/" class="font-semibold text-accent-light hover:text-text-primary">Nakanishi and colleagues, 2018</a>: 42 adults. Both measured heart rate with a chest sensor. A dash is a figure not drawn from that study.</p>
        <p class="text-[14.5px] leading-[1.6] text-text-secondary"><span class="font-semibold text-text-primary">Why 200 steps.</span> Heart rate rises with coffee, stress and a hard meeting, so heart rate alone cannot say you moved. The same five minutes must also hold 200 steps, an average of 40 a minute. <a href="https://pubmed.ncbi.nlm.nih.gov/21708187/" class="font-semibold text-accent-light hover:text-text-primary">A study of 3,744 adults wearing activity monitors</a> sorted every minute into cadence bands; 40 a minute is where its third band begins, above the bands of 1 to 19 and 20 to 39 steps. A raised pulse at a desk takes no steps, so it does not count.</p>
        <p class="text-[14.5px] leading-[1.6] text-text-secondary"><span class="font-semibold text-text-primary">On Android.</span> The same rule, the same numbers. Verve reads Health Connect, so the figure needs the wearable's own app to write two things there: heart rate between sessions, and steps in records of an hour or less. A Pixel Watch, a Fitbit or a Galaxy Watch writes steps by the minute, which is enough. A phone with no wearable has no heart rate, and Samsung Health on the phone alone writes one step record for the whole day, which cannot be placed in any five minutes: both leave the row empty. Health Connect lets an app read back to 30 days before you first gave it access, further if you allow its history permission.</p>
        <p class="text-[14.5px] leading-[1.6] text-text-tertiary">The rule is Verve's own. It is informed by these measurements, which were taken during supervised tasks with a chest sensor, not by a wearable on the wrist in daily life, so read the figure as an estimate. Housework that takes few steps is still left out.</p>
      </div>
    </section>

    <section class="flex flex-col gap-4 rounded-[20px] border border-accent/40 bg-accent/[0.08] p-7">
      <p class="text-[19px] font-bold text-text-primary">See it with your own numbers</p>
      <p class="text-[15.5px] text-[#c7d2fe]">The app is free. Your first fitness test places you in the table; the first Monday read is yours to keep.</p>
      <div><a href={GET_APP_PATH} class="inline-block rounded-xl bg-accent px-5 py-3 text-[14px] font-bold text-[#0d0d15]">Get the app</a></div>
    </section>
  </main>

  <Footer />
</Layout>
