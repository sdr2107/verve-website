---
/**
 * /science — the hub.
 *
 * This was one 1,200-line page carrying all twenty topics. It is now four
 * subject pages and this, which is the way in: the map, then every topic
 * listed under its subject. (Where the readings land in the app is on the landing
 * page now; it shows the app, not the science.)
 *
 * It stays a real page at the same address for a reason beyond the reader.
 * Ten anchors are linked from inside the app — /science#zone-2 and the rest —
 * and each of those topics is a page of its own now. The script at the top of the
 * body forwards them before the page paints, from the same list that builds
 * the pages, so no hosting redirect rules exist to fall out of date and no
 * App Store release is needed to keep an old link working.
 */
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import SiteHeader from "../components/SiteHeader.astro";
import CrfMapPreview from "../components/science/CrfMapPreview.astro";
import { SUBJECTS, subjectCounts, topicsFor, COUNTS, ANCHOR_TARGET, topicHref } from "../data/scienceTopics";

/** The three figures under the opening line. Counted, never typed. */
const figures = [
  { n: COUNTS.citations, label: "citations" },
  { n: COUNTS.topics, label: "topics" },
  { n: COUNTS.markers, label: "body markers" },
];

---

<Layout
  title="The Science Behind Verve"
  description="Every threshold in Verve, traced to its source. Four subjects — fitness, movement, sleep and heart, body — each opening with what the app shows you, then the studies behind it."
>
  {/* ── Anchor forwarding. The app links to ten anchors that used to live on
       this page; each is a page of its own now. This runs before the body
       paints and rewrites the address, so a link from inside the app — or one
       a reader bookmarked — still lands on its topic. The map is derived
       from the topic list itself, so a topic added later cannot be left out
       of it. An anchor this does not recognise is left alone and the page
       scrolls to the index, as it did before. ─────────────────────────── */}
  <script is:inline define:vars={{ ANCHOR_TARGET }}>
    (function () {
      var hash = window.location.hash.slice(1);
      if (!hash) return;
      var target = ANCHOR_TARGET[hash];
      if (target) {
        window.location.replace(target);
        return;
      }
      // Not a topic we know. The hub has nothing at that id, so the browser
      // would leave the reader at the top with no idea why. Put them at the
      // index instead, which is where the thing they asked for is listed.
      //
      // Twice: at DOMContentLoaded so there is no visible delay, and again at
      // load, because the first jump is measured before the web fonts settle
      // and a reflow after it would leave the reader short of the index.
      var toIndex = function () {
        var index = document.getElementById("every-topic");
        if (index) index.scrollIntoView();
      };
      document.addEventListener("DOMContentLoaded", toIndex);
      window.addEventListener("load", toIndex);
    })();
  </script>

  <SiteHeader current="science" />

  <!-- ── The opening ─────────────────────────────────────────────────── -->
  <section class="relative px-6 pt-8 pb-16 sm:px-10">
    <div class="mx-auto max-w-3xl text-center">
      <span class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-light">
        The evidence base
      </span>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-text-primary sm:text-5xl">
        Every threshold, traced to its source.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-text-secondary">
        Verve is built so you come to know your own readings. Every number it
        shows you is one a clinician would use, and every threshold names the
        study it came from.
      </p>

      <!-- Search everything the section says. The index is one file built
           from the same registry as the pages, fetched on first focus. -->
      <div class="relative mx-auto mt-8 max-w-xl text-left">
        <label for="q" class="sr-only">Search the science</label>
        <svg class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-text-tertiary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input
          id="q" type="search" autocomplete="off" spellcheck="false"
          placeholder="Search a marker, a topic, a section, a study…"
          aria-controls="results" aria-expanded="false"
          class="w-full rounded-2xl border border-white/10 bg-white/[0.04] py-3.5 pl-11 pr-12 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent/60 focus:outline-none"
        />
        <kbd class="pointer-events-none absolute right-4 top-1/2 hidden -translate-y-1/2 rounded-md border border-white/10 px-1.5 py-0.5 font-mono text-[10px] text-text-muted sm:block" aria-hidden="true">/</kbd>
        <div id="results" role="listbox" class="absolute left-0 right-0 top-full z-20 mt-2 hidden overflow-hidden rounded-2xl border border-white/10 bg-canvas-2/95 shadow-2xl shadow-black/40 backdrop-blur"></div>
      </div>

      <dl class="mx-auto mt-8 flex items-center justify-center gap-6 sm:gap-10">
        {figures.map((f, i) => (
          <>
            {i > 0 && <div class="h-10 w-px shrink-0 bg-white/10" aria-hidden="true"></div>}
            <div>
              <dt class="sr-only">{f.label}</dt>
              <dd>
                <span class="block font-mono text-3xl font-bold text-text-primary">{f.n}</span>
                <span class="mt-0.5 block text-[13px] text-text-tertiary">{f.label}</span>
              </dd>
            </div>
          </>
        ))}
      </dl>
    </div>
  </section>

  {/* ── Search. Terms score against the title first, then the one-line
       answer, the sub-headings and the prose; a hit links to the page and
       shows the sentence it was found in. No library: the index is small
       and the ranking is four lines. ───────────────────────────────────── */}
  <script is:inline>
    (function () {
      var q = document.getElementById("q");
      var box = document.getElementById("results");
      if (!q || !box) return;
      var index = null, loading = null;
      var KIND = { topic: "Topic", section: "Section", subject: "Subject", marker: "Body marker", study: "Study" };

      function load() {
        if (index || loading) return loading;
        loading = fetch("/search-index.json").then(function (r) { return r.json(); }).then(function (j) { index = j; return j; });
        return loading;
      }
      var esc = function (s) { return s.replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); };
      var rx = function (s) { return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"); };

      function score(e, terms) {
        var t = e.t.toLowerCase(), d = (e.d || "").toLowerCase(), h = e.h.join(" ").toLowerCase(), x = (e.x || "").toLowerCase(), s = e.s.toLowerCase();
        var total = 0, hit = 0;
        for (var i = 0; i < terms.length; i++) {
          var w = terms[i], n = 0;
          if (t.indexOf(w) === 0) n += 14; else if (t.indexOf(w) >= 0) n += 10;
          if (d.indexOf(w) >= 0) n += 4;
          if (h.indexOf(w) >= 0) n += 4;
          if (s.indexOf(w) >= 0) n += 2;
          var c = 0, p = -1;
          while (c < 3 && (p = x.indexOf(w, p + 1)) >= 0) { c++; }
          n += c;
          if (n > 0) hit++;
          total += n;
        }
        if (hit < terms.length) return 0;      // every word must land somewhere
        return total + (e.k === "topic" ? 3 : e.k === "section" || e.k === "marker" ? 2 : 0);
      }

      function snippet(e, terms) {
        var src = e.d && e.d.length ? e.d + " · " + (e.x || "") : (e.x || "");
        var low = src.toLowerCase(), at = -1;
        for (var i = 0; i < terms.length && at < 0; i++) at = low.indexOf(terms[i]);
        var start = Math.max(0, at - 70), end = Math.min(src.length, (at < 0 ? 0 : at) + 110);
        var out = (start > 0 ? "…" : "") + src.slice(start, end) + (end < src.length ? "…" : "");
        out = esc(out);
        for (var j = 0; j < terms.length; j++) out = out.replace(new RegExp("(" + rx(esc(terms[j])) + ")", "ig"), "<mark>$1</mark>");
        return out;
      }

      function render(list, query) {
        if (!query) { box.classList.add("hidden"); box.innerHTML = ""; q.setAttribute("aria-expanded", "false"); return; }
        if (!list.length) {
          box.innerHTML = '<p class="px-4 py-3.5 text-[13px] text-text-tertiary">Nothing for “' + esc(query) + '”. Try a marker’s name, a topic, or an author.</p>';
        } else {
          box.innerHTML = list.map(function (e) {
            return '<a href="' + esc(e.u) + '" role="option" class="block border-b border-white/[0.06] px-4 py-3 transition-colors last:border-b-0 hover:bg-white/[0.05]">' +
              '<span class="flex items-center gap-2"><span class="text-sm font-semibold text-text-primary">' + esc(e.t) + '</span>' +
              '<span class="rounded-md bg-white/[0.06] px-1.5 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider text-text-secondary">' + KIND[e.k] + '</span>' +
              '<span class="ml-auto shrink-0 text-[11px] text-text-tertiary">' + esc(e.s) + '</span></span>' +
              '<span class="mt-1 block text-[12.5px] leading-relaxed text-text-tertiary">' + snippet(e, e._terms) + '</span></a>';
          }).join("");
        }
        box.classList.remove("hidden");
        q.setAttribute("aria-expanded", "true");
      }

      var timer;
      function run() {
        var query = q.value.trim();
        if (!query) return render([], "");
        load().then(function (j) {
          var terms = query.toLowerCase().split(/\s+/).filter(Boolean);
          var hits = [];
          for (var i = 0; i < j.length; i++) {
            var sc = score(j[i], terms);
            if (sc > 0) { hits.push({ e: j[i], sc: sc }); }
          }
          hits.sort(function (a, b) { return b.sc - a.sc; });
          render(hits.slice(0, 8).map(function (h) { h.e._terms = terms; return h.e; }), query);
        });
      }
      q.addEventListener("focus", load);
      q.addEventListener("input", function () { clearTimeout(timer); timer = setTimeout(run, 80); });
      q.addEventListener("keydown", function (e) {
        if (e.key === "Escape") { q.value = ""; render([], ""); q.blur(); }
        if (e.key === "Enter") { var first = box.querySelector("a"); if (first) window.location.href = first.getAttribute("href"); }
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "/" && document.activeElement !== q && !/^(INPUT|TEXTAREA)$/.test(document.activeElement && document.activeElement.tagName)) { e.preventDefault(); q.focus(); }
      });
      document.addEventListener("click", function (e) { if (!box.contains(e.target) && e.target !== q) box.classList.add("hidden"); });
      q.addEventListener("focus", function () { if (q.value.trim()) run(); });
    })();
  </script>

  <!-- ── Start here: the map. Two columns, because the shape of the thing
       is the argument for opening it — 226 ideas is an abstraction until you
       see five branches off one node. ──────────────────────────────────── -->
  <section class="px-6 pb-20 sm:px-10">
    <div class="mx-auto max-w-5xl">
      <a
        href="/crf-map"
        class="group flex flex-col overflow-hidden rounded-2xl border border-accent/30 bg-accent/[0.06] transition-colors hover:border-accent/50 lg:flex-row"
      >
        <span class="flex flex-1 flex-col justify-center p-7 sm:p-9">
          <span class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-light">
            Start here
          </span>
          <span class="mt-3 block text-xl font-bold tracking-tight text-text-primary sm:text-2xl">
            The whole of cardiorespiratory fitness, on one map
          </span>
          <span class="mt-3 block text-sm leading-relaxed text-text-secondary">
            The American Heart Association&rsquo;s 2016 statement is 30 pages of
            prose. Here it is as 226 connected ideas: what fitness measures, what
            it predicts, how it is tested, how it improves. Open a branch to read
            the claim; every branch Verve acts on is marked.
          </span>
          <span class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
            <span class="rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-canvas transition-colors group-hover:bg-accent-light">
              Open the map
            </span>
            <span class="text-[13px] text-text-tertiary">
              Pan, zoom, expand &middot; Ross et al. 2016
            </span>
          </span>
        </span>

        <span class="shrink-0 border-t border-white/8 bg-black/25 p-5 sm:p-6 lg:w-[420px] lg:border-l lg:border-t-0">
          <CrfMapPreview />
          <span class="mt-3.5 flex items-center gap-2">
            <span class="h-[9px] w-[9px] rounded-sm border border-success/60 bg-success/35" aria-hidden="true"></span>
            <span class="text-xs text-text-tertiary">green = a branch Verve measures</span>
          </span>
        </span>
      </a>
    </div>
  </section>

  <!-- ── Every topic, by subject. One index: the four subjects in reading
       order, each with its topics and what each answers. This replaced a
       row of subject cards and a cloud of topic chips that said the same
       thing twice and put the topics nowhere in particular. Also where an
       unrecognised anchor lands. ────────────────────────────────────────── -->
  <section id="every-topic" class="scroll-mt-8 px-6 pb-28 sm:px-10">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
        <div>
          <h2 class="text-2xl font-bold text-text-primary">Every topic, by subject</h2>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text-secondary">
            Four subjects, one topic per page. Open a subject to read it in order, or go straight to a topic.
          </p>
        </div>
        <p class="text-xs text-text-tertiary">Each topic opens with what the app shows you, then the studies behind it.</p>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {SUBJECTS.map((s, si) => {
          const counts = subjectCounts(s.slug);
          const topics = topicsFor(s.slug);
          return (
            <div class="vrv-rise flex flex-col rounded-2xl border border-white/10 bg-white/4 p-[18px] pb-3.5" style={`--i: ${si}`}>
              <a
                href={`/science/${s.slug}`}
                class="group flex items-center gap-2.5 border-b border-white/[0.07] pb-3 transition-colors"
              >
                <span
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[10px]"
                  style={`background: ${s.accentTint}`}
                >
                  <svg
                    width="17" height="17" viewBox="0 0 24 24" fill="none"
                    stroke={s.accent} stroke-width="1.8"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                  >
                    {s.slug === "body" && <circle cx="12" cy="5" r="2.5" />}
                    <path d={s.icon} />
                  </svg>
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-[16px] font-bold text-text-primary">{s.label}</span>
                  <span class="block font-mono text-[10.5px] text-text-tertiary">
                    {counts.topics} topics &middot; {counts.citations} citations
                  </span>
                </span>
                <svg class="shrink-0 text-text-tertiary transition-colors group-hover:text-text-primary" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
              </a>
              <ol class="mt-1.5 flex flex-col">
                {topics.map((t, i) => (
                  <li>
                    <a
                      href={topicHref(t.slug)}
                      class="flex gap-2.5 rounded-[10px] px-1.5 py-2 transition-colors hover:bg-white/[0.05]"
                    >
                      <span class="w-3 shrink-0 pt-[3px] font-mono text-[10.5px] text-text-tertiary">{i + 1}</span>
                      <span class="min-w-0">
                        <span class="block text-[13.5px] font-semibold text-text-primary">{t.label}</span>
                        <span class="mt-0.5 block text-[12px] leading-snug text-text-tertiary">{t.sub}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
              {s.slug === "body" && (
                <p class="mt-auto border-t border-white/[0.07] pt-3.5 text-xs leading-relaxed text-text-muted">
                  Inside Body phenotyping: the {COUNTS.markers} body markers, each with its bands and how to measure it.
                </p>
              )}
            </div>
          );
        })}
      </div>

      <p class="mt-6 max-w-2xl text-xs leading-relaxed text-text-muted">
        Every address the app links to keeps working: this page forwards the old anchor to the topic’s page.
      </p>
    </div>
  </section>

  <Footer />
</Layout>
