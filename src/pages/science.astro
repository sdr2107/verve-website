---
/**
 * /science — the hub.
 *
 * This was one 1,200-line page carrying all twenty topics. It is now four
 * subject pages and this, which is the way in: the map, the four subjects,
 * where the readings land in the app, and the full index.
 *
 * It stays a real page at the same address for a reason beyond the reader.
 * Ten anchors are linked from inside the app — /science#zone-2 and the rest —
 * and those topics now live on subject pages. The script at the top of the
 * body forwards them before the page paints, from the same list that builds
 * the pages, so no hosting redirect rules exist to fall out of date and no
 * App Store release is needed to keep an old link working.
 */
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import { SUBJECTS, TOPICS, topicsFor, subjectCounts, COUNTS, ANCHOR_PAGE } from "../data/scienceTopics";

/** The three figures under the opening line. Counted, never typed. */
const figures = [
  { n: COUNTS.citations, label: "citations" },
  { n: COUNTS.topics, label: "topics" },
  { n: COUNTS.markers, label: "body markers" },
];

/** The sample readings drawn on the hub's three app cards. */
const screens = [
  {
    name: "Activity",
    caption: "This morning's read, your fitness tier, the week's climb.",
    tiles: [
      ["Sleep", "6h 29"],
      ["Resting HR", "52"],
      ["Recovery", "↓41"],
      ["Sitting", "3 h"],
    ],
    hero: { label: "CRF", value: "8.7 METs", note: "Below Average" },
  },
  {
    name: "Body",
    caption: "Metabolic, heart and muscle health from the values you already have.",
    tiles: [
      ["Metabolic", "6 of 8"],
      ["Heart", "4 of 7"],
      ["Muscle", "3 of 6"],
    ],
    hero: { label: "Lab timeline", value: "2024 – 2026", note: "Every reading, dated" },
  },
  {
    name: "Trends",
    caption: "Weeks, months and years, and a guide that says what moved.",
    tiles: [
      ["Fitness", "Below Avg"],
      ["Body", "Watch"],
      ["Sleep", "6h 29"],
      ["Activity", "Low Active"],
    ],
    hero: { label: "The Route", value: "8.7 METs", note: "Week · month · year" },
  },
];
---

<Layout
  title="The Science Behind Verve"
  description="Every threshold in Verve, traced to its source. Four subjects — fitness, movement, sleep and heart, body — each opening with what the app shows you, then the studies behind it."
>
  {/* ── Anchor forwarding. The app links to ten anchors that used to live on
       this page; they now live on subject pages. This runs before the body
       paints and rewrites the address, so a link from inside the app — or one
       a reader bookmarked — still lands on its paragraph. The map is derived
       from the topic list itself, so a topic added later cannot be left out
       of it. An anchor this does not recognise is left alone and the page
       scrolls to the index, as it did before. ─────────────────────────── */}
  <script is:inline define:vars={{ ANCHOR_PAGE }}>
    (function () {
      var hash = window.location.hash.slice(1);
      if (!hash) return;
      var page = ANCHOR_PAGE[hash];
      if (page) {
        window.location.replace(page + "#" + hash);
        return;
      }
      // Not a topic we know. The hub has nothing at that id, so the browser
      // would leave the reader at the top with no idea why. Put them at the
      // index instead, which is where the thing they asked for is listed.
      //
      // Twice: at DOMContentLoaded so there is no visible delay, and again at
      // load, because the first jump is measured before the web fonts settle
      // and a reflow after it would leave the reader short of the index.
      var toIndex = function () {
        var index = document.getElementById("every-topic");
        if (index) index.scrollIntoView();
      };
      document.addEventListener("DOMContentLoaded", toIndex);
      window.addEventListener("load", toIndex);
    })();
  </script>

  <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6 sm:px-10">
    <a href="/" class="flex items-center gap-2.5">
      <img src="/app-icon.png" alt="" class="h-8 w-8 rounded-lg" />
      <span class="text-lg font-semibold tracking-tight text-text-primary">Verve</span>
    </a>
    <div class="flex items-center gap-6">
      <a href="/my-health" class="text-sm font-medium text-text-secondary transition-colors hover:text-text-primary">
        My health
      </a>
      <a
        href="https://apps.apple.com/app/id6760022278"
        class="rounded-full border border-white/14 px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:border-white/25"
      >
        Get the app
      </a>
    </div>
  </header>

  <!-- ── The opening ─────────────────────────────────────────────────── -->
  <section class="relative px-6 pt-8 pb-16 sm:px-10">
    <div class="mx-auto max-w-3xl text-center">
      <span class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-light">
        The evidence base
      </span>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-text-primary sm:text-5xl">
        Every threshold, traced to its source.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-text-secondary">
        Verve is built so you come to know your own readings. Every number it
        shows you is one a clinician would use, and every threshold names the
        study it came from.
      </p>

      <dl class="mx-auto mt-10 flex max-w-lg justify-center gap-12">
        {figures.map((f) => (
          <div>
            <dt class="sr-only">{f.label}</dt>
            <dd>
              <span class="block font-mono text-3xl font-bold text-text-primary">{f.n}</span>
              <span class="mt-1 block text-xs text-text-tertiary">{f.label}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── Start here: the map ─────────────────────────────────────────── -->
  <section class="px-6 pb-20 sm:px-10">
    <div class="mx-auto max-w-4xl">
      <h2 class="font-mono text-[11px] font-semibold uppercase tracking-widest text-text-muted">
        Start here
      </h2>
      <a
        href="/crf-map"
        class="mt-4 block rounded-2xl border border-white/10 bg-white/4 p-7 transition-colors hover:border-white/22"
      >
        <span class="block text-xl font-semibold text-text-primary sm:text-2xl">
          The whole of cardiorespiratory fitness, on one map
        </span>
        <span class="mt-3 block max-w-2xl text-sm leading-relaxed text-text-secondary">
          The American Heart Association&rsquo;s 2016 statement is 30 pages of
          prose. Here it is as 226 connected ideas: what fitness measures, what
          it predicts, how it is tested, how it improves. Open a branch to read
          the claim; every branch Verve acts on is marked.
        </span>
        <span class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
          <span class="text-sm font-medium text-accent-light">Open the map &rarr;</span>
          <span class="font-mono text-xs text-text-muted">
            Pan, zoom, expand &middot; Ross et al. 2016
          </span>
        </span>
      </a>
    </div>
  </section>

  <!-- ── The four subjects ───────────────────────────────────────────── -->
  <section class="px-6 pb-20 sm:px-10">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-text-primary">Read it by subject</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text-secondary">
        Four pages instead of one scroll. Each opens with what the app shows
        you, then the studies behind it.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {SUBJECTS.map((s) => {
          const counts = subjectCounts(s.slug);
          return (
            <a
              href={`/science/${s.slug}`}
              class="flex flex-col rounded-2xl border border-white/8 bg-white/4 p-6 transition-colors hover:border-white/20"
            >
              <span class="text-lg font-semibold text-text-primary">{s.label}</span>
              <span class="mt-2 text-sm leading-relaxed text-text-secondary">
                {s.teaser}
              </span>
              <span class="mt-4 text-xs leading-relaxed text-text-tertiary">
                {topicsFor(s.slug).map((t) => t.label).join(" · ")}
              </span>
              <span class="mt-auto flex items-center justify-between pt-5">
                <span class="font-mono text-xs text-text-muted">
                  {counts.citations} citations &middot; {counts.topics} topics
                </span>
                <span class="text-sm text-accent-light">&rarr;</span>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ── Where the readings land in the app ──────────────────────────── -->
  <section class="px-6 pb-20 sm:px-10">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-text-primary">Where the numbers land</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text-secondary">
        Three pages. Each reading on them is one of the studies above, put
        where you will actually look at it.
      </p>
      <p class="mt-3 font-mono text-xs text-text-muted">
        iPhone &middot; Android soon &middot; sample figures
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {screens.map((s) => (
          <div class="rounded-2xl border border-white/8 bg-white/4 p-5">
            <span class="font-mono text-[11px] font-semibold uppercase tracking-widest text-accent-light">
              {s.name}
            </span>

            <div class="mt-4 rounded-xl border border-white/8 bg-white/4 px-4 py-3">
              <span class="block font-mono text-[10px] uppercase tracking-wider text-text-muted">
                {s.hero.label}
              </span>
              <span class="mt-1 block text-xl font-bold text-text-primary">{s.hero.value}</span>
              <span class="mt-0.5 block text-xs text-text-tertiary">{s.hero.note}</span>
            </div>

            <dl class="mt-3 space-y-1.5">
              {s.tiles.map(([label, value]) => (
                <div class="flex items-baseline justify-between gap-3">
                  <dt class="text-xs text-text-tertiary">{label}</dt>
                  <dd class="font-mono text-xs font-semibold text-text-secondary">{value}</dd>
                </div>
              ))}
            </dl>

            <p class="mt-4 text-xs leading-relaxed text-text-secondary">{s.caption}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── The full index. Also where an unrecognised anchor lands. ─────── -->
  <section id="every-topic" class="scroll-mt-8 px-6 pb-28 sm:px-10">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-text-primary">Every topic</h2>

      <div class="mt-6 flex flex-wrap gap-2">
        {TOPICS.map((t) => (
          <a
            href={`/science/${t.subject}#${t.slug}`}
            class="rounded-full border border-white/8 bg-white/4 px-4 py-2 text-xs font-medium text-text-secondary transition-colors hover:border-white/16 hover:text-text-primary"
          >
            {t.label}
          </a>
        ))}
      </div>

      <p class="mt-6 max-w-2xl text-xs leading-relaxed text-text-muted">
        Every one of these keeps the address it has today. A link from inside
        the app, or one you have bookmarked, lands on the same paragraph it
        always did.
      </p>
    </div>
  </section>

  <Footer />
</Layout>
