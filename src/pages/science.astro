---
import Layout from "../layouts/Layout.astro";
import CitationCard from "../components/CitationCard.astro";
import VideoSlot from "../components/VideoSlot.astro";
import Footer from "../components/Footer.astro";
import MetsVsMetHours from "../components/science/MetsVsMetHours.astro";
import MovementBalance from "../components/science/MovementBalance.astro";
import {
  CRF_SECTION,
  TEST_CRF_SECTION,
  MOVEMENT_BALANCE_SECTION,
  SEDENTARY_EXTRA,
  STEPS_SECTION,
  ZONE2_SECTION,
  WEEKLY_VOLUME_SECTION,
  ZONE2_HR_SECTION,
  BODY_PHENOTYPING_SECTION,
  HEART_HEALTH_SECTION,
  MUSCLE_HEALTH_SECTION,
  SLEEP_RHYTHM_SECTION,
  RESTING_HR_SECTION,
} from "../data/science";
import { BODY_MARKERS, BODY_MARKER_CONTEXT } from "../data/bodyMarkers";

const nav = [
  { slug: "mets-vs-met-h", label: "METs vs MET-h" },
  { slug: "crf", label: "Cardiorespiratory Fitness" },
  { slug: "test-crf", label: "Test Your CRF" },
  { slug: "test-accuracy", label: "Test Accuracy" },
  { slug: "run-protocols", label: "Run Protocols" },
  { slug: "movement-balance", label: "Movement Balance" },
  { slug: "activity-level", label: "Physical Activity Level" },
  { slug: "steps", label: "Steps & Cadence" },
  { slug: "zone-2", label: "Zone 2 Training" },
  { slug: "sleep-rhythm", label: "Sleep Timing" },
  { slug: "resting-heart-rate", label: "Resting Heart Rate" },
  { slug: "weekly-volume", label: "Weekly Volume" },
  { slug: "heart-health", label: "Heart Health" },
  { slug: "body-phenotyping", label: "Body Phenotyping" },
  { slug: "muscle-health", label: "Muscle Health" },
  { slug: "intrinsic-capacity", label: "Intrinsic Capacity" },
];
---

<Layout
  title="The Science Behind Verve"
  description="Every threshold in Verve, traced to its source — CRF, Zone 2, Heart Health, Body Phenotyping, and more, each backed by named, checkable research."
>
  <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6 sm:px-10">
    <a href="/" class="flex items-center gap-2.5">
      <img src="/app-icon.png" alt="" class="h-8 w-8 rounded-lg" />
      <span class="text-lg font-semibold tracking-tight text-text-primary">Verve</span>
    </a>
    <div class="flex items-center gap-6">
      <a href="/my-health" class="text-sm font-medium text-text-secondary transition-colors hover:text-text-primary">
        My health
      </a>
      <a
        href="https://apps.apple.com/app/id6760022278"
        class="rounded-full border border-white/14 px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:border-white/25"
      >
        Get the app
      </a>
    </div>
  </header>

  <section class="px-6 pt-8 pb-14 sm:px-10">
    <div class="mx-auto max-w-3xl text-center">
      <span class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-light">
        The evidence base
      </span>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-text-primary sm:text-5xl">
        Every threshold, traced to its source.
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-text-secondary">
        50 citations across 12 topics. No proprietary score you can't check the
        math on — every number below is the same one used inside the app, and
        every number links to where it came from.
      </p>
    </div>

    <!-- The map is the same evidence in a different shape — one whole-picture
         view of the AHA statement, versus this page's per-topic breakdown. -->
    <a
      href="/crf-map"
      class="mx-auto mt-8 flex max-w-2xl items-center gap-4 rounded-2xl border border-white/10 bg-white/4 px-5 py-4 transition-colors hover:border-white/22"
    >
      <span class="font-mono text-2xl leading-none text-accent-light" aria-hidden="true">⌥</span>
      <span class="flex-1">
        <span class="block text-sm font-semibold text-text-primary">
          See the whole AHA statement as one map
        </span>
        <span class="mt-0.5 block text-xs leading-relaxed text-text-secondary">
          226 concepts on cardiorespiratory fitness — interactive, pan and zoom.
        </span>
      </span>
      <span class="text-sm text-accent-light">&rarr;</span>
    </a>

    <!-- In-page nav -->
    <nav class="mx-auto mt-10 flex max-w-4xl flex-wrap justify-center gap-2">
      {nav.map((n) => (
        <a
          href={`#${n.slug}`}
          class="rounded-full border border-white/8 bg-white/4 px-4 py-2 text-xs font-medium text-text-secondary transition-colors hover:border-white/16 hover:text-text-primary"
        >
          {n.label}
        </a>
      ))}
    </nav>
  </section>

  <main class="mx-auto max-w-4xl space-y-20 px-6 pb-28 sm:px-10">
    <!-- ── METs vs MET-h ─────────────────────────────────────────────── -->
    <section id="mets-vs-met-h" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">METs vs MET-h</h2>
      <p class="mt-2 text-sm text-text-tertiary">Methodology &mdash; not a citation, this is how Verve computes it</p>
      <div class="mt-6"><VideoSlot topic="METs vs MET-h" /></div>
      <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
        <MetsVsMetHours />
      </div>
    </section>

    <!-- ── Cardiorespiratory Fitness ─────────────────────────────────── -->
    <section id="crf" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Cardiorespiratory Fitness &amp; MET</h2>
      <p class="mt-2 text-sm text-text-tertiary">Why Verve treats CRF as the headline metric, VO&#8322;Max as secondary</p>
      <div class="mt-6"><VideoSlot topic="Cardiorespiratory Fitness" /></div>
      <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
        <p class="text-sm leading-relaxed text-text-secondary">
          <strong class="text-text-primary">Ages 18&ndash;39:</strong> ACSM / Cooper
          Institute adult VO&#8322;Max norms (1997), converted to METs.
          <strong class="ml-1 text-text-primary">Ages 40+:</strong> Cleveland Clinic
          treadmill data (Mandsager 2018, 122,007 patients). Both use the same
          5-tier system (Low &rarr; Elite) &mdash; Verve automatically selects the
          correct source based on your profile age.
        </p>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {CRF_SECTION.map((c) => <CitationCard {...c} />)}
      </div>
    </section>

    <!-- ── Test Your CRF ─────────────────────────────────────────────── -->
    <section id="test-crf" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Test Your CRF</h2>
      <p class="mt-2 text-sm text-text-tertiary">Which test, when to retest, and why your watch disagrees</p>
      <div class="mt-6"><VideoSlot topic="Test Your CRF" /></div>

      <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
        <p class="text-sm leading-relaxed text-text-secondary">
          Verve recommends a fitness test in two stages, and the order is the
          whole design. <strong class="text-text-primary">Stage 1 is a safety
          ceiling</strong> &mdash; three questions about medical supervision,
          chest pain or dizziness during everyday activity, and any cardiac
          event in the past six months. Any yes means talking to a doctor before
          an all-out effort, and no amount of training history can lift that.
          It is applied before anything else is looked at.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          <strong class="text-text-primary">Stage 2 reads your recorded
          training</strong>, and all five checks must pass before a maximal test
          is recommended: trained within the window, 4 of 8 weeks carrying 3 or
          more training days, at least 2 hard sessions a week, one hard session
          in the last 14 days, and fewer than 2 consecutive quiet weeks. Where
          all five pass, Verve prefers to repeat <em>your last test</em> &mdash;
          comparing a 6-minute walk against a 12-minute run mixes method
          variance into what you would read as a change in your fitness.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          <strong class="text-text-primary">Why tests don&rsquo;t mix.</strong>
          A submaximal walk estimates your capacity from how your heart
          responds to easy work; a maximal run measures what you can actually
          do. The two carry different errors in different directions &mdash; a
          walk under-reads a fit person, a first maximal run under-reads a
          cautious pacer &mdash; so a change between test types usually
          reflects the tests, not your fitness. Verve flags a mixed history in
          the app and reads trends within one test type; when you retest, it
          offers your last test again for the same reason.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          <strong class="text-text-primary">Retesting is every 8 weeks.</strong>
          VO&#8322;Max adapts with a half-time of about 10&ndash;11 days and a
          dependable change takes on the order of 21 sessions, so a test before
          about 4 weeks usually returns your old number and teaches you only
          that you tested early. Eight weeks is also the window Verve reads your
          training over, so the two are the same span rather than two nearby
          ones.
        </p>
      </div>

      <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6" id="two-windows">
        <h3 class="text-lg font-semibold text-text-primary">Why the app shows two windows</h3>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          The readiness card in the app carries one row measured over
          <strong class="text-text-primary">three months</strong> and five
          measured over <strong class="text-text-primary">eight weeks</strong>.
          That is not an inconsistency. They answer different questions and
          come from different places.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          The three-month row is the exercise guideline&rsquo;s. ACSM defines
          &ldquo;currently active&rdquo; as habitual activity over the past
          three months, and that definition is used for one decision only:
          whether you should speak to a doctor before an all-out effort. It is
          a screening threshold, and screening thresholds are conservative on
          purpose.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          The eight-week rows are Verve&rsquo;s own, and they answer a
          physiological question instead: which test suits the training you
          have actually done. Eight weeks is chosen because that is roughly how
          long fitness takes to move by an amount a field test can detect
          (Hickson 1981). Neither number can stand in for the other. Borrowing
          the screening threshold to answer the physiology question is how an
          app ends up recommending a maximal run to someone who walked twice
          last month.
        </p>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {TEST_CRF_SECTION.map((c) => <CitationCard {...c} />)}
      </div>
    </section>

    <!-- ── How accurate each test is ─────────────────────── -->
    <section id="test-accuracy" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">How Accurate Each Test Is</h2>
      <p class="mt-2 text-sm text-text-tertiary">What r &asymp; 0.90 means, what the stars mean, and where these tests stop working</p>

      <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
        <h3 class="text-lg font-semibold text-text-primary">The r value</h3>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          Every test in Verve carries a small badge &mdash;
          <code class="rounded bg-white/8 px-1.5 py-0.5 text-xs">r &asymp; 0.90</code>
          on the Cooper run, for instance. <strong class="text-text-primary">r
          is a correlation coefficient</strong>: how closely the test&rsquo;s
          estimate tracks a true VO&#8322;Max measured in a laboratory with a
          gas-analysis mask. It runs from 0 (no relationship at all) to 1 (a
          perfect one).
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          An r of 0.90 means the test ranks people almost exactly as the lab
          would. Someone it puts above you would almost certainly test above
          you on a treadmill. What r does <em>not</em> tell you is how far off
          any single number is &mdash; a test can rank a whole group perfectly
          and still read a few points high for everyone in it. That is why the
          honest use of a field test is
          <strong class="text-text-primary">comparing you against yourself over
          time</strong>, on the same test, rather than treating one result as a
          laboratory measurement.
        </p>

        <div class="mt-6 overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-white/10 text-xs uppercase tracking-wide text-text-tertiary">
                <th class="pb-2 pr-4 font-medium">Test</th>
                <th class="pb-2 pr-4 font-medium">Effort</th>
                <th class="pb-2 font-medium">Accuracy</th>
              </tr>
            </thead>
            <tbody class="text-text-secondary">
              <tr class="border-b border-white/5"><td class="py-2 pr-4">Bruce Protocol</td><td class="py-2 pr-4">Maximal, supervised</td><td class="py-2">&plusmn;3.5 mL/kg/min</td></tr>
              <tr class="border-b border-white/5"><td class="py-2 pr-4">Cooper 12-Minute Run</td><td class="py-2 pr-4">Maximal</td><td class="py-2">r &asymp; 0.90</td></tr>
              <tr class="border-b border-white/5"><td class="py-2 pr-4">1.5-Mile Run</td><td class="py-2 pr-4">Maximal</td><td class="py-2">r &asymp; 0.85</td></tr>
              <tr class="border-b border-white/5"><td class="py-2 pr-4">1-Mile Walk Test</td><td class="py-2 pr-4">Submaximal</td><td class="py-2">r &asymp; 0.88</td></tr>
              <tr><td class="py-2 pr-4">6-Minute Walk Test</td><td class="py-2 pr-4">Submaximal</td><td class="py-2">~13% MAPE</td></tr>
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-xs leading-relaxed text-text-tertiary">
          MAPE is mean absolute percentage error &mdash; the average size of the
          miss, regardless of direction. It answers the question r cannot.
        </p>
      </div>

      <div class="mt-4 rounded-2xl border border-white/8 bg-white/4 p-6">
        <h3 class="text-lg font-semibold text-text-primary">The stars</h3>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          The star rating is Verve&rsquo;s own shorthand for how much weight a
          result deserves, and it combines two things the r value keeps
          separate: how well the method is validated, and how much of the
          answer depends on you performing well on the day. Four stars are the
          maximal tests, where the number is limited by your physiology. Three
          stars are the submaximal ones, which estimate your capacity from how
          your heart responds to easy work &mdash; safer, repeatable, and one
          inference further from the thing being measured.
        </p>
      </div>

      <div class="mt-4 rounded-2xl border border-white/8 bg-white/4 p-6">
        <h3 class="text-lg font-semibold text-text-primary">Where these tests stop working</h3>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          Field-test estimates are most accurate for active-to-trained young and
          middle-aged adults, because that is who the validation studies
          recruited. They are less reliable at both edges: highly trained
          athletes, whose results compress near the top of the scale, and very
          sedentary people, who are under-represented in the original data and
          whose pacing on an unfamiliar all-out effort is itself unpractised.
          If you sit at either edge, the trend in your own numbers is worth more
          than any single one of them.
        </p>
      </div>
    </section>

    <!-- ── The run protocols in full ─────────────────────── -->
    <section id="run-protocols" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">The Run Protocols In Full</h2>
      <p class="mt-2 text-sm text-text-tertiary">What the app&rsquo;s checklist is short for</p>

      <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
        <p class="text-sm leading-relaxed text-text-secondary">
          The app shows these as a short checklist on purpose. You read it
          standing on a start line, and a paragraph of reasoning is the wrong
          thing to hand someone in that moment. The reasoning is here.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          <strong class="text-text-primary">No hard exercise for 24 hours.</strong>
          A maximal test measures your ceiling, and residual fatigue lowers it.
          Testing the day after a hard session reads as a fitness decline that
          never happened &mdash; the most common way a person records a drop
          they then try to explain.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          <strong class="text-text-primary">Warm up for 10&ndash;15 minutes.</strong>
          Beyond injury risk, an unwarmed start spends the first minutes of a
          12-minute test on physiology a warm-up would already have handled, and
          those minutes are a measurable part of the distance.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          <strong class="text-text-primary">Start controlled, finish hard.</strong>
          The Cooper test rewards even pacing. Going out too fast produces an
          early slowdown that costs more distance than the fast start gained,
          which is why first-time testers frequently under-read their own
          fitness. On the 1.5-mile run the same logic applies to splits.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          <strong class="text-text-primary">Walk if you need to, but keep
          moving.</strong> The test is a distance in a fixed time (Cooper) or a
          time over a fixed distance (1.5-mile). Stopping entirely ends the
          test; walking is a slower pace, not a failure, and a walked finish is
          still a valid result.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          <strong class="text-text-primary">Why a large meal matters.</strong>
          Digestion diverts blood flow a maximal effort is competing for. Two to
          three hours is enough for a normal meal; the guidance is about comfort
          and performance rather than safety.
        </p>
      </div>

      <div class="mt-4 rounded-2xl border border-white/8 bg-white/4 p-6">
        <h3 class="text-lg font-semibold text-text-primary">The stop signals, and why they are absolute</h3>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          Chest pain, dizziness, lightheadedness, nausea, leg cramps, or
          breathlessness beyond hard breathing mean stop &mdash; not slow down.
          Hard running is uncomfortable, and the difficulty is telling ordinary
          maximal-effort discomfort from a symptom. The rule Verve uses is that
          you should not have to make that judgement: if you meet any of these,
          the test is over and the result does not matter.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          The same symptoms in the hours after a test warrant medical attention.
          Cardiac events associated with unaccustomed maximal exertion are rare,
          and are concentrated in people doing an all-out effort they have not
          trained for &mdash; which is precisely what the safety check and the
          eight-week training window exist to catch before you reach the start
          line.
        </p>
      </div>
    </section>

    <!-- ── Movement Balance ──────────────────────────────────────────── -->
    <section id="movement-balance" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Sedentary Behavior &amp; Movement Balance</h2>
      <p class="mt-2 text-sm text-text-tertiary">How Verve reads your day beyond workout minutes</p>
      <div class="mt-6"><VideoSlot topic="Movement Balance" /></div>
      <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
        <MovementBalance />
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {[...MOVEMENT_BALANCE_SECTION, ...SEDENTARY_EXTRA].map((c) => <CitationCard {...c} />)}
      </div>

      <h3 class="mt-10 text-lg font-semibold text-text-primary">What each figure on the card means</h3>
      <div class="mt-4 space-y-4 text-sm leading-relaxed text-text-secondary">
        <p>
          <strong class="text-text-primary">Sedentary hours.</strong> A waking hour with fewer than
          50 steps in it counts as sedentary. Steps come from Apple Health, so nothing is typed in.
          Waking hours are your measured sleep where Verve has it, and 7am to 10pm where it does
          not — the card says which, because an assumed wake time counts somebody's actual lie-in
          as sitting.
        </p>
        <p>
          <strong class="text-text-primary">Unbroken sitting.</strong> The longest run of
          consecutive sedentary hours, not the daily total. This is the figure the evidence is
          actually about: risk tracks uninterrupted sitting rather than hours accumulated across a
          day, and six hours broken every thirty minutes is a different day from six hours in one
          block. A sleep hour or a workout ends a run — you were not sitting through either.
        </p>
        <p>
          <strong class="text-text-primary">Standing minutes.</strong> Minutes Apple Watch detected
          you upright and moving. More precise than the Stand ring, which credits a whole hour for
          one minute on your feet: this counts the minutes themselves. Apple Watch only.
        </p>
        <p>
          <strong class="text-text-primary">Napped.</strong> Daytime sleep, shown when there was
          some. A nap is any sleep session that does not begin in the night (20:00 to 05:00),
          however long it runs. It is drawn as rest on the terrain and excluded from sitting — you
          were not sitting through it — and it is excluded from last night's sleep on the Sleep
          card, because a nap is not a bedtime. The same rule decides both.
        </p>
        <p>
          <strong class="text-text-primary">The 24-hour terrain.</strong> Height is steps per hour.
          The strip beneath it is the hour's state: green active, orange sedentary, blue asleep
          (naps included), grey an hour that has not happened yet.
        </p>
      </div>
    </section>

    <!-- ── Activity Level (PAL) ──────────────────────────────────────── -->
    <section id="activity-level" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Physical Activity Level (PAL)</h2>
      <p class="mt-2 text-sm text-text-tertiary">How active your whole day is — and how much of that number to trust</p>

      <div class="mt-6 space-y-4 text-sm leading-relaxed text-text-secondary">
        <p>
          <strong class="text-text-primary">Physical Activity Level</strong> measures how active your
          entire day is, not just your workouts. It is your total daily energy expenditure divided by
          your basal metabolic rate — the energy your body would use lying still. A PAL of 1.0 would
          mean complete bed rest. Around 2.5 is elite-athlete territory. Verve reads it from Apple
          Health's basal and active energy, averaged over seven days.
        </p>

        <h3 class="pt-2 text-lg font-semibold text-text-primary">The four levels</h3>
        <p>
          The tiers come from the Institute of Medicine's Dietary Reference Intakes, which defined
          them to set energy requirements for populations: sedentary 1.00–1.39, low active 1.40–1.59,
          active 1.60–1.89, very active 1.90–2.50.
        </p>

        <h3 class="pt-2 text-lg font-semibold text-text-primary">Read the trend, not the number</h3>
        <p>
          Both halves of this ratio are estimates, so the error compounds. Active calories come from
          your wrist, where systematic reviews put energy-expenditure error above 30%, and they miss
          effort that does not move your arm — cycling, rowing, lifting, carrying. Your resting figure
          is not measured at all; it is predicted from your height, weight, age and sex. Every wearable
          tested against doubly-labelled water <em>under</em>-estimates, for Apple Watch by roughly
          394 kcal a day, and the bias grows at higher effort and higher body fat.
        </p>
        <p>
          The practical consequence: a single PAL carries a band wide enough to straddle two tiers.
          Whether it drifts up over months does not. That is why Verve shows this as a trend read
          against the tier bands rather than as a figure to hit, and why the app's chart marks which
          band each week or month fell in rather than asking you to read a slope off a noisy line.
        </p>

        <h3 class="pt-2 text-lg font-semibold text-text-primary">The one correction Verve makes</h3>
        <p>
          Apple reports basal and active energy but not the thermic effect of food — the energy spent
          digesting, conventionally about 10% of total daily expenditure. Their sum is therefore not
          total daily energy expenditure, so Verve divides by 0.9 to recover it. That correction is
          definitional rather than a judgement call, and it is the only adjustment applied.
        </p>
        <p>
          Two further adjustments were tried and removed: an additive correction for occupational
          activity, and a rule that raised the tier when logged training contradicted a sedentary
          label. Both were judgement calls stacked on a base with more than 30% error, and the
          occupational one double-counted part of the very bias the thermic-effect correction already
          approximates. Layers of inference do not rescue a noisy instrument; they only obscure how
          noisy it is.
        </p>
      </div>
    </section>

    <!-- ── Steps & Cadence ───────────────────────────────────────────── -->
    <section id="steps" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Step Count &amp; Daily Movement</h2>
      <p class="mt-2 text-sm text-text-tertiary">Daily step tiers and cadence zones</p>
      <div class="mt-6"><VideoSlot topic="Steps & Cadence" /></div>
