---
import Layout from "../layouts/Layout.astro";
import CitationCard from "../components/CitationCard.astro";
import VideoSlot from "../components/VideoSlot.astro";
import Footer from "../components/Footer.astro";
import MetsVsMetHours from "../components/science/MetsVsMetHours.astro";
import MovementBalance from "../components/science/MovementBalance.astro";
import {
  CRF_SECTION,
  TEST_CRF_SECTION,
  MOVEMENT_BALANCE_SECTION,
  SEDENTARY_EXTRA,
  STEPS_SECTION,
  ZONE2_SECTION,
  WEEKLY_VOLUME_SECTION,
  ZONE2_HR_SECTION,
  BODY_PHENOTYPING_SECTION,
  HEART_HEALTH_SECTION,
  MUSCLE_HEALTH_SECTION,
  SLEEP_RHYTHM_SECTION,
  RESTING_HR_SECTION,
} from "../data/science";
import { BODY_MARKERS, BODY_MARKER_CONTEXT } from "../data/bodyMarkers";

const nav = [
  { slug: "mets-vs-met-h", label: "METs vs MET-h" },
  { slug: "crf", label: "Cardiorespiratory Fitness" },
  { slug: "test-crf", label: "Test Your CRF" },
  { slug: "movement-balance", label: "Movement Balance" },
  { slug: "activity-level", label: "Physical Activity Level" },
  { slug: "steps", label: "Steps & Cadence" },
  { slug: "zone-2", label: "Zone 2 Training" },
  { slug: "sleep-rhythm", label: "Sleep Timing" },
  { slug: "resting-heart-rate", label: "Resting Heart Rate" },
  { slug: "weekly-volume", label: "Weekly Volume" },
  { slug: "heart-health", label: "Heart Health" },
  { slug: "body-phenotyping", label: "Body Phenotyping" },
  { slug: "muscle-health", label: "Muscle Health" },
];
---

<Layout
  title="The Science Behind Verve"
  description="Every threshold in Verve, traced to its source — CRF, Zone 2, Heart Health, Body Phenotyping, and more, each backed by named, checkable research."
>
  <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6 sm:px-10">
    <a href="/" class="flex items-center gap-2.5">
      <img src="/app-icon.png" alt="" class="h-8 w-8 rounded-lg" />
      <span class="text-lg font-semibold tracking-tight text-text-primary">Verve</span>
    </a>
    <div class="flex items-center gap-6">
      <a href="/my-health" class="text-sm font-medium text-text-secondary transition-colors hover:text-text-primary">
        My health
      </a>
      <a
        href="https://apps.apple.com/app/id6760022278"
        class="rounded-full border border-white/14 px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:border-white/25"
      >
        Get the app
      </a>
    </div>
  </header>

  <section class="px-6 pt-8 pb-14 sm:px-10">
    <div class="mx-auto max-w-3xl text-center">
      <span class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-light">
        The evidence base
      </span>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-text-primary sm:text-5xl">
        Every threshold, traced to its source.
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-text-secondary">
        50 citations across 12 topics. No proprietary score you can't check the
        math on — every number below is the same one used inside the app, and
        every number links to where it came from.
      </p>
    </div>

    <!-- The map is the same evidence in a different shape — one whole-picture
         view of the AHA statement, versus this page's per-topic breakdown. -->
    <a
      href="/crf-map"
      class="mx-auto mt-8 flex max-w-2xl items-center gap-4 rounded-2xl border border-white/10 bg-white/4 px-5 py-4 transition-colors hover:border-white/22"
    >
      <span class="font-mono text-2xl leading-none text-accent-light" aria-hidden="true">⌥</span>
      <span class="flex-1">
        <span class="block text-sm font-semibold text-text-primary">
          See the whole AHA statement as one map
        </span>
        <span class="mt-0.5 block text-xs leading-relaxed text-text-secondary">
          226 concepts on cardiorespiratory fitness — interactive, pan and zoom.
        </span>
      </span>
      <span class="text-sm text-accent-light">&rarr;</span>
    </a>

    <!-- In-page nav -->
    <nav class="mx-auto mt-10 flex max-w-4xl flex-wrap justify-center gap-2">
      {nav.map((n) => (
        <a
          href={`#${n.slug}`}
          class="rounded-full border border-white/8 bg-white/4 px-4 py-2 text-xs font-medium text-text-secondary transition-colors hover:border-white/16 hover:text-text-primary"
        >
          {n.label}
        </a>
      ))}
    </nav>
  </section>

  <main class="mx-auto max-w-4xl space-y-20 px-6 pb-28 sm:px-10">
    <!-- ── METs vs MET-h ─────────────────────────────────────────────── -->
    <section id="mets-vs-met-h" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">METs vs MET-h</h2>
      <p class="mt-2 text-sm text-text-tertiary">Methodology &mdash; not a citation, this is how Verve computes it</p>
      <div class="mt-6"><VideoSlot topic="METs vs MET-h" /></div>
      <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
        <MetsVsMetHours />
      </div>
    </section>

    <!-- ── Cardiorespiratory Fitness ─────────────────────────────────── -->
    <section id="crf" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Cardiorespiratory Fitness &amp; MET</h2>
      <p class="mt-2 text-sm text-text-tertiary">Why Verve treats CRF as the headline metric, VO&#8322;Max as secondary</p>
      <div class="mt-6"><VideoSlot topic="Cardiorespiratory Fitness" /></div>
      <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
        <p class="text-sm leading-relaxed text-text-secondary">
          <strong class="text-text-primary">Ages 18&ndash;39:</strong> ACSM / Cooper
          Institute adult VO&#8322;Max norms (1997), converted to METs.
          <strong class="ml-1 text-text-primary">Ages 40+:</strong> Cleveland Clinic
          treadmill data (Mandsager 2018, 122,007 patients). Both use the same
          5-tier system (Low &rarr; Elite) &mdash; Verve automatically selects the
          correct source based on your profile age.
        </p>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {CRF_SECTION.map((c) => <CitationCard {...c} />)}
      </div>
    </section>

    <!-- ── Test Your CRF ─────────────────────────────────────────────── -->
    <section id="test-crf" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Test Your CRF</h2>
      <p class="mt-2 text-sm text-text-tertiary">Which test, when to retest, and why your watch disagrees</p>
      <div class="mt-6"><VideoSlot topic="Test Your CRF" /></div>

      <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
        <p class="text-sm leading-relaxed text-text-secondary">
          Verve recommends a fitness test in two stages, and the order is the
          whole design. <strong class="text-text-primary">Stage 1 is a safety
          ceiling</strong> &mdash; three questions about medical supervision,
          chest pain or dizziness during everyday activity, and any cardiac
          event in the past six months. Any yes means talking to a doctor before
          an all-out effort, and no amount of training history can lift that.
          It is applied before anything else is looked at.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          <strong class="text-text-primary">Stage 2 reads your recorded
          training</strong>, and all five checks must pass before a maximal test
          is recommended: trained within the window, 4 of 8 weeks carrying 3 or
          more training days, at least 2 hard sessions a week, one hard session
          in the last 14 days, and fewer than 2 consecutive quiet weeks. Where
          all five pass, Verve prefers to repeat <em>your last test</em> &mdash;
          comparing a 6-minute walk against a 12-minute run mixes method
          variance into what you would read as a change in your fitness.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          <strong class="text-text-primary">Why tests don&rsquo;t mix.</strong>
          A submaximal walk estimates your capacity from how your heart
          responds to easy work; a maximal run measures what you can actually
          do. The two carry different errors in different directions &mdash; a
          walk under-reads a fit person, a first maximal run under-reads a
          cautious pacer &mdash; so a change between test types usually
          reflects the tests, not your fitness. Verve flags a mixed history in
          the app and reads trends within one test type; when you retest, it
          offers your last test again for the same reason.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          <strong class="text-text-primary">Retesting is every 8 weeks.</strong>
          VO&#8322;Max adapts with a half-time of about 10&ndash;11 days and a
          dependable change takes on the order of 21 sessions, so a test before
          about 4 weeks usually returns your old number and teaches you only
          that you tested early. Eight weeks is also the window Verve reads your
          training over, so the two are the same span rather than two nearby
          ones.
        </p>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {TEST_CRF_SECTION.map((c) => <CitationCard {...c} />)}
      </div>
    </section>

    <!-- ── Movement Balance ──────────────────────────────────────────── -->
    <section id="movement-balance" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Sedentary Behavior &amp; Movement Balance</h2>
      <p class="mt-2 text-sm text-text-tertiary">How Verve reads your day beyond workout minutes</p>
      <div class="mt-6"><VideoSlot topic="Movement Balance" /></div>
      <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
        <MovementBalance />
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {[...MOVEMENT_BALANCE_SECTION, ...SEDENTARY_EXTRA].map((c) => <CitationCard {...c} />)}
      </div>
    </section>

    <!-- ── Activity Level (PAL) ──────────────────────────────────────── -->
    <section id="activity-level" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Physical Activity Level (PAL)</h2>
      <p class="mt-2 text-sm text-text-tertiary">How active your whole day is — and how much of that number to trust</p>

      <div class="mt-6 space-y-4 text-sm leading-relaxed text-text-secondary">
        <p>
          <strong class="text-text-primary">Physical Activity Level</strong> measures how active your
          entire day is, not just your workouts. It is your total daily energy expenditure divided by
          your basal metabolic rate — the energy your body would use lying still. A PAL of 1.0 would
          mean complete bed rest. Around 2.5 is elite-athlete territory. Verve reads it from Apple
          Health's basal and active energy, averaged over seven days.
        </p>

        <h3 class="pt-2 text-lg font-semibold text-text-primary">The four levels</h3>
        <p>
          The tiers come from the Institute of Medicine's Dietary Reference Intakes, which defined
          them to set energy requirements for populations: sedentary 1.00–1.39, low active 1.40–1.59,
          active 1.60–1.89, very active 1.90–2.50.
        </p>

        <h3 class="pt-2 text-lg font-semibold text-text-primary">Read the trend, not the number</h3>
        <p>
          Both halves of this ratio are estimates, so the error compounds. Active calories come from
          your wrist, where systematic reviews put energy-expenditure error above 30%, and they miss
          effort that does not move your arm — cycling, rowing, lifting, carrying. Your resting figure
          is not measured at all; it is predicted from your height, weight, age and sex. Every wearable
          tested against doubly-labelled water <em>under</em>-estimates, for Apple Watch by roughly
          394 kcal a day, and the bias grows at higher effort and higher body fat.
        </p>
        <p>
          The practical consequence: a single PAL carries a band wide enough to straddle two tiers.
          Whether it drifts up over months does not. That is why Verve shows this as a trend read
          against the tier bands rather than as a figure to hit, and why the app's chart marks which
          band each week or month fell in rather than asking you to read a slope off a noisy line.
        </p>

        <h3 class="pt-2 text-lg font-semibold text-text-primary">The one correction Verve makes</h3>
        <p>
          Apple reports basal and active energy but not the thermic effect of food — the energy spent
          digesting, conventionally about 10% of total daily expenditure. Their sum is therefore not
          total daily energy expenditure, so Verve divides by 0.9 to recover it. That correction is
          definitional rather than a judgement call, and it is the only adjustment applied.
        </p>
        <p>
          Two further adjustments were tried and removed: an additive correction for occupational
          activity, and a rule that raised the tier when logged training contradicted a sedentary
          label. Both were judgement calls stacked on a base with more than 30% error, and the
          occupational one double-counted part of the very bias the thermic-effect correction already
          approximates. Layers of inference do not rescue a noisy instrument; they only obscure how
          noisy it is.
        </p>
      </div>
    </section>

    <!-- ── Steps & Cadence ───────────────────────────────────────────── -->
    <section id="steps" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Step Count &amp; Daily Movement</h2>
      <p class="mt-2 text-sm text-text-tertiary">Daily step tiers and cadence zones</p>
      <div class="mt-6"><VideoSlot topic="Steps & Cadence" /></div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {STEPS_SECTION.map((c) => <CitationCard {...c} />)}
      </div>
    </section>

    <!-- ── Zone 2 (volume + HR method together) ──────────────────────── -->
    <section id="zone-2" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Zone 2 Training</h2>
      <p class="mt-2 text-sm text-text-tertiary">The weekly target, and the personal heart-rate band behind it</p>
      <div class="mt-6"><VideoSlot topic="Zone 2 Training" /></div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {ZONE2_SECTION.map((c) => <CitationCard {...c} />)}
      </div>
      <h3 class="mt-10 text-lg font-semibold text-text-primary">Heart-rate method: Karvonen HRR</h3>
      <p class="mt-2 text-sm leading-relaxed text-text-secondary">
        "Zone 2" is a training label applied to the 40&ndash;60% Heart Rate Reserve
        band &mdash; different models (Seiler polarised, Maffetone 180-minus-age,
        San Mill&aacute;n VT1-based) draw the upper boundary slightly differently, but
        all target the same physiological space just below the first ventilatory
        threshold.
      </p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {ZONE2_HR_SECTION.map((c) => <CitationCard {...c} />)}
      </div>
    </section>

    <!-- ── Conditions: the three readings on the Activity card ───────────
         Linked directly from the app — each tile's "The research behind
         this" opens the matching anchor below, not the page root. -->

    <!-- ── Sleep Rhythm ──────────────────────────────────────────────── -->
    <section id="sleep-rhythm" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Sleep Timing</h2>
      <p class="mt-2 text-sm text-text-tertiary">How much your bedtime moves, and the research index behind it</p>
      <div class="mt-6"><VideoSlot topic="Sleep Timing" /></div>
      <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
        <p class="text-sm leading-relaxed text-text-secondary">
          Verve leads with the <strong class="text-text-primary">spread of your
          bedtime in minutes</strong>: how far it moves from one night to the
          next. That is the measure the 2025 AHA scientific statement names for
          regularity, it carries a real mark at
          <strong class="text-text-primary">60 minutes</strong>, and it is in a
          unit you can act on tonight. Clock times are treated as angles on a
          24-hour circle &mdash; a plain average would place 23:50 and 00:10
          nearly a full day apart and report the steadiest sleepers as the most
          erratic.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          Behind it sits the <strong class="text-text-primary">Sleep Regularity
          Index</strong>: the probability of being in the same state, asleep or
          awake, at any two clock times 24 hours apart. It is the stronger
          research metric &mdash; in UK Biobank it out-predicted sleep duration
          for mortality &mdash; but it is a research metric, reported by no
          consumer wearable and named by no guideline for individual care, and
          two accepted calculators disagree on the same nights. So it is the
          number underneath, not the headline. Its median of
          <strong class="text-text-primary">81</strong> is a percentile of one
          cohort, not a clinical threshold.
        </p>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {SLEEP_RHYTHM_SECTION.map((c) => <CitationCard {...c} />)}
      </div>
    </section>

    <!-- ── Resting Heart Rate ────────────────────────────────────────── -->
    <section id="resting-heart-rate" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Resting Heart Rate</h2>
      <p class="mt-2 text-sm text-text-tertiary">Measured against your own normal, not a population range</p>
      <div class="mt-6"><VideoSlot topic="Resting Heart Rate" /></div>
      <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
        <p class="text-sm leading-relaxed text-text-secondary">
          Verve compares today's resting heart rate with the median of your own
          last 30 days. Within <strong class="text-text-primary">5 bpm</strong> is
          ordinary day-to-day variation; around
          <strong class="text-text-primary">5 bpm above</strong>, sustained for a few
          days, is worth noticing; around
          <strong class="text-text-primary">10 above</strong> is a clear departure.
          The instrument shades only the high side, because a low resting rate is
          not a finding &mdash; a rested morning and an adapted endurance athlete
          both land there.
        </p>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {RESTING_HR_SECTION.map((c) => <CitationCard {...c} />)}
      </div>
    </section>

    <!-- ── Weekly Volume ─────────────────────────────────────────────── -->
    <section id="weekly-volume" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Weekly Activity Volume</h2>
      <p class="mt-2 text-sm text-text-tertiary">How much per week &mdash; and why the summit sits well above 150 minutes</p>
      <div class="mt-6"><VideoSlot topic="Weekly Activity Volume" /></div>
      <p class="mt-6 text-sm leading-relaxed text-text-secondary">
        The Weekly Ascent draws four altitude lines: base camp at 150 minutes,
        your own goal, high camp at 300, and a summit at 610 that stays hidden
        until you pass high camp. The first two numbers are the familiar
        public-health doses. The third is newer, larger, and measured the same
        way Verve measures you.
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {WEEKLY_VOLUME_SECTION.map((c) => <CitationCard {...c} />)}
      </div>
    </section>

    <!-- ── Heart Health ──────────────────────────────────────────────── -->
    <section id="heart-health" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Heart Health</h2>
      <p class="mt-2 text-sm text-text-tertiary">ApoB &middot; LDL-C &middot; Lp(a) &middot; hs-CRP &mdash; screening bands, not treatment targets</p>
      <div class="mt-6"><VideoSlot topic="Heart Health" /></div>
      <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
        <p class="text-sm leading-relaxed text-text-secondary">
          For ApoB and LDL-C in particular, clinical targets are set by a
          person's overall cardiovascular risk category &mdash; a value in the
          "borderline" band may be perfectly appropriate for one person and a
          treatment trigger for another. Verve classifies against population
          screening bands and always defers to a clinician.
        </p>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {HEART_HEALTH_SECTION.map((c) => <CitationCard {...c} />)}
      </div>
    </section>

    <!-- ── Body Phenotyping ──────────────────────────────────────────── -->
    <section id="body-phenotyping" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Body Phenotyping</h2>
      <p class="mt-2 text-sm text-text-tertiary">Metabolic syndrome screening, beyond BMI</p>
      <div class="mt-6"><VideoSlot topic="Body Phenotyping" /></div>

      <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6" id="health-picture">
        <h3 class="text-base font-semibold text-text-primary">The Health Picture &mdash; weight &times; fitness</h3>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          The app&rsquo;s Health Picture grid crosses your BMI band with your
          fitness tier, because the two together predict better than either
          alone &mdash; and fitness is the half that responds to training
          within weeks. What each square means:
        </p>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-text-secondary">
          <li><strong class="text-text-primary">Lean &amp; Active</strong> &mdash; both dimensions working in your favour. Strength training is the highest-value next add.</li>
          <li><strong class="text-text-primary">Fit on the Outside</strong> &mdash; normal weight, low fitness. Normal-weight-unfit carries 2&ndash;3&times; the mortality of fit people across all BMI bands; fitness is the lever.</li>
          <li><strong class="text-text-primary">Active &amp; Heavy</strong> &mdash; fitness substantially attenuates the risk of extra weight. Keep fitness high while addressing visceral fat.</li>
          <li><strong class="text-text-primary">Weight &amp; Fitness Gap</strong> &mdash; improve fitness first: risk reduction begins before the scale moves.</li>
          <li><strong class="text-text-primary">Strong Foundation</strong> &mdash; fitness substantially attenuates but does not fully eliminate cardiovascular risk at this BMI. Maintain fitness alongside gradual body-composition change.</li>
          <li><strong class="text-text-primary">Time to Move</strong> &mdash; 1&ndash;2 METs gained from daily walking produces measurable mortality reduction; each 1 MET is roughly 13&ndash;14% lower risk.</li>
        </ul>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {BODY_PHENOTYPING_SECTION.map((c) => <CitationCard {...c} />)}
      </div>
    </section>

    <!-- ── Body markers ──────────────────────────────────────────────────
         One entry per marker the Body page can record, anchored so the app
         links straight to the parameter a reader is looking at.

         GENERATED from lib/markers.ts in the app repo — the same definitions
         the app classifies readings with. That is deliberate: a threshold
         quoted here that no longer matches the one a reader was just shown on
         their phone is worse than no page at all. ── -->
    <section id="body-markers" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Body markers</h2>
      <p class="mt-2 text-sm text-text-tertiary">
        What each measurement is, how to take it, and the ranges it is read against
      </p>
      <p class="mt-3 text-xs text-text-tertiary">{BODY_MARKER_CONTEXT}</p>

      {["Metabolic", "Heart", "Muscle"].map((group) => (
        <div class="mt-8">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-text-tertiary">{group}</h3>
          <div class="mt-4 space-y-6">
            {BODY_MARKERS.filter((m) => m.section === group).map((m) => (
              <article id={m.slug} class="scroll-mt-8 rounded-xl border border-white/10 bg-white/[0.03] p-5">
                <h4 class="text-lg font-bold text-text-primary">
                  {m.label}
                  {m.units.length > 0 && (
                    <span class="ml-2 text-sm font-normal text-text-tertiary">{m.units.join(" · ")}</span>
                  )}
                </h4>
                {m.purpose && <p class="mt-1 text-sm text-text-secondary">{m.purpose}</p>}
                {m.note && <p class="mt-2 text-sm text-text-tertiary">{m.note}</p>}

                {m.bands.length > 0 && (
                  <div class="mt-4">
                    <p class="text-xs font-semibold uppercase tracking-wider text-text-tertiary">Ranges</p>
                    <ul class="mt-2 space-y-1 text-sm text-text-secondary">
                      {m.bands.map((b) => <li>{b}</li>)}
                    </ul>
                  </div>
                )}

                {m.howTo.length > 0 && (
                  <div class="mt-4">
                    <p class="text-xs font-semibold uppercase tracking-wider text-text-tertiary">How to measure it</p>
                    <ol class="mt-2 list-decimal space-y-1 pl-5 text-sm text-text-secondary">
                      {m.howTo.map((h) => <li>{h}</li>)}
                    </ol>
                  </div>
                )}

                {m.detail.length > 0 && (
                  <div class="mt-4 space-y-3 border-t border-white/[0.07] pt-4">
                    {m.detail.map((d) => (
                      <p class="text-sm leading-6 text-text-secondary">{d}</p>
                    ))}
                  </div>
                )}

                {m.references.length > 0 && (
                  <div class="mt-4">
                    <p class="text-xs font-semibold uppercase tracking-wider text-text-tertiary">References</p>
                    <ol class="mt-2 list-decimal space-y-1.5 pl-5 text-xs leading-5 text-text-tertiary">
                      {m.references.map((r) => <li>{r}</li>)}
                    </ol>
                  </div>
                )}

                {m.citation && <p class="mt-4 text-xs text-text-tertiary">{m.citation}</p>}
              </article>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- ── Muscle Health ─────────────────────────────────────────────── -->
    <section id="muscle-health" class="scroll-mt-8">
      <h2 class="text-2xl font-bold text-text-primary">Muscle Health &amp; Grip Strength</h2>
      <p class="mt-2 text-sm text-text-tertiary">Why grip strength is in a fitness app at all</p>
      <div class="mt-6"><VideoSlot topic="Muscle Health & Grip Strength" /></div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {MUSCLE_HEALTH_SECTION.map((c) => <CitationCard {...c} />)}
      </div>
    </section>
  </main>

  <Footer showScience={false} />
</Layout>
