---
/**
 * /start — where Start here went (11 November 2026, the canvas "Verve on
 * the web, rethought", board 05).
 *
 * Start here was a page of its own: what Verve is, who it is for, the free
 * sheet, the letters, the call. The landing page is that page now: the
 * first number is a working tool on it, with who it is for and what you
 * come back for beneath. This address stays, because old links, the
 * printed sheet and search results point at it: a short page that says
 * where each thing lives, and still carries the call. Nothing a visitor
 * could do here was removed.
 */
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
import CallCard from "../components/CallCard.astro";
import { GET_APP_PATH, SUBSTACK_URL, X_URL, YOUTUBE_URL, TIKTOK_URL, INSTAGRAM_URL } from "../data/site";

const LETTERS = "https://roplekarsudeep.substack.com";
const places = [
  { title: "Find your number", body: "Six minutes of walking, or twelve of running. Your fitness in METs and where it stands for your age, on the front page. No app, no email.", href: "/#find-your-number", cta: "Open the tool" },
  { title: "The free sheet", body: "The same sum on one A4 page, with the tier tables, to print and keep.", href: "/sheet", cta: "Open the sheet" },
  { title: "Who it is for", body: "Starting again, already tracking, or reading other people’s pages as a coach or a clinician.", href: "/#who-it-is-for", cta: "See the three" },
  { title: "How the app works", body: "The four tabs, the Guide, free and Pro, how Verve counts, and six short videos.", href: "/how-it-works", cta: "Read the manual" },
  { title: "The evidence", body: "Every threshold Verve uses, traced to its source. One search, across topics, thresholds and videos.", href: "/science", cta: "Search the science" },
  { title: "My health", body: "Drop a lab report, add your family, share a page with a coach or a doctor. The same account as the app.", href: "/my-health", cta: "Sign in" },
];
const doors = [
  { label: "For a coach", href: "/coach" },
  { label: "For a clinician", href: "/clinician" },
  { label: "The plans", href: "/plans" },
  { label: "Get the app", href: GET_APP_PATH },
];
---

<Layout
  title="Start here · Verve"
  description="Start here is the front page now: find your first fitness number, see who Verve is for, and where everything else lives."
  cardType="summary"
>
  <SiteHeader current="start" />

  <main class="mx-auto flex w-full max-w-[1080px] flex-col gap-14 px-4 pb-20 pt-14 sm:px-6 lg:pt-16">

    <section class="flex max-w-[760px] flex-col gap-4">
      <span class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-accent-light">Start here</span>
      <h1 class="text-[34px] font-semibold leading-[1.08] tracking-[-0.03em] text-text-primary sm:text-[44px]">Start on the front page.</h1>
      <p class="text-[17px] leading-[1.6] text-text-secondary">This page used to hold the introduction. The front page does that now, and your first fitness number is a working tool on it. Everything that was here has a home below.</p>
      <a href="/#find-your-number" class="inline-flex min-h-12 items-center self-start rounded-full bg-accent px-6 text-[15px] font-semibold text-canvas transition-colors hover:bg-accent-text">Find your number</a>
    </section>

    <section class="flex flex-col gap-5" aria-labelledby="where">
      <h2 id="where" class="text-[24px] font-semibold tracking-[-0.02em] text-text-primary sm:text-[28px]">Where each thing lives</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {places.map((p) => (
          <li class="flex flex-col gap-2 rounded-2xl border border-border bg-card p-6">
            <h3 class="text-[18px] font-semibold text-text-primary">{p.title}</h3>
            <p class="text-[15px] leading-[1.5] text-text-secondary">{p.body}</p>
            <a href={p.href} class="mt-auto inline-flex min-h-9 items-center self-start text-[14.5px] font-semibold text-accent-text underline-offset-4 hover:underline">{p.cta}</a>
          </li>
        ))}
      </ul>
      <p class="flex flex-wrap gap-x-6 gap-y-1 text-[14.5px] font-semibold">
        {doors.map((d) => <a href={d.href} class="inline-flex min-h-9 items-center text-accent-text underline-offset-4 hover:underline">{d.label}</a>)}
      </p>
    </section>

    <section class="grid gap-4 sm:grid-cols-2">
      <div class="flex flex-col gap-3 rounded-2xl border border-border bg-card p-6">
        <span class="font-mono text-[11px] tracking-[0.1em] text-text-3">THE LETTERS</span>
        <h2 class="text-[20px] font-semibold text-text-primary">One number a week</h2>
        <p class="text-[15px] leading-[1.5] text-text-secondary">The threshold it is measured against, the study behind it, and what you can check today. Written by a radiologist, read in five minutes. The sheet&rsquo;s page has the box to get it by email.</p>
        <p class="mt-auto flex flex-wrap gap-x-5 gap-y-1 text-[14.5px] font-semibold">
          <a href={LETTERS} class="inline-flex min-h-9 items-center text-accent-text underline-offset-4 hover:underline">Read the letters</a>
          <a href="/sheet" class="inline-flex min-h-9 items-center text-accent-text underline-offset-4 hover:underline">Get them by email</a>
        </p>
      </div>
      <div class="flex flex-col gap-3 rounded-2xl border border-border bg-card p-6">
        <span class="font-mono text-[11px] tracking-[0.1em] text-text-3">THE VIDEOS</span>
        <h2 class="text-[20px] font-semibold text-text-primary">One number, under a minute</h2>
        <p class="text-[15px] leading-[1.5] text-text-secondary">Each sits on the Science page it explains. The study is in the caption.</p>
        <p class="mt-auto flex flex-wrap gap-x-5 gap-y-1 text-[14.5px] font-semibold">
          <a href="/videos" class="inline-flex min-h-9 items-center text-accent-text underline-offset-4 hover:underline">All the videos</a>
          <a href={YOUTUBE_URL} class="inline-flex min-h-9 items-center text-accent-text underline-offset-4 hover:underline">YouTube</a>
          <a href={INSTAGRAM_URL} class="inline-flex min-h-9 items-center text-accent-text underline-offset-4 hover:underline">Instagram</a>
          <a href={TIKTOK_URL} class="inline-flex min-h-9 items-center text-accent-text underline-offset-4 hover:underline">TikTok</a>
        </p>
      </div>
    </section>

    <CallCard />

    <section class="flex flex-wrap items-center gap-5 border-t border-border pt-6">
      <div class="flex min-w-[280px] flex-1 flex-col gap-1">
        <p class="font-semibold text-text-primary">Dr Sudeep Roplekar</p>
        <p class="text-base text-text-secondary">Radiologist. I built Verve to see my own numbers against the thresholds the studies use. One letter a week. <a href={SUBSTACK_URL} class="text-accent-text underline-offset-4 hover:underline">The letters</a> · <a href={X_URL} class="text-accent-text underline-offset-4 hover:underline">X</a></p>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
