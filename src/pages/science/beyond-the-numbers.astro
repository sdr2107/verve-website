---
/**
 * /science/beyond-the-numbers — what the app does not measure, by theme.
 *
 * The four subjects are the numbers Verve shows, each threshold with its
 * source. This page is the rest of the section (21 Nov 2026): plaque, heart
 * scans, risk and family history, the athlete's heart, everyday habits, stroke.
 * It has no thresholds and no topic pages; each theme is its videos, and,
 * where a video was made from one of the founder's posts, the post to read.
 * The themes and which video sits under which are in data/videos.ts, the
 * same list the hub's card and /videos read, so the three cannot disagree.
 *
 * The videos are the silent website cuts: nothing plays until it is
 * pressed, and nothing comes from a third party.
 *
 * It carries the section's sidebar, its own row unfolded to the six
 * themes, so the four subjects are one step away, as this page is from them.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Footer from "../../components/Footer.astro";
import VideoSlot from "../../components/VideoSlot.astro";
import ScienceSidebar from "../../components/science/ScienceSidebar.astro";
import { THEMES, BEYOND, videosInGroup, videosInTheme, readable } from "../../data/videos";

const all = videosInGroup("wider-picture");
---

<Layout
  title={`${BEYOND.label} · Science · Verve`}
  description="Health questions the app does not measure, one study at a time: arteries and plaque, heart scans, risk and family history, the athlete's heart, everyday habits, stroke."
  router
>
  <SiteHeader
    current="science"
    crumb={[{ href: "/science", label: "Science" }, { label: BEYOND.label }]}
    back={{ href: "/science", label: "Science" }}
  />

  <div class="mx-auto flex max-w-7xl gap-12 px-6 sm:px-10">
    <ScienceSidebar beyond />

  <main class="min-w-0 flex-1 pt-7 pb-20 sm:pt-12 sm:pb-28" transition:name="science-page" transition:animate="fade">
    <div class="max-w-2xl">
      <span class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-light">Science</span>
      <h1 class="mt-3 text-[34px] font-bold leading-[1.06] tracking-[-0.025em] text-text-primary sm:text-5xl">
        {BEYOND.label}
      </h1>
      <p class="mt-4 text-[15px] leading-relaxed text-text-secondary sm:text-base">
        {BEYOND.line} Short videos with captions and no sound; where one was made from a post, the post is linked under it to read.
      </p>
      <p class="mt-3 font-mono text-[11px] text-text-tertiary">
        {THEMES.length} themes &middot; {all.length} to watch &middot; {readable(all)} to read
      </p>
    </div>

    <!-- the themes, as the way down the page -->
    <nav class="mt-6 flex flex-wrap gap-2" aria-label="Themes">
      {THEMES.map((th) => (
        <a href={`#${th.key}`} class="inline-flex min-h-9 items-center rounded-full border border-border-strong bg-card px-3.5 text-[13px] font-semibold text-text-secondary transition-colors hover:text-text-primary">{th.label}</a>
      ))}
    </nav>

    {THEMES.map((th) => {
      const vs = videosInTheme(th.key);
      return (
        <section class="mt-12 scroll-mt-8 border-t border-ink/[0.07] pt-9" id={th.key}>
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h2 class="text-[22px] font-bold tracking-[-0.02em] text-text-primary">{th.label}</h2>
            <p class="font-mono text-[11px] text-text-tertiary">{vs.length} to watch &middot; {readable(vs)} to read</p>
          </div>
          <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-text-secondary">{th.sub}.</p>
          <div class="mt-5">
            <VideoSlot slugs={vs.map((v) => v.slug)} />
          </div>
        </section>
      );
    })}

    <p class="mt-12 border-t border-ink/[0.07] pt-6 text-sm leading-relaxed text-text-secondary">
      General health information, not medical advice. The numbers the app does show, each with its source, are under
      <a href="/science#every-topic" class="font-semibold text-accent-text underline-offset-4 hover:underline">the four subjects</a>;
      every video on the site is on <a href="/videos" class="font-semibold text-accent-text underline-offset-4 hover:underline">one list</a>.
    </p>
  </main>
  </div>

  <Footer />
</Layout>
