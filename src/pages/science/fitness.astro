---
import SubjectLayout from "../../layouts/SubjectLayout.astro";
import ScienceSection from "../../components/science/ScienceSection.astro";
import SplitCard from "../../components/science/SplitCard.astro";
import CitationCard from "../../components/CitationCard.astro";
import MetsVsMetHours from "../../components/science/MetsVsMetHours.astro";
import VideoSlot from "../../components/VideoSlot.astro";
import {
  CRF_SECTION,
  TEST_CRF_SECTION,
} from "../../data/science";

/** The intensity scale: bar widths are each band's top against a 12-MET ceiling. */
const intensities = [
  { met: "1", width: "8%", label: "at rest" },
  { met: "3\u20134", width: "30%", label: "walking" },
  { met: "6\u20138", width: "58%", label: "jogging" },
  { met: "10+", width: "84%", label: "running" },
];

/** The five tiers as the app draws them for one reader; the caption says whose. */
const tiers = [
  { range: "under 8.0", label: "Low", bar: "rgba(244,63,94,0.45)" },
  { range: "8.0\u20139.9", label: "Below average", bar: "rgba(251,191,36,0.5)", lit: true },
  { range: "10.0\u201311.9", label: "Above average", bar: "rgba(129,140,248,0.45)" },
  { range: "12.0\u201313.9", label: "High", bar: "rgba(6,182,212,0.4)" },
  { range: "14.0+", label: "Elite", bar: "rgba(52,211,153,0.4)" },
];

/** What each way of getting a number is worth, at a glance. */
const accuracy = [
  ["Lab test, direct", "measured", "text-success", "Gas analysis. The only one that measures rather than estimates."],
  ["12-minute run", "r \u2248 0.90", "text-text-secondary", "Strong, if you truly go all out. Pacing conservatively under-reads you."],
  ["6-minute walk", "submaximal", "text-text-secondary", "Built for lower fitness. It under-reads a fit person by design."],
  ["Watch estimate", "7 to 16 % error", "text-warning", "Carried with every wearable reading Verve shows. Never the headline."],
];
---

<SubjectLayout subject="fitness">
  <div slot="rail" class="rounded-2xl border border-white/8 bg-white/4 p-4">
    <p class="text-xs leading-relaxed text-text-secondary">
      Where this sits in the AHA statement.
    </p>
    <a href="/crf-map" class="mt-2 block text-xs font-medium text-accent-light">Open the map &rarr;</a>
  </div>
  <!-- ── METs vs MET-h ─────────────────────────────────────────────── -->
  <ScienceSection id="mets-vs-met-h" title="METs vs MET-hours" sub="One is how hard, the other is how much">
    <SplitCard eyebrow="The difference in one line">
      <p>
        A MET is intensity: one MET is you at rest, four METs is a brisk walk.
        A MET-hour is volume: four METs held for half an hour is two MET-hours.
        Verve tracks both, and never adds them together.
      </p>
      <div slot="panel" class="flex flex-col gap-2.5">
        {intensities.map((i) => (
          <div class="flex items-center gap-2.5">
            <span class="w-[34px] shrink-0 font-mono text-[11px] text-success">{i.met}</span>
            <span class="h-[7px] flex-1 rounded-full bg-success/20">
              <span class="block h-[7px] rounded-full bg-success" style={`width: ${i.width}`}></span>
            </span>
            <span class="w-[52px] shrink-0 text-[10.5px] text-text-secondary">{i.label}</span>
          </div>
        ))}
      </div>
    </SplitCard>

    <div class="mt-6"><VideoSlot topic="METs vs MET-h" /></div>
    <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
      <MetsVsMetHours />
    </div>
  </ScienceSection>

  <!-- ── Cardiorespiratory Fitness ─────────────────────────────────── -->
  <ScienceSection id="crf" title="Cardiorespiratory fitness" sub="The five tiers, and why they are read against your own age and sex">
    <div class="mt-[18px] rounded-2xl border border-white/8 bg-white/4 p-5 sm:px-[22px]">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-text-tertiary">
        Men, 40 to 49
      </p>
      <!-- No middle band, on purpose: the line between below and above average
           is the study population's median, so nobody lands on it. -->
      <div class="mt-3 flex gap-1">
        {tiers.map((t, i) => (
          <div class="min-w-0 flex-1">
            <div
              class:list={["h-[9px]", i === 0 && "rounded-l-full", i === tiers.length - 1 && "rounded-r-full"]}
              style={`background: ${t.bar}`}
            ></div>
            <div class={`mt-[7px] font-mono text-[10px] ${t.lit ? "text-warning" : "text-text-secondary"}`}>{t.range}</div>
            <div class="text-[11px] leading-tight text-text-tertiary">{t.label}</div>
          </div>
        ))}
      </div>
      <p class="mt-3.5 text-[12.5px] leading-relaxed text-text-tertiary">
        Figures in METs, for one reader. Your own table depends on your age and
        sex, and on which dataset covers you.
      </p>
    </div>

    <div class="mt-6"><VideoSlot topic="Cardiorespiratory Fitness" /></div>
    <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
      <p class="text-sm leading-relaxed text-text-secondary">
        <strong class="text-text-primary">Ages 18&ndash;39:</strong> ACSM / Cooper
        Institute adult VO&#8322;Max norms (1997), converted to METs.
        <strong class="ml-1 text-text-primary">Ages 40+:</strong> Cleveland Clinic
        treadmill data (Mandsager 2018, 122,007 patients). Both use the same
        5-tier system (Low &rarr; Elite) &mdash; Verve automatically selects the
        correct source based on your profile age.
      </p>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {CRF_SECTION.map((c) => <CitationCard {...c} />)}
    </div>
  </ScienceSection>

  <!-- ── Test Your CRF ─────────────────────────────────────────────── -->
  <ScienceSection id="test-crf" title="Test your CRF" sub="Which test you are offered, and why it might not be the hard one">
    <SplitCard eyebrow="In the app">
      <p>
        A short health screen runs before your first test. A beta-blocker, or a
        resting pressure at or above 180 over 110, and the six-minute walk is
        the only test offered. Cleared and training regularly, and the
        twelve-minute run is recommended instead. You can always pick another.
      </p>
      <div slot="panel" class="flex flex-col gap-2.5">
        <div class="flex items-center gap-2.5">
          <span class="flex h-[22px] w-[22px] items-center justify-center rounded-[7px] bg-success/15">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4 4L19 7" /></svg>
          </span>
          <span class="text-[11.5px] text-text-primary">6-minute walk</span>
          <span class="ml-auto font-mono text-[10px] text-text-tertiary">submaximal</span>
        </div>
        <div class="flex items-center gap-2.5">
          <span class="flex h-[22px] w-[22px] items-center justify-center rounded-[7px] bg-warning/15">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#FBBF24" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 8v5M12 16.5v.5" /></svg>
          </span>
          <span class="text-[11.5px] text-text-primary">12-minute run</span>
          <span class="ml-auto font-mono text-[10px] text-text-tertiary">maximal</span>
        </div>
        <div class="h-px bg-white/[0.07]"></div>
        <p class="font-mono text-[10px] text-danger">blocked at 180/110 or above</p>
        <p class="font-mono text-[10px] text-text-tertiary">retest nudged at 8 weeks</p>
      </div>
    </SplitCard>

    <div class="mt-6"><VideoSlot topic="Test Your CRF" /></div>

    <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
      <p class="text-sm leading-relaxed text-text-secondary">
        Verve recommends a fitness test in two stages, and the order is the
        whole design. <strong class="text-text-primary">Stage 1 is a safety
        ceiling</strong> &mdash; three questions about medical supervision,
        chest pain or dizziness during everyday activity, and any cardiac
        event in the past six months. Any yes means talking to a doctor before
        an all-out effort, and no amount of training history can lift that.
        It is applied before anything else is looked at.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-text-secondary">
        <strong class="text-text-primary">Stage 2 reads your recorded
        training</strong>, and all five checks must pass before a maximal test
        is recommended: trained within the window, 4 of 8 weeks carrying 3 or
        more training days, at least 2 hard sessions a week, one hard session
        in the last 14 days, and fewer than 2 consecutive quiet weeks. Where
        all five pass, Verve prefers to repeat <em>your last test</em> &mdash;
        comparing a 6-minute walk against a 12-minute run mixes method
        variance into what you would read as a change in your fitness.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-text-secondary">
        <strong class="text-text-primary">Why tests don&rsquo;t mix.</strong>
        A submaximal walk estimates your capacity from how your heart
        responds to easy work; a maximal run measures what you can actually
        do. The two carry different errors in different directions &mdash; a
        walk under-reads a fit person, a first maximal run under-reads a
        cautious pacer &mdash; so a change between test types usually
        reflects the tests, not your fitness. Verve flags a mixed history in
        the app and reads trends within one test type; when you retest, it
        offers your last test again for the same reason.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-text-secondary">
        <strong class="text-text-primary">Retesting is every 8 weeks.</strong>
        VO&#8322;Max adapts with a half-time of about 10&ndash;11 days and a
        dependable change takes on the order of 21 sessions, so a test before
        about 4 weeks usually returns your old number and teaches you only
        that you tested early. Eight weeks is also the window Verve reads your
        training over, so the two are the same span rather than two nearby
        ones.
      </p>
    </div>

    <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6" id="two-windows">
      <h3 class="text-lg font-semibold text-text-primary">Why the app shows two windows</h3>
      <p class="mt-3 text-sm leading-relaxed text-text-secondary">
        The readiness card in the app carries one row measured over
        <strong class="text-text-primary">three months</strong> and five
        measured over <strong class="text-text-primary">eight weeks</strong>.
        That is not an inconsistency. They answer different questions and
        come from different places.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-text-secondary">
        The three-month row is the exercise guideline&rsquo;s. ACSM defines
        &ldquo;currently active&rdquo; as habitual activity over the past
        three months, and that definition is used for one decision only:
        whether you should speak to a doctor before an all-out effort. It is
        a screening threshold, and screening thresholds are conservative on
        purpose.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-text-secondary">
        The eight-week rows are Verve&rsquo;s own, and they answer a
        physiological question instead: which test suits the training you
        have actually done. Eight weeks is chosen because that is roughly how
        long fitness takes to move by an amount a field test can detect
        (Hickson 1981). Neither number can stand in for the other. Borrowing
        the screening threshold to answer the physiology question is how an
        app ends up recommending a maximal run to someone who walked twice
        last month.
      </p>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {TEST_CRF_SECTION.map((c) => <CitationCard {...c} />)}
    </div>
  </ScienceSection>

  <!-- ── How accurate each test is ─────────────────────── -->
  <ScienceSection id="test-accuracy" title="How accurate each test is" sub="What r &asymp; 0.90 means, what the stars mean, and where each test stops working">
    <div class="mt-[18px] rounded-2xl border border-white/8 bg-white/4 p-5 sm:px-[22px]">
      <dl class="flex flex-col gap-3">
        {accuracy.map(([name, note, tone, detail]) => (
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-3">
            <dt class="w-[140px] shrink-0 text-[13px] font-semibold text-text-primary">{name}</dt>
            <dd class="contents">
              <span class={`w-[104px] shrink-0 font-mono text-[11px] ${tone}`}>{note}</span>
              <span class="flex-1 text-[12.5px] leading-relaxed text-text-tertiary">{detail}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>


    <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
      <h3 class="text-lg font-semibold text-text-primary">The r value</h3>
      <p class="mt-3 text-sm leading-relaxed text-text-secondary">
        Every test in Verve carries a small badge &mdash;
        <code class="rounded bg-white/8 px-1.5 py-0.5 text-xs">r &asymp; 0.90</code>
        on the Cooper run, for instance. <strong class="text-text-primary">r
        is a correlation coefficient</strong>: how closely the test&rsquo;s
        estimate tracks a true VO&#8322;Max measured in a laboratory with a
        gas-analysis mask. It runs from 0 (no relationship at all) to 1 (a
        perfect one).
      </p>
      <p class="mt-4 text-sm leading-relaxed text-text-secondary">
        An r of 0.90 means the test ranks people almost exactly as the lab
        would. Someone it puts above you would almost certainly test above
        you on a treadmill. What r does <em>not</em> tell you is how far off
        any single number is &mdash; a test can rank a whole group perfectly
        and still read a few points high for everyone in it. That is why the
        honest use of a field test is
        <strong class="text-text-primary">comparing you against yourself over
        time</strong>, on the same test, rather than treating one result as a
        laboratory measurement.
      </p>

      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-white/10 text-xs uppercase tracking-wide text-text-tertiary">
              <th class="pb-2 pr-4 font-medium">Test</th>
              <th class="pb-2 pr-4 font-medium">Effort</th>
              <th class="pb-2 font-medium">Accuracy</th>
            </tr>
          </thead>
          <tbody class="text-text-secondary">
            <tr class="border-b border-white/5"><td class="py-2 pr-4">Bruce Protocol</td><td class="py-2 pr-4">Maximal, supervised</td><td class="py-2">&plusmn;3.5 mL/kg/min</td></tr>
            <tr class="border-b border-white/5"><td class="py-2 pr-4">Cooper 12-Minute Run</td><td class="py-2 pr-4">Maximal</td><td class="py-2">r &asymp; 0.90</td></tr>
            <tr class="border-b border-white/5"><td class="py-2 pr-4">1.5-Mile Run</td><td class="py-2 pr-4">Maximal</td><td class="py-2">r &asymp; 0.85</td></tr>
            <tr class="border-b border-white/5"><td class="py-2 pr-4">1-Mile Walk Test</td><td class="py-2 pr-4">Submaximal</td><td class="py-2">r &asymp; 0.88</td></tr>
            <tr><td class="py-2 pr-4">6-Minute Walk Test</td><td class="py-2 pr-4">Submaximal</td><td class="py-2">~13% MAPE</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs leading-relaxed text-text-tertiary">
        MAPE is mean absolute percentage error &mdash; the average size of the
        miss, regardless of direction. It answers the question r cannot.
      </p>
    </div>

    <div class="mt-4 rounded-2xl border border-white/8 bg-white/4 p-6">
      <h3 class="text-lg font-semibold text-text-primary">The stars</h3>
      <p class="mt-3 text-sm leading-relaxed text-text-secondary">
        The star rating is Verve&rsquo;s own shorthand for how much weight a
        result deserves, and it combines two things the r value keeps
        separate: how well the method is validated, and how much of the
        answer depends on you performing well on the day. Four stars are the
        maximal tests, where the number is limited by your physiology. Three
        stars are the submaximal ones, which estimate your capacity from how
        your heart responds to easy work &mdash; safer, repeatable, and one
        inference further from the thing being measured.
      </p>
    </div>

    <div class="mt-4 rounded-2xl border border-white/8 bg-white/4 p-6">
      <h3 class="text-lg font-semibold text-text-primary">Where these tests stop working</h3>
      <p class="mt-3 text-sm leading-relaxed text-text-secondary">
        Field-test estimates are most accurate for active-to-trained young and
        middle-aged adults, because that is who the validation studies
        recruited. They are less reliable at both edges: highly trained
        athletes, whose results compress near the top of the scale, and very
        sedentary people, who are under-represented in the original data and
        whose pacing on an unfamiliar all-out effort is itself unpractised.
        If you sit at either edge, the trend in your own numbers is worth more
        than any single one of them.
      </p>
    </div>
  </ScienceSection>

  <!-- ── The run protocols in full ─────────────────────── -->
  <ScienceSection id="run-protocols" title="The run protocols" sub="What the app&rsquo;s checklist is short for">

    <div class="mt-6 rounded-2xl border border-white/8 bg-white/4 p-6">
      <p class="text-sm leading-relaxed text-text-secondary">
        The app shows these as a short checklist on purpose. You read it
        standing on a start line, and a paragraph of reasoning is the wrong
        thing to hand someone in that moment. The reasoning is here.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-text-secondary">
        <strong class="text-text-primary">No hard exercise for 24 hours.</strong>
        A maximal test measures your ceiling, and residual fatigue lowers it.
        Testing the day after a hard session reads as a fitness decline that
        never happened &mdash; the most common way a person records a drop
        they then try to explain.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-text-secondary">
        <strong class="text-text-primary">Warm up for 10&ndash;15 minutes.</strong>
        Beyond injury risk, an unwarmed start spends the first minutes of a
        12-minute test on physiology a warm-up would already have handled, and
        those minutes are a measurable part of the distance.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-text-secondary">
        <strong class="text-text-primary">Start controlled, finish hard.</strong>
        The Cooper test rewards even pacing. Going out too fast produces an
        early slowdown that costs more distance than the fast start gained,
        which is why first-time testers frequently under-read their own
        fitness. On the 1.5-mile run the same logic applies to splits.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-text-secondary">
        <strong class="text-text-primary">Walk if you need to, but keep
        moving.</strong> The test is a distance in a fixed time (Cooper) or a
        time over a fixed distance (1.5-mile). Stopping entirely ends the
        test; walking is a slower pace, not a failure, and a walked finish is
        still a valid result.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-text-secondary">
        <strong class="text-text-primary">Why a large meal matters.</strong>
        Digestion diverts blood flow a maximal effort is competing for. Two to
        three hours is enough for a normal meal; the guidance is about comfort
        and performance rather than safety.
      </p>
    </div>

    <div class="mt-4 rounded-2xl border border-white/8 bg-white/4 p-6">
      <h3 class="text-lg font-semibold text-text-primary">The stop signals, and why they are absolute</h3>
      <p class="mt-3 text-sm leading-relaxed text-text-secondary">
        Chest pain, dizziness, lightheadedness, nausea, leg cramps, or
        breathlessness beyond hard breathing mean stop &mdash; not slow down.
        Hard running is uncomfortable, and the difficulty is telling ordinary
        maximal-effort discomfort from a symptom. The rule Verve uses is that
        you should not have to make that judgement: if you meet any of these,
        the test is over and the result does not matter.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-text-secondary">
        The same symptoms in the hours after a test warrant medical attention.
        Cardiac events associated with unaccustomed maximal exertion are rare,
        and are concentrated in people doing an all-out effort they have not
        trained for &mdash; which is precisely what the safety check and the
        eight-week training window exist to catch before you reach the start
        line.
      </p>
    </div>
  </ScienceSection>
</SubjectLayout>
