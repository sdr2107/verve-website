  type Door = "apple" | "google" | "email";
  const LAST_DOOR = "verve:last-sign-in", PENDING_DOOR = "verve:pending-sign-in", COACH_DOOR = "verve:coach-door";
  /** The vetted role on this account, if one has been entered: it names the group (Clients, Patients) and nothing more. */
