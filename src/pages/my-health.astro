  // ── the ruler ─────────────────────────────────────────────────────────
  // Six marks on the way to a drawn page, measured from the script's first
  // line: the session known, the people known, the person's document in,
  // the page painted, the first tap. ?timing=1 (or localStorage mh-timing)
  // prints them in the console and under the page. Every change to the
  // load path is judged by these, never by feel. docs/my-health-architecture.md.
  const TIMING = (() => { try { return new URLSearchParams(location.search).has("timing") || localStorage.getItem("mh-timing") === "1"; } catch { return false; } })();
  const marked = new Set<string>();
  const mark = (name: string) => { if (marked.has(name)) return; marked.add(name); performance.mark(`mh:${name}`); if (name === "painted" || name === "fresh" || name === "interaction") report(); };
  function report() {
    if (!TIMING) return;
    const t0 = performance.getEntriesByName("mh:script")[0]?.startTime ?? 0;
    const rows = ["session", "cached", "headstart", "people", "document", "painted", "fresh", "interaction"].map((n) => {
      const e = performance.getEntriesByName(`mh:${n}`)[0];
      return { mark: n, ms: e ? Math.round(e.startTime - t0) : null };
    }).filter((r) => r.ms != null);
    console.table(rows);
    let el = document.getElementById("mh-timing");
    if (!el) { el = document.createElement("div"); el.id = "mh-timing"; el.className = "mx-auto mt-6 max-w-6xl px-4 font-mono text-[11px] text-text-tertiary"; document.querySelector("main")?.appendChild(el); }
    el.textContent = "ruler · " + rows.map((r) => `${r.mark} ${r.ms} ms`).join(" · ") + ` · ${Math.round(performance.now() - t0)} ms since script`;
  }
  mark("script");

  // ── the document ──────────────────────────────────────────────────────
  // Everything the page reads for a person comes from my_health_document,
  // one SQL function, one round trip (docs/my-health-architecture.md, step
  // 1). Every loader below reads from it; however many ask at once, there
  // is one request in flight. A write invalidates it and the next loader
  // fetches it again. The function is SECURITY INVOKER: row-level security
  // decides the content, so a viewer without a scope sees an empty list.
  let doc: MyHealthDocument | null = null;
  let docPromise: Promise<MyHealthDocument> | null = null;
  let docFor = "";   // the person id the document in hand (or in flight) is for; "" = the account's own
  function invalidateDocument() { doc = null; docPromise = null; }
  async function fetchDocument(personId: string | null): Promise<MyHealthDocument> {
    // the head start's request, when it was for this person and is unused
    const head = (window as any).__mh as { person: string; document: Promise<MyHealthDocument>; taken?: boolean } | undefined;
    let d: MyHealthDocument;
    // a head start for "" is the account's own person, by whichever name it is asked for
    const selfId = people.find((p) => p.self)?.id ?? "";
    if (head && !head.taken && (head.person === (personId ?? "") || (head.person === "" && personId === selfId))) {
      head.taken = true;
      try { d = await head.document; mark("headstart"); }
      catch {
        const { data, error } = await supabase.rpc("my_health_document", personId ? { person: personId } : {});
        if (error) throw error;
        d = data as MyHealthDocument;
      }
    } else {
      const { data, error } = await supabase.rpc("my_health_document", personId ? { person: personId } : {});
      if (error) throw error;
      d = data as MyHealthDocument;
    }
    // kept for the next visit: under the person asked for, and under the
    // person the function answered with (the account's own, when none was)
    if (userId) { void writeDocument(userId, personId ?? "", d); if (d.person?.id && d.person.id !== personId) void writeDocument(userId, d.person.id, d); }
    return d;
  }
  /**
   * Paint from the last visit first (step 2). The document kept for this
   * person is put in hand, so every loader draws at once; the fresh one is
   * fetched alongside and, when it differs, everything is drawn again.
   * Returns true when something was in hand.
   */
  async function openDocument(personId: string): Promise<boolean> {
    docFor = personId;
    const kept = userId ? await readDocument(userId, personId) : null;
    if (kept) { doc = kept; docPromise = Promise.resolve(kept); mark("cached"); return true; }
    doc = null;
    docPromise = fetchDocument(personId || null).then((d) => { if (docFor === personId) doc = d; return d; });
    return false;
  }
  /** After a paint from the store: the fresh document, and a redraw only when it says something new. */
  async function revalidate(personId: string): Promise<void> {
    let fresh: MyHealthDocument;
    try { fresh = await fetchDocument(personId || null); } catch { return; }
    if ((person?.id ?? "") !== (fresh.person?.id ?? "")) return;   // moved on to someone else meanwhile
    mark("fresh");
    if (doc && sameDocument(fresh, doc)) return;
    doc = fresh; docFor = person?.id ?? "";
    docPromise = Promise.resolve(fresh);
    await loadPeople(); renderPeople();
    await Promise.all([refresh(false), loadPersonNote(), loadSharing(), loadInvites(), loadAsked(), loadRequests(), loadGlance(), loadAiSummary()]);
  }
  /** The person's document: in hand, in flight, or fetched now. */
  function ensureDocument(): Promise<MyHealthDocument> {
    const want = person?.id ?? "";
    if (doc && docFor === want) return Promise.resolve(doc);
    if (!docPromise || docFor !== want) {
      docFor = want;
      docPromise = fetchDocument(want || null).then((d) => { if (docFor === want) doc = d; return d; });
    }
    return docPromise;
  }

  // ── tiny DOM helpers ───────────────────────────────────────────────────
  const $ = (id: string) => document.getElementById(id)!;
  const show = (id: string, on: boolean) => $(id).classList.toggle("hidden", !on);
  /** A status line: grey while something is happening, tinted when it went wrong. */
  const msg = (id: string, text: string, bad = false) => {
    const el = $(id);
    el.textContent = text;
    el.classList.toggle("hidden", !text);
    el.classList.toggle("text-danger", bad);
    el.classList.toggle("text-text-secondary", !bad);
  };


  let userId = "";
  let userEmail = "";
  /** The name on the account, and its first word for the greeting; "" when there is none. */
  let fullName = "";
  let firstName = "";
  let parsed: { path: string; lpa_unit: string | null; dupKeys: Set<string> } | null = null;

  // ── the plan this account holds ─────────────────────────────────────────
  // One login, three plans. The plan sits on whoever pays and decides how
  // many people they can see and how deep; consent is free on every plan.
  // Read once at sign-in from my_plan(), which folds in the grace period
  // and the VIP list. Nothing is held to a plan until PLANS_ENFORCED is on;
  // the owner can preview the gate with sessionStorage mh-plans-enforce=1,
  // which can only make the page stricter, never looser.
  let plan: PlanKey = "free";
  let ent = entitlements("free");
  const enforced = (() => { try { return PLANS_ENFORCED || sessionStorage.getItem("mh-plans-enforce") === "1"; } catch { return PLANS_ENFORCED; } })();
  async function loadPlan() {
    // Everyone is on the free plan while the plans are dormant (PLANS_OPEN).
    // The my_plan function was asked for on every load and does not exist;
    // when plans open, the plan joins the document.
    plan = "free";
    ent = entitlements(plan);
    show("planline", PLANS_OPEN);
    show("whopays", PLANS_OPEN);
    if (PLANS_OPEN) $("planline").innerHTML = plan === "free"
      ? `Free plan · <a href="/plans" class="font-semibold text-accent-light hover:text-text-primary">see the plans</a>`
      : `${esc(planOf(plan).name)} plan · <a href="/plans" class="font-semibold text-accent-light hover:text-text-primary">plans</a>`;
  }
  const lockCard = (title: string, body: string, cta = "See the plans") => `
    <div class="text-[17px] font-extrabold text-text-primary">${title}</div>
    <p class="text-[13.5px] leading-relaxed text-text-secondary">${body}</p>
    <div class="flex flex-wrap gap-2"><a href="/plans" class="inline-flex min-h-10 items-center rounded-xl bg-accent px-4 text-sm font-bold text-canvas">${cta}</a><button type="button" data-goto="overview" class="min-h-10 px-3 text-sm font-semibold text-text-secondary hover:text-text-primary">Not now</button></div>`;
  /** People besides you that count against the plan: looked after, or sharing with you. */
  const peopleCount = () => people.filter((p) => p.id && !p.self).length;
  /** Whether one more person may be added, and if not, why. */
  function roomForOneMore(): { ok: boolean; why: string } {
    if (!enforced) return { ok: true, why: "" };
    const max = ent.peopleMax;
    const n = peopleCount() + 1;   // you included
    if (max != null && n >= max) {
      const name = planOf(plan).name;
      return { ok: false, why: plan === "free"
        ? `The free plan lets you see one other person. Pro is the same; Max holds five in all, and Enterprise has no family limit.`
        : `${name} holds ${max} people, and you have ${n}. To add another, remove someone, or move to ${plan === "max" ? "Enterprise, which has no family limit" : "Max"}.` };
    }
    return { ok: true, why: "" };
  }

  // ── people: whose page this is ─────────────────────────────────────────
  // Every row belongs to a person. A person is one of three things: your own
  // self (account_id = you), someone you look after (no account of their
  // own; owner_id = you), or someone else's self seen through a grant they
  // accepted. Before the people table exists the page runs as before, with
  // a stand-in self whose id is empty: queries then fall back to user_id.
  type Person = { id: string; owner_id: string; account_id: string | null; name: string; born_year: number | null; mine: boolean; self: boolean; scopes: string[] };
  let people: Person[] = [];
  let person: Person | null = null;
  const PERSON_KEY = "mh-person";
  /** Where a person's files live: an account's own at <account>/, someone looked after at <account>/people/<id>/. */
  const folderOf = (p: Person) => p.account_id ? p.account_id : `${p.owner_id}/people/${p.id}`;
  const folder = () => folderOf(person!);
  const canWrite = () => !!person?.mine;
  const isSelf = () => !!person?.self;
  /** A query on web_labs / imaging_reports, scoped to one person (or, before the table exists, to the account). */
  const scopeRows = (q: any, who: Person | null = person) => who?.id ? q.eq("person_id", who.id) : q.eq("user_id", userId);
  const personCol = (who: Person | null = person) => who?.id ? { person_id: who.id } : {};
  const standIn = (): Person => ({ id: "", owner_id: userId, account_id: userId, name: fullName, born_year: null, mine: true, self: true, scopes: ALL_SCOPES });

  async function loadPeople() {
    const d = await ensureDocument();
    const rows = d.people, grants = d.grants_to_me;
    let list = [...rows] as any[];
    if (!list.some((p) => p.account_id === userId)) {
      // the account's own person, when the database has not made one yet
      const { data: made } = await supabase.from("people")
        .insert({ owner_id: userId, account_id: userId, name: fullName })
        .select("id, owner_id, account_id, name, born_year").maybeSingle();
      if (made) list = [made, ...list];
    }
    const mine = list.find((p) => p.account_id === userId);
    if (mine && !mine.name && fullName) { mine.name = fullName; supabase.from("people").update({ name: fullName }).eq("id", mine.id).then(() => {}); }
    const scopesBy = new Map<string, string[]>((grants ?? []).map((g: any) => [g.person_id, g.scopes ?? []]));
    grantIdBy = new Map<string, string>((grants ?? []).map((g: any) => [g.person_id, g.id]));
    people = list.map((p) => ({
      ...p, name: p.name ?? "", born_year: p.born_year ?? null,
      mine: p.owner_id === userId, self: p.account_id === userId,
      scopes: p.owner_id === userId ? ALL_SCOPES : (scopesBy.get(p.id) ?? []),
    }));
    if (!people.some((p) => p.self)) people = [standIn(), ...people];
    // you first, then the people you look after, then those who share with you
    people.sort((a, b) => Number(b.self) - Number(a.self) || Number(b.mine) - Number(a.mine) || a.name.localeCompare(b.name));
    let wanted = "";
    try { wanted = sessionStorage.getItem(PERSON_KEY) ?? ""; } catch { /* fine */ }
    person = people.find((p) => p.id && p.id === wanted) ?? people.find((p) => p.self) ?? people[0];
    personSignal.value = person;
    // the document in hand is this person's, or it is fetched again for them
    if (doc && (doc.person?.id ?? "") === (person?.id ?? "")) docFor = person?.id ?? ""; else invalidateDocument();
  }

  /** What the page lets you do depends on whose page it is. */
  function applyPersonMode() {
    const w = canWrite(), self = isSelf();
    show("addreport", w); show("drop", w); show("emptyadd", w);
    show("personnotewrap", w && !self && !!person?.id);
    show("viewernotewrap", !!person?.id && !person.mine && !person.self && grantIdBy.has(person.id));
    show("accesswrap", w && !!person?.id); if (!(w && person?.id)) closeAccess();
    show("namechange", self && !!firstName);
    if (!self) hideNameForm();
    renderPeople();
  }

  function renderPeople() {
    const has = people.some((p) => !!p.id);   // the people table exists
    show("peoplewrap", has); show("personwrap", has && activeTab !== "group");
    if (!has) return;
    const others = people.filter((x) => x.id && !x.self);
    // one control: the name of whose page this is, and under it the menu of
    // everyone, the group, and the ways to add someone or give access
    const onGroup = activeTab === "group";
    const w = canWrite();
    const initialOf = (p: Person) => esc((p.self ? (firstName || "You") : (p.name || "?")).trim().charAt(0).toUpperCase());
    const nameOf = (p: Person) => p.self ? esc(firstName || "You") : esc(p.name || "Unnamed");
    const hintOf = (p: Person) => p.self ? "your own page" : `${p.mine ? "in your care" : `shares ${scopeList(p.scopes).toLowerCase() || "nothing yet"} with you`}${p.born_year ? ` · ${p.born_year}` : ""}`;
    const cur = person!;
    const item = (inner: string, attrs: string, on = false) => `<button type="button" role="menuitem" ${attrs} aria-current="${on ? "true" : "false"}" class="flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 text-left text-[13.5px] transition-colors ${on ? "bg-accent/15 text-text-primary" : "text-text-primary hover:bg-white/[0.06]"}">${inner}</button>`;
    const peopleIcon = `<span class="flex h-[26px] w-[26px] shrink-0 items-center justify-center rounded-full bg-white/8 text-text-secondary"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17" cy="9" r="2.5"/><path d="M15.5 14.5a5 5 0 0 1 6 5"/></svg></span>`;
    const plain = (text: string, attrs: string) => item(`<span class="w-[26px] shrink-0"></span><span class="min-w-0 flex-1 truncate font-semibold text-text-secondary">${text}</span>`, attrs);
    $("people").innerHTML = `
      <div class="relative" data-personmenu>
        <button type="button" id="personmenubtn" aria-expanded="false" aria-haspopup="menu" aria-controls="personmenu"
          class="flex min-h-10 max-w-full items-center gap-2.5 rounded-full border border-white/14 bg-white/[0.04] py-1.5 pl-2 pr-3.5 text-[13px] font-semibold text-text-primary transition-colors hover:border-white/30 lg:w-full lg:rounded-[12px]">
          ${onGroup ? peopleIcon : `<span class="flex h-[26px] w-[26px] shrink-0 items-center justify-center rounded-full bg-accent/25 text-[11px] font-bold text-accent-light">${initialOf(cur)}</span>`}
          <span class="min-w-0 flex-1 truncate text-left">${onGroup ? "Everyone" : nameOf(cur)}</span>
          <svg class="shrink-0 text-text-tertiary" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div id="personmenu" role="menu" class="absolute left-0 top-full z-30 mt-2 hidden w-72 max-w-[calc(100vw-3rem)] flex-col gap-0.5 rounded-2xl border border-white/12 bg-[#12122a] p-1.5 shadow-2xl shadow-black/50">
          ${people.map((p) => item(`
            <span class="flex h-[26px] w-[26px] shrink-0 items-center justify-center rounded-full text-[11px] font-bold ${p.self ? "bg-accent/25 text-accent-light" : "bg-white/8 text-text-secondary"}">${initialOf(p)}</span>
            <span class="min-w-0 flex-1"><span class="block truncate font-semibold">${nameOf(p)}</span><span class="block truncate text-[11.5px] text-text-tertiary">${esc(hintOf(p))}</span></span>
            ${p.id === cur.id && !onGroup ? `<svg class="shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>` : ""}`,
            `data-person="${p.id}"`, p.id === cur.id && !onGroup)).join("")}
          <span class="mx-2 my-1 h-px bg-white/[0.08]" aria-hidden="true"></span>
          ${others.length ? item(`${peopleIcon}<span class="min-w-0 flex-1 truncate font-semibold">Everyone, ranked by movement</span><span class="font-mono text-[10.5px] text-text-tertiary">${others.length}</span>`, `id="everyone"`, onGroup) : ""}
          ${plain("Add a person", `id="personadd"`)}
          ${plain("Ask someone to share with you", `id="personask"`)}
          ${w && cur.id ? plain("Who can see this page", `id="personaccess"`) : ""}
        </div>
      </div>`;
    const menu = $("personmenu"), btn = $("personmenubtn");
    const setMenu = (open: boolean) => { menu.classList.toggle("hidden", !open); menu.classList.toggle("flex", open); btn.setAttribute("aria-expanded", String(open)); };
    btn.addEventListener("click", () => setMenu(menu.classList.contains("hidden")));
    menu.querySelectorAll<HTMLElement>("[data-person]").forEach((b) => b.addEventListener("click", () => { setMenu(false); switchPerson(b.dataset.person!); }));
    $("personadd").addEventListener("click", () => { setMenu(false); if (activeTab === "group") setTab("overview"); openPersonForm(null); });
    $("personask").addEventListener("click", () => { setMenu(false); if (activeTab === "group") setTab("overview"); openPersonForm(null); setPersonMode("ask"); });
    document.getElementById("personaccess")?.addEventListener("click", () => { setMenu(false); openAccess(); });
    document.getElementById("everyone")?.addEventListener("click", () => { setMenu(false); setTab("group"); });

    // the line under the chips: whose page, and what you may do here
    const p = person!;
    $("tabhead").textContent = p.self ? "Your page" : `${p.name || "Their"}’s page`;
    show("personhead", !p.self); $("personhead").classList.toggle("flex", !p.self);
    if (p.self) { $("personkicker").textContent = ""; $("personactions").innerHTML = ""; return; }
    $("personkicker").textContent = p.mine
      ? `YOU LOOK AFTER${p.born_year ? ` · BORN ${p.born_year}` : ""}`
      : `SHARES WITH YOU · ${p.scopes.map((x) => x.toUpperCase()).join(" · ") || "NOTHING YET"} · YOU CAN LOOK, NOT CHANGE`;
    $("personactions").innerHTML = p.mine
      ? `<button type="button" data-pedit class="text-accent-light hover:text-text-primary">Edit details</button>
         <button type="button" data-premove class="text-text-tertiary hover:text-danger">Remove person</button>`
      : "";
    $("personactions").querySelector("[data-pedit]")?.addEventListener("click", () => openPersonForm(p));
    $("personactions").querySelector("[data-premove]")?.addEventListener("click", () => removePerson(p));
  }

  async function switchPerson(id: string) {
    const p = people.find((x) => x.id === id);
    if (!p) return;
    if (p.id === person?.id) { if (activeTab === "group") setTab("overview"); closePersonForm(); closeAccess(); return; }
    person = p;
    if (activeTab === "group") setTab("overview");
    syncSignals = []; syncActs = []; syncProfile = null; syncWeights = []; allWeeks = []; allCrf = []; allBody = [];   // the last person's, until loadActivity brings this one's
    try { sessionStorage.setItem(PERSON_KEY, id); } catch { /* fine */ }
    msg("upmsg", ""); msg("sharemsg", "");
    show("review", false); show("echoreview", false); show("namecheck", false);
    $("upqueue").innerHTML = ""; show("upqueue", false);
    applyPersonMode();
    if (!p.mine && p.id) supabase.rpc("note_grant_view", { person: p.id }).then(() => {}, () => {});   // they can see when you last looked
    const fromStore = await openDocument(id);
    await Promise.all([refresh(false), loadPersonNote(), loadSharing(), loadGlance(), loadAiSummary()]);
    if (fromStore) void revalidate(id);
  }

  // ── add, edit, remove someone you look after ──────────────────────────
  let editingPerson: Person | null = null;
  /**
   * Two ways to add a person. Someone you look after — a child, or anyone
   * without a login — is yours to add, since there is nobody else to ask.
   * Someone with their own email is asked: they get an email, sign in, and
   * choose what you may see, or decline. Nothing is shared until they do.
   */
  let personMode: "care" | "ask" = "care";
  function setPersonMode(mode: "care" | "ask") {
    personMode = mode;
    $("personform").querySelectorAll<HTMLButtonElement>("[data-pmode]").forEach((b) => {
      const on = b.dataset.pmode === mode;
      b.className = `min-h-9 rounded-full border px-3.5 py-1.5 text-[13px] font-semibold transition-colors ${
        on ? "border-accent/70 bg-accent/15 text-text-primary" : "border-white/14 text-text-secondary hover:text-text-primary"}`;
    });
    const care = mode === "care";
    show("personnamewrap", care); $("personnamewrap").classList.toggle("flex", care);
    show("personbornwrap", care); $("personbornwrap").classList.toggle("flex", care);
    show("personemailwrap", !care); $("personemailwrap").classList.toggle("flex", !care);
    ($("personname") as HTMLInputElement).required = care;
    ($("personemail") as HTMLInputElement).required = !care;
