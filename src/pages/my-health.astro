---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<!--
  My health — the website's signed-in corner, in three tabs. Signed out,
  it says what the page is for before it asks for a password.

  · Overview — a greeting, the handful of findings worth a look, the latest
    report, and a slim drop bar. The answer-at-a-glance page.
  · Labs — every value from every report, section rail on the left, one
    section at a time on the right. A row expands into the full chart:
    band-shaded by each reading's OWN printed range, a diamond where a
    different lab's range enters the series, and readings in a different
    unit never share the line.
  · Reports — the drop zone and the archive: one card per original PDF
    with what came out of it. Review-and-send lives here too.

  The standing rules: app-bound markers go to lab_readings only on the
  user's explicit send, deduped; EVERYTHING parsed lands in web_labs with
  the lab's own printed range (a unique index backs the dedup); analyte
  names are canonicalised by lib/canon.js so "SGPT (ALT)" and "ALT" share
  one trend line; nothing is ever discarded.
-->

<Layout
  title="My health — Verve"
  description="Sign in with your Verve account, drop old lab reports, and their values file themselves into your app and your own lab dashboard."
  cardType="summary"
>
  <SiteHeader current="my-health">
    <!-- Signed in, Sign out takes the app button's place; the greeting is
         the page's heading, not a header ornament. Hidden until a session
         is found. -->
    <button
      slot="extra"
      id="signout"
      class="hidden rounded-full border border-white/14 px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:border-white/25"
    >Sign out</button>
  </SiteHeader>

  <main class="vrv-glow relative mx-auto max-w-6xl px-6 pb-24 sm:px-10">

    <!-- ── signed out: what My health is for, then the way in ────────────
         The page says why you would sign in before it asks you to: three
         lines on the left, one card on the right with one primary action.
         Every id the script wires is kept. ───────────────────────────── -->
    <section id="auth" class="mt-4 hidden max-w-[1120px] lg:mt-8">
      <!-- The grid lives on an inner div, not on #auth: the script hides
           #auth by adding `hidden`, and a responsive display class on the
           same element (`lg:grid`) would win over it on a desktop — which
           is how the sign-in card stayed on screen after signing in. -->
      <div class="gap-10 lg:grid lg:grid-cols-[minmax(0,1.1fr)_440px] lg:items-center lg:gap-16">
      <div class="flex flex-col gap-4 lg:gap-[22px]">
        <span class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-accent-light">My health</span>
        <h1 class="text-[30px] font-bold leading-[1.1] tracking-[-0.025em] text-text-primary sm:text-[46px] sm:leading-[1.06] sm:tracking-[-0.03em]">
          Your lab reports, read and filed for you.
        </h1>
        <p class="max-w-[520px] text-[14.5px] leading-[1.6] text-text-secondary sm:text-base sm:leading-[1.65]">
          Drop a PDF from any lab. Verve reads every value, sends the markers
          the app tracks to your phone on one tap, and keeps the rest charted
          here.
        </p>
        <ul class="mt-1 hidden flex-col gap-3.5 lg:flex">
          <li class="flex items-start gap-3.5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] bg-accent/[0.14]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg>
            </span>
            <span>
              <span class="block text-[15px] font-semibold text-text-primary">Drop a report</span>
              <span class="block text-[13px] leading-relaxed text-text-tertiary">Any lab, any year. Imaging reports too.</span>
            </span>
          </li>
          <li class="flex items-start gap-3.5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] bg-success/[0.12]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4 4L19 7" /></svg>
            </span>
            <span>
              <span class="block text-[15px] font-semibold text-text-primary">Every value read</span>
              <span class="block text-[13px] leading-relaxed text-text-tertiary">Everything parsed is charted here; you check the app-bound values before they are sent.</span>
            </span>
          </li>
          <li class="flex items-start gap-3.5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] bg-warning/[0.12]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FBBF24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2" /><path d="M11 18h2" /></svg>
            </span>
            <span>
              <span class="block text-[15px] font-semibold text-text-primary">The app&rsquo;s markers go to your phone</span>
              <span class="block text-[13px] leading-relaxed text-text-tertiary">Everything else stays charted here, with its own history.</span>
            </span>
          </li>
        </ul>
        <p class="hidden text-[13px] text-text-tertiary lg:block">The login is the one you use in the app.</p>
      </div>

      <!-- the card: one primary action, the alternative under a rule -->
      <div class="mt-6 rounded-[20px] border border-white/10 bg-white/[0.03] p-5 sm:p-7 lg:mt-0">
        <div class="flex w-full gap-1 rounded-full border border-white/10 bg-white/[0.04] p-1 sm:w-fit">
          <button type="button" data-mode="signin" class="min-h-10 flex-1 rounded-full px-4 py-1.5 text-[13px] font-bold sm:flex-none">Sign in</button>
          <button type="button" data-mode="signup" class="min-h-10 flex-1 rounded-full px-4 py-1.5 text-[13px] font-semibold sm:flex-none">Create account</button>
        </div>
        <p id="modenote" class="mt-3 hidden text-sm leading-relaxed text-text-secondary"></p>

        <form id="pwform" class="mt-4 flex flex-col gap-4">
          <div id="namerow" class="hidden">
            <label for="fullname" class="mb-1.5 block text-xs font-semibold text-text-secondary">Your name</label>
            <input id="fullname" type="text" autocomplete="name" placeholder="How the app should greet you"
              class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-3 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none sm:text-sm" />
          </div>
          <div>
            <label for="email" class="mb-1.5 block text-xs font-semibold text-text-secondary">Email</label>
            <input id="email" type="email" required placeholder="you@example.com" autocomplete="email"
              class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-3 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none sm:text-sm" />
          </div>
          <div>
            <div class="mb-1.5 flex items-baseline justify-between">
              <label for="password" class="text-xs font-semibold text-text-secondary">Password</label>
              <button type="button" id="forgot" class="text-xs font-medium text-accent-light hover:underline">Forgot password</button>
            </div>
            <div class="relative">
              <input id="password" type="password" placeholder="Password" autocomplete="current-password"
                class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-3 pr-12 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none sm:text-sm" />
              <button type="button" data-eye="password" aria-label="Show password"
                class="absolute inset-y-0 right-0 flex w-12 items-center justify-center text-text-tertiary hover:text-text-primary">
                <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>
          <!-- consent, affirmative and unticked: an account is not a newsletter -->
          <label id="newsletterrow" class="hidden items-start gap-2.5 text-xs leading-relaxed text-text-secondary">
            <input id="newsletter" type="checkbox" class="mt-0.5 h-4 w-4 shrink-0 accent-[#818cf8]" />
            <span>Send me the Verve newsletter: an email now and then on the science, and what changed in the app. Unsubscribe any time.</span>
          </label>
          <button type="submit" id="authsubmit"
            class="min-h-11 rounded-xl bg-accent px-4 py-3 text-sm font-bold text-canvas transition-opacity hover:opacity-90">
            Sign in
          </button>
        </form>

        <div id="ordiv" class="mt-4 flex items-center gap-3">
          <div class="h-px flex-1 bg-white/10"></div>
          <span class="text-xs text-text-muted">or</span>
          <div class="h-px flex-1 bg-white/10"></div>
        </div>

        <button id="magic"
          class="mt-4 min-h-11 w-full rounded-xl border border-white/14 px-4 py-3 text-sm font-semibold text-text-primary transition-colors hover:border-white/25">
          Email me a code
        </button>
        <p id="applenote" class="mt-3 text-xs leading-relaxed text-text-tertiary">
          A code you can type on any device, so a code read on your phone signs
          you in on your Mac. Signed up with Apple? The code goes to the address
          on your Apple ID.
        </p>

        <!-- ── the code step: the card flips to this once the email is sent ── -->
        <div id="codestep" class="hidden">
          <span class="font-mono text-[10.5px] font-semibold uppercase tracking-[0.14em] text-accent-light">Check your email</span>
          <h2 id="codehead" class="mt-2 text-[22px] font-bold tracking-[-0.02em] text-text-primary">Enter the code from the email</h2>
          <p id="codelead" class="mt-2 text-[13px] leading-relaxed text-text-secondary"></p>
          <form id="codeform" class="mt-4 flex flex-col gap-4">
            <label for="code" class="sr-only">Sign-in code</label>
            <input id="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="10"
              class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-4 py-3 text-center font-mono text-[26px] font-bold tracking-[0.25em] text-text-primary focus:border-accent focus:outline-none" />
            <button type="submit" id="verify"
              class="min-h-11 rounded-xl bg-accent px-4 py-3 text-sm font-bold text-canvas transition-opacity hover:opacity-90 disabled:opacity-50">
              Sign in
            </button>
          </form>
          <div class="mt-3 flex items-center justify-between gap-3">
            <button type="button" id="resend" class="text-xs font-medium text-text-tertiary hover:text-text-primary disabled:hover:text-text-tertiary" disabled></button>
            <button type="button" id="usepw" class="text-xs font-medium text-accent-light hover:underline"></button>
          </div>
          <p class="mt-3 text-xs leading-relaxed text-text-tertiary">The link in the same email still works, on the device it is opened on.</p>
        </div>

        <p id="authmsg" class="mh-status mt-4 hidden text-[13px] leading-relaxed"></p>
      </div>
      </div>
    </section>

    <!-- ── set a new password (arrived from a reset email) ──────────────── -->
    <section id="pwreset" class="mt-6 hidden max-w-md rounded-[20px] border border-white/10 bg-white/[0.03] p-5 sm:p-7 lg:mt-8">
      <span class="font-mono text-[10.5px] font-semibold uppercase tracking-[0.14em] text-accent-light">Reset your password</span>
      <h2 class="mt-2 text-[22px] font-bold tracking-[-0.02em] text-text-primary">Choose a new password</h2>
      <p class="mt-2 text-[13px] leading-relaxed text-text-secondary">It works here and in the Verve app. Eight characters or more.</p>
      <form id="pwform2" class="mt-4 flex flex-col gap-4">
        <div>
          <label for="newpw" class="mb-1.5 block text-xs font-semibold text-text-secondary">New password</label>
          <div class="relative">
            <input id="newpw" type="password" autocomplete="new-password"
              class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-3 pr-12 text-[15px] text-text-primary focus:border-accent focus:outline-none sm:text-sm" />
            <button type="button" data-eye="newpw" aria-label="Show password"
              class="absolute inset-y-0 right-0 flex w-12 items-center justify-center text-text-tertiary hover:text-text-primary">
              <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <div>
          <label for="newpw2" class="mb-1.5 block text-xs font-semibold text-text-secondary">Repeat it</label>
          <input id="newpw2" type="password" autocomplete="new-password"
            class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-3 text-[15px] text-text-primary focus:border-accent focus:outline-none sm:text-sm" />
        </div>
        <button type="submit" id="savepw" class="min-h-11 rounded-xl bg-accent px-4 py-3 text-sm font-bold text-canvas transition-opacity hover:opacity-90 disabled:opacity-50">
          Save password
        </button>
      </form>
      <p id="pwmsg" class="mh-status mt-4 hidden text-[13px] leading-relaxed"></p>
    </section>

    <!-- ── signed in ──────────────────────────────────────────────────── -->
    <section id="home" class="mt-2 hidden">

      <!-- the greeting: the page's heading, first name from the same
           profile the app greets you with, and the one way to add a report -->
      <div class="flex flex-wrap items-end justify-between gap-4 pt-5 sm:pt-8">
        <div class="min-w-0">
          <div class="flex items-center gap-2.5">
            <h1 id="greet" class="text-[28px] font-extrabold leading-[1.05] tracking-[-0.03em] text-text-primary sm:text-4xl"></h1>
            <button type="button" id="namechange" aria-label="Change your name" title="Change your name" class="hidden text-text-muted transition-colors hover:text-text-primary">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
            </button>
          </div>
          <!-- no name on the account yet: the greeting asks, prefilled when the
               email is clearly a name, and the answer goes to the app too -->
          <form id="nameform" class="mt-3 hidden flex-wrap items-center gap-2">
            <label for="namein" class="text-[13px] text-text-secondary">What should we call you?</label>
            <input id="namein" type="text" autocomplete="given-name" placeholder="Your first name"
              class="w-44 max-w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-2 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none sm:text-sm" />
            <button type="submit" class="min-h-10 rounded-xl bg-accent px-4 py-2 text-sm font-bold text-canvas transition-opacity hover:opacity-90">Save</button>
            <button type="button" id="namelater" class="text-xs font-medium text-text-tertiary hover:text-text-primary">Not now</button>
          </form>
        </div>
        <button
          id="addreport"
          class="inline-flex min-h-11 items-center gap-2 rounded-full border border-white/14 px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:border-white/25"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          Add a report
        </button>
      </div>

      <!-- ═══ PEOPLE: whose page this is ═══════════════════════════════════
           Every row belongs to a person: you, someone you look after, or
           someone who shares with you. The chips switch the whole page. -->
      <div id="peoplewrap" class="mt-5 hidden">
        <div id="people" class="flex flex-wrap items-center gap-2"></div>
        <form id="personform" class="mt-3 hidden max-w-3xl flex-wrap items-end gap-2 rounded-2xl border border-white/10 bg-white/[0.03] p-4">
          <div id="personmodes" class="flex basis-full flex-wrap gap-1.5" role="group" aria-label="Who is this">
            <button type="button" data-pmode="care" class="min-h-9 rounded-full border px-3.5 py-1.5 text-[13px] font-semibold">Someone I look after</button>
            <button type="button" data-pmode="ask" class="min-h-9 rounded-full border px-3.5 py-1.5 text-[13px] font-semibold">Someone with their own email</button>
          </div>
          <label id="personnamewrap" class="flex flex-col gap-1 text-[12px] text-text-secondary">Their name
            <input id="personname" type="text" autocomplete="off" placeholder="Amma" maxlength="60" required
              class="w-48 max-w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-2 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none" />
          </label>
          <label id="personbornwrap" class="flex flex-col gap-1 text-[12px] text-text-secondary">Born, year (optional)
            <input id="personborn" type="number" inputmode="numeric" min="1900" max="2100" placeholder="1958"
              class="w-28 rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-2 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none" />
          </label>
          <label id="personemailwrap" class="hidden flex-col gap-1 text-[12px] text-text-secondary">Their email
            <input id="personemail" type="email" autocomplete="off" placeholder="umar@example.com"
              class="w-64 max-w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-2 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none" />
          </label>
          <button type="submit" id="personsave" class="min-h-10 rounded-xl bg-accent px-4 py-2 text-sm font-bold text-canvas transition-opacity hover:opacity-90">Add</button>
          <button type="button" id="personcancel" class="min-h-10 px-2 text-xs font-medium text-text-tertiary hover:text-text-primary">Cancel</button>
          <p id="personformnote" class="basis-full text-[12px] leading-relaxed text-text-tertiary"></p>
        </form>
        <div id="personhead" class="mt-3 hidden flex-wrap items-center gap-x-4 gap-y-1">
          <span id="personkicker" class="font-mono text-[10px] font-semibold tracking-[0.14em] text-accent-light"></span>
          <span id="personactions" class="flex items-center gap-3 text-[13px] font-medium"></span>
        </div>
        <div id="personnotewrap" class="mt-3 hidden max-w-3xl">
          <label for="personnote" class="font-mono text-[10px] font-semibold tracking-wider text-text-tertiary">NOTE &middot; ONLY YOU SEE THIS</label>
          <textarea id="personnote" rows="2" placeholder="On metformin since June. Next HbA1c due December."
            class="mt-1 w-full resize-none rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-2 text-[14px] leading-relaxed text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none"></textarea>
        </div>

        <!-- invitations waiting for you: someone asked you to look at their page -->
        <div id="invites" class="mt-3 hidden max-w-3xl flex-col gap-3"></div>
        <!-- people you asked to share their page with you: waiting until they decide -->
        <p id="asked" class="mt-2 hidden max-w-3xl text-[12.5px] leading-relaxed text-text-tertiary"></p>
        <!-- someone asks to see your page: nothing is shared until you say so -->
        <div id="requests" class="mt-3 hidden max-w-3xl flex-col gap-3"></div>

        <!-- who can see this person: yours to change, closed until opened -->
        <details id="sharewrap" class="mt-3 hidden max-w-3xl rounded-2xl border border-white/10 bg-white/[0.03]">
          <summary class="cursor-pointer list-none px-4 py-3 text-[13px] font-semibold text-text-secondary hover:text-text-primary">
            <span id="sharesummary">Who can see this page</span>
          </summary>
          <div class="border-t border-white/[0.06] px-4 py-3">
            <div id="sharelist" class="flex flex-col gap-2"></div>
            <form id="shareform" class="mt-4 flex flex-wrap items-end gap-x-3 gap-y-2">
              <label class="flex flex-col gap-1 text-[12px] text-text-secondary">Their email
                <input id="shareemail" type="email" required autocomplete="off" placeholder="coach@example.com"
                  class="w-60 max-w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-2 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none" />
              </label>
              <fieldset class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] text-text-primary">
                <legend class="mb-1 text-[12px] text-text-secondary">What they see</legend>
                <label class="flex min-h-9 items-center gap-1.5"><input type="checkbox" data-scope="labs" class="h-4 w-4 accent-[#818cf8]" />Labs</label>
                <label class="flex min-h-9 items-center gap-1.5"><input type="checkbox" data-scope="imaging" class="h-4 w-4 accent-[#818cf8]" />Imaging</label>
                <label class="flex min-h-9 items-center gap-1.5"><input type="checkbox" data-scope="activity" class="h-4 w-4 accent-[#818cf8]" />Activity and fitness</label>
                <label class="flex min-h-9 items-center gap-1.5"><input type="checkbox" data-scope="body" class="h-4 w-4 accent-[#818cf8]" />Body measurements</label>
              </fieldset>
              <button type="submit" class="min-h-10 rounded-xl bg-accent px-4 py-2 text-sm font-bold text-canvas transition-opacity hover:opacity-90">Invite</button>
              <p class="basis-full text-[12px] leading-relaxed text-text-tertiary">They can look, not change. You can stop, or change what they see, at any time. Activity and body measurements come from the app, so they are offered only for a person with an account.</p>
            </form>
            <p id="sharemsg" class="mt-2 hidden text-[13px]"></p>
          </div>
        </details>
      </div>

      <!-- reading in progress: shown on every tab, since the read carries on
           whichever tab is open; the bar eases toward the end and jumps when
           the reader answers -->
      <button id="busy" class="mt-5 hidden w-full items-center gap-3 rounded-2xl border border-accent/30 bg-accent/[0.06] px-4 py-3 text-left transition-colors hover:border-accent/50">
        <span id="busyicon" class="relative flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] bg-accent/[0.16]">
          <svg class="mh-spin h-4 w-4 text-accent-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9"/></svg>
        </span>
        <span class="min-w-0 flex-1">
          <span id="busytext" class="block text-[13px] font-semibold text-text-primary"></span>
          <span id="busysub" class="block text-xs text-text-tertiary"></span>
          <span class="mt-2 block h-1 w-full overflow-hidden rounded-full bg-white/[0.07]"><span id="busybar" class="block h-1 rounded-full bg-accent" style="width: 0%"></span></span>
        </span>
      </button>

      <!-- tab pills -->
      <nav id="tabbar" class="mt-5 flex gap-1.5 rounded-2xl border border-white/10 bg-white/[0.03] p-1.5 sm:w-fit">
        <button data-tab="overview" class="flex-1 rounded-xl px-4 py-2 text-sm font-semibold sm:flex-none">Overview</button>
        <button data-tab="labs" class="flex-1 rounded-xl px-4 py-2 text-sm font-semibold sm:flex-none">Labs</button>
