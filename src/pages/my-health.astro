  // ── the app's export: read in the browser, kept per person ─────────────
  // Settings → Export → JSON in the app writes one file with the profile,
  // every activity, the fitness tests, waist readings, lab readings and a
  // weekly summary. Dropped here it lands on the open person: weeks →
  // web_weeks, fitness tests → web_crf, waist → web_body, lab readings →
  // web_labs like any report's values. Every row carries the import's tag,
  // so the whole import can be undone in one press. The app's own tables
  // are never written from here.
  const isExport = (f: File) => f.type === "application/json" || /\.json$/i.test(f.name);
  /** The export's camelCase reading fields → the app's column names the site already knows. */
  const EXPORT_KEYS: Record<string, string> = {
    glucoseMgdl: "glucose_mgdl", hba1cPct: "hba1c_pct", postMealGlucoseMgdl: "post_meal_glucose_mgdl",
    fastingInsulinUIUmL: "fasting_insulin_uiuml", triglyceridesMgdl: "triglycerides_mgdl", hdlMgdl: "hdl_mgdl",
    waistCm: "waist_cm", sbp: "sbp", dbp: "dbp", apoBMgdl: "apo_b_mgdl", ldlMgdl: "ldl_mgdl", lpaValue: "lpa_value",
    hsCrpMgL: "hs_crp_mgl", bodyFatPct: "body_fat_pct", skelMuscPct: "skel_musc_pct",
    almKg: "alm_kg", ffmKg: "ffm_kg", handgripKg: "handgrip_kg", singleLegBalanceSeconds: "single_leg_balance_seconds",
    chairStandSeconds: "chair_stand_seconds", gaitSpeedMs: "gait_speed_ms",
  };
  const LAB_SECTION: Record<string, string> = { metabolic: "metabolic", heart: "heart", sarcopenia: "muscle" };
  const num = (v: unknown) => (typeof v === "number" && Number.isFinite(v) ? v : null);
  const int = (v: unknown) => Math.round(num(v) ?? 0);

  async function importExport(file: File, rid: string): Promise<"ok" | "bad" | "skip"> {
    const who = person!;
    qset(rid, "READING…", "busy", "Reading the export");
    let data: any;
    try { data = JSON.parse(await file.text()); }
    catch { qset(rid, "FAILED", "bad", "Not a readable JSON file"); return "bad"; }
    const looks = data && typeof data === "object" &&
      (Array.isArray(data.activities) || Array.isArray(data.labReadings) || Array.isArray(data.weeklySummaries) || Array.isArray(data.crfEntries));
    if (!looks) { qset(rid, "SKIPPED", "bad", "Not a Verve export: no activities, readings or weeks in it"); return "skip"; }
    if (!who.id) { qset(rid, "SKIPPED", "bad", "The people tables are not set up yet, so there is nowhere to keep this"); return "skip"; }
    const exportedOn = String(data.exportedAt ?? "").slice(0, 10) || new Date().toISOString().slice(0, 10);
    const tag = `export:${exportedOn}:${Date.now()}`;   // which export, and when it was dropped here

    // weeks: the app's own summary, else built from the activities the same way
    const byWeek = new Map<string, any>();
    for (const w of Array.isArray(data.weeklySummaries) ? data.weeklySummaries : []) {
      const start = String(w?.weekStart ?? "").slice(0, 10);
      if (!/^\d{4}-\d{2}-\d{2}$/.test(start)) continue;
      byWeek.set(start, { met_hours: num(w.totalMETHours) ?? 0, minutes: int(w.totalMinutes), light_min: int(w.lightMinutes), moderate_min: int(w.modMinutes), vigorous_min: int(w.vigMinutes), workouts: int(w.workouts) });
    }
    if (!byWeek.size) for (const a of Array.isArray(data.activities) ? data.activities : []) {
      if (!a?.timestamp) continue;
      const start = mondayOf(new Date(a.timestamp));
      const w = byWeek.get(start) ?? { met_hours: 0, minutes: 0, light_min: 0, moderate_min: 0, vigorous_min: 0, workouts: 0 };
      w.met_hours += num(a.metHours) ?? 0; w.minutes += int(a.durationMinutes);
      w.light_min += int(a.lightMinutes); w.moderate_min += int(a.moderateMinutes); w.vigorous_min += int(a.vigorousMinutes); w.workouts += 1;
      byWeek.set(start, w);
    }
    const weeks = [...byWeek].map(([week_start, w]) => ({ user_id: userId, person_id: who.id, week_start, ...w, met_hours: Math.round(w.met_hours * 100) / 100, source: "export", import_tag: tag }));

    const byDay = <T,>(rows: T[], key: (r: T) => string) => [...new Map(rows.map((r) => [key(r), r])).values()];
    const crf = byDay((Array.isArray(data.crfEntries) ? data.crfEntries : []).filter((c: any) => c?.timestamp).map((c: any) => ({
      user_id: userId, person_id: who.id, measured_on: localDay(c.timestamp),
      met_capacity: num(c.metCapacity),
      vo2max: num(c.vo2MaxEstimate) ?? (num(c.metCapacity) != null ? Math.round(c.metCapacity * 3.5 * 10) / 10 : null),
      method: c.estimationMethod ?? null, category: c.performanceCategory ?? null, source: "export", import_tag: tag,
    })), (r: any) => r.measured_on);
    const body = byDay((Array.isArray(data.waistReadings) ? data.waistReadings : []).filter((w: any) => w?.measuredAt && num(w.waistCm) != null).map((w: any) => ({
      user_id: userId, person_id: who.id, measured_on: localDay(w.measuredAt), waist_cm: w.waistCm, source: "export", import_tag: tag,
    })), (r: any) => r.measured_on);

    // lab readings: each known marker becomes a value on Labs, in the app's unit
    const labRows: any[] = [];
    for (const r of Array.isArray(data.labReadings) ? data.labReadings : []) {
      if (!r?.measuredAt) continue;
      const date = localDay(r.measuredAt);
      for (const [field, key] of Object.entries(EXPORT_KEYS)) {
        const v = num(r[field]);
        if (v == null || !LABELS[key]) continue;
        labRows.push({
          id: crypto.randomUUID(), user_id: userId, person_id: who.id,
          analyte: canonName(LABELS[key].label), value: v,
          unit: key === "lpa_value" ? (r.lpaUnit ?? null) : (LABELS[key].unit || null),
          ref_low: null, ref_high: null, ref_text: null,
          section: LAB_SECTION[LABELS[key].section] ?? "other", measured_on: date, report_path: tag,
        });
      }
    }
    // the same value on the same day is one measurement, however it arrived
    const dates = [...new Set(labRows.map((r) => r.measured_on))];
    const { data: existing } = dates.length
      ? await scopeRows(supabase.from("web_labs").select("analyte, value, measured_on"), who).in("measured_on", dates)
      : { data: [] as any[] };
    const have = new Set((existing ?? []).map((r: any) => `${canonName(String(r.analyte)).toLowerCase()}|${r.measured_on}|${r.value}`));
    const freshLabs = labRows.filter((r) => !have.has(`${r.analyte.toLowerCase()}|${r.measured_on}|${r.value}`));

    qset(rid, "FILING…", "busy", `${weeks.length} weeks · ${crf.length} fitness tests · ${body.length} waist readings · ${freshLabs.length} lab values`);
    const errs: string[] = [];
    if (weeks.length) { const { error } = await supabase.from("web_weeks").upsert(weeks, { onConflict: "person_id,week_start" }); if (error) errs.push(`weeks: ${error.message}`); }
    if (crf.length) { const { error } = await supabase.from("web_crf").upsert(crf, { onConflict: "person_id,measured_on" }); if (error) errs.push(`fitness: ${error.message}`); }
    if (body.length) { const { error } = await supabase.from("web_body").upsert(body, { onConflict: "person_id,measured_on" }); if (error) errs.push(`waist: ${error.message}`); }
    if (freshLabs.length) {
      const { error } = await supabase.from("web_labs").insert(freshLabs);
      if (error) for (const r of freshLabs) { const { error: e } = await supabase.from("web_labs").insert(r); if (e && e.code !== "23505") errs.push(`labs: ${e.message}`); }
    }
    if (errs.length) { qset(rid, "PART FILED", "bad", errs.join(" · ")); return "bad"; }
    const under = who.self ? "" : ` · under ${who.name}`;
    const parts = [`${weeks.length} week${weeks.length === 1 ? "" : "s"} of activity`, `${crf.length} fitness test${crf.length === 1 ? "" : "s"}`, `${body.length} waist reading${body.length === 1 ? "" : "s"}`, `${freshLabs.length} lab value${freshLabs.length === 1 ? "" : "s"}${labRows.length > freshLabs.length ? ` (${labRows.length - freshLabs.length} already here)` : ""}`];
    qset(rid, "IMPORTED ✓", "ok", `Verve export from ${fmtDay(exportedOn)} · ${parts.join(" · ")}${under}`);
    $("importcard").innerHTML = `<span class="min-w-0 flex-1">Imported the app's export from ${esc(fmtDay(exportedOn))}${esc(under)}: ${esc(parts.join(", "))}. The Overview has the weeks; this tab lists the export under From the Verve app.</span>
      <button type="button" data-undo="${tag}" class="min-h-9 rounded-lg border border-white/14 px-3 py-1.5 text-xs font-semibold text-text-secondary hover:text-danger">Undo this import</button>`;
    show("importcard", true); $("importcard").classList.add("flex");
    $("importcard").querySelector("[data-undo]")!.addEventListener("click", async () => {
      await removeImport(tag, who);
      show("importcard", false); $("importcard").classList.remove("flex");
      msg("upmsg", "The import is undone; nothing from that file remains.");
      await refresh();
    });
    return "ok";
  }

  /** Everything one export brought, gone: its weeks, fitness tests, waist readings and lab values. The app is untouched. */
  async function removeImport(tag: string, who: Person) {
    await Promise.all([
      supabase.from("web_weeks").delete().eq("person_id", who.id).eq("import_tag", tag),
      supabase.from("web_crf").delete().eq("person_id", who.id).eq("import_tag", tag),
      supabase.from("web_body").delete().eq("person_id", who.id).eq("import_tag", tag),
      supabase.from("web_labs").delete().eq("user_id", userId).eq("report_path", tag),
    ]);
  }

  /** The exports dropped on this person, rebuilt from the rows they left: one line each, with Remove. */
  function renderAppImports() {
    type Imp = { tag: string; exported: string; imported: string; weeks: number; crf: number; body: number; labs: number };
    const by = new Map<string, Imp>();
    const isTag = (t: unknown): t is string => typeof t === "string" && t.startsWith("export:");
    const get = (tag: string) => {
      if (by.has(tag)) return by.get(tag)!;
      const [, exported = "", stamp = ""] = tag.split(":");
      const imp: Imp = {
        tag, exported: /^\d{4}-\d{2}-\d{2}$/.test(exported) ? exported : "",
        imported: /^\d{10,}$/.test(stamp) ? new Date(Number(stamp)).toLocaleDateString("en-CA") : "",
        weeks: 0, crf: 0, body: 0, labs: 0,
      };
      by.set(tag, imp);
      return imp;
    };
    for (const w of exportRows.weeks) if (isTag(w.import_tag)) get(w.import_tag).weeks++;
    for (const c of exportRows.crf) if (isTag(c.import_tag)) get(c.import_tag).crf++;
    for (const b of exportRows.body) if (isTag(b.import_tag)) get(b.import_tag).body++;
    for (const r of allLabs) if (isTag(r.report_path)) get(r.report_path).labs++;
    const imps = [...by.values()].sort((a, b) => b.tag.localeCompare(a.tag));
    show("appimports", imps.length > 0);
    if (!imps.length) return;
    const n = (k: number, one: string, many: string) => k ? `${k} ${k === 1 ? one : many}` : "";
    $("appimportrows").innerHTML = imps.map((im) => `
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 rounded-xl border border-white/[0.08] px-3 py-2 text-[13px]">
        <span class="font-semibold text-text-primary">Export of ${esc(im.exported ? fmtDay(im.exported) : "an unknown date")}</span>
        ${im.imported ? `<span class="text-text-muted">dropped here ${esc(fmtDay(im.imported))}</span>` : ""}
        <span class="text-text-tertiary">${esc([n(im.weeks, "week", "weeks"), n(im.crf, "fitness test", "fitness tests"), n(im.body, "waist day", "waist days"), n(im.labs, "lab value", "lab values")].filter(Boolean).join(" · "))}</span>
        ${canWrite() ? `<button type="button" data-rmimport="${esc(im.tag)}" class="ml-auto min-h-9 text-[12px] font-semibold text-text-tertiary hover:text-danger">Remove</button>` : ""}
      </div>`).join("");
    $("appimportrows").querySelectorAll("[data-rmimport]").forEach((b) => b.addEventListener("click", async () => {
      if (!confirm("Remove everything this export brought? Its weeks, fitness tests, waist readings and lab values are deleted from this page. The app itself is untouched.")) return;
      await removeImport((b as HTMLElement).dataset.rmimport!, person!);
      show("importcard", false); $("importcard").classList.remove("flex");
      msg("upmsg", "Removed; nothing from that export remains here.");
      await refresh();
    }));
  }

  // ── activity and fitness on the Overview: the app's weeks, a marker on top ─
  let allWeeks: any[] = [], allCrf: any[] = [], allBody: any[] = [];
  /** The export tables' own rows, before sync overrides any: what each import brought, for the list on Reports. */
  let exportRows: { weeks: any[]; crf: any[]; body: any[] } = { weeks: [], crf: [], body: [] };
  let pickedMarker = "";

  // ── the app's sync: the source for anyone with an account ──────────────
  // Cloud Sync in the app is free and automatic, and it already carries
  // every workout, fitness test and waist reading. For a person with an
  // account those rows are read straight from the app's tables, yours
  // through your own policies and a client's through the activity and
  // body scopes they ticked. An export is then only for what sync does
  // not have: weeks from before sync was on, or a person with no account.
  async function loadSynced(accountId: string) {
    const [a, c, w, pr] = await Promise.all([
      supabase.from("activities").select("timestamp, duration_minutes, met_hours, intensity_category, activity_name, zone2_minutes")
        .eq("user_id", accountId).is("deleted_at", null).order("timestamp", { ascending: true }).limit(6000),
      supabase.from("crf_entries").select("timestamp, met_capacity, performance_category, estimation_method, vo2_max_estimate")
        .eq("user_id", accountId).is("deleted_at", null).order("timestamp", { ascending: true }).limit(300),
      supabase.from("waist_readings").select("measured_at, waist_cm")
        .eq("user_id", accountId).is("deleted_at", null).order("measured_at", { ascending: true }).limit(600),
      supabase.from("profiles").select("weekly_met_hours_goal, height_cm, sex, age").eq("user_id", accountId).maybeSingle(),
    ]);
    return { activities: a.data ?? [], crf: c.data ?? [], waist: w.data ?? [], profile: pr.data ?? null };
  }
  /** The app's weeks from its workouts, bucketed the way the app does: by the Monday, in local time. */
  function weeksFrom(activities: any[]): any[] {
    const by = new Map<string, any>();
    for (const a of activities) {
      if (!a?.timestamp) continue;
      const start = mondayOf(new Date(a.timestamp));
      const w = by.get(start) ?? { week_start: start, met_hours: 0, minutes: 0, light_min: 0, moderate_min: 0, vigorous_min: 0, workouts: 0, source: "sync" };
      const mins = Number(a.duration_minutes) || 0;
      w.met_hours += Number(a.met_hours) || 0; w.minutes += mins; w.workouts += 1;
      const cat = String(a.intensity_category ?? "");
      if (cat === "vigorous") w.vigorous_min += mins; else if (cat === "moderate") w.moderate_min += mins; else w.light_min += mins;
      by.set(start, w);
    }
    return [...by.values()].map((w) => ({ ...w, met_hours: Math.round(w.met_hours * 100) / 100 })).sort((x, y) => x.week_start.localeCompare(y.week_start));
  }
  const crfFromSync = (rows: any[]) => rows.filter((c) => c?.timestamp).map((c) => ({
    measured_on: localDay(c.timestamp),
    vo2max: c.vo2_max_estimate ?? (c.met_capacity != null ? Math.round(Number(c.met_capacity) * 3.5 * 10) / 10 : null),
    met_capacity: c.met_capacity ?? null, method: c.estimation_method ?? null, category: c.performance_category ?? null, source: "sync",
  }));
  const bodyFromSync = (rows: any[]) => rows.filter((w) => w?.measured_at && w.waist_cm != null).map((w) => ({ measured_on: localDay(w.measured_at), waist_cm: w.waist_cm, source: "sync" }));
  /** Sync rows first; a fallback row only for a key sync does not have. Within sync, the last row for a key wins. */
  function mergeBy(key: string, primary: any[], fallback: any[]): any[] {
    const out = new Map<string, any>();
    for (const r of fallback) out.set(String(r[key]), r);
    for (const r of primary) out.set(String(r[key]), r);
    return [...out.values()].sort((x, y) => String(x[key]).localeCompare(String(y[key])));
  }

  async function loadActivity() {
    const p = person;
    if (!p?.id) { show("activitywrap", false); show("appimports", false); return; }
    const [w, c, b, synced] = await Promise.all([
      supabase.from("web_weeks").select("week_start, met_hours, minutes, moderate_min, vigorous_min, workouts, import_tag").eq("person_id", p.id).order("week_start", { ascending: true }).limit(260),
      supabase.from("web_crf").select("measured_on, vo2max, met_capacity, method, import_tag").eq("person_id", p.id).order("measured_on", { ascending: true }).limit(100),
      supabase.from("web_body").select("measured_on, waist_cm, weight_kg, import_tag").eq("person_id", p.id).order("measured_on", { ascending: true }).limit(400),
      p.account_id ? loadSynced(p.account_id) : Promise.resolve(null),
    ]);
    if (person?.id !== p.id) return;   // switched away meanwhile
    exportRows = { weeks: w.data ?? [], crf: c.data ?? [], body: b.data ?? [] };
    allWeeks = mergeBy("week_start", synced ? weeksFrom(synced.activities) : [], w.data ?? []);
    allCrf = mergeBy("measured_on", synced ? crfFromSync(synced.crf) : [], c.data ?? []);
    allBody = mergeBy("measured_on", synced ? bodyFromSync(synced.waist) : [], b.data ?? []);
    syncActs = synced?.activities ?? [];
    syncProfile = synced?.profile ?? null;
    renderActivity();
    renderAppImports();
    renderDepth();
  }

  // ── the 21 markers, in the three sections the landing page counts ──────
  // A chart key is a lab_readings column, except "bp", which pairs sbp and
  // dbp, and "sppb_score", which the app computes and no table stores. A
  // marker with no reading anywhere shows as a dashed chip, never hidden:
  // the page says 21 markers, and 21 it is.
  type ChartMarker = { key: string; label: string; section: "metabolic" | "heart" | "muscle"; pair?: [string, string]; lines?: [number, number] };
  const CHART_MARKERS: ChartMarker[] = [
    { key: "glucose_mgdl", label: "Fasting glucose", section: "metabolic" },
    { key: "hba1c_pct", label: "HbA1c", section: "metabolic" },
    { key: "bp", label: "Blood pressure", section: "metabolic", pair: ["sbp", "dbp"], lines: [120, 80] },
    { key: "triglycerides_mgdl", label: "Triglycerides", section: "metabolic" },
    { key: "hdl_mgdl", label: "HDL", section: "metabolic" },
    { key: "waist_cm", label: "Waist", section: "metabolic" },
    { key: "post_meal_glucose_mgdl", label: "Post-meal glucose", section: "metabolic" },
    { key: "fasting_insulin_uiuml", label: "Fasting insulin", section: "metabolic" },
    { key: "apo_b_mgdl", label: "ApoB", section: "heart" },
    { key: "ldl_mgdl", label: "LDL", section: "heart" },
    { key: "lpa_value", label: "Lp(a)", section: "heart" },
    { key: "hs_crp_mgl", label: "hs-CRP", section: "heart" },
    { key: "body_fat_pct", label: "Body fat", section: "muscle" },
    { key: "skel_musc_pct", label: "Muscle mass", section: "muscle" },
    { key: "alm_kg", label: "Lean mass, arms and legs", section: "muscle" },
    { key: "ffm_kg", label: "Whole-body lean mass", section: "muscle" },
    { key: "handgrip_kg", label: "Grip strength", section: "muscle" },
    { key: "single_leg_balance_seconds", label: "Single-leg balance", section: "muscle" },
    { key: "chair_stand_seconds", label: "Chair stand", section: "muscle" },
    { key: "sppb_score", label: "SPPB", section: "muscle" },
    { key: "gait_speed_ms", label: "Walk speed", section: "muscle" },
  ];
  const CHART_SECTIONS: Array<["metabolic" | "heart" | "muscle", string]> = [["metabolic", "METABOLIC"], ["heart", "HEART"], ["muscle", "MUSCLE"]];
  /** The chart's key for an analyte name: the app's column, or SPPB. */
  const chartKeyFor = (analyte: string) => appKeyFor(analyte) ?? (squash(canonName(analyte)) === "sppb" || squash(canonName(analyte)) === "sppbscore" ? "sppb_score" : null);

  type Pt = { d: string; v: number; lo: number | null; hi: number | null; unit: string | null };
  /**
   * Every reading of every marker this person has, by chart key, from the
   * three places one can come from: the values read from reports and
   * imports (web_labs), the app's own rows (lab_readings), and waist days
   * (web_body). The same value on the same day is one reading.
   */
  function markerPoints(): Map<string, Pt[]> {
    const by = new Map<string, Pt[]>();
    const seen = new Set<string>();
    const add = (key: string, pt: Pt) => {
      const id = `${key}|${pt.d}|${pt.v}`;
      if (seen.has(id)) return;
      seen.add(id);
      (by.get(key) ?? by.set(key, []).get(key)!).push(pt);
    };
    for (const r of allLabs) {
      const k = chartKeyFor(String(r.analyte));
      if (!k || !Number.isFinite(Number(r.value))) continue;
      add(k, { d: String(r.measured_on).slice(0, 10), v: Number(r.value), lo: Number.isFinite(Number(r.ref_low)) && r.ref_low != null ? Number(r.ref_low) : null, hi: Number.isFinite(Number(r.ref_high)) && r.ref_high != null ? Number(r.ref_high) : null, unit: r.unit ?? null });
    }
    for (const r of allApp) {
      const d = localDay(r.measured_at);
      for (const m of CHART_MARKERS) {
        const cols = m.pair ?? [m.key];
        for (const col of cols) {
          const v = Number(r[col]);
          if (r[col] == null || !Number.isFinite(v)) continue;
          add(col, { d, v, lo: null, hi: null, unit: col === "lpa_value" ? (r.lpa_unit ?? null) : (LABELS[col]?.unit || null) });
        }
      }
    }
    for (const b of allBody) if (b.waist_cm != null && Number.isFinite(Number(b.waist_cm)))
      add("waist_cm", { d: String(b.measured_on).slice(0, 10), v: Number(b.waist_cm), lo: null, hi: null, unit: "cm" });
    for (const pts of by.values()) pts.sort((a, b) => a.d.localeCompare(b.d));
    return by;
  }
  const hasPoints = (m: ChartMarker, by: Map<string, Pt[]>) => m.pair ? m.pair.some((k) => by.has(k)) : by.has(m.key);

  function renderActivity() {
    const weeks = allWeeks.slice(-52);
    show("activitywrap", weeks.length > 0);
    if (!weeks.length) return;
    const by = markerPoints();
    const onFile = CHART_MARKERS.filter((m) => hasPoints(m, by));
    if (!onFile.some((m) => m.key === pickedMarker)) pickedMarker = onFile.find((m) => m.key === "apo_b_mgdl")?.key ?? onFile[0]?.key ?? "";
    $("markercount").textContent = `${CHART_MARKERS.length} markers · ${onFile.length} on file · dashed ones have no reading yet`;

    // the chips: three rows, one per section, every marker present
    $("markerpick").innerHTML = CHART_SECTIONS.map(([sec, name]) => `
      <div class="flex items-center gap-2.5">
        <div class="w-[84px] shrink-0 font-mono text-[10px] font-semibold tracking-[0.12em] text-text-tertiary">${name}</div>
        <div class="flex flex-wrap gap-2">${CHART_MARKERS.filter((m) => m.section === sec).map((m) => {
          const on = m.key === pickedMarker, has = hasPoints(m, by);
          return has
            ? `<button type="button" data-marker="${m.key}" aria-pressed="${on}" class="min-h-[34px] rounded-full border px-3 py-1 text-[13px] font-semibold transition-colors ${on ? "border-accent/70 bg-accent/15 text-text-primary" : "border-white/14 text-text-secondary hover:text-text-primary"}">${esc(m.label)}</button>`
            : `<button type="button" aria-disabled="true" title="No reading on file yet" class="min-h-[34px] cursor-default rounded-full border border-dashed border-white/14 px-3 py-1 text-[13px] font-semibold text-text-muted">${esc(m.label)}</button>`;
        }).join("")}</div>
      </div>`).join("");
    $("markerpick").querySelectorAll("[data-marker]").forEach((b) =>
      b.addEventListener("click", () => { pickedMarker = (b as HTMLElement).dataset.marker!; renderActivity(); }));
    const m = CHART_MARKERS.find((x) => x.key === pickedMarker) ?? null;
    const inProse = (label: string) => /^[A-Z][a-z]{3,}(?=[\s-]|$)/.test(label) ? label.charAt(0).toLowerCase() + label.slice(1) : label;
    $("activitysub").textContent = m ? `Weekly MET-hours from the app, with ${inProse(m.label)} on the days it was measured.` : "Weekly MET-hours from the app.";

    // ── geometry: the marker's lane above, a hairline, the bars below ─────
    const W = 1150, x0 = 60, x1 = 1130, plotW = x1 - x0;
    const LT = 18, LB = 128, SEP = 142, BT = 160, BB = 320, MONTH_Y = 342;
    const at = (iso: string) => new Date(String(iso).slice(0, 10) + "T00:00:00").getTime();
    const WEEK = 7 * 86400000;
    const first = at(weeks[0].week_start), last = at(weeks[weeks.length - 1].week_start) + WEEK;
    const span = Math.max(last - first, WEEK);
    const xAt = (iso: string) => x0 + ((at(iso) - first) / span) * plotW;
    const barW = Math.max(3, plotW / Math.max(1, span / WEEK) - 3.6);
    const maxMet = Math.max(1, ...weeks.map((w) => Number(w.met_hours)));
    const yMet = (v: number) => BB - (v / maxMet) * (BB - BT);
    const MONO = `font-family="JetBrains Mono, ui-monospace, monospace"`;
    let svg = "";

    // the lane
    if (m) {
      const series: Array<{ col: string; pts: Pt[] }> = (m.pair ?? [m.key]).map((col) => ({ col, pts: (by.get(col) ?? []).filter((p) => at(p.d) >= first - 2 * WEEK && at(p.d) <= last + 2 * WEEK) }));
      const all = series.flatMap((s) => s.pts);
      const unit = all.map((p) => p.unit).filter(Boolean).pop() ?? LABELS[m.key]?.unit ?? "";
      // the range: the marker page's line for blood pressure; else the lab's printed range on the latest reading that has one
      const ranged = m.lines ? null : [...all].reverse().find((p) => p.lo != null || p.hi != null) ?? null;
      const lo = ranged?.lo ?? null, hi = ranged?.hi ?? null;
      const vals = [...all.map((p) => p.v), ...(m.lines ?? []), ...(lo != null ? [lo] : []), ...(hi != null ? [hi] : [])];
      let vmin = Math.min(...vals), vmax = Math.max(...vals);
      const pad = (vmax - vmin) || Math.max(1, Math.abs(vmax) * 0.2);
      vmin -= pad * 0.35; vmax += pad * 0.35;
      const yL = (v: number) => LB - ((v - vmin) / (vmax - vmin)) * (LB - LT);
      const laneTitle = m.lines
        ? `${m.label.toUpperCase()} · ${esc(unit)} · ${m.lines[0]}/${m.lines[1]} DASHED, THE LINE THE MARKER PAGE CITES`
        : `${m.label.toUpperCase()}${unit ? ` · ${esc(unit)}` : ""}${ranged ? ` · THE LAB'S RANGE${lo != null && hi != null ? `, ${lo} TO ${hi},` : hi != null ? `, BELOW ${hi},` : `, ABOVE ${lo},`} SHADED` : ""}`;
      svg += `<text x="${x0}" y="14" fill="#94a3b8" font-size="10" letter-spacing="1.2" ${MONO}>${laneTitle}</text>`;
      if (m.lines) {
        for (const v of m.lines) svg += `<line x1="${x0}" y1="${yL(v).toFixed(1)}" x2="${x1}" y2="${yL(v).toFixed(1)}" stroke="#a5b4fc" stroke-opacity="0.45" stroke-dasharray="4 4"/><text x="${x0 - 10}" y="${(yL(v) + 4).toFixed(1)}" text-anchor="end" fill="#94a3b8" font-size="10" ${MONO}>${v}</text>`;
      } else if (ranged) {
        const top = hi != null ? yL(hi) : LT, bottom = lo != null ? yL(lo) : LB;
        svg += `<rect x="${x0}" y="${top.toFixed(1)}" width="${plotW}" height="${Math.max(0, bottom - top).toFixed(1)}" fill="#34d399" fill-opacity="0.07"/>`;
        for (const v of [lo, hi]) if (v != null) svg += `<line x1="${x0}" y1="${yL(v).toFixed(1)}" x2="${x1}" y2="${yL(v).toFixed(1)}" stroke="#34d399" stroke-opacity="0.45" stroke-dasharray="4 4"/><text x="${x0 - 10}" y="${(yL(v) + 4).toFixed(1)}" text-anchor="end" fill="#94a3b8" font-size="10" ${MONO}>${v}</text>`;
      }
      // the readings; a label within 28 px of the previous one steps below its point
      if (m.pair) {
        const [top, bot] = series;
        const byDay = new Map<string, { s?: Pt; d?: Pt }>();
        for (const p of top.pts) (byDay.get(p.d) ?? byDay.set(p.d, {}).get(p.d)!).s = p;
        for (const p of bot.pts) (byDay.get(p.d) ?? byDay.set(p.d, {}).get(p.d)!).d = p;
        const days = [...byDay.keys()].sort();
        const line = (pick: (r: { s?: Pt; d?: Pt }) => Pt | undefined, op: number) => {
          const pts = days.map((d) => [d, pick(byDay.get(d)!)] as const).filter(([, p]) => p).map(([d, p]) => `${Math.min(x1, Math.max(x0, xAt(d))).toFixed(1)},${yL(p!.v).toFixed(1)}`);
          return pts.length > 1 ? `<polyline points="${pts.join(" ")}" fill="none" stroke="#a5b4fc" stroke-opacity="${op}" stroke-width="1.5" stroke-dasharray="4 4"/>` : "";
        };
        svg += line((r) => r.s, 1) + line((r) => r.d, 0.6);
        // a reading's pair of labels sits outside its bar, else beside it; a third close reading keeps only its tooltip
        const taken = { out: -999, side: -999 };
        for (const d of days) {
          const r = byDay.get(d)!, x = Math.min(x1, Math.max(x0, xAt(d)));
          const slot = x - taken.out >= 28 ? "out" : x - taken.side >= 34 ? "side" : "";
          if (slot) taken[slot] = x;
          const ys = r.s ? yL(r.s.v) : null, yd = r.d ? yL(r.d.v) : null;
          if (ys != null && yd != null) svg += `<rect x="${(x - 2).toFixed(1)}" y="${ys.toFixed(1)}" width="4" height="${Math.max(0, yd - ys).toFixed(1)}" rx="2" fill="#818cf8"/>`;
          const title = `${esc(fmtDay(d))}: ${r.s?.v ?? "?"}/${r.d?.v ?? "?"} ${esc(unit)}`;
          for (const [p, y, above] of [[r.s, ys, true], [r.d, yd, false]] as Array<[Pt | undefined, number | null, boolean]>) {
            if (!p || y == null) continue;
            svg += `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="5" fill="#818cf8" stroke="#0D0D1C" stroke-width="2"><title>${title}</title></circle>`;
            if (slot === "out") svg += `<text x="${x.toFixed(1)}" y="${(above ? y - 9 : y + 15).toFixed(1)}" text-anchor="middle" fill="#c7d2fe" font-size="12" font-weight="700">${p.v}</text>`;
            else if (slot === "side") svg += `<text x="${(x + 9).toFixed(1)}" y="${(y + 4).toFixed(1)}" fill="#c7d2fe" font-size="12" font-weight="700">${p.v}</text>`;
          }
        }
        if (!days.length) svg += `<text x="${x1}" y="${LT + 6}" text-anchor="end" fill="#64748b" font-size="11">no ${esc(m.label.toLowerCase())} in these weeks</text>`;
      } else {
        const pts = series[0].pts.map((p) => ({ ...p, x: Math.min(x1, Math.max(x0, xAt(p.d))), y: yL(p.v) }));
        if (pts.length > 1) svg += `<polyline points="${pts.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ")}" fill="none" stroke="#a5b4fc" stroke-width="1.5" stroke-dasharray="4 4"/>`;
        // a label takes the first free slot: above, then below, then beside; a fourth close reading keeps only its tooltip
        const taken = { above: -999, below: -999, side: -999 };
        for (const p of pts) {
          const slot = p.x - taken.above >= 28 ? "above" : p.x - taken.below >= 28 ? "below" : p.x - taken.side >= 34 ? "side" : "";
          if (slot) taken[slot] = p.x;
          svg += `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="5" fill="#818cf8" stroke="#0D0D1C" stroke-width="2"><title>${esc(fmtDay(p.d))}: ${esc(m.label)} ${p.v}${unit ? ` ${esc(unit)}` : ""}</title></circle>`;
          if (slot === "above") svg += `<text x="${p.x.toFixed(1)}" y="${(p.y - 9).toFixed(1)}" text-anchor="middle" fill="#c7d2fe" font-size="12" font-weight="700">${p.v}</text>`;
          else if (slot === "below") svg += `<text x="${p.x.toFixed(1)}" y="${(p.y + 17).toFixed(1)}" text-anchor="middle" fill="#c7d2fe" font-size="12" font-weight="700">${p.v}</text>`;
          else if (slot === "side") svg += `<text x="${(p.x + 9).toFixed(1)}" y="${(p.y + 4).toFixed(1)}" fill="#c7d2fe" font-size="12" font-weight="700">${p.v}</text>`;
        }
        if (!pts.length) svg += `<text x="${x1}" y="${LT + 6}" text-anchor="end" fill="#64748b" font-size="11">no ${esc(m.label.toLowerCase())} in these weeks</text>`;
      }
    }

    // the hairline, then the bars
    svg += `<line x1="${x0}" y1="${SEP}" x2="${x1}" y2="${SEP}" stroke="rgba(255,255,255,0.10)"/>`;
    for (const f of [0, 0.5, 1]) {
      const y = BB - f * (BB - BT);
      svg += `<line x1="${x0}" y1="${y}" x2="${x1}" y2="${y}" stroke="rgba(255,255,255,${f === 0 ? 0.14 : 0.06})"/><text x="${x0 - 10}" y="${y + 4}" text-anchor="end" fill="#94a3b8" font-size="11" ${MONO}>${Math.round(maxMet * f)}</text>`;
    }
    for (const w of weeks) {
      const x = xAt(w.week_start), y = yMet(Number(w.met_hours));
      svg += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barW.toFixed(1)}" height="${(BB - y).toFixed(1)}" rx="2" fill="#f97316" fill-opacity="0.85"><title>Week of ${esc(fmtDay(String(w.week_start).slice(0, 10)))}: ${Number(w.met_hours).toFixed(1)} MET-hours, ${w.workouts} workout${Number(w.workouts) === 1 ? "" : "s"}</title></rect>`;
    }
    let lastMonth = "";
    for (const w of weeks) {
      const mo = String(w.week_start).slice(0, 7);
      if (mo === lastMonth) continue;
      lastMonth = mo;
      svg += `<text x="${xAt(w.week_start).toFixed(1)}" y="${MONTH_Y}" fill="#94a3b8" font-size="11" ${MONO}>${new Date(at(w.week_start)).toLocaleDateString(undefined, { month: "short" }).toUpperCase()}</text>`;
    }
    $("activitychart").innerHTML = svg;
    $("activitylegend").innerHTML = `<span class="inline-flex items-center gap-2"><span class="inline-block h-2 w-3 rounded-[2px] bg-met-hero"></span>MET-hours per week, from the app</span>`
      + (m ? `<span class="inline-flex items-center gap-2"><span class="inline-block h-3.5 w-1 rounded-[2px] bg-accent"></span>${esc(m.label)}, from reports and the app, on the days it was measured</span>` : "");

    const avg = weeks.reduce((sum, w) => sum + Number(w.met_hours), 0) / weeks.length;
    const crf = allCrf.filter((c) => c.vo2max != null).slice(-1)[0];
    const body = allBody.filter((b) => b.waist_cm != null).slice(-1)[0];
    $("activitystats").innerHTML = [
      `<span>${weeks.length} week${weeks.length === 1 ? "" : "s"}</span>`,
      `<span>average <strong class="font-semibold text-text-secondary">${avg.toFixed(1)}</strong> MET-hours a week</span>`,
      crf ? `<span>VO₂max <strong class="font-semibold text-text-secondary">${Math.round(Number(crf.vo2max))}</strong> on ${esc(fmtDay(String(crf.measured_on).slice(0, 10)))}</span>` : "",
      body ? `<span>waist <strong class="font-semibold text-text-secondary">${body.waist_cm}</strong> cm on ${esc(fmtDay(String(body.measured_on).slice(0, 10)))}</span>` : "",
    ].filter(Boolean).join("");
  }

  // ═══ IN DEPTH ════════════════════════════════════════════════════════════
  // The four questions a coach asks of one person, answered from rows the
  // page already holds. Nothing here is written anywhere.
  let syncActs: any[] = [];
  let syncProfile: any = null;

  /**
   * The cited retest cadences, in days, from the app's own threshold table:
   * one figure while the latest reading is in range, a shorter one once it
   * is outside. The lipid panel shares one draw and one interval.
   */
  const RETEST: Record<string, { ok: number; out: number; text: string; source: string }> = {
    glucose_mgdl:       { ok: 1095, out: 365,  text: "every 3 years · yearly from 100 mg/dL",            source: "ADA Standards of Care 2026" },
    hba1c_pct:          { ok: 1095, out: 365,  text: "every 3 years · yearly from 5.7%",                 source: "ADA Standards of Care 2026" },
    bp:                 { ok: 365,  out: 91,   text: "yearly under 120/80 · 3 to 6 months once above",   source: "AHA/ACC 2017" },
    triglycerides_mgdl: { ok: 1461, out: 1461, text: "every 4 to 6 years · one draw for the panel",       source: "AHA · USPSTF" },
    hdl_mgdl:           { ok: 1461, out: 1461, text: "every 4 to 6 years · one draw for the panel",       source: "AHA · USPSTF" },
    apo_b_mgdl:         { ok: 1461, out: 1461, text: "every 4 to 6 years · one draw for the panel",       source: "AHA · USPSTF" },
    ldl_mgdl:           { ok: 1461, out: 1461, text: "every 4 to 6 years · one draw for the panel",       source: "AHA · USPSTF" },
    alm_kg:             { ok: 182,  out: 182,  text: "every 6 months",                                   source: "Verve's own cadence, anchored to EWGSOP2" },
  };
  const CRF_RETEST = { due: 56, overdue: 112 };          // the app's own reminder: eight weeks, overdue at sixteen
  const BODY_RETEST = 182;                               // a body assessment every six months, the app's cadence
  const METHOD_LABEL: Record<string, string> = { cpet: "CPET", "treadmill-test": "treadmill test", "bruce-protocol": "Bruce protocol", "cooper-run": "Cooper run", "1.5-mile-run": "1.5-mile run", "six-minute-walk": "six-minute walk", "one-mile-walk": "one-mile walk" };
  const MAXIMAL = new Set(["cpet", "treadmill-test", "bruce-protocol", "cooper-run", "1.5-mile-run"]);
  const methodLabel = (m: unknown) => METHOD_LABEL[String(m ?? "")] ?? String(m ?? "").replace(/-/g, " ");
  const ORD = ["", "first", "second", "third", "fourth", "fifth", "sixth", "seventh", "eighth", "ninth", "tenth"];
  const ordinal = (n: number) => ORD[n] ?? `${n}th`;
  const monthOf = (d: string) => new Date(d + "T00:00:00").toLocaleDateString(undefined, { month: "short" });
  const monthYearOf = (d: string) => new Date(d + "T00:00:00").toLocaleDateString(undefined, { month: "short", year: "numeric" });
  const addDays = (d: string, n: number) => { const x = new Date(d + "T00:00:00"); x.setDate(x.getDate() + n); return x.toLocaleDateString("en-CA"); };
  const fmt1 = (v: number) => (Math.round(v * 10) / 10).toString();
  const signed = (v: number, digits = 1) => `${v > 0 ? "+" : v < 0 ? "−" : ""}${Math.abs(Math.round(v * 10 ** digits) / 10 ** digits)}`;
  const kicker = (t: string, tone = "text-text-tertiary") => `<div class="font-mono text-[10px] font-semibold tracking-[0.12em] ${tone}">${t}</div>`;
  const rangeText = (pt: Pt | null) => !pt ? "" : pt.lo != null && pt.hi != null ? `${pt.lo} to ${pt.hi}` : pt.hi != null ? `below ${pt.hi}` : pt.lo != null ? `above ${pt.lo}` : "";

  type Due = { what: string; on: string; days: number; why: string };
  /** When a marker is next due, from its latest reading and whether that reading sits in the lab's range. */
  function dueFor(key: string, pts: Pt[]): Due | null {
    const r = RETEST[key]; if (!r || !pts.length) return null;
    const last = pts[pts.length - 1];
    const ranged = [...pts].reverse().find((p) => p.lo != null || p.hi != null) ?? null;
    const out = ranged ? inRange({ value: last.v, ref_low: ranged.lo, ref_high: ranged.hi }) === false : false;
    const on = addDays(last.d, out ? r.out : r.ok);
    return { what: CHART_MARKERS.find((m) => m.key === key)?.label ?? key, on, days: daysBetween(new Date().toLocaleDateString("en-CA"), on), why: r.text };
  }
  const dueWord = (d: Due) => d.days < 0 ? `overdue ${Math.abs(d.days) < 14 ? `${Math.abs(d.days)} days` : `${Math.round(Math.abs(d.days) / 7)} weeks`}` : d.days === 0 ? "due today" : d.days < 45 ? `due ${fmtDay(d.on)}` : `due ${monthYearOf(d.on)}`;
  const dueTone = (d: Due) => d.days < 0 ? "text-danger" : d.days <= 30 ? "text-warning" : "text-text-secondary";

  function renderDepth() {
    const p = person;
    if (!p) return;
    const today = new Date().toLocaleDateString("en-CA"), thisMonday = mondayOf(new Date());
    const by = markerPoints();
    const weeks = allWeeks;
    const nothing = !weeks.length && !allCrf.length && !by.size;
    show("dp-empty", nothing); show("dp-cards", !nothing); show("dp-panels", !nothing); show("dp-changed", !nothing);
    $("dp-panels").classList.toggle("grid", !nothing); $("dp-cards").classList.toggle("grid", !nothing); $("dp-changed").classList.toggle("flex", !nothing);
    if (nothing) {
      $("dp-empty").textContent = p.self
        ? "Nothing to go deep on yet. Turn on Cloud Sync in the app, or drop a report or the app's export on the Reports tab, and this page fills itself."
        : p.mine ? `Nothing on file for ${p.name} yet. Drop a report or an export for them on the Reports tab.`
        : `${p.name} has not shared anything this page can read yet.`;
      return;
    }

    // ── activity ───────────────────────────────────────────────────────────
    const goal = Number(syncProfile?.weekly_met_hours_goal) || 7.5;
    const complete = weeks.filter((w) => w.week_start < thisMonday);
    const recent = (complete.length ? complete : weeks).slice(-4), prior = complete.slice(-8, -4);
    const sum = (xs: any[], k: string) => xs.reduce((t, w) => t + (Number(w[k]) || 0), 0);
    const recentAvg = recent.length ? sum(recent, "met_hours") / recent.length : 0;
    const priorAvg = prior.length ? sum(prior, "met_hours") / prior.length : null;
    const change = priorAvg && priorAvg > 0 ? (recentAvg - priorAvg) / priorAvg : null;
    let streak = 0; for (let i = complete.length - 1; i >= 0 && Number(complete[i].met_hours) >= goal; i--) streak++;
    const lastWorkoutDay = syncActs.length ? localDay(syncActs[syncActs.length - 1].timestamp) : ([...weeks].reverse().find((w) => Number(w.workouts) > 0)?.week_start ?? "");
    const quietDays = lastWorkoutDay ? daysBetween(lastWorkoutDay, today) : null;
    const recentActs = syncActs.filter((a) => recent.length && localDay(a.timestamp) >= recent[0].week_start && localDay(a.timestamp) < addDays(recent[recent.length - 1].week_start, 7));
    const kinds = new Map<string, number>();
    for (const a of recentActs) { const k = String(a.activity_name ?? "workout").split(/[,(]/)[0].trim().toLowerCase(); kinds.set(k, (kinds.get(k) ?? 0) + 1); }
    const perWeek = recent.length ? sum(recent, "workouts") / recent.length : 0;
    const minutes = sum(recent, "minutes"), vig = sum(recent, "vigorous_min");
    const zone2 = recentActs.length ? recentActs.reduce((t, a) => t + (Number(a.zone2_minutes) || 0), 0) / recent.length : null;
    const twelve = weeks.slice(-12);
    const maxW = Math.max(goal, ...twelve.map((w) => Number(w.met_hours)));
    const bw = 30, gap = 12, left = 24;
    const ySv = (v: number) => 120 - (v / maxW) * 100;
    let asvg = `<line x1="${left}" y1="120" x2="528" y2="120" stroke="rgba(255,255,255,0.14)"/>`;
    asvg += `<line x1="${left}" y1="${ySv(goal).toFixed(1)}" x2="528" y2="${ySv(goal).toFixed(1)}" stroke="#a5b4fc" stroke-opacity="0.7" stroke-dasharray="4 4"/><text x="528" y="${(ySv(goal) - 5).toFixed(1)}" text-anchor="end" fill="#a5b4fc" font-size="10" font-family="JetBrains Mono, ui-monospace, monospace">GOAL ${goal}</text>`;
    twelve.forEach((w, i) => {
      const x = left + 6 + i * (bw + gap), y = ySv(Number(w.met_hours));
      const dim = i < twelve.length - Math.min(4, recent.length) || w.week_start >= thisMonday;
      asvg += `<rect x="${x}" y="${y.toFixed(1)}" width="${bw}" height="${(120 - y).toFixed(1)}" rx="2" fill="#f97316" fill-opacity="${dim ? 0.5 : 1}"><title>Week of ${esc(fmtDay(w.week_start))}: ${fmt1(Number(w.met_hours))} MET-hours, ${w.workouts} workout${Number(w.workouts) === 1 ? "" : "s"}</title></rect>`;
    });
    let lastM = "";
    twelve.forEach((w, i) => { const mo = w.week_start.slice(0, 7); if (mo === lastM) return; lastM = mo; asvg += `<text x="${left + 6 + i * (bw + gap)}" y="134" fill="#94a3b8" font-size="10" font-family="JetBrains Mono, ui-monospace, monospace">${monthOf(w.week_start).toUpperCase()}</text>`; });
    const kindText = [...kinds].sort((a, b) => b[1] - a[1]).slice(0, 3).map(([k, n]) => `${k} ${Math.round(n / Math.max(1, recent.length))}`).join(", ");
    $("dp-activity").innerHTML = `
      <div class="flex flex-wrap items-baseline justify-between gap-2"><h2 class="text-[17px] font-extrabold text-text-primary">Activity</h2><span class="text-[12.5px] text-text-tertiary">${twelve.length} week${twelve.length === 1 ? "" : "s"} from the app · goal ${goal} MET-hours</span></div>
      <svg viewBox="0 0 540 140" class="mt-3 block h-auto w-full" role="img" aria-label="Twelve weeks of MET-hours as bars, the latest four brighter, with the goal line">${asvg}</svg>
      <div class="mt-2 flex flex-col gap-1.5 text-[13px] leading-relaxed text-text-secondary">
        <div><strong class="text-text-primary">${fmt1(recentAvg)} MET-hours</strong> a week over the last ${recent.length === 1 ? "week" : `${recent.length} weeks`}${change != null ? `, ${change >= 0 ? "up" : "down"} ${Math.round(Math.abs(change) * 100)}% on the ${prior.length} before` : ""}${streak ? ` · ${streak} week${streak === 1 ? "" : "s"} at goal in a row` : " · not at goal last week"}</div>
        <div>Last workout <strong class="text-text-primary">${quietDays == null ? "none on file" : quietDays === 0 ? "today" : quietDays === 1 ? "yesterday" : `${quietDays} days ago`}</strong>${perWeek ? ` · ${Math.round(perWeek)} a week${kindText ? `: ${esc(kindText)}` : ""}` : ""}</div>
        <div>${minutes ? `Vigorous share <strong class="text-text-primary">${Math.round((vig / minutes) * 100)}%</strong>` : "No minutes on file"}${zone2 != null ? ` · Zone 2 <strong class="text-text-primary">${Math.round(zone2)} min</strong> a week, scored against each day's own band` : ""}</div>
      </div>`;

    // ── fitness ────────────────────────────────────────────────────────────
    const tests = allCrf.filter((c) => c.vo2max != null).map((c) => ({ ...c, v: Number(c.vo2max), max: MAXIMAL.has(String(c.method)) }));
    const latest = tests[tests.length - 1] ?? null;
    const prevSame = latest ? [...tests.slice(0, -1)].reverse().find((t) => t.method === latest.method) ?? null : null;
    const within = latest && prevSame ? latest.v - prevSame.v : null;
    const trendWord = within == null ? "" : within >= 1 ? "rising" : within <= -1 ? "falling" : "flat";
    const crfDue: Due | null = latest ? { what: "Fitness test", on: addDays(latest.measured_on, CRF_RETEST.due), days: daysBetween(today, addDays(latest.measured_on, CRF_RETEST.due)), why: "the app's own reminder, eight weeks" } : null;
    let fsvg = "";
    if (tests.length) {
      const vs = tests.map((t) => t.v); const lo = Math.min(...vs) - 2, hi = Math.max(...vs) + 2;
      const t0 = new Date(tests[0].measured_on + "T00:00:00").getTime(), t1 = Math.max(new Date(tests[tests.length - 1].measured_on + "T00:00:00").getTime(), t0 + 86400000);
      const xf = (d: string) => 40 + ((new Date(d + "T00:00:00").getTime() - t0) / (t1 - t0)) * 470;
      const yf = (v: number) => 120 - ((v - lo) / (hi - lo)) * 100;
      fsvg += `<line x1="24" y1="120" x2="528" y2="120" stroke="rgba(255,255,255,0.14)"/><text x="8" y="124" fill="#94a3b8" font-size="10" font-family="JetBrains Mono, ui-monospace, monospace">${Math.round(lo)}</text><text x="8" y="24" fill="#94a3b8" font-size="10" font-family="JetBrains Mono, ui-monospace, monospace">${Math.round(hi)}</text>`;
      for (const grp of [false, true]) {
        const g = tests.filter((t) => t.max === grp);
        if (g.length > 1) fsvg += `<polyline points="${g.map((t) => `${xf(t.measured_on).toFixed(1)},${yf(t.v).toFixed(1)}`).join(" ")}" fill="none" stroke="${grp ? "#a5b4fc" : "#64748b"}" stroke-width="2"${grp ? "" : ' stroke-dasharray="3 4"'}/>`;
      }
      for (const t of tests) fsvg += `<circle cx="${xf(t.measured_on).toFixed(1)}" cy="${yf(t.v).toFixed(1)}" r="${t.max ? 6 : 5}" fill="${t.max ? "#818cf8" : "#64748b"}" stroke="#0D0D1C" stroke-width="2"><title>${esc(fmtDay(t.measured_on))}: ${fmt1(t.v)} by ${esc(methodLabel(t.method))}</title></circle><text x="${xf(t.measured_on).toFixed(1)}" y="${(yf(t.v) - 11).toFixed(1)}" text-anchor="middle" fill="${t.max ? "#c7d2fe" : "#94a3b8"}" font-size="12" font-weight="700">${fmt1(t.v)}</text><text x="${xf(t.measured_on).toFixed(1)}" y="134" text-anchor="middle" fill="#94a3b8" font-size="10" font-family="JetBrains Mono, ui-monospace, monospace">${monthOf(t.measured_on).toUpperCase()}</text>`;
    }
    $("dp-fitness").innerHTML = `
      <div class="flex flex-wrap items-baseline justify-between gap-2"><h2 class="text-[17px] font-extrabold text-text-primary">Fitness</h2><span class="text-[12.5px] text-text-tertiary">Every test, compared only within its method</span></div>
      ${tests.length ? `<svg viewBox="0 0 540 140" class="mt-3 block h-auto w-full" role="img" aria-label="Fitness tests over time, maximal tests in colour and submaximal in grey">${fsvg}</svg>` : `<p class="mt-3 text-[13px] text-text-tertiary">No fitness test on file.</p>`}
      ${latest ? `<div class="mt-2 flex flex-col gap-1.5 text-[13px] leading-relaxed text-text-secondary">
        <div><strong class="text-text-primary">${fmt1(latest.v)} mL/kg/min</strong> by ${esc(methodLabel(latest.method))} on ${esc(fmtDay(latest.measured_on))}${within != null ? ` · ${within >= 0 ? "up" : "down"} ${fmt1(Math.abs(within))} on the ${esc(methodLabel(latest.method))} of ${esc(monthYearOf(prevSame!.measured_on))}` : " · the first of its method"}</div>
        <div>${tests.some((t) => !t.max) ? "Submaximal tests are shown in grey, never compared with a maximal one" : "All tests on file are maximal"}</div>
        <div>${latest.category ? `Category <strong class="text-text-primary">${esc(String(latest.category).replace(/-/g, " "))}</strong> · ` : ""}retest <strong class="${crfDue ? dueTone(crfDue) : ""}">${crfDue ? dueWord(crfDue) : ""}</strong>, the app's own reminder</div>
      </div>` : ""}`;

    // ── labs ───────────────────────────────────────────────────────────────
    type LabRow = { key: string; label: string; latest: string; tone: string; range: string; since: string; sinceTone: string; retest: string; retestTone: string; out: boolean; d: string; due: Due | null; noFollow: number | null };
    const labRows: LabRow[] = [];
    for (const m of CHART_MARKERS) {
      if (m.section === "muscle" || m.key === "waist_cm") continue;
      if (m.pair) {
        const S = by.get("sbp") ?? [], D = by.get("dbp") ?? [];
        if (!S.length) continue;
        const s1 = S[S.length - 1], d1 = D.find((x) => x.d === s1.d) ?? D[D.length - 1] ?? null;
        const s0 = S[S.length - 2] ?? null, d0 = s0 ? (D.find((x) => x.d === s0.d) ?? null) : null;
        const out = s1.v >= 120 || (d1 ? d1.v >= 80 : false);
        const due = RETEST.bp ? { what: "Blood pressure", on: addDays(s1.d, out ? RETEST.bp.out : RETEST.bp.ok), days: 0, why: RETEST.bp.text } : null;
        if (due) due.days = daysBetween(today, due.on);
        labRows.push({ key: "bp", label: "Blood pressure", latest: `${s1.v}/${d1 ? d1.v : "?"} mmHg`, tone: out ? "text-warning" : "text-text-primary", range: "under 120/80", since: s0 ? `${signed(s1.v - s0.v, 0)}/${d0 && d1 ? signed(d1.v - d0.v, 0) : "?"} since ${monthOf(s0.d)}` : "measured once", sinceTone: out ? "text-warning" : "text-text-secondary", retest: due ? `${dueWord(due)} · ${due.why}` : "—", retestTone: due ? dueTone(due) : "text-text-muted", out, d: s1.d, due, noFollow: null });
        continue;
      }
      const pts = by.get(m.key) ?? [];
      if (!pts.length) continue;
      const last = pts[pts.length - 1], prev = pts[pts.length - 2] ?? null;
      const ranged = [...pts].reverse().find((x) => x.lo != null || x.hi != null) ?? null;
      const out = ranged ? inRange({ value: last.v, ref_low: ranged.lo, ref_high: ranged.hi }) === false : false;
      const due = dueFor(m.key, pts);
      const months = Math.floor(daysBetween(last.d, today) / 30);
      const noFollow = out && months >= 3 ? months : null;
      labRows.push({ key: m.key, label: m.label, latest: `${last.v}${last.unit ? ` ${last.unit}` : ""}`, tone: out ? "text-warning" : "text-text-primary", range: ranged ? rangeText(ranged) : "no range on file", since: prev ? `${signed(last.v - prev.v, Number.isInteger(last.v) && Number.isInteger(prev.v) ? 0 : 1)} since ${monthOf(prev.d)}` : "measured once", sinceTone: out ? "text-warning" : prev && ranged && inRange({ value: prev.v, ref_low: ranged.lo, ref_high: ranged.hi }) === false ? "text-success-light" : "text-text-secondary", retest: noFollow ? `outside range, no follow-up in ${noFollow} months` : due ? `${dueWord(due)} · ${due.why}` : "—", retestTone: noFollow ? "text-warning" : due ? dueTone(due) : "text-text-muted", out, d: last.d, due, noFollow });
    }
    labRows.sort((a, b) => Number(b.out) - Number(a.out) || b.d.localeCompare(a.d));
    $("dp-labs").innerHTML = `
      <div class="flex flex-wrap items-baseline justify-between gap-2"><h2 class="text-[17px] font-extrabold text-text-primary">Labs</h2><span class="text-[12.5px] text-text-tertiary">Against each lab's own printed range</span></div>
      ${labRows.length ? `<div class="mt-3 overflow-x-auto"><table class="w-full min-w-[520px] border-collapse text-[12.5px]">
        <thead><tr class="text-left font-mono text-[10px] tracking-[0.1em] text-text-tertiary"><th class="border-b border-white/10 pb-1.5 pr-2 font-semibold">MARKER</th><th class="border-b border-white/10 px-2 pb-1.5 font-semibold">LATEST</th><th class="border-b border-white/10 px-2 pb-1.5 font-semibold">LAB'S RANGE</th><th class="border-b border-white/10 px-2 pb-1.5 font-semibold">SINCE LAST</th><th class="border-b border-white/10 pb-1.5 pl-2 font-semibold">RETEST</th></tr></thead>
        <tbody>${labRows.map((r) => `<tr><td class="py-1.5 pr-2 font-bold text-text-primary">${esc(r.label)}</td><td class="px-2 py-1.5 font-bold ${r.tone}">${esc(r.latest)}</td><td class="px-2 py-1.5 text-text-tertiary">${esc(r.range)}</td><td class="px-2 py-1.5 ${r.sinceTone}">${esc(r.since)}</td><td class="py-1.5 pl-2 ${r.retestTone}">${esc(r.retest)}</td></tr>`).join("")}</tbody></table></div>`
        : `<p class="mt-3 text-[13px] text-text-tertiary">No lab values on file.</p>`}`;

    // ── body ───────────────────────────────────────────────────────────────
    const waist = by.get("waist_cm") ?? [];
    const wl = waist[waist.length - 1] ?? null;
    const height = Number(syncProfile?.height_cm) || null;
    const fat = (by.get("body_fat_pct") ?? []).slice(-1)[0] ?? null, musc = (by.get("skel_musc_pct") ?? []).slice(-1)[0] ?? null;
    const method = [...allApp].reverse().find((r) => r.body_comp_method)?.body_comp_method ?? null;
    const female = String(syncProfile?.sex ?? "") === "female";
    const fn: Array<{ label: string; key: string; unit: string; judge: (v: number) => [string, boolean] }> = [
      { label: "Grip strength", key: "handgrip_kg", unit: "kg", judge: (v) => [v >= (female ? 16 : 27) ? `above ${female ? 16 : 27}` : `below ${female ? 16 : 27}`, v >= (female ? 16 : 27)] },
      { label: "Chair stand, 5 rises", key: "chair_stand_seconds", unit: "s", judge: (v) => [v <= 15 ? "under 15" : "over 15", v <= 15] },
      { label: "Walk speed", key: "gait_speed_ms", unit: "m/s", judge: (v) => [v >= 0.8 ? "above 0.8" : "below 0.8", v >= 0.8] },
      { label: "Single-leg balance", key: "single_leg_balance_seconds", unit: "s", judge: (v) => [v >= 10 ? "held" : "under 10 s", v >= 10] },
    ];
    const fnRows = fn.map((f) => ({ ...f, pt: (by.get(f.key) ?? []).slice(-1)[0] ?? null })).filter((f) => f.pt);
    const fnDay = fnRows.map((f) => f.pt!.d).sort().pop() ?? "";
    const muscleDays = [...(by.get("alm_kg") ?? []), ...(by.get("body_fat_pct") ?? []), ...(by.get("skel_musc_pct") ?? []), ...fnRows.map((f) => f.pt!)].map((x) => x.d).sort();
    const bodyDue: Due | null = muscleDays.length ? { what: "Body assessment", on: addDays(muscleDays[muscleDays.length - 1], BODY_RETEST), days: daysBetween(today, addDays(muscleDays[muscleDays.length - 1], BODY_RETEST)), why: "every 6 months, Verve's own cadence anchored to EWGSOP2" } : null;
    let wsvg = "";
    if (waist.length) {
      const W3 = waist.slice(-6); const vs = W3.map((x) => x.v); const lo = Math.min(...vs) - 1, hi = Math.max(...vs) + 1;
      const xw = (i: number) => 14 + (W3.length > 1 ? (i / (W3.length - 1)) * 222 : 111), yw = (v: number) => 62 - ((v - lo) / Math.max(1, hi - lo)) * 44;
      if (W3.length > 1) wsvg += `<polyline points="${W3.map((x, i) => `${xw(i).toFixed(1)},${yw(x.v).toFixed(1)}`).join(" ")}" fill="none" stroke="#a5b4fc" stroke-width="2"/>`;
      W3.forEach((x, i) => { wsvg += `<circle cx="${xw(i).toFixed(1)}" cy="${yw(x.v).toFixed(1)}" r="5" fill="#818cf8" stroke="#0D0D1C" stroke-width="2"><title>${esc(fmtDay(x.d))}: ${x.v} cm</title></circle><text x="${xw(i).toFixed(1)}" y="${(yw(x.v) - 10).toFixed(1)}" text-anchor="middle" fill="#c7d2fe" font-size="11" font-weight="700">${x.v}</text><text x="${xw(i).toFixed(1)}" y="78" text-anchor="middle" fill="#94a3b8" font-size="10" font-family="JetBrains Mono, ui-monospace, monospace">${monthOf(x.d).toUpperCase()}</text>`; });
    }
    $("dp-body").innerHTML = `
      <div class="flex flex-wrap items-baseline justify-between gap-2"><h2 class="text-[17px] font-extrabold text-text-primary">Body</h2><span class="text-[12.5px] text-text-tertiary">Waist, composition, function</span></div>
      <div class="mt-3 grid gap-4 sm:grid-cols-2">
        <div class="flex flex-col gap-2">
          ${waist.length ? `<svg viewBox="0 0 250 82" class="block h-auto w-full max-w-[250px]" role="img" aria-label="Waist over the last measurements">${wsvg}</svg>` : `<p class="text-[13px] text-text-tertiary">No waist on file.</p>`}
          ${wl ? `<div class="text-[13px] leading-relaxed text-text-secondary">Waist <strong class="text-text-primary">${wl.v} cm</strong> on ${esc(fmtDay(wl.d))}${height ? ` · waist-to-height <strong class="text-text-primary">${(wl.v / height).toFixed(2)}</strong> at ${height} cm` : ""}</div>` : ""}
          ${fat || musc ? `<div class="text-[13px] leading-relaxed text-text-secondary">${fat ? `Body fat <strong class="text-text-primary">${fat.v}%</strong>` : ""}${fat && musc ? " · " : ""}${musc ? `muscle mass <strong class="text-text-primary">${musc.v}%</strong>` : ""}${method ? ` · ${esc(String(method).toUpperCase())}` : ""}, ${esc(fmtDay((fat ?? musc)!.d))}</div>` : ""}
        </div>
        <div class="flex flex-col gap-1.5">
          ${fnRows.length ? `${kicker(`FUNCTION · ${fnDay ? esc(fmtDay(fnDay)).toUpperCase() : ""} · AGAINST THE CUT-OFFS THE APP USES`)}${fnRows.map((f) => { const [word, ok] = f.judge(f.pt!.v); return `<div class="flex justify-between gap-3 text-[13px]"><span class="text-text-secondary">${esc(f.label)}</span><span><strong class="text-text-primary">${f.pt!.v} ${f.unit}</strong> <span class="${ok ? "text-success-light" : "text-warning"}">${esc(word)}</span></span></div>`; }).join("")}` : `<p class="text-[13px] text-text-tertiary">No function tests on file: grip, chair stand, walk speed, balance.</p>`}
          ${bodyDue ? `<div class="mt-1 text-[12px] text-text-muted">Next body assessment <span class="${dueTone(bodyDue)}">${dueWord(bodyDue)}</span>: ${bodyDue.why}</div>` : ""}
        </div>
      </div>`;

    // ── the four cards ─────────────────────────────────────────────────────
    const moving = change == null ? { k: "ACTIVITY", v: recent.length ? `${fmt1(recentAvg)} MET-h` : "—", tone: "", sub: recent.length ? `a week over the last ${recent.length === 1 ? "week" : `${recent.length} weeks`}; not enough weeks before to compare` : "no weeks on file" }
      : change >= 0.05 ? { k: "MOVING", v: `${signed(change * 100, 0)}%`, tone: "success", sub: `${recent.length}-week MET-hours against the ${prior.length} before` }
      : change <= -0.05 ? { k: "DECLINING", v: `${signed(change * 100, 0)}%`, tone: "danger", sub: `${recent.length}-week MET-hours against the ${prior.length} before` }
      : { k: "STEADY", v: `${signed(change * 100, 0)}%`, tone: "", sub: `${recent.length}-week MET-hours against the ${prior.length} before` };
    const outRows = labRows.filter((r) => r.out);
    const oldest = outRows.filter((r) => r.noFollow != null).sort((a, b) => b.noFollow! - a.noFollow!)[0];
    const dues: Due[] = [...labRows.map((r) => r.due).filter((d): d is Due => !!d), ...(crfDue ? [crfDue] : []), ...(bodyDue ? [bodyDue] : [])].sort((a, b) => a.days - b.days);
    const nextDue = dues[0] ?? null;
    const card = (k: string, v: string, sub: string, tone = "") => `<div class="flex flex-col gap-1 rounded-2xl border p-4 ${tone === "success" ? "border-success/40 bg-success/[0.06]" : tone === "warning" ? "border-warning/45 bg-warning/[0.06]" : tone === "danger" ? "border-danger/40 bg-danger/[0.06]" : "border-white/10 bg-white/[0.03]"}">${kicker(k, tone === "success" ? "text-success-light" : tone === "warning" ? "text-warning" : tone === "danger" ? "text-danger" : "text-text-tertiary")}<div class="text-[22px] font-extrabold leading-tight text-text-primary">${v}</div><div class="text-[12.5px] leading-snug text-text-tertiary">${sub}</div></div>`;
    $("dp-cards").innerHTML = [
      card(moving.k, moving.v, moving.sub, moving.tone),
      card("FITNESS", latest ? `${fmt1(latest.v)} <span class="text-[13px] font-semibold ${trendWord === "rising" ? "text-success-light" : trendWord === "falling" ? "text-danger" : "text-text-tertiary"}">${trendWord}</span>` : "—", latest ? `VO₂max by ${esc(methodLabel(latest.method))}${within != null ? `, ${within >= 0 ? "up" : "down"} ${fmt1(Math.abs(within))} within the method` : ", first of its method"}` : "no fitness test on file"),
      card("LABS", labRows.length ? `${outRows.length} <span class="text-[13px] font-semibold ${outRows.length ? "text-warning" : "text-success-light"}">${outRows.length ? "outside range" : "all in range"}</span>` : "—", labRows.length ? (outRows.length ? `${esc(outRows.slice(0, 2).map((r) => r.label).join(" and "))}${outRows.length > 2 ? ` and ${outRows.length - 2} more` : ""}${oldest ? `, no follow-up in ${oldest.noFollow} months` : ""}` : `${labRows.length} marker${labRows.length === 1 ? "" : "s"} on file, latest ${esc(fmtDay(labRows[0].d))}`) : "no lab values on file", outRows.length ? "warning" : ""),
      card("RETEST DUE", nextDue ? esc(nextDue.what) : "Nothing due", nextDue ? `${esc(nextDue.why)} · ${dueWord(nextDue)}` : "in the cited cadences", nextDue && nextDue.days < 0 ? "danger" : nextDue && nextDue.days <= 30 ? "warning" : ""),
    ].join("");

    // ── what changed this week ─────────────────────────────────────────────
    const weekAgo = addDays(today, -7);
    const events: Array<{ d: string; text: string }> = [];
    const filedThisWeek = allLabs.filter((r) => String(r.created_at ?? "").slice(0, 10) >= weekAgo);
    const byDayFiled = new Map<string, any[]>();
    for (const r of filedThisWeek) { const d = String(r.created_at).slice(0, 10); (byDayFiled.get(d) ?? byDayFiled.set(d, []).get(d)!).push(r); }
    for (const [d, rows] of byDayFiled) {
      const named = rows.map((r) => ({ r, key: chartKeyFor(String(r.analyte)) })).filter((x) => x.key && labRows.some((l) => l.key === x.key || (l.key === "bp" && (x.key === "sbp" || x.key === "dbp"))));
      const pick = named.find((x) => labRows.find((l) => l.key === x.key)?.out) ?? named[0];
      if (pick) { const l = labRows.find((x) => x.key === pick.key); events.push({ d, text: `${esc(String(pick.r.analyte))} ${pick.r.value} read from a report${l && l.since !== "measured once" ? `, ${esc(l.since)}` : ""}${l?.out ? ", above the lab's range" : ""}` }); }
      else events.push({ d, text: `${rows.length} value${rows.length === 1 ? "" : "s"} read from a report` });
    }
    for (const t of tests.filter((t) => t.measured_on >= weekAgo)) events.push({ d: t.measured_on, text: `${esc(methodLabel(t.method))} ${fmt1(t.v)}${t === latest && within != null ? `, ${within >= 0 ? "up" : "down"} ${fmt1(Math.abs(within))} within the method` : ""}` });
    if (streak >= 2 && complete.length) events.push({ d: addDays(complete[complete.length - 1].week_start, 6), text: `${ordinal(streak)} week at goal in a row` });
    if (quietDays != null && quietDays >= 14) events.push({ d: today, text: `${quietDays} days without a workout` });
    events.sort((a, b) => b.d.localeCompare(a.d));
    $("dp-changed").innerHTML = kicker("WHAT CHANGED THIS WEEK") + (events.length
      ? events.slice(0, 4).map((e) => `<span><span class="text-text-muted">${esc(new Date(e.d + "T00:00:00").toLocaleDateString(undefined, { weekday: "short", day: "numeric" }))}</span> ${e.text}</span>`).join("")
      : `<span class="text-text-tertiary">Nothing new this week.</span>`);
  }

  // ── people at a glance: every person you can see, one line each ────────
  // The same table serves a family and a coach. Activity and fitness come
  // from web_weeks and web_crf (an app export, or later the app's sync);
  // labs from web_labs; unchecked from the app's rows a labs scope lets
  // you read. Anything a scope does not cover shows as a dash.
  const mondayOf = (d: Date) => { const x = new Date(d); const day = x.getDay() === 0 ? 7 : x.getDay(); x.setDate(x.getDate() - day + 1); return x.toLocaleDateString("en-CA"); };
  const daysBetween = (a: string, b: string) => Math.round((new Date(b + "T00:00:00").getTime() - new Date(a + "T00:00:00").getTime()) / 86400000);

  async function loadGlance() {
    const others = people.filter((p) => p.id && !p.self);
    const on = isSelf() && others.length > 0;
    show("glance", on);
    if (!on) return;
    const managed = others.filter((p) => p.mine).length, shared = others.length - managed;
    const coach = shared > 0 && managed === 0;
    $("glancetitle").textContent = coach ? "Clients" : "People";
    $("glancesub").textContent = coach
      ? `${shared} ${shared === 1 ? "person shares" : "people share"} with you. You see what each chose, and nothing else. Tap a row to open them.`
      : [managed ? `${managed} you look after` : "", shared ? `${shared} sharing with you` : ""].filter(Boolean).join(", ") + ". Tap a row to open them.";
    $("glanceaddr").textContent = userEmail;

    const ids = people.filter((p) => p.id).map((p) => p.id);
    const accounts = people.filter((p) => p.account_id).map((p) => p.account_id!);
    const thisMonday = mondayOf(new Date()), today = new Date().toLocaleDateString("en-CA");
    const since = new Date(new Date(thisMonday + "T00:00:00").getTime() - 12 * 7 * 86400000).toISOString();
    const [labs, app, weeks, crf, acts, tests] = await Promise.all([
      supabase.from("web_labs").select("person_id, analyte, value, ref_low, ref_high, ref_text, measured_on")
        .in("person_id", ids).order("measured_on", { ascending: false }).limit(6000),
      supabase.from("lab_readings").select("user_id").in("user_id", accounts).eq("review_status", "unchecked").is("deleted_at", null).limit(1000),
      supabase.from("web_weeks").select("person_id, week_start, met_hours, workouts").in("person_id", ids).order("week_start", { ascending: false }).limit(ids.length * 12),
      supabase.from("web_crf").select("person_id, measured_on, vo2max").in("person_id", ids).order("measured_on", { ascending: false }).limit(ids.length * 6),
      // the app's own rows, for everyone with an account: the last twelve weeks of workouts, and every fitness test
      supabase.from("activities").select("user_id, timestamp, duration_minutes, met_hours, intensity_category")
        .in("user_id", accounts).is("deleted_at", null).gte("timestamp", since).order("timestamp", { ascending: false }).limit(accounts.length * 400),
      supabase.from("crf_entries").select("user_id, timestamp, met_capacity, vo2_max_estimate")
        .in("user_id", accounts).is("deleted_at", null).order("timestamp", { ascending: false }).limit(accounts.length * 40),
    ]);
    if (!isSelf()) return;   // switched away meanwhile
    type Line = { p: Person; sees: string; week: string; weekTone: string; fit: string; labs: string; labsTone: string; unchecked: number; quietDays: number | null; worst: { name: string; value: number; ratio: number } | null };
    const lines: Line[] = people.filter((p) => p.id).map((p) => {
      const L = (labs.data ?? []).filter((r: any) => r.person_id === p.id);
      const latestDay = L[0]?.measured_on ?? "";
      const latest = L.filter((r: any) => r.measured_on === latestDay);
      const out = latest.filter((r: any) => inRange(r) === false);
      // how far the worst value sits outside its range, as a share of the range's edge
      let worst: Line["worst"] = null;
      for (const r of out) {
        const v = Number(r.value), hi = Number(r.ref_high), lo = Number(r.ref_low);
        const ratio = Number.isFinite(hi) && v > hi ? (v - hi) / hi : Number.isFinite(lo) && v < lo && lo > 0 ? (lo - v) / lo : 0;
        if (!worst || ratio > worst.ratio) worst = { name: String(r.analyte), value: v, ratio };
      }
      // sync where there is an account, the export tables where there is not
      const mine = p.account_id ? (acts.data ?? []).filter((a: any) => a.user_id === p.account_id) : [];
      const W = mine.length ? weeksFrom(mine).reverse() : (weeks.data ?? []).filter((r: any) => r.person_id === p.id);
      const cur = W.find((r: any) => r.week_start === thisMonday);
      const lastActive = mine.length ? localDay(mine[0].timestamp) : (W.find((r: any) => Number(r.workouts) > 0)?.week_start ?? "");
      const quietDays = mine.length ? daysBetween(lastActive, today) : W.length ? daysBetween(lastActive || W[W.length - 1].week_start, today) : null;
      const myTests = p.account_id ? crfFromSync((tests.data ?? []).filter((t: any) => t.user_id === p.account_id)) : [];   // newest first, as the export table's are
      const C = myTests.length ? myTests.filter((r: any) => r.vo2max != null) : (crf.data ?? []).filter((r: any) => r.person_id === p.id && r.vo2max != null);
      const trend = C.length > 1 ? Number(C[0].vo2max) - Number(C[1].vo2max) : 0;
      const unchecked = p.account_id ? (app.data ?? []).filter((r: any) => r.user_id === p.account_id).length : 0;
      return {
        p,
        sees: p.self ? "you" : p.mine ? "you look after" : scopeList(p.scopes).toLowerCase() || "nothing yet",
        week: cur ? `${Number(cur.met_hours).toFixed(1)} MET-h` : W.length ? `0 MET-h` : "—",
        weekTone: cur ? "text-met-hero" : W.length ? "text-danger" : "text-text-muted",
        fit: C.length ? `VO₂max ${Math.round(Number(C[0].vo2max))}${C.length > 1 ? (trend >= 1 ? " · rising" : trend <= -1 ? " · falling" : " · flat") : ""}` : "—",
        labs: latestDay ? `${fmtDay(latestDay)}${out.length ? ` · ${out.length} outside range` : " · all in range"}` : "—",
        labsTone: out.length ? "text-warning" : "text-text-secondary",
        unchecked, quietDays, worst,
      };
    });
    $("glancerows").innerHTML = lines.map((l) => `
      <tr data-open="${l.p.id}" class="cursor-pointer transition-colors hover:bg-white/[0.03]">
        <td class="px-3 py-2.5 font-semibold text-text-primary">${l.p.self ? "You" : esc(l.p.name || "Unnamed")}</td>
        <td class="px-3 py-2.5 text-text-tertiary">${esc(l.sees)}</td>
        <td class="px-3 py-2.5 font-semibold ${l.weekTone}">${esc(l.week)}</td>
        <td class="px-3 py-2.5 text-text-secondary">${esc(l.fit)}</td>
        <td class="px-3 py-2.5 ${l.labsTone}">${esc(l.labs)}</td>
        <td class="px-3 py-2.5 ${l.unchecked ? "text-text-secondary" : "text-text-muted"}">${l.unchecked || "—"}</td>
      </tr>`).join("");
    $("glancerows").querySelectorAll("[data-open]").forEach((tr) =>
      tr.addEventListener("click", () => switchPerson((tr as HTMLElement).dataset.open!)));

    // worth a look, across everyone: the furthest value outside its range,
    // the longest quiet spell, and values waiting to be checked
    const cards: string[] = [];
    const worstLine = lines.filter((l) => l.worst).sort((a, b) => b.worst!.ratio - a.worst!.ratio)[0];
    if (worstLine) cards.push(`<div class="rounded-2xl border border-warning/40 bg-warning/[0.06] p-4"><div class="font-mono text-[10px] tracking-wider text-warning">OUTSIDE RANGE</div><div class="mt-1 text-[14px] font-bold text-text-primary">${esc(worstLine.p.self ? "Your" : worstLine.p.name + "'s")} ${esc(worstLine.worst!.name)} is ${worstLine.worst!.value}</div><div class="mt-0.5 text-[12.5px] text-text-secondary">${Math.round(worstLine.worst!.ratio * 100)}% past the lab's own range, in the latest report.</div></div>`);
    const quiet = lines.filter((l) => l.quietDays != null && l.quietDays >= 14 && !l.p.self).sort((a, b) => b.quietDays! - a.quietDays!)[0];
    if (quiet) cards.push(`<div class="rounded-2xl border border-danger/40 bg-danger/[0.06] p-4"><div class="font-mono text-[10px] tracking-wider text-danger">QUIET</div><div class="mt-1 text-[14px] font-bold text-text-primary">${esc(quiet.p.name)} has logged nothing for ${quiet.quietDays} days</div><div class="mt-0.5 text-[12.5px] text-text-secondary">A message from you, not from Verve.</div></div>`);
    const un = lines.filter((l) => l.unchecked > 0 && !l.p.self).sort((a, b) => b.unchecked - a.unchecked)[0];
    if (un) cards.push(`<div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4"><div class="font-mono text-[10px] tracking-wider text-text-tertiary">UNCHECKED</div><div class="mt-1 text-[14px] font-bold text-text-primary">${esc(un.p.name)} has ${un.unchecked} value${un.unchecked === 1 ? "" : "s"} to confirm</div><div class="mt-0.5 text-[12.5px] text-text-secondary">Read from a report, not yet confirmed in the app. Grey until then.</div></div>`);
    $("glancecards").innerHTML = cards.join("");
    show("glancecards", cards.length > 0); $("glancecards").classList.toggle("grid", cards.length > 0);
  }

  // one fetch feeds Overview, Labs and the Reports cards
  let allLabs: any[] = [];
  let allImaging: any[] = [];   // imaging_reports — the narrative half of a study
  let allApp: any[] = [];       // lab_readings — what the app holds, to say what was sent
  let labSecs: Map<string, Map<string, any[]>> = new Map();
  let labSection = "";
  let expandedAnalyte = "";          // one chart open at a time
  let mobileSectionOpen = false;     // phone: section list ⇄ section page

  // ── tabs ───────────────────────────────────────────────────────────────
  let activeTab = "overview";
  function setTab(t: string) {
    const switching = activeTab !== t;
    activeTab = t;
    ["overview", "labs", "reports", "depth"].forEach((x) => show("tab-" + x, x === t));
    if (switching) {
      const el = $("tab-" + t);
      el.classList.remove("mh-fade");
      void el.offsetWidth;   // restart the animation
      el.classList.add("mh-fade");
    }
    $("tabbar").querySelectorAll("[data-tab]").forEach((b) => {
      const on = (b as HTMLElement).dataset.tab === t;
      b.className = `flex-1 rounded-xl px-4 py-2 text-sm font-semibold sm:flex-none transition-colors ${
        on ? "bg-accent/20 text-text-primary" : "text-text-tertiary hover:text-text-primary"}`;
    });
    history.replaceState(null, "", "#" + t);
  }
  $("tabbar").querySelectorAll("[data-tab]").forEach((b) =>
    b.addEventListener("click", () => setTab((b as HTMLElement).dataset.tab!)));

  // ── session ────────────────────────────────────────────────────────────
  const appLink = document.querySelector('[data-nav="app"]') as HTMLElement | null;

  async function boot() {
    // an invitation's button: the link carries a token the site verifies
    // here, so it signs in the device it is opened on, from any device
    const url = new URL(location.href);
    const tokenHash = url.searchParams.get("token_hash"), linkType = url.searchParams.get("type");
    if (tokenHash && (linkType === "invite" || linkType === "magiclink" || linkType === "email")) {
      try { await supabase.auth.verifyOtp({ token_hash: tokenHash, type: linkType as any }); }
      catch { /* an old or used link: the sign-in card below still works */ }
      history.replaceState(null, "", location.pathname + location.hash);
    }
    const { data: { session } } = await supabase.auth.getSession();
    show("loading", false);
    if (session?.user) {
      userId = session.user.id;
      userEmail = session.user.email ?? "";
      firstName = await resolveFirstName(session.user);
      $("greet").textContent = greeting();
      $("greet").closest(".flex.flex-wrap")!.classList.add("mh-rise");
      show("namechange", !!firstName);
      if (!firstName) askForName(guessNameFromEmail(userEmail));
      else hideNameForm();
      appLink?.classList.add("hidden");
      show("signout", true); show("home", true); show("auth", false);
      const wanted = window.location.hash.replace("#", "");
      setTab(["overview", "labs", "reports", "depth"].includes(wanted) ? wanted : "overview");
      await loadPeople();
      applyPersonMode();
      await Promise.all([refresh(), loadPersonNote(), loadSharing(), loadInvites(), loadAsked(), loadRequests(), loadGlance()]);
    } else {
      firstName = "";
      people = []; person = null;
      show("peoplewrap", false);
      appLink?.classList.remove("hidden");
      show("auth", true); show("home", false); show("signout", false);
    }
  }

  /**
   * The name the app greets you with, in the same order the app resolves
   * it: the profile name set in Settings, then the full name Apple gave,
   * then nothing. Never the email — "roplekarsudeep" is not a name.
   */
  async function resolveFirstName(user: { id: string; user_metadata?: Record<string, unknown> }): Promise<string> {
    let full = "";
    try {
      const { data } = await supabase.from("profiles").select("name").eq("user_id", user.id).maybeSingle();
      full = String(data?.name ?? "").trim();
    } catch { /* no profile row, or none we may read: fall through */ }
    if (!full) full = String(user.user_metadata?.full_name ?? "").trim();
    fullName = full;
    return full.split(/\s+/)[0] ?? "";
  }

  /**
   * A first name from an email, only when the address is plainly a name:
   * "sadiya.naik@" gives Sadiya, "roplekarsudeep@" gives nothing, because a
   * wrong guess in a greeting is worse than a question. The guess is only
   * ever a prefilled field the person confirms with a tap.
   */
  function guessNameFromEmail(email: string): string {
    const local = email.split("@")[0] ?? "";
    const parts = local.split(/[._-]/).filter(Boolean);
    if (parts.length < 2) return "";
    const first = parts[0];
    if (!/^[a-z]{2,20}$/i.test(first)) return "";
    return first[0].toUpperCase() + first.slice(1).toLowerCase();
  }

  /** "Good evening, Sudeep", or just "Good evening" when no name is known. */
  function greeting(): string {
    if (person && !person.self) return person.name || "Unnamed";
    const hour = new Date().getHours();
    const tod = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    return firstName ? `${tod}, ${firstName}` : tod;
  }

  // ── the reader at work, shown on every tab ─────────────────────────────
  // A read is a fetch: it carries on whichever tab is open, and even if the
  // page is scrolled away. What the person needs is to see that it is
  // happening and roughly how far along it is. Leaving the page is the one
  // thing that loses it, so the browser asks first while a read is on.
  let busyCount = 0;
  let busyTimer: number | undefined;
  const busyBar = () => $("busybar") as HTMLElement;
  function busyStart(text: string, sub = "Verve is reading every value and its printed range — usually 20 to 40 seconds. You can move around the site meanwhile.") {
    busyCount++;
    $("busytext").textContent = text;
    $("busysub").textContent = sub;
    show("busy", true); $("busy").classList.add("flex");
    $("busyicon").firstElementChild!.classList.add("mh-spin");
    if (busyTimer) { clearTimeout(busyTimer); busyTimer = undefined; }
    busyBar().classList.remove("mh-creep");
    busyBar().style.width = "0%";
    void busyBar().offsetWidth;
    busyBar().classList.add("mh-creep");
    busyBar().style.width = "90%";
  }
  function busyEnd(text: string, sub: string, ok: boolean) {
    busyCount = Math.max(0, busyCount - 1);
    if (busyCount > 0) return;
    busyBar().classList.remove("mh-creep");
    busyBar().style.width = "100%";
    $("busyicon").firstElementChild!.classList.remove("mh-spin");
    $("busytext").textContent = text;
    $("busysub").textContent = sub;
    busyBar().classList.toggle("bg-danger", !ok);
    busyBar().classList.toggle("bg-accent", ok);
    busyTimer = window.setTimeout(() => { show("busy", false); $("busy").classList.remove("flex"); }, ok ? 6000 : 12000);
  }
  $("busy").addEventListener("click", () => setTab("reports"));
  window.addEventListener("beforeunload", (e) => {
    if (busyCount > 0) { e.preventDefault(); e.returnValue = ""; }
  });

  /** The one way to add a report: the Reports tab, and its picker. */
  function pickReport() {
    setTab("reports");
    $("file").click();
  }
  $("addreport").addEventListener("click", pickReport);
  $("tosendgo").addEventListener("click", () => {
    const paths = pendingReports();
    if (!paths.length) return;
    setTab("reports");
    reviewPos = { n: 1, of: paths.length };
    reviewQueue = paths.slice(1).map((p) => () => reviewFromArchive(p));
    reviewFromArchive(paths[0]);
  });

  // ── a name for an account that has none: the greeting asks, once. The
  // answer is saved with the account (where the app's setup reads it) and
  // into the app's own profile when that has no name, so the app greets by
  // it too after its next sync. ──────────────────────────────────────────
  const LATER_KEY = "mh-name-later";
  function askForName(prefill: string) {
    let later = false;
    try { later = sessionStorage.getItem(LATER_KEY) === "1"; } catch { /* no storage: ask */ }
    if (later) return;
    ($("namein") as HTMLInputElement).value = prefill;
    $("nameform").classList.remove("hidden"); $("nameform").classList.add("flex");
  }
  function hideNameForm() { $("nameform").classList.add("hidden"); $("nameform").classList.remove("flex"); }
  $("namelater").addEventListener("click", () => {
    try { sessionStorage.setItem(LATER_KEY, "1"); } catch { /* fine */ }
    hideNameForm();
  });
  $("namechange").addEventListener("click", () => {
    ($("namein") as HTMLInputElement).value = fullName;
    $("nameform").classList.remove("hidden"); $("nameform").classList.add("flex");
    $("namein").focus();
  });
  $("nameform").addEventListener("submit", async (e) => {
    e.preventDefault();
    const name = ($("namein") as HTMLInputElement).value.trim().replace(/\s+/g, " ");
    if (!name) return;
    const { error } = await supabase.auth.updateUser({ data: { full_name: name } });
    if (error) { msg("upmsg", `Could not save your name: ${error.message}`, true); return; }
    // the app's profile, only where it has no name of its own
    try {
      await supabase.from("profiles").update({ name, updated_at: new Date().toISOString() })
        .eq("user_id", userId).or("name.is.null,name.eq.");
      if (person?.self && person.id) await supabase.from("people").update({ name }).eq("id", person.id);
    } catch { /* no profile row yet: the app's setup will read full_name */ }
    fullName = name;
    firstName = name.split(/\s+/)[0] ?? "";
    $("greet").textContent = greeting();
    show("namechange", true);
    hideNameForm();
  });
  $("emptyadd").addEventListener("click", pickReport);

  /** Refetch web_labs + imaging_reports once; every surface renders from them. */
  async function refresh() {
    const [{ data: rows }, { data: imaging }, { data: app }] = await Promise.all([
      scopeRows(supabase.from("web_labs")
        .select("analyte, value, unit, ref_low, ref_high, ref_text, section, measured_on, report_path"))
        .order("measured_on", { ascending: true }).limit(4000),
      scopeRows(supabase.from("imaging_reports")
        .select("modality, report_date, report_path, impression, findings"))
        .order("report_date", { ascending: true }).limit(200),
      // the app's rows exist only for a person with an account of their own
      person?.account_id
        ? supabase.from("lab_readings").select("*").eq("user_id", person.account_id).is("deleted_at", null).limit(2000)
        : Promise.resolve({ data: [] as any[] }),
    ]);
    allLabs = rows ?? [];
    allImaging = imaging ?? [];
    allApp = app ?? [];
    groupLabs();
    renderOverview();
    renderLabsRail(); renderLabsPanel();
    await renderReports();
    await loadActivity();
  }

  // ═══ THE APP'S SHARE OF A REPORT ═════════════════════════════════════════
  // Every value of a report is filed here. The app's markers reach the app
  // only when they are sent, and until now nothing remembered which reports
  // had been sent. This reads it from the two tables: a report's app-bound
  // values are the archived rows whose canonical name is one of the app's
  // markers, in the app's unit; one is "sent" when a lab_readings row on the
  // same day carries that value.

  /** Canonical analyte name (letters and digits only) → the app's column. */
  const APP_KEY_BY_NAME: Record<string, string> = {
    fastingglucose: "glucose_mgdl", glucosefasting: "glucose_mgdl", fastingbloodsugar: "glucose_mgdl", fbs: "glucose_mgdl", glucosef: "glucose_mgdl",
    hba1c: "hba1c_pct", hemoglobina1c: "hba1c_pct", glycatedhemoglobin: "hba1c_pct", glycosylatedhemoglobin: "hba1c_pct",
    postmealglucose: "post_meal_glucose_mgdl", postprandialglucose: "post_meal_glucose_mgdl", ppglucose: "post_meal_glucose_mgdl", glucosepp: "post_meal_glucose_mgdl", glucosepostprandial: "post_meal_glucose_mgdl",
    fastinginsulin: "fasting_insulin_uiuml", insulinfasting: "fasting_insulin_uiuml", insulin: "fasting_insulin_uiuml",
    triglycerides: "triglycerides_mgdl", hdl: "hdl_mgdl", hdlcholesterol: "hdl_mgdl",
    waist: "waist_cm", waistcircumference: "waist_cm",
    systolicbp: "sbp", systolicbloodpressure: "sbp", diastolicbp: "dbp", diastolicbloodpressure: "dbp",
    apob: "apo_b_mgdl", apolipoproteinb: "apo_b_mgdl", ldl: "ldl_mgdl", ldlcholesterol: "ldl_mgdl",
    lpa: "lpa_value", lipoproteina: "lpa_value",
    hscrp: "hs_crp_mgl", highsensitivitycrp: "hs_crp_mgl", crphs: "hs_crp_mgl", hscreactiveprotein: "hs_crp_mgl",
    bodyfat: "body_fat_pct", bodyfatpercentage: "body_fat_pct", skeletalmuscle: "skel_musc_pct", skeletalmusclepercentage: "skel_musc_pct",
    musclemass: "skel_musc_pct", musclemasspercentage: "skel_musc_pct",
    leanmassarmsandlegs: "alm_kg", appendicularleanmass: "alm_kg", alm: "alm_kg",
    wholebodyleanmass: "ffm_kg", fatfreemass: "ffm_kg", leanmass: "ffm_kg", leanbodymass: "ffm_kg",
    gripstrength: "handgrip_kg", handgrip: "handgrip_kg", handgripstrength: "handgrip_kg",
    singlelegbalance: "single_leg_balance_seconds", singlelegstand: "single_leg_balance_seconds", onelegstand: "single_leg_balance_seconds",
    chairstand: "chair_stand_seconds", chairstand5: "chair_stand_seconds", sittostand: "chair_stand_seconds", fivetimessittostand: "chair_stand_seconds",
    walkspeed: "gait_speed_ms", gaitspeed: "gait_speed_ms", usualgaitspeed: "gait_speed_ms",
  };
  const squash = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "");
  function appKeyFor(analyte: string): string | null {
    return APP_KEY_BY_NAME[squash(canonName(String(analyte)))] ?? null;
  }
  /** The app stores one unit per marker; a value in another unit is not sent from the archive. */
  function unitFits(key: string, unit: string | null): boolean {
    if (key === "lpa_value") return true;
    const want = LABELS[key].unit;
    if (!want) return true;
    return unitKey(unit ?? "") === unitKey(want);
  }
  const localDay = (iso: string) => new Date(iso).toLocaleDateString("en-CA");

  type AppBound = { key: string; value: number; unit: string | null; name: string };
  /** A report's app-bound values, one per marker, from its archived rows. */
  function appBoundFor(path: string): { date: string; values: AppBound[] } {
    if (!isSelf()) return { date: "", values: [] };   // the app tier is yours alone
    if (path.startsWith("export:")) return { date: "", values: [] };   // came from the app: nothing to send back
    const rows = allLabs.filter((r) => r.report_path === path);
    const values: AppBound[] = [];
    for (const r of rows) {
      const key = appKeyFor(r.analyte);
      if (!key || values.some((v) => v.key === key) || !unitFits(key, r.unit) || !Number.isFinite(Number(r.value))) continue;
      values.push({ key, value: Number(r.value), unit: r.unit ?? null, name: String(r.analyte) });
    }
    return { date: rows[0]?.measured_on ?? "", values };
  }
  function isSent(date: string, key: string, value: number): boolean {
    return allApp.some((a) => localDay(a.measured_at) === date && Number(a[key]) === value);
  }
  /** The app's columns a row carries, for counting what a report sent. */
  const APP_KEYS = Object.keys(LABELS);
  /** What a report's card says: how many of its app values the app holds, and how many await a look there. */
  function reportAppState(path: string) {
    const { date, values } = appBoundFor(path);
    const pending = values.filter((v) => !isSent(date, v.key, v.value));
    const unchecked = allApp
      .filter((a) => a.report_path === path && a.review_status === "unchecked")
      .reduce((n, a) => n + APP_KEYS.filter((k) => a[k] != null).length, 0);
    return { date, total: values.length, sent: values.length - pending.length, pending, unchecked };
  }
  /** Values the app holds from reports that nobody has looked at yet, across the archive. */
  function uncheckedInApp(): number {
    if (!isSelf()) return 0;
    return allApp
      .filter((a) => a.review_status === "unchecked")
      .reduce((n, a) => n + APP_KEYS.filter((k) => a[k] != null).length, 0);
  }
  /** Reports with app values the app does not have yet, newest first. */
  function pendingReports(): string[] {
    const paths = [...new Set(allLabs.map((r) => r.report_path).filter(Boolean))] as string[];
    return paths
      .filter((p) => reportAppState(p).pending.length > 0)
      .sort((a, b) => (appBoundFor(b).date || "").localeCompare(appBoundFor(a).date || ""));
  }

  // ── two modes, one card: the same account works here and in the app ────
  let authMode: "signin" | "signup" = "signin";
  function setAuthMode(m: "signin" | "signup") {
    authMode = m;
    document.querySelectorAll("[data-mode]").forEach((b) => {
      const on = (b as HTMLElement).dataset.mode === m;
      b.className = `rounded-full px-4 py-1.5 text-[13px] ${on ? "bg-accent/20 font-bold text-text-primary" : "font-semibold text-text-tertiary hover:text-text-primary"}`;
    });
    // Sign-in needs no note: the left column says whose login it is, and
    // the Apple line sits under the email link it is about.
    const note = m === "signin"
      ? ""
      : "No app needed to start — this account works here today and signs into the Verve app whenever you get it.";
    $("modenote").textContent = note;
    show("modenote", !!note);
    $("authsubmit").textContent = m === "signin" ? "Sign in" : "Create my account";
    ($("password") as HTMLInputElement).placeholder = m === "signin" ? "Password" : "Choose a password (8+ characters)";
    ($("password") as HTMLInputElement).autocomplete = m === "signin" ? "current-password" : "new-password";
    show("forgot", m === "signin");
    show("magic", m === "signin");
    show("ordiv", m === "signin");
    show("applenote", m === "signin");
    $("newsletterrow").classList.toggle("hidden", m !== "signup");
    $("newsletterrow").classList.toggle("flex", m === "signup");
    show("namerow", m === "signup");
    msg("authmsg", "");
  }
  document.querySelectorAll("[data-mode]").forEach((b) =>
    b.addEventListener("click", () => setAuthMode((b as HTMLElement).dataset.mode as any)));
  setAuthMode("signin");

  $("pwform").addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = ($("email") as HTMLInputElement).value.trim();
    const password = ($("password") as HTMLInputElement).value;
    if (authMode === "signup") {
      if (password.length < 8) { msg("authmsg", "Choose a password of at least 8 characters.", true); return; }
      const fullName = ($("fullname") as HTMLInputElement).value.trim();
      if (!fullName) { msg("authmsg", "Your name, so the app and this page can greet you.", true); return; }
      msg("authmsg", "Creating your account…");
      const optIn = ($("newsletter") as HTMLInputElement).checked;
      const { data, error } = await supabase.auth.signUp({
        email, password,
        options: {
          emailRedirectTo: window.location.origin + "/my-health/",
          // consent travels with the account: user_metadata, exportable later
          data: { full_name: fullName, newsletter_opt_in: optIn, newsletter_opt_in_at: optIn ? new Date().toISOString() : null },
        },
      });
      if (error) { msg("authmsg", error.message, true); return; }
      // Supabase answers an existing address with a userless success — say so
      // honestly instead of promising an email that will never come.
      if (data.user && (data.user.identities?.length ?? 1) === 0) {
        msg("authmsg", "That address already has a Verve account — switch to Sign in.", true);
        return;
      }
      if (data.session) { msg("authmsg", ""); boot(); return; }
      // No session: the project requires the email to be confirmed first. The
      // confirmation email carries a code and a link; the code is entered here.
      enterCodeStep(email, "signup");
      return;
    }
    msg("authmsg", "Signing in…");
    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) msg("authmsg", error.message, true);
    else { msg("authmsg", ""); boot(); }
  });

  // ── the code: one email carries the code and the link. The code
  // signs in whichever device it is typed on; the link, the one it is
  // opened on. Both come from the same Supabase call. ────────────────────
  let otpEmail = "";
  /** What the code proves: a sign-in, a new account's email, or a password reset. */
  let codeMode: "signin" | "signup" | "recovery" = "signin";
  /** True from a recovery code being checked until the new password is saved. */
  let recovering = false;
  let resendTimer: number | undefined;

  async function sendCode(email: string): Promise<boolean> {
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: { shouldCreateUser: false, emailRedirectTo: window.location.origin + "/my-health/" },
    });
    if (error) { msg("authmsg", error.message, true); return false; }
    return true;
  }

  /** The card flips: the email is out, the code is what is left. */
  function enterCodeStep(email: string, mode: "signin" | "signup" | "recovery" = "signin") {
    otpEmail = email;
    codeMode = mode;
    $("codehead").textContent =
      mode === "signup" ? "Confirm your email" : mode === "recovery" ? "Reset your password" : "Enter the code from the email";
    const to = `<strong class="font-semibold text-text-primary">${esc(email)}</strong>`;
    $("codelead").innerHTML =
      mode === "signup" ? `We sent a code to ${to}. Enter it here to finish creating your account. It expires in one hour.`
      : mode === "recovery" ? `We sent a code to ${to}. Enter it here, then choose a new password. It expires in one hour.`
      : `Sent to ${to}. It works on any device: read it on your phone, type it here. It expires in one hour.`;
    $("usepw").textContent = mode === "signin" ? "Use a password instead" : "Back";
    ["modenote", "pwform", "ordiv", "magic", "applenote"].forEach((id) => show(id, false));
    document.querySelectorAll("[data-mode]").forEach((b) => (b as HTMLElement).parentElement!.classList.add("hidden"));
    show("codestep", true);
    ($("code") as HTMLInputElement).value = "";
    msg("authmsg", "");
    $("code").focus();
    startResendCountdown();
  }

  function leaveCodeStep() {
    if (resendTimer) { clearInterval(resendTimer); resendTimer = undefined; }
    otpEmail = "";
    codeMode = "signin";
    show("codestep", false);
    document.querySelectorAll("[data-mode]").forEach((b) => (b as HTMLElement).parentElement!.classList.remove("hidden"));
    show("pwform", true);
    setAuthMode(authMode);
  }

  /** Sixty seconds: Supabase refuses a second email to the same address sooner. */
  function startResendCountdown() {
    if (resendTimer) clearInterval(resendTimer);
    let left = 60;
    const btn = $("resend") as HTMLButtonElement;
    const tick = () => {
      if (left > 0) { btn.disabled = true; btn.textContent = `Resend in ${Math.floor(left / 60)}:${String(left % 60).padStart(2, "0")}`; left--; }
      else { btn.disabled = false; btn.textContent = "Resend the code"; clearInterval(resendTimer); resendTimer = undefined; }
    };
    tick();
    resendTimer = window.setInterval(tick, 1000);
  }

  $("magic").addEventListener("click", async () => {
    const email = ($("email") as HTMLInputElement).value.trim();
    if (!email) { msg("authmsg", "Type your email above first.", true); return; }
    msg("authmsg", "Sending…");
    if (await sendCode(email)) enterCodeStep(email);
  });

  $("resend").addEventListener("click", async () => {
    msg("authmsg", "Sending again…");
    const redirect = { emailRedirectTo: window.location.origin + "/my-health/" };
    const ok = codeMode === "signup"
      ? !(await supabase.auth.resend({ type: "signup", email: otpEmail, options: redirect })).error
      : codeMode === "recovery"
        ? !(await supabase.auth.resetPasswordForEmail(otpEmail, { redirectTo: redirect.emailRedirectTo })).error
        : await sendCode(otpEmail);
    if (ok) { msg("authmsg", "A new code is on its way."); startResendCountdown(); }
    else if (codeMode !== "signin") msg("authmsg", "Could not send another code just now. Try again in a minute.", true);
  });

  $("usepw").addEventListener("click", () => leaveCodeStep());

  $("code").addEventListener("input", () => {
    const el = $("code") as HTMLInputElement;
    el.value = el.value.replace(/\D/g, "").slice(0, 10);
  });

  $("codeform").addEventListener("submit", async (e) => {
    e.preventDefault();
    // Supabase sets the length in the project's settings (six to ten digits).
    const token = ($("code") as HTMLInputElement).value.replace(/\D/g, "");
    if (token.length < 6) { msg("authmsg", "Type the whole code from the email.", true); return; }
    const btn = $("verify") as HTMLButtonElement;
    btn.disabled = true;
    msg("authmsg", "Checking…");
    // "signup" proves a new account's address, "recovery" a password reset,
    // "email" is a sign-in code.
    const type = codeMode === "signup" ? "signup" : codeMode === "recovery" ? "recovery" : "email";
    // A recovery code signs in as it is checked; the flag keeps the reset
    // card in front of the dashboard until the new password is saved.
    recovering = codeMode === "recovery";
    const { error } = await supabase.auth.verifyOtp({ email: otpEmail, token, type });
    btn.disabled = false;
    // Supabase answers a wrong code and a stale one with the same message.
    if (error) { recovering = false; msg("authmsg", "That code did not match, or has expired. Check it, or send a new one.", true); return; }
    msg("authmsg", "");
    const wasRecovery = codeMode === "recovery";
    leaveCodeStep();
    if (wasRecovery) { showReset(); return; }
    boot();
  });

  /** The reset card, alone on the page. */
  function showReset() {
    show("loading", false); show("auth", false); show("home", false);
    show("pwreset", true);
    ($("newpw") as HTMLInputElement).value = "";
    ($("newpw2") as HTMLInputElement).value = "";
    msg("pwmsg", "");
    $("newpw").focus();
  }

  $("signout").addEventListener("click", async () => {
    await supabase.auth.signOut();
    boot();
  });

  // ── show/hide password — the eye at the end of the bar ────────────────
  document.querySelectorAll("[data-eye]").forEach((b) =>
    b.addEventListener("click", () => {
      const input = $((b as HTMLElement).dataset.eye!) as HTMLInputElement;
      const showing = input.type === "text";
      input.type = showing ? "password" : "text";
      b.setAttribute("aria-label", showing ? "Show password" : "Hide password");
      (b as HTMLElement).classList.toggle("text-accent-light", !showing);
    }));

  // ── forgot password → a code by email → the code opens the reset card.
  // The email's link is kept for the device it is opened on; the code is
  // what works from any device, and what a mail scanner cannot use up. ──
  $("forgot").addEventListener("click", async () => {
    const email = ($("email") as HTMLInputElement).value.trim();
    if (!email) { msg("authmsg", "Type your email above first.", true); return; }
    msg("authmsg", "Sending…");
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: window.location.origin + "/my-health/",
    });
    if (error) { msg("authmsg", error.message, true); return; }
    enterCodeStep(email, "recovery");
  });

  $("pwform2").addEventListener("submit", async (e) => {
    e.preventDefault();
    const pw = ($("newpw") as HTMLInputElement).value;
    const pw2 = ($("newpw2") as HTMLInputElement).value;
    if (pw.length < 8) { msg("pwmsg", "Eight characters or more.", true); return; }
    if (pw !== pw2) { msg("pwmsg", "The two passwords do not match.", true); return; }
    const btn = $("savepw") as HTMLButtonElement;
    btn.disabled = true;
    msg("pwmsg", "Saving…");
    const { error } = await supabase.auth.updateUser({ password: pw });
    btn.disabled = false;
    if (error) { msg("pwmsg", error.message, true); return; }
    recovering = false;
    msg("pwmsg", "Saved. This password now works in the app and here.");
    setTimeout(() => { show("pwreset", false); boot(); }, 1400);
  });

  // ── range helpers — every value against ITS OWN printed range ─────────
  function inRange(v: { value: number; ref_low?: number | null; ref_high?: number | null }): boolean | null {
    const lo = v.ref_low, hi = v.ref_high;
    if (lo == null && hi == null) return null;
    if (lo != null && v.value < lo) return false;
    if (hi != null && v.value > hi) return false;
    return true;
  }
  function rangeLabel(v: { ref_low?: number | null; ref_high?: number | null; ref_text?: string | null }): string {
    if (v.ref_text) return v.ref_text;
    if (v.ref_low != null && v.ref_high != null) return `${v.ref_low}–${v.ref_high}`;
    if (v.ref_high != null) return `<${v.ref_high}`;
    if (v.ref_low != null) return `>${v.ref_low}`;
    return "";
  }

  // ── grouping: section → canonical analyte → readings by date ──────────
  function groupLabs() {
    labSecs = new Map();
    for (const r of allLabs) {
      const s = SECTIONS[r.section] ? r.section : "other";
      const sec = labSecs.get(s) ?? labSecs.set(s, new Map()).get(s)!;
      const key = canonName(String(r.analyte));
      (sec.get(key) ?? sec.set(key, []).get(key)!).push(r);
    }
    if (!labSecs.has(labSection)) labSection = SECTION_ORDER.find((s) => labSecs.has(s)) ?? "";
  }

  // ═══ OVERVIEW ═══════════════════════════════════════════════════════════
  /** A section's ring: latest readings in range, out of those with a printed range. */
  function ringSvg(ok: number, judged: number, i = 0): string {
    const C = 2 * Math.PI * 22;
    const frac = judged ? ok / judged : 0;
    const len = (frac * C).toFixed(1);
    const color = judged === 0 ? "#64748b" : ok === judged ? "#34d399" : "#FBBF24";
    return `
      <svg width="52" height="52" viewBox="0 0 56 56" aria-hidden="true">
        <circle cx="28" cy="28" r="22" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="5"/>
        <circle class="mh-ring" style="--len: ${len}; --i: ${i}" cx="28" cy="28" r="22" fill="none" stroke="${color}" stroke-width="5" stroke-linecap="round"
          stroke-dasharray="${len} ${C.toFixed(1)}" transform="rotate(-90 28 28)"/>
        <text x="28" y="26.5" text-anchor="middle" font-size="13" font-weight="800" fill="#f1f5f9">${judged ? ok : "–"}</text>
        <text x="28" y="37" text-anchor="middle" font-size="7.5" fill="#64748b">${judged ? `of ${judged}` : "no range"}</text>
      </svg>`;
  }

  /** A tiny trend line for a card: the series on its own scale, last point marked. */
  function sparkline(rs: any[], color: string): string {
    const vals = rs.map((r) => Number(r.value));
    if (vals.length < 2) return "";
    const lo = Math.min(...vals), hi = Math.max(...vals);
    const x = (i: number) => 3 + (i / (vals.length - 1)) * 74;
    const y = (v: number) => hi === lo ? 13 : 23 - ((v - lo) / (hi - lo)) * 20;
    const pts = vals.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(" ");
    const last = vals.length - 1;
    return `<svg width="80" height="26" viewBox="0 0 80 26" class="shrink-0" aria-hidden="true">
      <polyline points="${pts}" fill="none" stroke="${color}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="${x(last).toFixed(1)}" cy="${y(vals[last]).toFixed(1)}" r="2.6" fill="${color}"/></svg>`;
  }

  function renderOverview() {
    $("greet").textContent = greeting();

    const dates = [...new Set(allLabs.map((r) => r.measured_on))].sort();
    if (dates.length === 0) {
      show("emptycard", true); show("secwrap", false); show("worthwrap", false); show("latestwrap", false);
      return;
    }
    show("emptycard", false);
    const waiting = pendingReports();
    const unchecked = uncheckedInApp();
    show("tosend", waiting.length > 0 || unchecked > 0);
    $("tosend").classList.toggle("flex", waiting.length > 0 || unchecked > 0);
    show("tosendgo", waiting.length > 0);
    if (waiting.length) {
      const n = waiting.reduce((sum, p) => sum + reportAppState(p).pending.length, 0);
      $("tosendtext").textContent = waiting.length === 1
        ? `${n} value${n === 1 ? "" : "s"} for your app from ${pretty(waiting[0].split("/").pop()!)} ${n === 1 ? "has" : "have"} not been sent.`
        : `${waiting.length} reports have values for your app that have not been sent: ${n} in all.`;
    } else if (unchecked) {
      // sent as they were read: the look happens in the app
      $("tosendtext").textContent = `${unchecked} value${unchecked === 1 ? "" : "s"} from your reports ${unchecked === 1 ? "is" : "are"} in your app, unchecked. Open the app's Body page to look ${unchecked === 1 ? "it" : "them"} over.`;
    }

    // ── your sections: the same split as Labs, each a way in ─────────────
    show("secwrap", true);
    $("sections").innerHTML = SECTION_ORDER.filter((s) => labSecs.has(s)).map((s, i) => {
      const series = [...labSecs.get(s)!.values()];
      let ok = 0, judged = 0;
      for (const rs of series) {
        const v = inRange(rs[rs.length - 1]);
        if (v !== null) judged++;
        if (v === true) ok++;
      }
      const flagged = judged - ok;
      const status = flagged
        ? `<span class="text-warning">${flagged} outside range</span>`
        : judged ? `<span class="text-success">all in range</span>` : `<span class="text-text-tertiary">no printed ranges</span>`;
      return `
        <button data-opensec="${s}" style="--i: ${i}" class="mh-rise flex items-center gap-3 rounded-2xl border border-white/8 bg-white/4 px-3.5 py-3 text-left transition-colors hover:border-white/16">
          ${ringSvg(ok, judged, i)}
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-semibold text-text-primary">${SECTIONS[s]}</span>
            <span class="block text-xs leading-snug">${series.length} marker${series.length === 1 ? "" : "s"} · ${status}</span>
          </span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>`;
    }).join("");
    $("sections").querySelectorAll("[data-opensec]").forEach((b) =>
      b.addEventListener("click", () => openSection((b as HTMLElement).dataset.opensec!)));

    // ── worth a look: the latest reading out of its own range, worst first ──
    type Finding = { sec: string; name: string; rs: any[]; latest: any; n: number; first: any; sev: number };
    const findings: Finding[] = [];
    let inCount = 0, judged = 0;
    for (const [sec, m] of labSecs) for (const [name2, rs] of m) {
      const latest = rs[rs.length - 1];
      const ok = inRange(latest);
      if (ok !== null) judged++;
      if (ok === true) inCount++;
      if (ok !== false) continue;
      const lo = latest.ref_low, hi = latest.ref_high;
      const width = lo != null && hi != null ? hi - lo : Math.abs(hi ?? lo ?? 1) || 1;
      const dist = lo != null && latest.value < lo ? lo - latest.value : latest.value - (hi ?? 0);
      findings.push({ sec, name: name2, rs, latest, n: rs.length, first: rs[0], sev: dist / (width || 1) });
    }
    findings.sort((a, b) => b.sev - a.sev);
    const top = findings.slice(0, 3);

    show("worthwrap", true);
    $("worthall").textContent = findings.length > top.length
      ? `All ${findings.length} outside range in Labs →` : findings.length ? "Open in Labs →" : "";
    show("worthall", findings.length > 0);
    $("worth").innerHTML = top.length ? top.map((f, i) => {
      const dir = f.latest.ref_low != null && f.latest.value < f.latest.ref_low ? "below" : "above";
      const trend = f.n > 1 ? `${f.first.value} → ${f.latest.value} across ${f.n} reports` : `from ${fmtDay(f.latest.measured_on)}`;
      return `
        <button data-worth="${esc(f.sec)}|${esc(f.name)}" style="--i: ${i + 4}" class="mh-rise flex flex-col gap-1.5 rounded-2xl border border-white/8 bg-white/4 p-4 text-left transition-colors hover:border-warning/40">
          <span class="flex w-full items-center justify-between gap-2">
            <span class="min-w-0 truncate text-sm font-semibold text-text-primary">${esc(f.name)}</span>
            <span class="shrink-0 rounded-md bg-white/[0.06] px-2 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider text-text-secondary">${esc(SECTIONS[f.sec])}</span>
          </span>
          <span class="flex w-full items-end justify-between gap-3">
            <span class="font-mono text-[26px] font-bold leading-none text-warning">${f.latest.value}${f.latest.unit ? ` <span class="text-xs font-semibold">${esc(f.latest.unit)}</span>` : ""}</span>
            ${sparkline(f.rs, "#FBBF24")}
          </span>
          <span class="text-xs leading-snug text-text-tertiary">${dir} the lab&rsquo;s range ${esc(rangeLabel(f.latest))} · ${esc(trend)}</span>
        </button>`;
    }).join("") : `
      <div class="rounded-2xl border border-success/25 bg-success/[0.05] p-4 sm:col-span-2 lg:col-span-3">
        <div class="text-sm font-semibold text-success">${inCount} of ${judged} markers in range</div>
        <div class="mt-1 text-xs leading-relaxed text-text-tertiary">Nothing is outside its lab&rsquo;s printed range right now. The full list is in Labs.</div>
      </div>`;
    $("worth").querySelectorAll("[data-worth]").forEach((b) =>
      b.addEventListener("click", () => {
        const [sec, name3] = (b as HTMLElement).dataset.worth!.split("|");
        openMarker(sec, name3);
      }));

    // ── the latest report ───────────────────────────────────────────────
    const lastDate = dates[dates.length - 1];
    const dayRows = allLabs.filter((r) => r.measured_on === lastDate);
    const flaggedN = dayRows.filter((r) => inRange(r) === false).length;
    const path = dayRows.map((r) => r.report_path).filter(Boolean).pop() ?? "";
    const fromApp = path.startsWith("export:");   // brought by the app's export: no PDF behind it
    const repName = fromApp ? "From the Verve app" : path ? pretty(path.split("/").pop()!) : "";
    show("latestwrap", true);
    $("latestcard").innerHTML = `
      <div class="mh-rise flex flex-wrap items-center gap-3 sm:gap-4" style="--i: 7">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/[0.14]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>
        </span>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="truncate text-sm font-semibold text-text-primary">${esc(repName || fmtDay(lastDate))}</span>
            <span class="rounded-md bg-white/[0.06] px-2 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider text-text-secondary">${fmtDay(lastDate)}</span>
          </div>
          <div class="mt-1 text-xs text-text-tertiary">${dayRows.length} values · ${flaggedN ? `<span class="text-warning">${flaggedN} outside range</span>` : `<span class="text-success">all in range</span>`} · all on your Labs tab</div>
        </div>
        ${path && !fromApp ? `<button data-viewpath="${esc(path)}" class="rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-secondary transition-colors hover:border-white/25 hover:text-text-primary">View report</button>` : ""}
        <button data-goto="reports" class="rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-secondary transition-colors hover:border-white/25 hover:text-text-primary">All reports →</button>
      </div>`;
    const vp = $("latestcard").querySelector("[data-viewpath]");
    if (vp) vp.addEventListener("click", () => viewPdf((vp as HTMLElement).dataset.viewpath!));
    wireGoto();
  }

  function wireGoto() {
    document.querySelectorAll("[data-goto]").forEach((b) => {
      const el = b as HTMLElement;
      if (el.dataset.wired) return;
      el.dataset.wired = "1";
      el.addEventListener("click", () => setTab(el.dataset.goto!));
    });
  }

  /** Jump from Overview into one section of Labs. */
  function openSection(sec: string) {
    labSection = sec;
    expandedAnalyte = "";
    mobileSectionOpen = true;
    setTab("labs");
    renderLabsRail(); renderLabsPanel();
  }

  /** Jump from Overview straight to one marker's chart. */
  function openMarker(sec: string, name: string) {
    labSection = sec;
    expandedAnalyte = name;
    mobileSectionOpen = true;
    setTab("labs");
    renderLabsRail(); renderLabsPanel();
  }

  // ═══ LABS ═══════════════════════════════════════════════════════════════
  function renderLabsRail() {
    const empty = allLabs.length === 0;
    show("labsempty", empty);
    if (empty) { $("labsrail").innerHTML = ""; $("labspanel").innerHTML = ""; wireGoto(); return; }

    // phone: the section list IS the page until a section opens
    $("labsrail").className = `${mobileSectionOpen ? "hidden md:flex" : "flex"} flex-col gap-1.5 md:w-56 md:shrink-0`;
    $("labspanel").className = `${mobileSectionOpen ? "" : "hidden md:block"} min-w-0 flex-1 rounded-2xl border border-white/10 bg-white/[0.03] p-5`;

    $("labsrail").innerHTML = SECTION_ORDER.filter((s) => labSecs.has(s)).map((s) => {
      const analytes = [...labSecs.get(s)!.values()];
      const flagged = analytes.filter((rs) => inRange(rs[rs.length - 1]) === false).length;
      const on = s === labSection;
      return `
        <button data-sec="${s}" class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-left text-[13px] transition-colors ${on ? "bg-accent/15 font-bold text-text-primary" : "text-text-secondary hover:bg-white/[0.05]"}">
          <span class="flex-1">${SECTIONS[s]}</span>
          <span class="rounded-md ${flagged ? "bg-warning/15 text-warning" : "bg-white/[0.06] text-text-tertiary"} px-1.5 py-0.5 font-mono text-[9px] font-semibold tracking-wider">${analytes.length}${flagged ? ` · ${flagged}!` : ""}</span>
          <span class="text-text-muted md:hidden">›</span>
        </button>`;
    }).join("");
    $("labsrail").querySelectorAll("[data-sec]").forEach((b) =>
      b.addEventListener("click", () => {
        labSection = (b as HTMLElement).dataset.sec!;
        expandedAnalyte = "";
        mobileSectionOpen = true;
        renderLabsRail(); renderLabsPanel();
      }));
  }

  function renderLabsPanel() {
    const sec = labSecs.get(labSection);
    if (!sec) { $("labspanel").innerHTML = ""; return; }
    const analytes = [...sec.entries()];
    const flagged = analytes.filter(([, rs]) => inRange(rs[rs.length - 1]) === false).length;
    $("labspanel").innerHTML = `
      <button id="labsback" class="mb-2 flex items-center gap-1 text-sm font-semibold text-accent-light md:hidden">‹ All sections</button>
      <div class="flex flex-wrap items-baseline gap-3">
        <h3 class="text-base font-extrabold">${SECTIONS[labSection]}</h3>
        <span class="font-mono text-[10px] text-text-tertiary">${analytes.length} MARKER${analytes.length === 1 ? "" : "S"}</span>
        ${flagged ? `<span class="rounded-md bg-warning/15 px-2 py-0.5 font-mono text-[9px] tracking-wider text-warning">${flagged} OUT OF RANGE</span>` : ""}
      </div>
      <div class="mt-2 divide-y divide-white/[0.05]">
        ${analytes.map(([name, rs]) => labRow(name, rs)).join("")}
      </div>
      ${labSection === "imaging" && allImaging.length ? `
        <div class="mt-5 font-mono text-[10px] font-semibold uppercase tracking-widest text-text-tertiary">The reports' own conclusions</div>
        ${[...allImaging].reverse().map((im) => `
          <div class="mt-2 rounded-xl border border-white/[0.07] bg-white/[0.02] p-3">
            <div class="flex items-center gap-2">
              <span class="rounded-md bg-accent/15 px-1.5 py-0.5 font-mono text-[9px] font-semibold tracking-wider text-accent-light">${esc(String(im.modality).toUpperCase())}</span>
              <span class="font-mono text-[10px] text-text-tertiary">${fmtDay(im.report_date)}</span>
            </div>
            ${im.impression ? `<p class="mt-1.5 text-[13px] leading-5 text-text-secondary">${esc(im.impression)}</p>` : ""}
          </div>`).join("")}` : ""}`;
    $("labsback")?.addEventListener("click", () => {
      mobileSectionOpen = false;
      renderLabsRail(); renderLabsPanel();
    });
    $("labspanel").querySelectorAll("[data-an]").forEach((b) =>
      b.addEventListener("click", () => {
        const n = (b as HTMLElement).dataset.an!;
        expandedAnalyte = expandedAnalyte === n ? "" : n;
        renderLabsPanel();
        if (expandedAnalyte) $("labspanel").querySelector(`[data-an="${CSS.escape(n)}"]`)?.scrollIntoView({ block: "nearest" });
      }));
