    const dues: Due[] = [...labRows.map((r) => r.due).filter((d): d is Due => !!d), ...(crfDue ? [crfDue] : []), ...(bodyDue ? [bodyDue] : [])].sort((x, y) => x.days - y.days);
    const nextDue = dues[0] ?? null;
    const card = (k: string, v: string, sub: string, tone = "") => `<div class="flex flex-col gap-1 rounded-2xl border p-4 ${tone === "success" ? "border-success/40 bg-success/[0.06]" : tone === "warning" ? "border-warning/45 bg-warning/[0.06]" : tone === "danger" ? "border-danger/40 bg-danger/[0.06]" : "border-white/10 bg-white/[0.03]"}">${kicker(k, tone === "success" ? "text-success-light" : tone === "warning" ? "text-warning" : tone === "danger" ? "text-danger" : "text-text-tertiary")}<div class="text-[22px] font-extrabold leading-tight text-text-primary">${v}</div><div class="text-[12.5px] leading-snug text-text-tertiary">${sub}</div></div>`;
    $("dp-cards").innerHTML = [
      card(moving.k, moving.v, moving.sub, moving.tone),
      card("FITNESS", latest ? `${fmt1(latest.v)} <span class="text-[13px] font-semibold ${trendWord === "rising" ? "text-success-light" : trendWord === "falling" ? "text-danger" : "text-text-tertiary"}">${trendWord}</span>` : "—", latest ? `VO₂max by ${esc(methodLabel(latest.method))}${within != null ? `, ${within >= 0 ? "up" : "down"} ${fmt1(Math.abs(within))} within the method` : ", first of its method"}` : "no fitness test on file"),
      card("LABS", labRows.length ? `${outRows.length} <span class="text-[13px] font-semibold ${outRows.length ? "text-warning" : "text-success-light"}">${outRows.length ? "outside range" : "all in range"}</span>` : "—", labRows.length ? (outRows.length ? `${esc(outRows.slice(0, 2).map((r) => r.label).join(" and "))}${outRows.length > 2 ? ` and ${outRows.length - 2} more` : ""}${oldest ? `, no follow-up in ${oldest.noFollow} months` : ""}` : `${labRows.length} marker${labRows.length === 1 ? "" : "s"} on file, latest ${esc(fmtDay(labRows[0].d))}`) : "no lab values on file", outRows.length ? "warning" : ""),
      card("RETEST DUE", nextDue ? esc(nextDue.what) : "Nothing due", nextDue ? `${esc(nextDue.why)} · ${dueWord(nextDue)}` : "in the cited cadences", nextDue && nextDue.days < 0 ? "danger" : nextDue && nextDue.days <= 30 ? "warning" : ""),
    ].join("");

    // ── the working, for "In Verve's words" ─────────────────────────────
    depthWorking = {
      person: { self: p.self, ageBand: syncProfile?.age ? `${Math.floor(Number(syncProfile.age) / 10) * 10}s` : null, sex: syncProfile?.sex ?? null, weeklyGoalMetHours: goal, scopes: p.self || p.mine ? "all" : p.scopes },
      activity: { weeksOnFile: act.weeks.length, recentWeeks: recent.length, recentAvgMetHours: fmt1(recentAvg), changeVsPrior: change == null ? null : `${Math.round(change * 100)}%`, weeksAtGoalInARow: streak, atGoalOfLast12: `${act.atGoal} of ${act.of}`, daysSinceLastWorkout: quietDays, workoutsAWeek: Math.round(perWeek), kinds: [...kinds].map(([k, n]) => `${k} ${n}`), vigorousShare: minutes ? `${Math.round((vig / minutes) * 100)}%` : null, zone2MinutesAWeek: zone2 != null ? Math.round(zone2) : null, zone2WeeklyDose: 150, lastWorkouts: lastWorkouts.map((w) => ({ on: localDay(w.timestamp), name: String(w.activity_name ?? "workout"), minutes: Math.round(Number(w.duration_minutes) || 0), metHours: fmt1(Number(w.met_hours) || 0), intensity: w.intensity_category ?? null, zone2Minutes: w.zone2_minutes != null ? Math.round(Number(w.zone2_minutes)) : null })) },
      fitness: latest ? { latestVo2max: fmt1(latest.v), method: methodLabel(latest.method), maximal: latest.max, changeWithinMethod: within == null ? null : fmt1(within), trend: trendWord || null, category: latest.category ?? null, testedOn: latest.measured_on, retest: crfDue ? `${dueWord(crfDue)} (${crfDue.why})` : null } : null,
      labs: labRows.map((r) => ({ marker: r.label, latest: r.latest, labsRange: r.range, sinceLast: r.since, outsideRange: r.out, measuredOn: r.d, retest: r.retest })),
      body: { waist: wl ? { cm: wl.v, on: wl.d, waistToHeight: height ? (wl.v / height).toFixed(2) : null } : null, bodyFatPct: fat?.v ?? null, muscleMassPct: musc?.v ?? null, function: fnRows.map((f) => { const [word, ok] = f.judge(f.pt!.v); return { test: f.label, value: `${f.pt!.v} ${f.unit}`, verdict: word, withinCutoff: ok }; }), nextAssessment: bodyDue ? dueWord(bodyDue) : null },
      sleepHeart: heart ? {
        restingHeartRate: heart.rhr.latest != null ? { latest: heart.rhr.latest, on: heart.rhr.latestDay, ownMedian: heart.rhr.baseline, delta: heart.rhr.delta, status: heart.rhr.status, morningsAboveBandInARow: heart.rhr.run, absoluteLevel: heart.rhr.level } : null,
        sleep: heart.sleep.last ? { lastNightMinutes: heart.sleep.last.min, usualMinutes: heart.sleep.usual, band: heart.sleep.last.band, nightsIn30: heart.sleep.nights, shortNightsIn30: heart.sleep.shortNights } : null,
        heartRateRecovery: heart.hrr.latest != null ? { latestBpm: heart.hrr.latest, on: heart.hrr.latestDay, ownMedian: heart.hrr.median, citedLine: 12 } : null,
        steps: heart.steps.avg != null ? { dailyAverageLast7: heart.steps.avg, weekBefore: heart.steps.prior } : null,
      } : null,
      thisWeek: eventsFrom(allLabs, labRows, fit, act, today).map((e) => `${e.d}: ${e.text.replace(/<[^>]+>/g, "")}`),
    };
    renderAiCard();

    // ── what changed this week ─────────────────────────────────────────────
    const events = eventsFrom(allLabs, labRows, fit, act, today);
    $("dp-changed").innerHTML = kicker("WHAT CHANGED THIS WEEK") + (events.length
      ? events.slice(0, 4).map((e) => `<span><span class="text-text-muted">${esc(dayWord(e.d))}</span> ${e.text}</span>`).join("")
      : `<span class="text-text-tertiary">Nothing new this week.</span>`);
  }

  // ── "In Verve's words": the card, the consent, the call ─────────────────
  // Off until AI_SUMMARY_OPEN is on and the depth-summary function is
  // switched on; the owner can preview the card with sessionStorage
  // mh-ai-open=1, which only shows a card whose function answers "not open".
  let depthWorking: Record<string, unknown> | null = null;
  let aiSummary: { summary: any; created_at: string; model: string; cached?: boolean } | null = null;
  let aiState: "idle" | "writing" | "error" = "idle";
  let aiError = "";
  let aiConsented = false;
  const aiOpen = (() => { try { return AI_SUMMARY_OPEN || sessionStorage.getItem("mh-ai-open") === "1"; } catch { return AI_SUMMARY_OPEN; } })();
  const aiPersonId = () => person?.id ?? "";
  async function loadAiSummary() {
    aiSummary = null; aiState = "idle"; aiError = "";
    if (!aiOpen || !aiPersonId()) return;
    const [{ data: kept }, { data: consent }] = await Promise.all([
      supabase.from("depth_summaries").select("summary, created_at, model").eq("person_id", aiPersonId()).eq("viewer_id", userId).maybeSingle(),
      supabase.from("ai_consent").select("summary_at").eq("user_id", userId).maybeSingle(),
    ]);
    aiConsented = !!consent?.summary_at;
    if (kept?.summary) aiSummary = { summary: kept.summary, created_at: kept.created_at, model: kept.model };
    renderAiCard();
  }
  const modelName = (m: string) => m.includes("fable") ? "Claude Fable 5.1" : m.includes("opus") ? "Claude Opus 5" : m.includes("sonnet") ? "Claude Sonnet 5" : m;
  function renderAiCard() {
    const on = aiOpen && !!aiPersonId() && !$("dp-locked").classList.contains("flex");
    show("dp-ai", on); $("dp-ai").classList.toggle("flex", on);
    if (!on) return;
    const who = person!.self ? "you" : (person!.name || "this person");
    const head = (sub: string) => `
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-[9px] bg-accent/20"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/></svg></span>
          <div><div class="text-[15px] font-extrabold text-text-primary">In Verve's words${person!.self ? "" : `, for ${esc(person!.name || "this person")}`}</div><div class="text-[12px] text-text-tertiary">${sub}</div></div>
        </div>
        <button type="button" id="dp-ai-go" class="min-h-9 rounded-xl ${aiSummary ? "border border-white/14 text-text-secondary hover:text-text-primary" : "bg-accent text-canvas"} px-3.5 text-[13px] font-bold" ${aiState === "writing" ? "disabled" : ""}>${aiState === "writing" ? "Writing…" : aiSummary ? "Write it again" : "Sum it up"}</button>
      </div>`;
    if (!aiSummary) {
      $("dp-ai").innerHTML = head("A short reading of this page, from its numbers and nothing else") + `
        <p class="text-[13.5px] leading-relaxed text-text-secondary">How ${who === "you" ? "you are" : `${who} is`} doing in two or three sentences, at most three things worth a conversation with a doctor or a coach, and what is due. It can only say what this page already shows: a number that is not on the page cannot appear.</p>
        ${aiConsented ? "" : `<label class="flex items-start gap-2.5 text-[13px] leading-relaxed text-text-secondary"><input type="checkbox" id="dp-ai-consent" class="mt-0.5 h-4 w-4 shrink-0 accent-[#818cf8]" /><span>Send the numbers on this page to Anthropic's Claude to write it. Not ${person!.self ? "your" : "the"} name, not the reports, not the email. Deleted from their systems within 30 days; never used to train.</span></label>`}
        ${aiState === "error" ? `<p class="text-[13px] text-danger">${esc(aiError)}</p>` : ""}`;
    } else {
      const sm = aiSummary.summary;
      const tone = (w: string) => w === "doctor" ? "text-warning" : "text-accent-light";
      $("dp-ai").innerHTML = head(`From the working on this page · ${esc(fmtDay(String(aiSummary.created_at).slice(0, 10)))} · ${esc(modelName(aiSummary.model))}`) + `
        <p class="text-[15px] leading-relaxed text-text-primary">${esc(String(sm.lead ?? ""))}</p>
        ${Array.isArray(sm.conversations) && sm.conversations.length ? `<div class="grid gap-3 sm:grid-cols-${Math.min(3, sm.conversations.length)}">${sm.conversations.map((c: any) => `<div class="rounded-xl border border-white/10 bg-white/[0.03] p-3.5"><div class="font-mono text-[10px] font-semibold tracking-[0.12em] ${tone(c.who)}">WORTH A CONVERSATION · ${String(c.who ?? "").toUpperCase()}</div><p class="mt-1 text-[13px] leading-relaxed text-text-secondary">${esc(String(c.text ?? ""))}</p></div>`).join("")}</div>` : ""}
        ${sm.due ? `<div class="rounded-xl border border-white/10 bg-white/[0.03] p-3.5"><div class="font-mono text-[10px] font-semibold tracking-[0.12em] text-text-tertiary">DUE</div><p class="mt-1 text-[13px] leading-relaxed text-text-secondary">${esc(String(sm.due))}</p></div>` : ""}
        ${sm.notShared ? `<p class="text-[12.5px] text-text-tertiary">${esc(String(sm.notShared))}</p>` : ""}
        <p class="text-[12px] leading-relaxed text-text-muted">Not a diagnosis. Every number above is on this page; ranges are the lab's own and cadences the cited ones. Nothing was sent but the numbers${sm.dropped ? `; ${sm.dropped} sentence${sm.dropped === 1 ? "" : "s"} the model wrote with a number not on this page ${sm.dropped === 1 ? "was" : "were"} dropped` : ""}.</p>
        ${aiState === "error" ? `<p class="text-[13px] text-danger">${esc(aiError)}</p>` : ""}`;
    }
    $("dp-ai-go")?.addEventListener("click", writeSummary);
  }
  async function writeSummary() {
    if (!depthWorking || !aiPersonId()) return;
    if (!aiConsented) {
      const box = $("dp-ai").querySelector("#dp-ai-consent") as HTMLInputElement | null;
      if (!box?.checked) { aiState = "error"; aiError = "Tick the box first: it says what is sent, and what is not."; renderAiCard(); return; }
      const { error } = await supabase.from("ai_consent").upsert({ user_id: userId, summary_at: new Date().toISOString() }, { onConflict: "user_id" });
      if (error) { aiState = "error"; aiError = `Could not record your consent: ${error.message}`; renderAiCard(); return; }
      aiConsented = true;
    }
    aiState = "writing"; aiError = ""; renderAiCard();
    try {
      const { data: { session } } = await supabase.auth.getSession();
      const resp = await fetch(`${SUPABASE_URL}/functions/v1/depth-summary`, {
        method: "POST",
        headers: { "content-type": "application/json", authorization: `Bearer ${session?.access_token}`, apikey: SUPABASE_ANON_KEY },
        body: JSON.stringify({ person_id: aiPersonId(), working: depthWorking, force: !!aiSummary }),
      });
      const out = await resp.json().catch(() => ({}));
      if (!resp.ok || !out.summary) {
        aiState = "error";
        aiError = out.error === "summary_not_open" ? "In Verve's words is not switched on yet." : out.error === "consent_required" ? "Consent was not recorded; tick the box and try again." : resp.status === 429 ? "Today's allowance is used up; try tomorrow." : `Could not write it${out.detail ? `: ${out.detail}` : out.error ? `: ${out.error}` : ""}.`;
        renderAiCard(); return;
      }
      aiSummary = { summary: out.summary, created_at: out.created_at, model: out.model, cached: out.cached };
      aiState = "idle"; renderAiCard();
    } catch { aiState = "error"; aiError = "Could not reach the writer. Try again in a moment."; renderAiCard(); }
  }

  // ── people at a glance: every person you can see, one line each ────────
  // The same table serves a family and a coach. Activity and fitness come
  // from web_weeks and web_crf (an app export, or later the app's sync);
  // labs from web_labs; unchecked from the app's rows a labs scope lets
  // you read. Anything a scope does not cover shows as a dash.
  const mondayOf = (d: Date) => { const x = new Date(d); const day = x.getDay() === 0 ? 7 : x.getDay(); x.setDate(x.getDate() - day + 1); return x.toLocaleDateString("en-CA"); };
  const daysBetween = (a: string, b: string) => Math.round((new Date(b + "T00:00:00").getTime() - new Date(a + "T00:00:00").getTime()) / 86400000);

  async function loadGlance() {
    const others = people.filter((p) => p.id && !p.self);
    const on = others.length > 0;
    const locked = on && enforced && !ent.depthOthers;
    show("glancelocked", locked); $("glancelocked").classList.toggle("flex", locked);
    if (locked) {
      $("glancelocked").innerHTML = lockCard("The group is on Max.", `${others.length === 1 ? "The person" : `The ${others.length} people`} you can see ${others.length === 1 ? "is" : "are"} in the sidebar, each with their own page. One table across everyone, ranked by movement, with this week and retest due, comes with Max; Enterprise adds clients without a family limit.`);
      $("glancelocked").querySelector("[data-goto]")?.addEventListener("click", () => { show("glancelocked", false); $("glancelocked").classList.remove("flex"); });
    }
    show("glance", on && !locked);
    if (!on || locked) return;
    const managed = others.filter((p) => p.mine).length, shared = others.length - managed;
    const coach = shared > 0 && managed === 0;
    $("glancetitle").textContent = coach ? "Clients" : "People";
    $("glancesub").textContent = coach
      ? "You see what each person chose, and nothing else. Tap a row for their page; In depth has the working."
      : [managed ? `${managed} you look after` : "", shared ? `${shared} sharing with you` : ""].filter(Boolean).join(", ") + ". Tap a row for their page; In depth has the working.";
    $("glanceaddr").textContent = userEmail;

    const ids = people.filter((p) => p.id).map((p) => p.id);
    const accounts = people.filter((p) => p.account_id).map((p) => p.account_id!);
    const thisMonday = mondayOf(new Date()), today = new Date().toLocaleDateString("en-CA");
    const since = new Date(new Date(thisMonday + "T00:00:00").getTime() - 12 * 7 * 86400000).toISOString();
    const none = Promise.resolve({ data: [] as any[] });
    const LAB_COLS = "user_id, measured_at, review_status, lpa_unit, body_comp_method, sbp, dbp, glucose_mgdl, hba1c_pct, post_meal_glucose_mgdl, fasting_insulin_uiuml, triglycerides_mgdl, hdl_mgdl, waist_cm, apo_b_mgdl, ldl_mgdl, lpa_value, hs_crp_mgl, body_fat_pct, skel_musc_pct, alm_kg, ffm_kg, handgrip_kg, single_leg_balance_seconds, chair_stand_seconds, gait_speed_ms";
    const [labs, app, weeks, crf, body, acts, tests, profiles, asked] = await Promise.all([
      supabase.from("web_labs").select("person_id, analyte, value, unit, ref_low, ref_high, ref_text, measured_on, created_at").in("person_id", ids).order("measured_on", { ascending: true }).limit(8000),
      accounts.length ? supabase.from("lab_readings").select(LAB_COLS).in("user_id", accounts).is("deleted_at", null).order("measured_at", { ascending: true }).limit(accounts.length * 300 + 1) : none,
      supabase.from("web_weeks").select("person_id, week_start, met_hours, minutes, vigorous_min, workouts").in("person_id", ids).order("week_start", { ascending: false }).limit(ids.length * 14 + 1),
      supabase.from("web_crf").select("person_id, measured_on, vo2max, method").in("person_id", ids).order("measured_on", { ascending: true }).limit(ids.length * 10 + 1),
      supabase.from("web_body").select("person_id, measured_on, waist_cm").in("person_id", ids).order("measured_on", { ascending: true }).limit(ids.length * 60 + 1),
      // the app's own rows, for everyone with an account: twelve weeks of workouts, every fitness test, the goal
      accounts.length ? supabase.from("activities").select("user_id, timestamp, duration_minutes, met_hours, intensity_category, activity_name, source, zone2_minutes").in("user_id", accounts).is("deleted_at", null).neq("source", "passive-nakanishi").gte("timestamp", since).order("timestamp", { ascending: true }).limit(accounts.length * 400 + 1) : none,
      accounts.length ? supabase.from("crf_entries").select("user_id, timestamp, met_capacity, performance_category, estimation_method, vo2_max_estimate").in("user_id", accounts).is("deleted_at", null).order("timestamp", { ascending: true }).limit(accounts.length * 40 + 1) : none,
      accounts.length ? supabase.from("profiles").select("user_id, weekly_met_hours_goal").in("user_id", accounts) : none,
      supabase.from("share_requests").select("target_email, created_at").eq("requester_id", userId).eq("status", "requested").order("created_at", { ascending: true }),
    ]);
    const waiting = asked.data ?? [];
    const goalOf = new Map<string, number>((profiles.data ?? []).map((r: any) => [r.user_id, Number(r.weekly_met_hours_goal) || 7.5]));

    // one summary per person, from the same working the In depth tab uses
    const lines = people.filter((p) => p.id).map((p) => {
      const labsP = (labs.data ?? []).filter((r: any) => r.person_id === p.id);
      const appP = p.account_id ? (app.data ?? []).filter((r: any) => r.user_id === p.account_id) : [];
      const bodyP = (body.data ?? []).filter((r: any) => r.person_id === p.id);
      const actsP = p.account_id ? (acts.data ?? []).filter((x: any) => x.user_id === p.account_id) : [];
      const weeksP = actsP.length ? weeksFrom(actsP) : (weeks.data ?? []).filter((r: any) => r.person_id === p.id);
      const testsP = p.account_id ? (tests.data ?? []).filter((t: any) => t.user_id === p.account_id) : [];
      const crfP = testsP.length ? crfFromSync(testsP) : (crf.data ?? []).filter((r: any) => r.person_id === p.id);
      const goal = (p.account_id && goalOf.get(p.account_id)) || 7.5;
      const by = markerPointsFrom(labsP, appP, bodyP);
      const labRows = labRowsFrom(by, today);
      const fit = fitnessSummary(crfP, today);
      const act = activitySummary(weeksP, actsP, goal, today, thisMonday);
      const bodyDue = bodyDueFrom(by, today);
      const dues = [...labRows.map((r) => r.due), fit.due, bodyDue].filter((d): d is Due => !!d).sort((x, y) => x.days - y.days);
      return { p, act, fit, labRows, outRows: labRows.filter((r) => r.out), unchecked: appP.filter((r: any) => r.review_status === "unchecked").length,
        dues, events: eventsFrom(labsP, labRows, fit, act, today), latestLabDay: labRows.map((r) => r.d).sort().pop() ?? "" };
    });
    lines.sort((x, y) => { const cx = x.act.change, cy = y.act.change; if (cx == null && cy == null) return x.p.name.localeCompare(y.p.name); if (cx == null) return 1; if (cy == null) return -1; return cy - cx || x.p.name.localeCompare(y.p.name); });
    $("glancekick").textContent = `${coach ? "COACH" : "FAMILY"} · ${others.length} ${coach ? (others.length === 1 ? "CLIENT" : "CLIENTS") : (others.length === 1 ? "PERSON" : "PEOPLE")}${waiting.length ? ` · ${waiting.length} WAITING` : ""} · SORTED BY FOUR-WEEK CHANGE`;

    const canSeeLabs = (p: Person) => p.self || p.mine || p.scopes.includes("labs");
    $("glancerows").innerHTML = lines.map((l) => {
      const ch = l.act.change;
      const chTone = ch == null ? "text-text-muted" : ch >= 0.05 ? "text-success-light" : ch <= -0.05 ? "text-danger" : "text-text-secondary";
      const tw = l.act.thisWeek ? fmt1(Number(l.act.thisWeek.met_hours)) : l.act.weeks.length ? "0" : null;
      const fitTone = l.fit.trendWord === "rising" ? "text-success-light" : l.fit.trendWord === "falling" ? "text-danger" : "text-text-tertiary";
      const labText = l.labRows.length
        ? `${esc(fmtDay(l.latestLabDay))} · ${l.outRows.length ? `<span class="text-warning font-semibold">${esc(l.outRows[0].label)} outside</span>${l.outRows.length > 1 ? ` <span class="text-text-tertiary">+${l.outRows.length - 1}</span>` : ""}` : "all in range"}${l.unchecked ? ` <span class="rounded-md bg-white/[0.06] px-1.5 py-0.5 font-mono text-[9px] tracking-wider text-text-secondary">${l.unchecked} UNCHECKED</span>` : ""}`
        : canSeeLabs(l.p) ? "—" : "not shared";
      const due = l.dues[0] ?? null;
      const q = l.act.quietDays;
      return `<tr data-open="${l.p.id}" class="cursor-pointer transition-colors hover:bg-white/[0.03]">
        <td class="px-3 py-2.5 font-semibold text-text-primary">${l.p.self ? "You" : esc(l.p.name || "Unnamed")}</td>
        <td class="px-3 py-2.5 text-text-tertiary">${esc(l.p.self ? "you" : l.p.mine ? "you look after" : scopeList(l.p.scopes).toLowerCase() || "nothing yet")}</td>
        <td class="px-3 py-2.5 font-bold ${chTone}">${ch == null ? "—" : `${signed(ch * 100, 0)}%`}</td>
        <td class="px-3 py-2.5">${tw == null ? `<span class="text-text-muted">—</span>` : `<span class="font-semibold ${tw === "0" ? "text-danger" : "text-met-hero"}">${tw}</span> <span class="text-text-tertiary">MET-h</span>`}</td>
        <td class="px-3 py-2.5 text-text-secondary">${l.fit.latest ? `${fmt1(l.fit.latest.v)}${l.fit.trendWord ? ` <span class="${fitTone}">${l.fit.trendWord}</span>` : ""}` : "—"}</td>
        <td class="px-3 py-2.5 text-text-secondary">${labText}</td>
        <td class="px-3 py-2.5">${due ? `<span class="${dueTone(due)}">${esc(due.what)} · ${dueWord(due)}</span>` : `<span class="text-text-muted">—</span>`}</td>
        <td class="px-3 py-2.5 ${q != null && q >= 14 ? "text-danger font-semibold" : "text-text-tertiary"}">${q == null ? "—" : q === 0 ? "today" : q === 1 ? "yesterday" : `${q} days ago`}</td>
        <td class="px-3 py-2.5 text-text-tertiary">${l.act.of ? `${l.act.atGoal} of ${l.act.of}` : "—"}</td>
      </tr>`;
    }).join("") + waiting.map((r: any) => `<tr><td class="px-3 py-2.5 font-semibold text-text-tertiary">${esc(r.target_email)}</td><td colspan="8" class="px-3 py-2.5 text-text-tertiary">Asked ${esc(dayOf(r.created_at))} · waiting. Nothing shows until they share.</td></tr>`).join("");
    $("glancerows").querySelectorAll("[data-open]").forEach((tr) =>
      tr.addEventListener("click", () => switchPerson((tr as HTMLElement).dataset.open!)));

    // this week, across everyone
    const feed = lines.flatMap((l) => l.events.map((e) => ({ ...e, who: l.p.self ? "You" : (l.p.name || "Unnamed") }))).sort((x, y) => y.d.localeCompare(x.d)).slice(0, 6);
    $("glanceweek").innerHTML = feed.length
      ? feed.map((e) => `<div><span class="font-mono text-[11px] text-text-muted">${esc(dayWord(e.d)).toUpperCase()}</span> &nbsp;<strong class="text-text-primary">${esc(e.who)}</strong>: ${e.text}</div>`).join("")
      : `<div class="text-text-tertiary">Nothing new this week.</div>`;

    // retest due, across everyone: overdue first, then the next 30 and 90 days
    const dueList = lines.flatMap((l) => l.dues.map((d) => ({ d, who: l.p.self ? "You" : (l.p.name || "Unnamed") }))).filter((x) => x.d.days <= 90).sort((x, y) => x.d.days - y.d.days).slice(0, 8);
    const group = (days: number) => days < 0 ? ["OVERDUE", "text-danger"] : days <= 30 ? ["NEXT 30 DAYS", "text-warning"] : ["NEXT 90 DAYS", "text-text-tertiary"];
    $("glancedue").innerHTML = dueList.length
      ? dueList.map(({ d, who }) => { const [g, tone] = group(d.days); return `<div><span class="font-mono text-[10px] tracking-[0.1em] ${tone}">${g}</span> &nbsp;${esc(who)} · ${esc(d.what)}, ${esc(d.days < 0 ? dueWord(d).replace("overdue", "overdue by") : dueWord(d))}</div>`; }).join("")
      : `<div class="text-text-tertiary">Nothing due in the next 90 days.</div>`;
  }

  // one fetch feeds Overview, Labs and the Reports cards
  let allLabs: any[] = [];
  let allImaging: any[] = [];   // imaging_reports — the narrative half of a study
  let allApp: any[] = [];       // lab_readings — what the app holds, to say what was sent
  let labSecs: Map<string, Map<string, any[]>> = new Map();
  let labSection = "";
  let expandedAnalyte = "";          // one chart open at a time
  let mobileSectionOpen = false;     // phone: section list ⇄ section page

  // ── search: every word typed must land ──────────────────────────────────
  let searchQuery = "";
  const searchTerms = () => searchQuery.toLowerCase().split(/\s+/).filter(Boolean);
  const landsAll = (hay: string, terms: string[]) => terms.every((t) => hay.includes(t));
  /** A date, every way someone might type it: 2026-09-12, Sep 12, September, 2026. */
  function dateHay(d: string): string {
    if (!d) return "undated";
    const dt = new Date(d.slice(0, 10) + "T00:00:00");
    return `${d.slice(0, 10)} ${fmtDay(d.slice(0, 10))} ${dt.toLocaleDateString(undefined, { month: "long" })} ${dt.toLocaleDateString(undefined, { month: "short" })} ${dt.getFullYear()}`.toLowerCase();
  }
  /** The Labs sections with only the markers the search lands on; all of them when nothing is typed. */
  function filteredSecs(): Map<string, Map<string, any[]>> {
    const terms = searchTerms();
    if (!terms.length) return labSecs;
    const out = new Map<string, Map<string, any[]>>();
    for (const [sec, analytes] of labSecs) {
      for (const [name, rows] of analytes) {
        if (landsAll(`${name} ${SECTIONS[sec] ?? ""} ${sec}`.toLowerCase(), terms)) (out.get(sec) ?? out.set(sec, new Map()).get(sec)!).set(name, rows);
      }
    }
    return out;
  }
  const searchNote = (text: string) => { const el = $("mhsearchnote"); el.textContent = text; el.classList.toggle("hidden", !text); };
  let searchTimer = 0;
  $("mhsearch").addEventListener("input", () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      searchQuery = ($("mhsearch") as HTMLInputElement).value.trim();
      show("mhsearchclear", !!searchQuery);
      if (!searchQuery) searchNote("");
      renderLabsRail(); renderLabsPanel(); renderReports();
    }, 120);
  });
  $("mhsearchclear").addEventListener("click", () => { ($("mhsearch") as HTMLInputElement).value = ""; $("mhsearch").dispatchEvent(new Event("input")); $("mhsearch").focus(); });

  // ── tabs ───────────────────────────────────────────────────────────────
  let activeTab = "overview";
  function setTab(t: string) {
    // Everyone is a view of the account, not of a person: the greeting and
    // the person's own rows step aside, and no person is lit in the sidebar
    if (t === "group" && !people.some((x) => x.id && !x.self)) t = "overview";
    const switching = activeTab !== t;
    const wasGroup = activeTab === "group", group = t === "group";
    activeTab = t;
    ["group", "overview", "labs", "reports", "depth"].forEach((x) => show("tab-" + x, x === t));
    show("pagehead", !group); show("personwrap", !group && people.some((x) => !!x.id));
    show("mhsearchwrap", t === "labs" || t === "reports");
    show("ovsections", t === "overview"); $("ovsections").classList.toggle("flex", t === "overview");
    if (group !== wasGroup && people.some((x) => !!x.id)) renderPeople();
    if (switching) {
      const el = $("tab-" + t);
      el.classList.remove("mh-fade");
      void el.offsetWidth;   // restart the animation
      el.classList.add("mh-fade");
    }
    $("tabbar").querySelectorAll("[data-tab]").forEach((b) => {
      const on = (b as HTMLElement).dataset.tab === t;
      b.className = `flex min-h-9 flex-1 items-center justify-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold transition-colors sm:flex-none lg:min-h-10 lg:w-full lg:justify-start lg:gap-2.5 lg:rounded-[10px] lg:border-l-2 lg:px-3 lg:py-2 lg:text-[13.5px] ${
        on ? "bg-accent/20 text-text-primary lg:border-accent lg:bg-white/6" : "text-text-tertiary hover:text-text-primary lg:border-transparent lg:text-text-secondary lg:hover:bg-white/[0.04]"}`;
    });
    history.replaceState(null, "", t === "overview" && ovSection !== "all" ? `#overview-${ovSection}` : "#" + t);
  }
  /** The small figure beside a tab in the sidebar: how many outside range, how many reports. */
  function setTabCount(t: string, text: string, tone = "text-text-tertiary") {
    const el = $("tabbar").querySelector(`[data-tab="${t}"] [data-count]`);
    if (!el) return;
    el.textContent = text;
    el.className = `ml-auto hidden font-mono text-[10.5px] font-semibold lg:inline ${tone}`;
  }
  $("accessgo").addEventListener("click", openAccess);
  $("accessgophone").addEventListener("click", openAccess);
  $("tabbar").querySelectorAll("[data-tab]").forEach((b) =>
    b.addEventListener("click", () => setTab((b as HTMLElement).dataset.tab!)));

  // ── session ────────────────────────────────────────────────────────────
  const appLink = document.querySelector('[data-nav="app"]') as HTMLElement | null;

  async function boot() {
    // an invitation's button: the link carries a token the site verifies
    // here, so it signs in the device it is opened on, from any device
    const url = new URL(location.href);
    const tokenHash = url.searchParams.get("token_hash"), linkType = url.searchParams.get("type");
    if (tokenHash && (linkType === "invite" || linkType === "magiclink" || linkType === "email")) {
      try { await supabase.auth.verifyOtp({ token_hash: tokenHash, type: linkType as any }); }
      catch { /* an old or used link: the sign-in card below still works */ }
      history.replaceState(null, "", location.pathname + location.hash);
    }
    const { data: { session } } = await supabase.auth.getSession();
    show("loading", false);
    if (session?.user) {
      userId = session.user.id;
      userEmail = session.user.email ?? "";
      firstName = await resolveFirstName(session.user);
      $("greet").textContent = greeting();
      $("greet").closest(".flex.flex-wrap")!.classList.add("mh-rise");
      show("namechange", !!firstName);
      if (!firstName) askForName(guessNameFromEmail(userEmail));
      else hideNameForm();
      appLink?.classList.add("hidden");
      show("signout", true); show("home", true); show("auth", false);
      const wanted = window.location.hash.replace("#", "");
      if (wanted.startsWith("overview-") && SEC_ORDER.includes(wanted.slice(9) as SecKey)) ovSection = wanted.slice(9) as SecKey;
      setTab(["overview", "labs", "reports", "depth"].includes(wanted) || wanted.startsWith("overview-") ? wanted.split("-")[0] : "overview");
      await Promise.all([loadPeople(), loadPlan()]);
      applyPersonMode();
      if (wanted === "group") setTab("group");   // only once the people are known
      await Promise.all([refresh(), loadPersonNote(), loadSharing(), loadInvites(), loadAsked(), loadRequests(), loadGlance(), loadAiSummary()]);
    } else {
      firstName = "";
      people = []; person = null;
      show("peoplewrap", false);
      appLink?.classList.remove("hidden");
      show("auth", true); show("home", false); show("signout", false);
    }
  }

  /**
   * The name the app greets you with, in the same order the app resolves
   * it: the profile name set in Settings, then the full name Apple gave,
   * then nothing. Never the email — "roplekarsudeep" is not a name.
   */
  async function resolveFirstName(user: { id: string; user_metadata?: Record<string, unknown> }): Promise<string> {
    let full = "";
    try {
      const { data } = await supabase.from("profiles").select("name").eq("user_id", user.id).maybeSingle();
      full = String(data?.name ?? "").trim();
    } catch { /* no profile row, or none we may read: fall through */ }
    if (!full) full = String(user.user_metadata?.full_name ?? "").trim();
    fullName = full;
    return full.split(/\s+/)[0] ?? "";
  }

  /**
   * A first name from an email, only when the address is plainly a name:
   * "sadiya.naik@" gives Sadiya, "roplekarsudeep@" gives nothing, because a
   * wrong guess in a greeting is worse than a question. The guess is only
   * ever a prefilled field the person confirms with a tap.
   */
  function guessNameFromEmail(email: string): string {
    const local = email.split("@")[0] ?? "";
    const parts = local.split(/[._-]/).filter(Boolean);
    if (parts.length < 2) return "";
    const first = parts[0];
    if (!/^[a-z]{2,20}$/i.test(first)) return "";
    return first[0].toUpperCase() + first.slice(1).toLowerCase();
  }

  /** "Good evening, Sudeep", or just "Good evening" when no name is known. */
  function greeting(): string {
    if (person && !person.self) return person.name || "Unnamed";
    const hour = new Date().getHours();
    const tod = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    return firstName ? `${tod}, ${firstName}` : tod;
  }

  // ── the reader at work, shown on every tab ─────────────────────────────
  // A read is a fetch: it carries on whichever tab is open, and even if the
  // page is scrolled away. What the person needs is to see that it is
  // happening and roughly how far along it is. Leaving the page is the one
  // thing that loses it, so the browser asks first while a read is on.
  let busyCount = 0;
  let busyTimer: number | undefined;
  const busyBar = () => $("busybar") as HTMLElement;
  function busyStart(text: string, sub = "Verve is reading every value and its printed range — usually 20 to 40 seconds. You can move around the site meanwhile.") {
    busyCount++;
    $("busytext").textContent = text;
    $("busysub").textContent = sub;
    show("busy", true); $("busy").classList.add("flex");
    $("busyicon").firstElementChild!.classList.add("mh-spin");
    if (busyTimer) { clearTimeout(busyTimer); busyTimer = undefined; }
    busyBar().classList.remove("mh-creep");
    busyBar().style.width = "0%";
    void busyBar().offsetWidth;
    busyBar().classList.add("mh-creep");
    busyBar().style.width = "90%";
  }
  function busyEnd(text: string, sub: string, ok: boolean) {
    busyCount = Math.max(0, busyCount - 1);
    if (busyCount > 0) return;
    busyBar().classList.remove("mh-creep");
    busyBar().style.width = "100%";
    $("busyicon").firstElementChild!.classList.remove("mh-spin");
    $("busytext").textContent = text;
    $("busysub").textContent = sub;
    busyBar().classList.toggle("bg-danger", !ok);
    busyBar().classList.toggle("bg-accent", ok);
    busyTimer = window.setTimeout(() => { show("busy", false); $("busy").classList.remove("flex"); }, ok ? 6000 : 12000);
  }
  $("busy").addEventListener("click", () => setTab("reports"));
  window.addEventListener("beforeunload", (e) => {
    if (busyCount > 0) { e.preventDefault(); e.returnValue = ""; }
  });

  /** The one way to add a report: the Reports tab, and its picker. */
  function pickReport() {
    setTab("reports");
    $("file").click();
  }
  $("addreport").addEventListener("click", pickReport);
  $("tosendgo").addEventListener("click", () => {
    const paths = pendingReports();
    if (!paths.length) return;
    setTab("reports");
    reviewPos = { n: 1, of: paths.length };
    reviewQueue = paths.slice(1).map((p) => () => reviewFromArchive(p));
    reviewFromArchive(paths[0]);
  });

  // ── a name for an account that has none: the greeting asks, once. The
  // answer is saved with the account (where the app's setup reads it) and
  // into the app's own profile when that has no name, so the app greets by
  // it too after its next sync. ──────────────────────────────────────────
  const LATER_KEY = "mh-name-later";
  function askForName(prefill: string) {
    let later = false;
    try { later = sessionStorage.getItem(LATER_KEY) === "1"; } catch { /* no storage: ask */ }
    if (later) return;
    ($("namein") as HTMLInputElement).value = prefill;
    $("nameform").classList.remove("hidden"); $("nameform").classList.add("flex");
  }
  function hideNameForm() { $("nameform").classList.add("hidden"); $("nameform").classList.remove("flex"); }
  $("namelater").addEventListener("click", () => {
    try { sessionStorage.setItem(LATER_KEY, "1"); } catch { /* fine */ }
    hideNameForm();
  });
  $("namechange").addEventListener("click", () => {
    ($("namein") as HTMLInputElement).value = fullName;
    $("nameform").classList.remove("hidden"); $("nameform").classList.add("flex");
    $("namein").focus();
  });
  $("nameform").addEventListener("submit", async (e) => {
    e.preventDefault();
    const name = ($("namein") as HTMLInputElement).value.trim().replace(/\s+/g, " ");
    if (!name) return;
    const { error } = await supabase.auth.updateUser({ data: { full_name: name } });
    if (error) { msg("upmsg", `Could not save your name: ${error.message}`, true); return; }
    // the app's profile, only where it has no name of its own
    try {
      await supabase.from("profiles").update({ name, updated_at: new Date().toISOString() })
        .eq("user_id", userId).or("name.is.null,name.eq.");
      if (person?.self && person.id) await supabase.from("people").update({ name }).eq("id", person.id);
    } catch { /* no profile row yet: the app's setup will read full_name */ }
    fullName = name;
    firstName = name.split(/\s+/)[0] ?? "";
    $("greet").textContent = greeting();
    show("namechange", true);
    hideNameForm();
  });
  $("emptyadd").addEventListener("click", pickReport);

  /** Refetch web_labs + imaging_reports once; every surface renders from them. */
  async function refresh() {
    const [{ data: rows }, { data: imaging }, { data: app }] = await Promise.all([
      scopeRows(supabase.from("web_labs")
        .select("analyte, value, unit, ref_low, ref_high, ref_text, section, measured_on, report_path"))
        .order("measured_on", { ascending: true }).limit(4000),
      scopeRows(supabase.from("imaging_reports")
        .select("modality, report_date, report_path, impression, findings"))
        .order("report_date", { ascending: true }).limit(200),
      // the app's rows exist only for a person with an account of their own
      person?.account_id
        ? supabase.from("lab_readings").select("*").eq("user_id", person.account_id).is("deleted_at", null).limit(2000)
        : Promise.resolve({ data: [] as any[] }),
    ]);
    allLabs = rows ?? [];
    allImaging = imaging ?? [];
    allApp = app ?? [];
    groupLabs();
    renderOverview();
    renderLabsRail(); renderLabsPanel();
    await renderReports();
    await loadActivity();
  }

  // ═══ THE APP'S SHARE OF A REPORT ═════════════════════════════════════════
  // Every value of a report is filed here. The app's markers reach the app
  // only when they are sent, and until now nothing remembered which reports
  // had been sent. This reads it from the two tables: a report's app-bound
  // values are the archived rows whose canonical name is one of the app's
  // markers, in the app's unit; one is "sent" when a lab_readings row on the
  // same day carries that value.

  /** Canonical analyte name (letters and digits only) → the app's column. */
  const APP_KEY_BY_NAME: Record<string, string> = {
    fastingglucose: "glucose_mgdl", glucosefasting: "glucose_mgdl", fastingbloodsugar: "glucose_mgdl", fbs: "glucose_mgdl", glucosef: "glucose_mgdl",
    hba1c: "hba1c_pct", hemoglobina1c: "hba1c_pct", glycatedhemoglobin: "hba1c_pct", glycosylatedhemoglobin: "hba1c_pct",
    postmealglucose: "post_meal_glucose_mgdl", postprandialglucose: "post_meal_glucose_mgdl", ppglucose: "post_meal_glucose_mgdl", glucosepp: "post_meal_glucose_mgdl", glucosepostprandial: "post_meal_glucose_mgdl",
    fastinginsulin: "fasting_insulin_uiuml", insulinfasting: "fasting_insulin_uiuml", insulin: "fasting_insulin_uiuml",
    triglycerides: "triglycerides_mgdl", hdl: "hdl_mgdl", hdlcholesterol: "hdl_mgdl",
    waist: "waist_cm", waistcircumference: "waist_cm",
    systolicbp: "sbp", systolicbloodpressure: "sbp", diastolicbp: "dbp", diastolicbloodpressure: "dbp",
    apob: "apo_b_mgdl", apolipoproteinb: "apo_b_mgdl", ldl: "ldl_mgdl", ldlcholesterol: "ldl_mgdl",
    lpa: "lpa_value", lipoproteina: "lpa_value",
    hscrp: "hs_crp_mgl", highsensitivitycrp: "hs_crp_mgl", crphs: "hs_crp_mgl", hscreactiveprotein: "hs_crp_mgl",
    bodyfat: "body_fat_pct", bodyfatpercentage: "body_fat_pct", skeletalmuscle: "skel_musc_pct", skeletalmusclepercentage: "skel_musc_pct",
    musclemass: "skel_musc_pct", musclemasspercentage: "skel_musc_pct",
    leanmassarmsandlegs: "alm_kg", appendicularleanmass: "alm_kg", alm: "alm_kg",
    wholebodyleanmass: "ffm_kg", fatfreemass: "ffm_kg", leanmass: "ffm_kg", leanbodymass: "ffm_kg",
    gripstrength: "handgrip_kg", handgrip: "handgrip_kg", handgripstrength: "handgrip_kg",
    singlelegbalance: "single_leg_balance_seconds", singlelegstand: "single_leg_balance_seconds", onelegstand: "single_leg_balance_seconds",
    chairstand: "chair_stand_seconds", chairstand5: "chair_stand_seconds", sittostand: "chair_stand_seconds", fivetimessittostand: "chair_stand_seconds",
    walkspeed: "gait_speed_ms", gaitspeed: "gait_speed_ms", usualgaitspeed: "gait_speed_ms",
  };
  const squash = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "");
  function appKeyFor(analyte: string): string | null {
    return APP_KEY_BY_NAME[squash(canonName(String(analyte)))] ?? null;
  }
  /** The app stores one unit per marker; a value in another unit is not sent from the archive. */
  function unitFits(key: string, unit: string | null): boolean {
    if (key === "lpa_value") return true;
    const want = LABELS[key].unit;
    if (!want) return true;
    return unitKey(unit ?? "") === unitKey(want);
  }
  const localDay = (iso: string) => new Date(iso).toLocaleDateString("en-CA");

  type AppBound = { key: string; value: number; unit: string | null; name: string };
  /** A report's app-bound values, one per marker, from its archived rows. */
  function appBoundFor(path: string): { date: string; values: AppBound[] } {
    if (!isSelf()) return { date: "", values: [] };   // the app tier is yours alone
    if (path.startsWith("export:")) return { date: "", values: [] };   // came from the app: nothing to send back
    const rows = allLabs.filter((r) => r.report_path === path);
    const values: AppBound[] = [];
    for (const r of rows) {
      const key = appKeyFor(r.analyte);
      if (!key || values.some((v) => v.key === key) || !unitFits(key, r.unit) || !Number.isFinite(Number(r.value))) continue;
      values.push({ key, value: Number(r.value), unit: r.unit ?? null, name: String(r.analyte) });
    }
    return { date: rows[0]?.measured_on ?? "", values };
  }
  function isSent(date: string, key: string, value: number): boolean {
    return allApp.some((a) => localDay(a.measured_at) === date && Number(a[key]) === value);
  }
  /** The app's columns a row carries, for counting what a report sent. */
  const APP_KEYS = Object.keys(LABELS);
  /** What a report's card says: how many of its app values the app holds, and how many await a look there. */
  function reportAppState(path: string) {
    const { date, values } = appBoundFor(path);
    const pending = values.filter((v) => !isSent(date, v.key, v.value));
    const unchecked = allApp
      .filter((a) => a.report_path === path && a.review_status === "unchecked")
      .reduce((n, a) => n + APP_KEYS.filter((k) => a[k] != null).length, 0);
    return { date, total: values.length, sent: values.length - pending.length, pending, unchecked };
  }
  /** Values the app holds from reports that nobody has looked at yet, across the archive. */
  function uncheckedInApp(): number {
    if (!isSelf()) return 0;
    return allApp
      .filter((a) => a.review_status === "unchecked")
      .reduce((n, a) => n + APP_KEYS.filter((k) => a[k] != null).length, 0);
  }
  /** Reports with app values the app does not have yet, newest first. */
  function pendingReports(): string[] {
    const paths = [...new Set(allLabs.map((r) => r.report_path).filter(Boolean))] as string[];
    return paths
      .filter((p) => reportAppState(p).pending.length > 0)
      .sort((a, b) => (appBoundFor(b).date || "").localeCompare(appBoundFor(a).date || ""));
  }

  // ── two modes, one card: the same account works here and in the app ────
  let authMode: "signin" | "signup" = "signin";
  function setAuthMode(m: "signin" | "signup") {
    authMode = m;
    document.querySelectorAll("[data-mode]").forEach((b) => {
      const on = (b as HTMLElement).dataset.mode === m;
      b.className = `rounded-full px-4 py-1.5 text-[13px] ${on ? "bg-accent/20 font-bold text-text-primary" : "font-semibold text-text-tertiary hover:text-text-primary"}`;
    });
    // Sign-in needs no note: the left column says whose login it is, and
    // the Apple line sits under the email link it is about.
    const note = m === "signin"
      ? ""
      : "No app needed to start — this account works here today and signs into the Verve app whenever you get it.";
    $("modenote").textContent = note;
    show("modenote", !!note);
    $("authsubmit").textContent = m === "signin" ? "Sign in" : "Create my account";
    ($("password") as HTMLInputElement).placeholder = m === "signin" ? "Password" : "Choose a password (8+ characters)";
    ($("password") as HTMLInputElement).autocomplete = m === "signin" ? "current-password" : "new-password";
    show("forgot", m === "signin");
    show("magic", m === "signin");
    show("ordiv", m === "signin");
    show("applenote", m === "signin");
    $("newsletterrow").classList.toggle("hidden", m !== "signup");
    $("newsletterrow").classList.toggle("flex", m === "signup");
    show("namerow", m === "signup");
    msg("authmsg", "");
  }
  document.querySelectorAll("[data-mode]").forEach((b) =>
    b.addEventListener("click", () => setAuthMode((b as HTMLElement).dataset.mode as any)));
  setAuthMode("signin");

  $("pwform").addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = ($("email") as HTMLInputElement).value.trim();
    const password = ($("password") as HTMLInputElement).value;
    if (authMode === "signup") {
      if (password.length < 8) { msg("authmsg", "Choose a password of at least 8 characters.", true); return; }
      const fullName = ($("fullname") as HTMLInputElement).value.trim();
      if (!fullName) { msg("authmsg", "Your name, so the app and this page can greet you.", true); return; }
      msg("authmsg", "Creating your account…");
      const optIn = ($("newsletter") as HTMLInputElement).checked;
      const { data, error } = await supabase.auth.signUp({
        email, password,
        options: {
          emailRedirectTo: window.location.origin + "/my-health/",
          // consent travels with the account: user_metadata, exportable later
          data: { full_name: fullName, newsletter_opt_in: optIn, newsletter_opt_in_at: optIn ? new Date().toISOString() : null },
        },
      });
      if (error) { msg("authmsg", error.message, true); return; }
      // Supabase answers an existing address with a userless success — say so
      // honestly instead of promising an email that will never come.
      if (data.user && (data.user.identities?.length ?? 1) === 0) {
        msg("authmsg", "That address already has a Verve account — switch to Sign in.", true);
        return;
      }
      if (data.session) { msg("authmsg", ""); boot(); return; }
      // No session: the project requires the email to be confirmed first. The
      // confirmation email carries a code and a link; the code is entered here.
      enterCodeStep(email, "signup");
      return;
    }
    msg("authmsg", "Signing in…");
    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) msg("authmsg", error.message, true);
    else { msg("authmsg", ""); boot(); }
  });

  // ── the code: one email carries the code and the link. The code
  // signs in whichever device it is typed on; the link, the one it is
  // opened on. Both come from the same Supabase call. ────────────────────
  let otpEmail = "";
  /** What the code proves: a sign-in, a new account's email, or a password reset. */
  let codeMode: "signin" | "signup" | "recovery" = "signin";
  /** True from a recovery code being checked until the new password is saved. */
  let recovering = false;
  let resendTimer: number | undefined;

  async function sendCode(email: string): Promise<boolean> {
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: { shouldCreateUser: false, emailRedirectTo: window.location.origin + "/my-health/" },
    });
    if (error) { msg("authmsg", error.message, true); return false; }
    return true;
  }

  /** The card flips: the email is out, the code is what is left. */
  function enterCodeStep(email: string, mode: "signin" | "signup" | "recovery" = "signin") {
    otpEmail = email;
    codeMode = mode;
    $("codehead").textContent =
      mode === "signup" ? "Confirm your email" : mode === "recovery" ? "Reset your password" : "Enter the code from the email";
    const to = `<strong class="font-semibold text-text-primary">${esc(email)}</strong>`;
    $("codelead").innerHTML =
      mode === "signup" ? `We sent a code to ${to}. Enter it here to finish creating your account. It expires in one hour.`
      : mode === "recovery" ? `We sent a code to ${to}. Enter it here, then choose a new password. It expires in one hour.`
      : `Sent to ${to}. It works on any device: read it on your phone, type it here. It expires in one hour.`;
    $("usepw").textContent = mode === "signin" ? "Use a password instead" : "Back";
    ["modenote", "pwform", "ordiv", "magic", "applenote"].forEach((id) => show(id, false));
    document.querySelectorAll("[data-mode]").forEach((b) => (b as HTMLElement).parentElement!.classList.add("hidden"));
    show("codestep", true);
    ($("code") as HTMLInputElement).value = "";
    msg("authmsg", "");
    $("code").focus();
    startResendCountdown();
  }

  function leaveCodeStep() {
    if (resendTimer) { clearInterval(resendTimer); resendTimer = undefined; }
    otpEmail = "";
    codeMode = "signin";
    show("codestep", false);
    document.querySelectorAll("[data-mode]").forEach((b) => (b as HTMLElement).parentElement!.classList.remove("hidden"));
    show("pwform", true);
    setAuthMode(authMode);
  }

  /** Sixty seconds: Supabase refuses a second email to the same address sooner. */
  function startResendCountdown() {
    if (resendTimer) clearInterval(resendTimer);
    let left = 60;
    const btn = $("resend") as HTMLButtonElement;
    const tick = () => {
      if (left > 0) { btn.disabled = true; btn.textContent = `Resend in ${Math.floor(left / 60)}:${String(left % 60).padStart(2, "0")}`; left--; }
      else { btn.disabled = false; btn.textContent = "Resend the code"; clearInterval(resendTimer); resendTimer = undefined; }
    };
    tick();
    resendTimer = window.setInterval(tick, 1000);
  }

  $("magic").addEventListener("click", async () => {
    const email = ($("email") as HTMLInputElement).value.trim();
    if (!email) { msg("authmsg", "Type your email above first.", true); return; }
    msg("authmsg", "Sending…");
    if (await sendCode(email)) enterCodeStep(email);
  });

  $("resend").addEventListener("click", async () => {
    msg("authmsg", "Sending again…");
    const redirect = { emailRedirectTo: window.location.origin + "/my-health/" };
    const ok = codeMode === "signup"
      ? !(await supabase.auth.resend({ type: "signup", email: otpEmail, options: redirect })).error
      : codeMode === "recovery"
        ? !(await supabase.auth.resetPasswordForEmail(otpEmail, { redirectTo: redirect.emailRedirectTo })).error
        : await sendCode(otpEmail);
    if (ok) { msg("authmsg", "A new code is on its way."); startResendCountdown(); }
    else if (codeMode !== "signin") msg("authmsg", "Could not send another code just now. Try again in a minute.", true);
  });

  $("usepw").addEventListener("click", () => leaveCodeStep());

  $("code").addEventListener("input", () => {
    const el = $("code") as HTMLInputElement;
    el.value = el.value.replace(/\D/g, "").slice(0, 10);
  });

  $("codeform").addEventListener("submit", async (e) => {
    e.preventDefault();
    // Supabase sets the length in the project's settings (six to ten digits).
    const token = ($("code") as HTMLInputElement).value.replace(/\D/g, "");
    if (token.length < 6) { msg("authmsg", "Type the whole code from the email.", true); return; }
    const btn = $("verify") as HTMLButtonElement;
    btn.disabled = true;
    msg("authmsg", "Checking…");
    // "signup" proves a new account's address, "recovery" a password reset,
    // "email" is a sign-in code.
    const type = codeMode === "signup" ? "signup" : codeMode === "recovery" ? "recovery" : "email";
    // A recovery code signs in as it is checked; the flag keeps the reset
    // card in front of the dashboard until the new password is saved.
    recovering = codeMode === "recovery";
    const { error } = await supabase.auth.verifyOtp({ email: otpEmail, token, type });
    btn.disabled = false;
    // Supabase answers a wrong code and a stale one with the same message.
    if (error) { recovering = false; msg("authmsg", "That code did not match, or has expired. Check it, or send a new one.", true); return; }
    msg("authmsg", "");
    const wasRecovery = codeMode === "recovery";
    leaveCodeStep();
    if (wasRecovery) { showReset(); return; }
    boot();
  });

  /** The reset card, alone on the page. */
  function showReset() {
    show("loading", false); show("auth", false); show("home", false);
    show("pwreset", true);
    ($("newpw") as HTMLInputElement).value = "";
    ($("newpw2") as HTMLInputElement).value = "";
    msg("pwmsg", "");
    $("newpw").focus();
  }

  $("signout").addEventListener("click", async () => {
    await supabase.auth.signOut();
    boot();
  });

  // ── show/hide password — the eye at the end of the bar ────────────────
  document.querySelectorAll("[data-eye]").forEach((b) =>
    b.addEventListener("click", () => {
      const input = $((b as HTMLElement).dataset.eye!) as HTMLInputElement;
      const showing = input.type === "text";
      input.type = showing ? "password" : "text";
      b.setAttribute("aria-label", showing ? "Show password" : "Hide password");
      (b as HTMLElement).classList.toggle("text-accent-light", !showing);
    }));

  // ── forgot password → a code by email → the code opens the reset card.
  // The email's link is kept for the device it is opened on; the code is
  // what works from any device, and what a mail scanner cannot use up. ──
  $("forgot").addEventListener("click", async () => {
    const email = ($("email") as HTMLInputElement).value.trim();
    if (!email) { msg("authmsg", "Type your email above first.", true); return; }
    msg("authmsg", "Sending…");
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: window.location.origin + "/my-health/",
    });
    if (error) { msg("authmsg", error.message, true); return; }
    enterCodeStep(email, "recovery");
  });

  $("pwform2").addEventListener("submit", async (e) => {
    e.preventDefault();
    const pw = ($("newpw") as HTMLInputElement).value;
    const pw2 = ($("newpw2") as HTMLInputElement).value;
    if (pw.length < 8) { msg("pwmsg", "Eight characters or more.", true); return; }
    if (pw !== pw2) { msg("pwmsg", "The two passwords do not match.", true); return; }
    const btn = $("savepw") as HTMLButtonElement;
    btn.disabled = true;
    msg("pwmsg", "Saving…");
    const { error } = await supabase.auth.updateUser({ password: pw });
    btn.disabled = false;
    if (error) { msg("pwmsg", error.message, true); return; }
    recovering = false;
    msg("pwmsg", "Saved. This password now works in the app and here.");
    setTimeout(() => { show("pwreset", false); boot(); }, 1400);
  });

  // ── range helpers — every value against ITS OWN printed range ─────────
  function inRange(v: { value: number; ref_low?: number | null; ref_high?: number | null }): boolean | null {
    const lo = v.ref_low, hi = v.ref_high;
    if (lo == null && hi == null) return null;
    if (lo != null && v.value < lo) return false;
    if (hi != null && v.value > hi) return false;
    return true;
  }
  function rangeLabel(v: { ref_low?: number | null; ref_high?: number | null; ref_text?: string | null }): string {
    if (v.ref_text) return v.ref_text;
    if (v.ref_low != null && v.ref_high != null) return `${v.ref_low}–${v.ref_high}`;
    if (v.ref_high != null) return `<${v.ref_high}`;
    if (v.ref_low != null) return `>${v.ref_low}`;
    return "";
  }

  // ── grouping: section → canonical analyte → readings by date ──────────
  function groupLabs() {
    labSecs = new Map();
    for (const r of allLabs) {
      const s = SECTIONS[r.section] ? r.section : "other";
      const sec = labSecs.get(s) ?? labSecs.set(s, new Map()).get(s)!;
      const key = canonName(String(r.analyte));
      (sec.get(key) ?? sec.set(key, []).get(key)!).push(r);
    }
    if (!labSecs.has(labSection)) labSection = SECTION_ORDER.find((s) => labSecs.has(s)) ?? "";
  }

  // ═══ OVERVIEW ═══════════════════════════════════════════════════════════
  /** A section's ring: latest readings in range, out of those with a printed range. */
  function ringSvg(ok: number, judged: number, i = 0): string {
    const C = 2 * Math.PI * 22;
    const frac = judged ? ok / judged : 0;
    const len = (frac * C).toFixed(1);
    const color = judged === 0 ? "#64748b" : ok === judged ? "#34d399" : "#FBBF24";
    return `
      <svg width="52" height="52" viewBox="0 0 56 56" aria-hidden="true">
        <circle cx="28" cy="28" r="22" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="5"/>
        <circle class="mh-ring" style="--len: ${len}; --i: ${i}" cx="28" cy="28" r="22" fill="none" stroke="${color}" stroke-width="5" stroke-linecap="round"
          stroke-dasharray="${len} ${C.toFixed(1)}" transform="rotate(-90 28 28)"/>
        <text x="28" y="26.5" text-anchor="middle" font-size="13" font-weight="800" fill="#f1f5f9">${judged ? ok : "–"}</text>
        <text x="28" y="37" text-anchor="middle" font-size="7.5" fill="#64748b">${judged ? `of ${judged}` : "no range"}</text>
      </svg>`;
  }

  /** A tiny trend line for a card: the series on its own scale, last point marked. */
  function sparkline(rs: any[], color: string): string {
    const vals = rs.map((r) => Number(r.value));
    if (vals.length < 2) return "";
    const lo = Math.min(...vals), hi = Math.max(...vals);
    const x = (i: number) => 3 + (i / (vals.length - 1)) * 74;
    const y = (v: number) => hi === lo ? 13 : 23 - ((v - lo) / (hi - lo)) * 20;
    const pts = vals.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(" ");
    const last = vals.length - 1;
    return `<svg width="80" height="26" viewBox="0 0 80 26" class="shrink-0" aria-hidden="true">
      <polyline points="${pts}" fill="none" stroke="${color}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="${x(last).toFixed(1)}" cy="${y(vals[last]).toFixed(1)}" r="2.6" fill="${color}"/></svg>`;
  }

  /**
   * Worth a look: what moved, first. Two rows.
   *
   * Today is the app's daily read, judged the way the app's Today tile
   * judges it: the resting rate against the median of the person's own
   * prior 30 mornings, the night against the usual and the 7 to 9 hour
   * band, steps as counted, recovery against the one cited line. This
   * week is the app's week against the goal, the latest lab values outside
   * their lab's own range, worst first, and the nearest retest. A card
   * opens where its number came from. Runs when the labs arrive and again
   * when the app's rows do, since the two come at different times.
   */
  function renderWorth() {
    const today = new Date().toLocaleDateString("en-CA"), thisMonday = mondayOf(new Date());
    const tagOf = (t: string) => `<span class="shrink-0 rounded-md bg-white/[0.06] px-1.5 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider text-text-secondary">${t}</span>`;
    const card = (o: { title: string; tag: string; value: string; unit?: string; tone?: string; spark?: string; line: string; go: string; i: number }) => `
      <button type="button" data-go="${o.go}" style="--i: ${o.i}" class="mh-rise flex flex-col gap-1.5 rounded-2xl border bg-white/4 p-4 text-left transition-colors ${o.tone === "warn" ? "border-warning/35 hover:border-warning/60" : o.tone === "bad" ? "border-danger/35 hover:border-danger/60" : "border-white/8 hover:border-white/16"}">
        <span class="flex w-full items-center justify-between gap-2"><span class="min-w-0 truncate text-sm font-semibold text-text-primary">${o.title}</span>${tagOf(o.tag)}</span>
        <span class="flex w-full items-end justify-between gap-3"><span class="font-mono text-[26px] font-bold leading-none ${o.tone === "warn" ? "text-warning" : o.tone === "bad" ? "text-danger" : o.tone === "met" ? "text-met-hero" : o.tone === "ok" ? "text-success-light" : "text-text-primary"}">${o.value}${o.unit ? ` <span class="text-xs font-semibold">${o.unit}</span>` : ""}</span>${o.spark ?? ""}</span>
        <span class="text-xs leading-snug text-text-tertiary">${o.line}</span>
      </button>`;

    // ── today: the app's daily read ──────────────────────────────────────
    const heart = sleepHeartSummary(syncSignals, today);
    const t: string[] = [];
    if (heart) {
      const r = heart.rhr;
      if (r.latest != null) t.push(card({ title: "Resting heart rate", tag: "App", value: String(r.latest), unit: "bpm", i: t.length, go: "depth",
        tone: r.status === "stronglyElevated" ? "bad" : r.status === "elevated" ? "warn" : "",
        line: r.baseline != null
          ? `${r.delta === 0 ? "At" : `${Math.abs(r.delta!)} ${r.delta! > 0 ? "above" : "below"}`} ${person?.self ? "your" : "their"} own normal of ${r.baseline}${r.run > 1 ? ` · ${r.run} mornings running` : ""}`
          : `${esc(dayWord(r.latestDay!))} · a normal needs 14 mornings, ${r.priors} so far` }));
      const sl = heart.sleep;
      if (sl.last) t.push(card({ title: "Sleep", tag: "App", i: t.length, go: "depth", tone: sl.last.band === "inRange" ? "" : "warn",
        value: `${Math.floor(sl.last.min / 60)}<span class="text-xs font-semibold">h</span> ${String(Math.round(sl.last.min % 60)).padStart(2, "0")}<span class="text-xs font-semibold">m</span>`,
        line: `${sl.usual != null ? (Math.abs(sl.last.min - sl.usual) < 20 ? "About the usual" : `${fmtSleepMin(Math.abs(sl.last.min - sl.usual))} ${sl.last.min < sl.usual ? "under" : "over"} the usual`) : sl.last.band === "short" ? "Under 7 h" : sl.last.band === "long" ? "Over 9 h" : "In the 7 to 9 h band"}${sl.last.bed ? ` · in bed ${esc(sl.last.bed)}` : ""}` }));
      if (heart.steps.latest) t.push(card({ title: "Steps", tag: "App", value: heart.steps.latest.steps.toLocaleString(), i: t.length, go: "depth",
        line: `${esc(dayWord(heart.steps.latest.day))}${heart.steps.avg != null ? ` · ${heart.steps.avg.toLocaleString()} a day over the last 7` : ""}` }));
      const h = heart.hrr;
      if (h.latest != null) t.push(card({ title: "Heart rate recovery", tag: "App", value: String(h.latest), unit: "bpm", i: t.length, go: "depth", tone: h.latest <= 12 ? "bad" : "",
        line: `${esc(dayWord(h.latestDay!))}${h.median != null ? ` · own median ${h.median}` : ""}${h.latest <= 12 ? " · at or under the cited 12" : ""}` }));
    }
    const newest = syncSignals.length ? String(syncSignals[syncSignals.length - 1].day) : "";
    $("worthtodaykick").textContent = newest === today ? `TODAY · ${new Date().toLocaleDateString(undefined, { weekday: "long" }).toUpperCase()}` : newest ? `LATEST FROM THE APP · ${fmtDay(newest).toUpperCase()}` : "";
    show("worthtoday", t.length > 0);
    $("worthtodaycards").innerHTML = t.join("");

    // ── this week: the app's week, the labs, the nearest retest ───────────
    const w: string[] = [];
    const left = 6 - daysBetween(thisMonday, today);
    if (allWeeks.length) {
      const goal = Number(syncProfile?.weekly_met_hours_goal) || 7.5;
      const act = activitySummary(allWeeks, syncActs, goal, today, thisMonday);
      const tw = act.thisWeek ? Number(act.thisWeek.met_hours) : 0, n = act.thisWeek ? Number(act.thisWeek.workouts) : 0;
      w.push(card({ title: "MET-hours", tag: "App", value: fmt1(tw), unit: `of ${goal}`, tone: tw >= goal ? "ok" : "met", i: 4, go: "depth",
        line: `${n === 0 ? "No workout yet this week" : `${n} workout${n === 1 ? "" : "s"} so far`} · ${tw >= goal ? "at goal" : `${fmt1(goal - tw)} to go, ${left === 0 ? "today is the last day" : `${left} day${left === 1 ? "" : "s"} left`}`}${act.streak ? ` · ${act.streak} week${act.streak === 1 ? "" : "s"} at goal in a row` : ""}` }));
    }

    // the latest reading out of its own range, worst first
    type Finding = { sec: string; name: string; rs: any[]; latest: any; n: number; first: any; sev: number };
    const findings: Finding[] = [];
    let inCount = 0, judged = 0;
    for (const [sec, m] of labSecs) for (const [name2, rs] of m) {
      const latest = rs[rs.length - 1];
      const ok = inRange(latest);
      if (ok !== null) judged++;
      if (ok === true) inCount++;
      if (ok !== false) continue;
      const lo = latest.ref_low, hi = latest.ref_high;
      const width = lo != null && hi != null ? hi - lo : Math.abs(hi ?? lo ?? 1) || 1;
      const dist = lo != null && latest.value < lo ? lo - latest.value : latest.value - (hi ?? 0);
      findings.push({ sec, name: name2, rs, latest, n: rs.length, first: rs[0], sev: dist / (width || 1) });
    }
    findings.sort((a, b) => b.sev - a.sev);
    const top = findings.slice(0, w.length ? 2 : 3);
    setTabCount("labs", findings.length ? `${findings.length} outside` : "", findings.length ? "text-warning" : "text-text-tertiary");
    $("worthall").textContent = findings.length > top.length
      ? `All ${findings.length} outside range in Labs →` : findings.length ? "Open in Labs →" : "";
    show("worthall", findings.length > 0);
    for (const f of top) {
      const dir = f.latest.ref_low != null && f.latest.value < f.latest.ref_low ? "below" : "above";
      const trend = f.n > 1 ? `${f.first.value} → ${f.latest.value} across ${f.n} reports` : `from ${fmtDay(f.latest.measured_on)}`;
      w.push(card({ title: esc(f.name), tag: esc(SECTIONS[f.sec]), value: String(f.latest.value), unit: f.latest.unit ? esc(f.latest.unit) : "", tone: "warn", spark: sparkline(f.rs, "#FBBF24"), i: w.length + 4,
        go: `marker:${encodeURIComponent(f.sec)}|${encodeURIComponent(f.name)}`, line: `${dir} the lab&rsquo;s range ${esc(rangeLabel(f.latest))} · ${esc(trend)}` }));
    }
    if (!findings.length && judged) w.push(card({ title: "Labs", tag: "Labs", value: `${inCount} <span class="text-xs font-semibold">of ${judged}</span>`, tone: "ok", i: w.length + 4, go: "labs", line: "Nothing outside its lab&rsquo;s printed range right now" }));


    // the nearest retest, from the cited cadences the In depth tab uses
    const by = markerPoints();
    const dues = [...labRowsFrom(by, today).map((r) => r.due), fitnessSummary(allCrf, today).due, bodyDueFrom(by, today)]
      .filter((d): d is Due => !!d).sort((x, y) => x.days - y.days);
    if (dues[0]) w.push(card({ title: `${esc(dues[0].what)} retest`, tag: "Due", i: w.length + 4, go: "depth",
      value: dues[0].days === 0 ? "Today" : String(Math.abs(dues[0].days)), unit: dues[0].days === 0 ? "" : dues[0].days < 0 ? "days overdue" : "days",
      tone: dues[0].days < 0 ? "bad" : dues[0].days <= 30 ? "warn" : "", line: esc(dues[0].why) }));

    $("worthweekkick").textContent = `THIS WEEK · ${left === 0 ? "LAST DAY" : `${left} DAY${left === 1 ? "" : "S"} LEFT`}`;
    show("worthweek", w.length > 0);
    $("worth").innerHTML = w.join("");
    show("worthwrap", t.length > 0 || w.length > 0);
    show("emptycard", !allLabs.length && !allWeeks.length && !syncSignals.length);
    $("worthwrap").querySelectorAll("[data-go]").forEach((b) => b.addEventListener("click", () => {
      const go = (b as HTMLElement).dataset.go!;
      if (go.startsWith("marker:")) { const [sec, name3] = go.slice(7).split("|").map(decodeURIComponent); openMarker(sec, name3); }
      else setTab(go);
    }));
    wireGoto();
    renderSection();
  }

  // ═══ THE FOUR SECTIONS UNDER OVERVIEW ═══════════════════════════════════
  // Fitness, Movement, Sleep & heart, Body: the same four subjects the
  // science section is written in. Each shows the markers the app captures
  // for it as tiles, and one marker opened: a day, a week, a month or a year
  // of it, drawn against the person's own normal or the goal, then what
  // Verve reads from it and what else moved on the same days. Every rule
  // here is the app's own, so the two never disagree; the science link on
  // each section is the page the rule is cited on.
  //
  // Two kinds of marker. A DAILY one has a value most days (resting heart
  // rate, sleep, steps, the day's MET-hours) and gets day, week, month and
  // year. A SPARSE one has a reading now and then (a fitness test, a
  // waist, a grip) and gets six months, a year, or everything: a "day" of
  // a waist is nothing to look at.
  type SecKey = "fitness" | "movement" | "heart" | "body";
  type Rng = "day" | "week" | "month" | "year" | "6m" | "1y" | "all";
  type Pt2 = { d: string; v: number; note?: string };
  type Marker = {
    key: string; section: SecKey; label: string; unit: string; sub: string;
    daily: boolean; sum?: boolean;              // a daily marker that adds up (steps, MET-hours) rather than averages
    avgDay?: boolean;                           // adds up within a day, but a year of it reads as a daily average (steps)
    color: string; science: string; source: string;
    fmt: (v: number) => string;
    series: () => Pt2[];                        // every point, oldest first
    goal?: () => number | null;                 // a weekly goal, drawn as a line on the week
    band?: () => { lo: number; hi: number; why: string } | null;   // the person's own normal, shaded
    reads: (pts: Pt2[]) => string[];            // what Verve reads, in sentences
  };
  const SEC_META: Record<SecKey, { label: string; dot: string; blurb: string; science: string }> = {
    fitness:  { label: "Fitness",       dot: "#f97316", blurb: "What a MET is, how yours is measured, and how much to trust the answer.", science: "/science/fitness" },
    movement: { label: "Movement",      dot: "#34d399", blurb: "How much, how hard, how often, and how much of the rest of the day is sitting.", science: "/science/movement" },
    heart:    { label: "Sleep & heart", dot: "#818cf8", blurb: "What the watch reads while you are asleep and in the minute after you stop.", science: "/science/sleep-heart" },
    body:     { label: "Body",          dot: "#FBBF24", blurb: "Waist, composition, and the function tests that say how the body works.", science: "/science/body" },
  };
  const SEC_ORDER: SecKey[] = ["fitness", "movement", "heart", "body"];
  let ovSection: "all" | SecKey = "all";
  let openMarkerKey = "";
  let openRange: Rng | "" = "";

  const todayStr = () => new Date().toLocaleDateString("en-CA");
  const round0 = (v: number) => String(Math.round(v));
  const fmtHM = (m: number) => `${Math.floor(m / 60)}h ${String(Math.round(m % 60)).padStart(2, "0")}m`;
  /** The app's rows by day: MET-hours, minutes by effort, Zone 2, the count. Only when the sessions themselves are here. */
  function actsByDay(): Map<string, { met: number; z2: number; n: number; vig: number; mod: number; min: number }> {
    const by = new Map<string, { met: number; z2: number; n: number; vig: number; mod: number; min: number }>();
    for (const a of syncActs) {
      if (!a?.timestamp) continue;
      const d = localDay(a.timestamp);
      const r = by.get(d) ?? { met: 0, z2: 0, n: 0, vig: 0, mod: 0, min: 0 };
      const mins = Number(a.duration_minutes) || 0;
      r.met += Number(a.met_hours) || 0; r.z2 += Number(a.zone2_minutes) || 0; r.n += 1; r.min += mins;
      if (a.intensity_category === "vigorous") r.vig += mins; else if (a.intensity_category === "moderate") r.mod += mins;
      by.set(d, r);
    }
    return by;
  }
  const signalSeries = (col: string): Pt2[] => syncSignals.filter((r) => r[col] != null).map((r) => ({ d: String(r.day), v: Number(r[col]) }));
  const sparseFrom = (key: string): Pt2[] => (markerPoints().get(key) ?? []).map((p) => ({ d: p.d, v: p.v }));
  const weeklyGoal = () => Number(syncProfile?.weekly_met_hours_goal) || 7.5;
  /** The person's own normal for a daily marker: the median of the prior 30 days, five either side. */
  function ownBand(pts: Pt2[], spread: number, why: string) {
    const last = pts[pts.length - 1]; if (!last) return null;
    const from = addDays(last.d, -30);
    const pri = pts.filter((p) => p.d >= from && p.d < last.d).map((p) => p.v);
    if (pri.length < 14) return null;
    const m = medianOf(pri)!;
    return { lo: Math.round(m) - spread, hi: Math.round(m) + spread, why };
  }

  const MARKERS: Marker[] = [
    // ── fitness ──
    { key: "mets", section: "fitness", label: "Fitness", unit: "METs", sub: "The number Verve leads with, from each test", daily: false, color: "#f97316",
      science: "/science/fitness/crf", source: "Every fitness test the app holds, compared only within its method.", fmt: (v) => fmt1(v),
      series: () => allCrf.filter((c) => c.met_capacity != null || c.vo2max != null).map((c) => ({ d: String(c.measured_on), v: c.met_capacity != null ? Number(c.met_capacity) : Number(c.vo2max) / 3.5, note: methodLabel(c.method) })),
      reads: () => { const f = fitnessSummary(allCrf, todayStr()); if (!f.latest) return ["No fitness test on file. The app offers one in six to twelve minutes."]; const out = [`<strong class="text-text-primary">${fmt1(f.latest.v / 3.5)} METs</strong> by ${esc(methodLabel(f.latest.method))} on ${esc(fmtDay(f.latest.measured_on))}${f.within != null ? `, ${f.within >= 0 ? "up" : "down"} ${fmt1(Math.abs(f.within) / 3.5)} on the same method before` : ", the first of its method"}.`]; if (f.latest.category) out.push(`Tier <strong class="text-text-primary">${esc(String(f.latest.category).replace(/-/g, " "))}</strong> for this age and sex. Each MET more is worth about 13% lower all-cause mortality in Kodama's pooled 33 studies.`); if (f.due) out.push(`Retest <strong class="${dueTone(f.due)}">${dueWord(f.due)}</strong>: the app's own reminder, eight weeks from the last.`); return out; } },
    { key: "vo2", section: "fitness", label: "VO₂max", unit: "mL/kg/min", sub: "The same tests, in the unit the studies use", daily: false, color: "#f97316",
      science: "/science/fitness/mets-vs-met-h", source: "Estimated from each test; a wearable's own figure is shown in grey in the app and never graded.", fmt: (v) => fmt1(v),
      series: () => allCrf.filter((c) => c.vo2max != null).map((c) => ({ d: String(c.measured_on), v: Number(c.vo2max), note: methodLabel(c.method) })),
      reads: (pts) => pts.length ? [`<strong class="text-text-primary">${fmt1(pts[pts.length - 1].v)} mL/kg/min</strong> on ${esc(fmtDay(pts[pts.length - 1].d))}. One MET is 3.5 of these; the tiers are drawn in METs.`] : ["No test on file."] },
    // ── movement ──
    { key: "met", section: "movement", label: "MET-hours", unit: "MET-h", sub: "The week's dose of movement", daily: true, sum: true, color: "#f97316",
      science: "/science/movement/weekly-volume", source: "Workouts the app synced, each as Verve read it; background movement is not counted here.", fmt: (v) => fmt1(v),
      series: () => [...actsByDay()].map(([d, r]) => ({ d, v: r.met })).sort((a, b) => a.d.localeCompare(b.d)), goal: weeklyGoal,
      reads: () => { const t = todayStr(), m = mondayOf(new Date()); const a = activitySummary(allWeeks, syncActs, weeklyGoal(), t, m); const tw = a.thisWeek ? Number(a.thisWeek.met_hours) : 0; const out = [`<strong class="text-text-primary">${fmt1(tw)} of ${weeklyGoal()}</strong> this week${tw >= weeklyGoal() ? ", at goal" : `, ${fmt1(weeklyGoal() - tw)} to go`}${a.streak ? ` · ${a.streak} week${a.streak === 1 ? "" : "s"} at goal in a row` : ""}.`]; if (a.change != null) out.push(`The last four weeks averaged <strong class="text-text-primary">${fmt1(a.recentAvg)}</strong> a week, ${a.change >= 0 ? "up" : "down"} ${Math.round(Math.abs(a.change) * 100)}% on the four before.`); out.push("One MET-hour is an hour at rest; a run earns more than a walk of the same length. The summit sits well above 150 minutes."); return out; } },
    { key: "z2", section: "movement", label: "Zone 2", unit: "min", sub: "Minutes in the personal heart-rate band", daily: true, sum: true, color: "#34d399",
      science: "/science/movement/zone-2", source: "Scored against each day's own band, set from the resting rate and the highest rate the app has seen.", fmt: (v) => round0(v),
      series: () => [...actsByDay()].map(([d, r]) => ({ d, v: r.z2 })).sort((a, b) => a.d.localeCompare(b.d)), goal: () => 150,
      reads: (pts) => { const m = mondayOf(new Date()); const wk = pts.filter((p) => p.d >= m).reduce((t, p) => t + p.v, 0); return [`<strong class="text-text-primary">${round0(wk)} of 150 minutes</strong> this week in the band. The target is a weekly dose, not a daily one.`, "The band moves as you do: a morning above your normal resting rate narrows it."]; } },
    { key: "sessions", section: "movement", label: "Workouts", unit: "", sub: "Sessions the app read, by day", daily: true, sum: true, color: "#a5b4fc",
      science: "/science/movement/a-workout", source: "One session is one row; the app keeps what the watch recorded and only reads the rest.", fmt: (v) => round0(v),
      series: () => [...actsByDay()].map(([d, r]) => ({ d, v: r.n })).sort((a, b) => a.d.localeCompare(b.d)),
      reads: () => { const a = activitySummary(allWeeks, syncActs, weeklyGoal(), todayStr(), mondayOf(new Date())); const kinds = [...a.kinds].sort((x, y) => y[1] - x[1]).slice(0, 3).map(([k, n]) => `${k} ${Math.round(n / Math.max(1, a.recent.length))}`).join(", "); return [`<strong class="text-text-primary">${Math.round(a.perWeek)} a week</strong> over the last ${a.recent.length} weeks${kinds ? `: ${esc(kinds)}` : ""}.`, `Last workout <strong class="text-text-primary">${a.quietDays == null ? "none on file" : a.quietDays === 0 ? "today" : a.quietDays === 1 ? "yesterday" : `${a.quietDays} days ago`}</strong>.`]; } },
    { key: "vig", section: "movement", label: "Vigorous", unit: "min", sub: "Minutes graded vigorous, by day", daily: true, sum: true, color: "#f87171",
      science: "/science/movement/weekly-volume", source: "Each session graded against the person's own heart-rate reserve, not a population band.", fmt: (v) => round0(v),
      series: () => [...actsByDay()].map(([d, r]) => ({ d, v: r.vig })).sort((a, b) => a.d.localeCompare(b.d)),
      reads: () => { const a = activitySummary(allWeeks, syncActs, weeklyGoal(), todayStr(), mondayOf(new Date())); return a.minutes ? [`Vigorous share <strong class="text-text-primary">${Math.round((a.vig / a.minutes) * 100)}%</strong> of the last four weeks' minutes.`, "Most of a week easy, one hard day: the shape the endurance literature keeps finding."] : ["No minutes on file yet."]; } },
    { key: "steps", section: "movement", label: "Steps", unit: "", sub: "Every source, one total a day", daily: true, sum: true, avgDay: true, color: "#34d399",
      science: "/science/movement/steps", source: "Apple Health's daily total, watch and phone together, pushed by the app on every sync.", fmt: (v) => Math.round(v).toLocaleString(),
      series: () => signalSeries("steps"),
      reads: (pts) => { const h = sleepHeartSummary(syncSignals, todayStr()); if (!h?.steps.avg) return ["No steps on file yet."]; return [`<strong class="text-text-primary">${h.steps.avg.toLocaleString()} a day</strong> over the last seven${h.steps.prior != null ? `, ${h.steps.avg >= h.steps.prior ? "up" : "down"} from ${h.steps.prior.toLocaleString()} the week before` : ""}.`, "Paluch's 2023 pooled cohorts found the mortality curve flattening around 7,000 to 8,000 a day for adults over 60, higher for younger adults, with the fall steepest from the lowest counts."]; } },
    // ── sleep & heart ──
    { key: "rhr", section: "heart", label: "Resting heart rate", unit: "bpm", sub: "Every morning, against your own normal", daily: true, color: "#818cf8",
      science: "/science/sleep-heart/resting-heart-rate", source: "Apple's one figure per day, from heart rate during stillness, weighted to sleep and the early morning.", fmt: (v) => round0(v),
      series: () => signalSeries("resting_hr"), band: () => ownBand(signalSeries("resting_hr"), 5, "the median of the prior 30 mornings, five either side"),
      reads: () => { const h = sleepHeartSummary(syncSignals, todayStr()); if (!h?.rhr.latest) return ["No resting heart rate on file yet."]; const r = h.rhr; const out = [`<strong class="text-text-primary">${r.latest} bpm</strong> ${esc(dayWord(r.latestDay!))}${r.baseline != null ? `, ${r.delta === 0 ? "at" : `${Math.abs(r.delta!)} ${r.delta! > 0 ? "above" : "below"}`} the median of the ${r.priors} mornings before${r.status === "elevated" ? `: <span class="text-warning">elevated</span>` : r.status === "stronglyElevated" ? `: <span class="text-danger">strongly elevated</span>` : ""}` : `; a normal needs 14 mornings, ${r.priors} so far`}.`]; out.push(r.run > 1 ? `<strong class="text-text-primary">${r.run} mornings running</strong> above the band. One is noise; three is a pattern. It says nothing about why: a late meal, heat, hard training and a cold all do this.` : `Inside the band ${r.inBand} of the last ${r.read} mornings read.`); if (r.level) out.push(`Absolute level <strong class="text-text-primary">${r.level}</strong> on the ARIC bands: a reading aid for a graded association, not a diagnosis.`); return out; } },
    { key: "sleep", section: "heart", label: "Sleep", unit: "", sub: "Time asleep, the night that ended each morning", daily: true, color: "#a5b4fc",
      science: "/science/sleep-heart/sleep-rhythm", source: "Every writer's asleep intervals; the stages from one elected writer per night.", fmt: (v) => fmtHM(v),
      series: () => signalSeries("sleep_minutes"), band: () => ({ lo: 420, hi: 540, why: "7 to 9 hours, the adult band" }),
      reads: () => { const h = sleepHeartSummary(syncSignals, todayStr()); if (!h?.sleep.last) return ["No night on file yet."]; const s = h.sleep; return [`<strong class="text-text-primary">${fmtSleepMin(s.last.min)}</strong> ${esc(dayWord(s.last.day))}${s.usual != null ? `, ${Math.abs(s.last.min - s.usual) < 20 ? "about the usual" : `${fmtSleepMin(Math.abs(s.last.min - s.usual))} ${s.last.min < s.usual ? "under" : "over"} the usual ${fmtSleepMin(s.usual)}`}` : ""}${s.last.bed ? ` · in bed ${esc(s.last.bed)}` : ""}.`, `${s.shortNights} of the last ${s.nights} nights under 7 h. A move toward the band is the improvement, not more sleep without limit.`]; } },
    { key: "hrr", section: "heart", label: "Heart rate recovery", unit: "bpm", sub: "The drop in the minute after a workout", daily: true, color: "#818cf8",
      science: "/science/sleep-heart/heart-rate-recovery", source: "Apple's stored one-minute recovery after each workout; for a workout without one, the rate at the end minus the rate a minute later, marked derived.", fmt: (v) => round0(v),
      series: () => signalSeries("hrr_bpm"),
      reads: () => { const h = sleepHeartSummary(syncSignals, todayStr()); if (!h || h.hrr.latest == null) return ["No recovery on file: the watch records one after a workout that ends above the Zone 2 floor."]; return [`<strong class="${h.hrr.latest <= 12 ? "text-danger" : "text-text-primary"}">${h.hrr.latest} bpm</strong> ${esc(dayWord(h.hrr.latestDay!))}${h.hrr.median != null ? `, own 30-day median ${h.hrr.median}` : ""}.`, h.hrr.latest <= 12 ? `<span class="text-danger">At or under the one cited line, 12 bpm</span> (Cole 1999). Worth a conversation if it stays there; one reading is not.` : "Above the one cited line, 12 bpm. There is no validated \"good\" threshold, so no verdict word above it."]; } },
    // ── body ──
    { key: "waist_cm", section: "body", label: "Waist", unit: "cm", sub: "The measure that stands in for the fat that matters", daily: false, color: "#FBBF24",
      science: "/science/body/body-phenotyping", source: "Measured in the app or read from a report; the app's row wins on the same day.", fmt: (v) => fmt1(v),
      series: () => sparseFrom("waist_cm"),
      reads: (pts) => { if (!pts.length) return ["No waist on file."]; const l = pts[pts.length - 1], h = Number(syncProfile?.height_cm) || null; const out = [`<strong class="text-text-primary">${fmt1(l.v)} cm</strong> on ${esc(fmtDay(l.d))}${pts.length > 1 ? `, ${l.v === pts[0].v ? "the same as" : `${fmt1(Math.abs(l.v - pts[0].v))} cm ${l.v < pts[0].v ? "less than" : "more than"}`} the first on ${esc(fmtDay(pts[0].d))}` : ""}.`]; if (h) out.push(`Waist-to-height <strong class="text-text-primary">${(l.v / h).toFixed(2)}</strong> at ${h} cm; the screening line is 0.5.`); return out; } },
    { key: "body_fat_pct", section: "body", label: "Body fat", unit: "%", sub: "Composition, by whichever method the report used", daily: false, color: "#FBBF24", science: "/science/body/body-phenotyping", source: "From a body-composition report or the app.", fmt: (v) => fmt1(v), series: () => sparseFrom("body_fat_pct"), reads: (pts) => pts.length ? [`<strong class="text-text-primary">${fmt1(pts[pts.length - 1].v)}%</strong> on ${esc(fmtDay(pts[pts.length - 1].d))}. Methods differ; compare only within one.`] : ["No body fat on file."] },
    { key: "skel_musc_pct", section: "body", label: "Skeletal muscle", unit: "%", sub: "Muscle as a share of weight", daily: false, color: "#FBBF24", science: "/science/body/muscle-health", source: "From a body-composition report or the app.", fmt: (v) => fmt1(v), series: () => sparseFrom("skel_musc_pct"), reads: (pts) => pts.length ? [`<strong class="text-text-primary">${fmt1(pts[pts.length - 1].v)}%</strong> on ${esc(fmtDay(pts[pts.length - 1].d))}.`] : ["No muscle mass on file."] },
    { key: "handgrip_kg", section: "body", label: "Grip strength", unit: "kg", sub: "Why grip is in a fitness app at all", daily: false, color: "#FBBF24", science: "/science/body/muscle-health", source: "The app's grip test, or a report.", fmt: (v) => fmt1(v), series: () => sparseFrom("handgrip_kg"), reads: (pts) => { if (!pts.length) return ["No grip test on file."]; const cut = String(syncProfile?.sex ?? "") === "female" ? 16 : 27; const l = pts[pts.length - 1]; return [`<strong class="text-text-primary">${fmt1(l.v)} kg</strong> on ${esc(fmtDay(l.d))}, <span class="${l.v >= cut ? "text-success-light" : "text-warning"}">${l.v >= cut ? "above" : "below"} the EWGSOP2 cut-off of ${cut}</span>.`]; } },
    { key: "chair_stand_seconds", section: "body", label: "Chair stand", unit: "s", sub: "Five rises, timed", daily: false, color: "#FBBF24", science: "/science/body/intrinsic-capacity", source: "The app's chair-stand test.", fmt: (v) => fmt1(v), series: () => sparseFrom("chair_stand_seconds"), reads: (pts) => pts.length ? [`<strong class="text-text-primary">${fmt1(pts[pts.length - 1].v)} s</strong>, <span class="${pts[pts.length - 1].v <= 15 ? "text-success-light" : "text-warning"}">${pts[pts.length - 1].v <= 15 ? "under" : "over"} the 15-second line</span>.`] : ["No chair stand on file."] },
    { key: "gait_speed_ms", section: "body", label: "Walk speed", unit: "m/s", sub: "Usual pace over a short course", daily: false, color: "#FBBF24", science: "/science/body/intrinsic-capacity", source: "The app's walk test.", fmt: (v) => v.toFixed(2), series: () => sparseFrom("gait_speed_ms"), reads: (pts) => pts.length ? [`<strong class="text-text-primary">${pts[pts.length - 1].v.toFixed(2)} m/s</strong>, <span class="${pts[pts.length - 1].v >= 0.8 ? "text-success-light" : "text-warning"}">${pts[pts.length - 1].v >= 0.8 ? "above" : "below"} 0.8</span>.`] : ["No walk speed on file."] },
    { key: "single_leg_balance_seconds", section: "body", label: "Single-leg balance", unit: "s", sub: "How long one leg holds", daily: false, color: "#FBBF24", science: "/science/body/intrinsic-capacity", source: "The app's balance test.", fmt: (v) => round0(v), series: () => sparseFrom("single_leg_balance_seconds"), reads: (pts) => pts.length ? [`<strong class="text-text-primary">${round0(pts[pts.length - 1].v)} s</strong>, <span class="${pts[pts.length - 1].v >= 10 ? "text-success-light" : "text-warning"}">${pts[pts.length - 1].v >= 10 ? "held past" : "under"} 10 seconds</span>.`] : ["No balance test on file."] },
  ];
  const markerByKey = (k: string) => MARKERS.find((m) => m.key === k)!;

  // ── one range of one marker: the points to draw, the headline, the caption ──
  type Drawn = { pts: { x: string; v: number | null; tone?: string; note?: string }[]; headline: string; caption: string; labelEvery: number; goalLine?: number | null };
  function drawnFor(m: Marker, range: Rng): Drawn | null {
    const all = m.series();
    if (!all.length) return null;
    const t = todayStr();
    const by = new Map(all.map((p) => [p.d, p.v]));
    const summing = !!m.sum && !(range === "year" && m.avgDay);
    const agg = (from: string, to: string) => { const xs = all.filter((p) => p.d >= from && p.d <= to).map((p) => p.v); return xs.length ? (summing ? xs.reduce((a, b) => a + b, 0) : xs.reduce((a, b) => a + b, 0) / xs.length) : null; };
    const band = m.band?.() ?? null;
    const toneOf = (v: number | null) => v == null ? "" : band ? (v > band.hi ? "warn" : v < band.lo ? "low" : "") : "";
    if (range === "day" || range === "week" || range === "month") {
      const n = range === "day" ? 14 : range === "week" ? 7 : 30;
      const start = range === "week" ? mondayOf(new Date()) : addDays(t, -(n - 1));
      const pts = []; for (let d = start, i = 0; i < n; d = addDays(d, 1), i++) { const v = by.has(d) ? by.get(d)! : null; pts.push({ x: d, v, tone: d === t ? "today" : toneOf(v) }); }
      const latest = [...all].reverse().find((p) => p.d <= t) ?? null;
      const inRangePts = pts.filter((p) => p.v != null).map((p) => p.v!);
      const total = inRangePts.reduce((a, b) => a + b, 0);
      const goal = m.goal?.() ?? null;
      if (range === "week") {
        const headline = m.sum ? m.fmt(total) : latest ? m.fmt(latest.v) : "—";
        const caption = m.sum ? (goal != null ? `of ${m.fmt(goal)}${m.unit ? ` ${m.unit}` : ""} this week, Monday to today` : `${m.unit ? `${m.unit} ` : ""}this week so far`) : `${inRangePts.length ? `${m.fmt(inRangePts.reduce((a, b) => a + b, 0) / inRangePts.length)} ${m.unit} average this week, ` : ""}${latest ? `latest ${esc(dayWord(latest.d))}` : ""}`;
        return { pts, headline, caption, labelEvery: 1, goalLine: null };
      }
      const avg = inRangePts.length ? inRangePts.reduce((a, b) => a + b, 0) / inRangePts.length : null;
      const headline = range === "day" ? (latest ? m.fmt(latest.v) : "—") : (m.sum ? m.fmt(total) : avg != null ? m.fmt(avg) : "—");
      const caption = range === "day"
        ? `${m.unit ? `${m.unit}, ` : ""}${latest?.d === t ? "today" : latest ? esc(dayWord(latest.d)) : ""}${avg != null && inRangePts.length > 1 ? ` · ${m.fmt(avg)} a day over the last ${inRangePts.length}` : ""}`
        : `${m.unit ? `${m.unit} ` : ""}${m.sum ? "over" : "a day, averaged over"} the last 30 days · ${inRangePts.length} days read`;
      return { pts, headline, caption, labelEvery: range === "day" ? 2 : 5, goalLine: null };
    }
    if (range === "year") {
      const pts = []; const now = new Date();
      for (let i = 11; i >= 0; i--) { const d = new Date(now.getFullYear(), now.getMonth() - i, 1); const from = d.toLocaleDateString("en-CA"), to = new Date(d.getFullYear(), d.getMonth() + 1, 0).toLocaleDateString("en-CA"); const v = agg(from, to); pts.push({ x: from, v, tone: toneOf(v) }); }
      const have = pts.filter((p) => p.v != null).map((p) => p.v!);
      const yearVal = summing ? have.reduce((a, b) => a + b, 0) : have.length ? have.reduce((a, b) => a + b, 0) / have.length : null;
      return { pts, headline: yearVal != null ? m.fmt(yearVal) : "—", caption: `${m.unit ? `${m.unit} ` : ""}${summing ? "over the last twelve months, month by month" : "a day, averaged over the last twelve months"}`, labelEvery: 1, goalLine: null };
    }
    // sparse: six months, a year, everything
    const from = range === "6m" ? addDays(t, -182) : range === "1y" ? addDays(t, -365) : "0000";
    const sel = all.filter((p) => p.d >= from);
    const pts = sel.map((p) => ({ x: p.d, v: p.v, note: p.note, tone: toneOf(p.v) }));
    const l = sel[sel.length - 1] ?? null;
    return { pts, headline: l ? m.fmt(l.v) : "—", caption: l ? `${m.unit ? `${m.unit}, ` : ""}latest ${esc(fmtDay(l.d))}${sel.length > 1 ? ` · ${sel.length} readings${sel[0].v !== l.v ? `, ${l.v > sel[0].v ? "up" : "down"} ${m.fmt(Math.abs(l.v - sel[0].v))} since ${esc(fmtDay(sel[0].d))}` : ""}` : ""}` : "nothing in this range", labelEvery: Math.max(1, Math.ceil(sel.length / 8)), goalLine: null };
  }

  /** The chart: bars for a marker that adds up, a line for one that is read; the band or the goal behind it. */
  function chartSvg(m: Marker, range: Rng, dr: Drawn): string {
    const W = 820, H = 200, L = 34, R = 20, T = 18, B = 34;
    const band = m.daily && (range !== "year") ? (m.band?.() ?? null) : null;
    const weekGoal = range === "week" && m.goal?.() ? m.goal()! : null;
    const vals = dr.pts.map((p) => p.v).filter((v): v is number => v != null);
    if (!vals.length) return `<text x="${W / 2}" y="${H / 2}" text-anchor="middle" fill="#64748b" font-size="13">Nothing read in this range.</text>`;
    let lo = Math.min(...vals), hi = Math.max(...vals);
    if (band) { lo = Math.min(lo, band.lo); hi = Math.max(hi, band.hi); }
    const bars = !!m.sum;
    if (bars) lo = 0; else { const pad = Math.max((hi - lo) * 0.15, 1); lo -= pad; hi += pad; }
    if (hi === lo) hi = lo + 1;
    const n = dr.pts.length, slot = (W - L - R) / Math.max(1, n);
    const xf = (i: number) => L + slot * (i + 0.5);
    const yf = (v: number) => T + (H - T - B) * (1 - (v - lo) / (hi - lo));
    let s = "";
    if (band) s += `<rect x="${L}" y="${yf(band.hi).toFixed(1)}" width="${W - L - R}" height="${(yf(band.lo) - yf(band.hi)).toFixed(1)}" fill="rgba(52,211,153,0.12)"/><text x="${W - R + 3}" y="${(yf(band.hi) + 4).toFixed(1)}" fill="#64748b" font-size="10" font-family="JetBrains Mono, ui-monospace, monospace">${m.fmt(band.hi)}</text><text x="${W - R + 3}" y="${(yf(band.lo) + 4).toFixed(1)}" fill="#64748b" font-size="10" font-family="JetBrains Mono, ui-monospace, monospace">${m.fmt(band.lo)}</text>`;
    s += `<line x1="${L}" y1="${H - B}" x2="${W - R}" y2="${H - B}" stroke="rgba(255,255,255,0.12)"/>`;
    if (!bars) s += `<text x="4" y="${(yf(hi) + 4).toFixed(1)}" fill="#64748b" font-size="10" font-family="JetBrains Mono, ui-monospace, monospace">${m.fmt(hi)}</text><text x="4" y="${(yf(lo) + 4).toFixed(1)}" fill="#64748b" font-size="10" font-family="JetBrains Mono, ui-monospace, monospace">${m.fmt(lo)}</text>`;
    if (weekGoal != null && m.sum) {
      // the week's running total against the goal, dashed; the goal line above
      const gy = yf(Math.min(weekGoal, hi)); if (weekGoal <= hi) s += `<line x1="${L}" y1="${gy.toFixed(1)}" x2="${W - R}" y2="${gy.toFixed(1)}" stroke="#a5b4fc" stroke-opacity="0.6" stroke-dasharray="4 4"/><text x="${W - R}" y="${(gy - 5).toFixed(1)}" text-anchor="end" fill="#a5b4fc" font-size="10" font-family="JetBrains Mono, ui-monospace, monospace">GOAL ${m.fmt(weekGoal)}</text>`;
      let run = 0; const rp: string[] = [];
      dr.pts.forEach((p, i) => { if (p.v == null && p.x > todayStr()) return; run += p.v ?? 0; rp.push(`${xf(i).toFixed(1)},${yf(Math.min(run, hi)).toFixed(1)}`); });
      if (rp.length > 1) s += `<polyline points="${rp.join(" ")}" fill="none" stroke="#a5b4fc" stroke-width="1.5" stroke-dasharray="3 4" stroke-opacity="0.8"/>`;
    }
    const color = m.color;
    if (bars) {
      const bw = Math.min(46, slot * 0.62);
      dr.pts.forEach((p, i) => {
        if (p.v == null) { if (p.x <= todayStr()) s += `<rect x="${(xf(i) - bw / 2).toFixed(1)}" y="${H - B - 3}" width="${bw.toFixed(1)}" height="3" rx="1.5" fill="rgba(255,255,255,0.08)"/>`; return; }
        const y = yf(p.v), hgt = Math.max(2, H - B - y);
        s += `<rect x="${(xf(i) - bw / 2).toFixed(1)}" y="${y.toFixed(1)}" width="${bw.toFixed(1)}" height="${hgt.toFixed(1)}" rx="3" fill="${color}" fill-opacity="${p.tone === "today" ? 1 : 0.6}"><title>${esc(fmtDay(p.x))}: ${m.fmt(p.v)} ${m.unit}</title></rect>`;
        if (n <= 14 && p.v > 0) s += `<text x="${xf(i).toFixed(1)}" y="${(y - 6).toFixed(1)}" text-anchor="middle" fill="#f1f5f9" font-size="11" font-weight="700">${m.fmt(p.v)}</text>`;
      });
    } else {
      const have = dr.pts.map((p, i) => ({ p, i })).filter(({ p }) => p.v != null);
      if (have.length > 1) s += `<polyline points="${have.map(({ p, i }) => `${xf(i).toFixed(1)},${yf(p.v!).toFixed(1)}`).join(" ")}" fill="none" stroke="${color}" stroke-opacity="0.8" stroke-width="1.8"/>`;
      for (const { p, i } of have) {
        const fill = p.tone === "warn" ? "#FBBF24" : p.tone === "low" ? "#94a3b8" : color;
        s += `<circle cx="${xf(i).toFixed(1)}" cy="${yf(p.v!).toFixed(1)}" r="${n <= 14 ? 5.5 : 3.5}" fill="${fill}" stroke="#0D0D1C" stroke-width="1.5"><title>${esc(fmtDay(p.x))}: ${m.fmt(p.v!)} ${m.unit}${p.note ? ` · ${esc(p.note)}` : ""}</title></circle>`;
        if (n <= 14) s += `<text x="${xf(i).toFixed(1)}" y="${(yf(p.v!) - 11).toFixed(1)}" text-anchor="middle" fill="${p.tone === "warn" ? "#FBBF24" : "#c7d2fe"}" font-size="11" font-weight="700">${m.fmt(p.v!)}</text>`;
      }
    }
    const label = (x: string) => range === "year" ? new Date(x + "T00:00:00").toLocaleDateString(undefined, { month: "short" }).toUpperCase() : range === "week" || range === "day" ? new Date(x + "T00:00:00").toLocaleDateString(undefined, { weekday: "short" }).toUpperCase() : range === "month" ? new Date(x + "T00:00:00").toLocaleDateString(undefined, { day: "numeric", month: "short" }).toUpperCase() : new Date(x + "T00:00:00").toLocaleDateString(undefined, { month: "short", year: "2-digit" }).toUpperCase();
    dr.pts.forEach((p, i) => { if (i % dr.labelEvery === 0 || i === n - 1) s += `<text x="${xf(i).toFixed(1)}" y="${H - B + 16}" text-anchor="middle" fill="${p.tone === "today" ? "#f1f5f9" : "#94a3b8"}" font-size="10" font-family="JetBrains Mono, ui-monospace, monospace">${label(p.x)}</text>`; });
    return s;
  }

  /** Alongside: two or three other daily markers on the same days, as small strips. */
  function alongsideHtml(m: Marker, range: Rng, dr: Drawn): string {
    if (!m.daily || range === "year") return "";
    const others = MARKERS.filter((o) => o.daily && o.key !== m.key && o.series().length).slice(0, 3);
    if (!others.length) return "";
    const days = dr.pts.map((p) => p.x);
    const rows = others.map((o) => {
      const by = new Map(o.series().map((p) => [p.d, p.v]));
      const vs = days.map((d) => by.has(d) ? by.get(d)! : null);
      const have = vs.filter((v): v is number => v != null);
      if (!have.length) return "";
      const lo = Math.min(...have), hi = Math.max(...have) || 1;
      const W = 300, Hh = 26, slot = W / days.length;
      const svg = o.sum
        ? vs.map((v, i) => v == null ? "" : `<rect x="${(i * slot + slot * 0.2).toFixed(1)}" y="${(Hh - (v / hi) * (Hh - 2)).toFixed(1)}" width="${(slot * 0.6).toFixed(1)}" height="${((v / hi) * (Hh - 2)).toFixed(1)}" fill="${o.color}" opacity="0.6"/>`).join("")
        : `<polyline points="${vs.map((v, i) => v == null ? null : `${(i * slot + slot / 2).toFixed(1)},${(Hh - 3 - ((v - lo) / (hi - lo || 1)) * (Hh - 6)).toFixed(1)}`).filter(Boolean).join(" ")}" fill="none" stroke="${o.color}" stroke-width="1.6" stroke-opacity="0.9"/>`;
      return `<div class="flex items-center gap-3"><span class="w-24 shrink-0 text-[12.5px] text-text-secondary">${esc(o.label)}</span><svg viewBox="0 0 ${W} ${Hh}" preserveAspectRatio="none" class="h-[26px] w-full" aria-hidden="true">${svg}</svg></div>`;
    }).filter(Boolean).join("");
    return rows ? `<div class="flex flex-col gap-2">${rows}</div><p class="mt-2 text-[12px] leading-relaxed text-text-muted">The same days. Two things on one timeline, with no claim about which moved the other.</p>` : "";
  }

  function renderSection() {
