      return `<button type="button" data-marker="${m.key}" style="--i: ${i}" aria-current="${on ? "true" : "false"}" class="mh-rise flex flex-col gap-1 rounded-2xl border p-3.5 text-left transition-colors ${on ? "border-accent/60 bg-accent/[0.08]" : l ? "border-white/8 bg-white/4 hover:border-white/16" : "border-dashed border-white/10 hover:border-white/20"}">
