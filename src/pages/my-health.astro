   */
  async function showRoleChip() {
    const greet = $("greet");
    let chip = document.getElementById("rolechip");
    if (!chip) {
      chip = document.createElement("span");
      chip.id = "rolechip";
      chip.className = "hidden rounded-md px-1.5 py-0.5 font-mono text-[9.5px] tracking-wider";
      greet.insertAdjacentElement("afterend", chip);
    }
    let text = "", tone = "";
    if (myRole === "clinician") { text = "CLINICIAN · VERIFIED"; tone = "bg-accent/15 text-accent-light"; }
    else if (myRole === "coach") { text = "COACH · VERIFIED"; tone = "bg-accent/15 text-accent-light"; }
    else {
      try {
        const { data: gs } = await supabase.from("grants").select("viewer_email").eq("owner_id", userId).eq("status", "active");
        const emails = [...new Set((gs ?? []).map((g: any) => String(g.viewer_email).toLowerCase()))];
        if (emails.length) {
          const { data: pros } = await supabase.from("professionals").select("email, role, title").in("email", emails).eq("role", "coach").limit(1);
          const c = pros?.[0];
          if (c) { text = `CLIENT OF ${String(c.title || c.email).split(/[,\s]+/)[0].toUpperCase()}`; tone = "bg-success/15 text-success-light"; }
