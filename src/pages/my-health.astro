            ${heart.rhr.run > 1 ? `<div><strong class="text-text-primary">${heart.rhr.run} mornings running</strong> above the band. One is noise; three is a pattern. It says nothing about why: a late meal, heat, hard training and a cold all do this.</div>` : heart.rhr.latest != null ? `<div>Inside the band ${heart.rhr.inBand} of the last ${heart.rhr.read} mornings read.</div>` : ""}
