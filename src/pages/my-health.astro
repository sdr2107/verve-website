  }
  $("ovsections").querySelectorAll<HTMLElement>("[data-section]").forEach((b) => b.addEventListener("click", () => setSection(b.dataset.section as "all" | SecKey)));

  function renderOverview() {
    $("greet").textContent = greeting();

    const dates = [...new Set(allLabs.map((r) => r.measured_on))].sort();
    renderWorth();
    if (dates.length === 0) { show("secwrap", false); show("latestwrap", false); return; }
    const waiting = pendingReports();
