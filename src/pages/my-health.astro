  });
  // The entrance animation plays the first time a list is drawn, never on a
  // redraw: a tile that only changed its number must not rise again.
  const risen = new Set<string>();
  const riseOnce = (key: string) => risen.has(key) ? "" : (risen.add(key), "mh-rise");







  function setSection(k: "all" | SecKey) {
    if (marked.has("painted")) mark("interaction");
    setSectionState(k);
    if (activeTab !== "overview") setTab("overview");
    history.replaceState(null, "", k === "all" ? "#overview" : `#overview-${k}`);
  }
  document.querySelectorAll<HTMLElement>("[data-section]").forEach((b) => b.addEventListener("click", () => setSection(b.dataset.section as "all" | SecKey)));

  function renderOverview() {
    $("greet").textContent = greeting();
    renderGlance();
    const waiting = pendingReports(allLabs, allApp, isSelf());
    const unchecked = uncheckedInApp(allApp, isSelf());
    show("tosend", waiting.length > 0 || unchecked > 0);
    $("tosend").classList.toggle("flex", waiting.length > 0 || unchecked > 0);
    show("tosendgo", waiting.length > 0);
    if (waiting.length) {
      const n = waiting.reduce((sum, p) => sum + reportAppState(allLabs, allApp, p, isSelf()).pending.length, 0);
      $("tosendtext").textContent = waiting.length === 1
        ? `${n} value${n === 1 ? "" : "s"} for your app from ${pretty(waiting[0].split("/").pop()!)} ${n === 1 ? "has" : "have"} not been sent.`
        : `${waiting.length} reports have values for your app that have not been sent: ${n} in all.`;
