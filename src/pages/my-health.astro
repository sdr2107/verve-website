          ${heart.rhr.svg ? `<svg viewBox="0 0 540 150" class="mt-2 block h-auto w-full" role="img" aria-label="Twenty-eight mornings of resting heart rate, the person's own band shaded, mornings above it marked">${heart.rhr.svg}</svg>` : `<p class="mt-2 text-[13px] text-text-tertiary">No resting heart rate on file.</p>`}
          <div class="mt-2 flex flex-col gap-1.5 text-[13px] leading-relaxed text-text-secondary">
