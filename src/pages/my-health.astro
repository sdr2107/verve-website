---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SUPABASE_URL, SUPABASE_ANON_KEY } from "../lib/supabase";
---

<!--
  My health — the website's signed-in corner, in three tabs. Signed out,
  it says what the page is for before it asks for a password.

  · Overview — a greeting, what moved today and this week, the sections, and
    under it the four subjects with every marker by day, week, month and
    year. Reports live on Reports; the depth on In depth.
  · Labs — every value from every report, section rail on the left, one
    section at a time on the right. A row expands into the full chart:
    band-shaded by each reading's OWN printed range, a diamond where a
    different lab's range enters the series, and readings in a different
    unit never share the line.
  · Reports — the drop zone and the archive: one card per original PDF
    with what came out of it. Review-and-send lives here too.

  The standing rules: app-bound markers go to lab_readings only on the
  user's explicit send, deduped; EVERYTHING parsed lands in web_labs with
  the lab's own printed range (a unique index backs the dedup); analyte
  names are canonicalised by lib/canon.js so "SGPT (ALT)" and "ALT" share
  one trend line; nothing is ever discarded.
-->

<Layout
  title="My health — Verve"
  description="Sign in with your Verve account, drop old lab reports, and their values file themselves into your app and your own lab dashboard."
  cardType="summary"
>
  <!-- The head start (docs/my-health-architecture.md, step 4). Inline, so
       it runs as the HTML is parsed, before the page's bundle has arrived:
       it reads the session the Supabase client keeps in local storage and,
       if it is still valid, asks for the person's document now. The bundle
       finds the request in flight under window.__mh and uses it instead of
       making its own. A session it does not recognise is "no session" and
       costs nothing: the client does its work as before. The address and
       the key come from src/lib/supabase.ts through define:vars, one
       source; the person is the one the page remembered in session
       storage, as boot reads it. -->
  <script is:inline data-astro-rerun define:vars={{ url: SUPABASE_URL, key: SUPABASE_ANON_KEY }}>
    (function () {
      try {
        var ref = url.replace("https://", "").split(".")[0];
        var raw = localStorage.getItem("sb-" + ref + "-auth-token");
        if (!raw) return;
        var session = JSON.parse(raw);
        var token = session && session.access_token;
        var expires = session && session.expires_at;
        if (!token || !expires || expires * 1000 < Date.now() + 30000) return;
        var person = "";
        try { person = sessionStorage.getItem("mh-person") || ""; } catch (e) { /* fine */ }
        var started = performance.now();
        window.__mh = { person: person, started: started, document: fetch(url + "/rest/v1/rpc/my_health_document", {
          method: "POST",
          headers: { apikey: key, Authorization: "Bearer " + token, "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(person ? { person: person } : {}),
        }).then(function (r) { if (!r.ok) throw new Error("rpc " + r.status); return r.json(); }) };
      } catch (e) { /* no head start; the bundle fetches as before */ }
    })();
  </script>
  <SiteHeader current="my-health">
    <!-- Signed in, Sign out takes the app button's place; the greeting is
         the page's heading, not a header ornament. Hidden until a session
         is found. -->
    <button
      slot="extra"
      id="signout"
      class="hidden rounded-full border border-white/14 px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:border-white/25"
    >Sign out</button>
  </SiteHeader>

  <main class="vrv-glow relative mx-auto min-h-[80vh] max-w-7xl px-6 pb-24 sm:px-10">

    <!-- ── signed out: what My health is for, then the way in ────────────
         The page says why you would sign in before it asks you to: three
         lines on the left, one card on the right with one primary action.
         Every id the script wires is kept. ───────────────────────────── -->
    <section id="auth" class="mt-4 hidden max-w-[1120px] lg:mt-8">
      <!-- The grid lives on an inner div, not on #auth: the script hides
           #auth by adding `hidden`, and a responsive display class on the
           same element (`lg:grid`) would win over it on a desktop — which
           is how the sign-in card stayed on screen after signing in. -->
      <div class="gap-10 lg:grid lg:grid-cols-[minmax(0,1.1fr)_440px] lg:items-center lg:gap-16">
      <div class="flex flex-col gap-4 lg:gap-[22px]">
        <span id="authkick" class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-accent-light">My health</span>
        <h1 id="authtitle" class="text-[30px] font-bold leading-[1.1] tracking-[-0.025em] text-text-primary sm:text-[46px] sm:leading-[1.06] sm:tracking-[-0.03em]">
          Your lab reports, read and filed for you.
        </h1>
        <p id="authlede" class="max-w-[520px] text-[14.5px] leading-[1.6] text-text-secondary sm:text-base sm:leading-[1.65]">
          Drop a PDF from any lab. Verve reads every value, sends the markers
          the app tracks to your phone on one tap, and keeps the rest charted
          here.
        </p>
        <ul class="mt-1 hidden flex-col gap-3.5 lg:flex">
          <li class="flex items-start gap-3.5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] bg-accent/[0.14]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg>
            </span>
            <span>
              <span class="block text-[15px] font-semibold text-text-primary">Drop a report</span>
              <span class="block text-[13px] leading-relaxed text-text-tertiary">Any lab, any year. Imaging reports too.</span>
            </span>
          </li>
          <li class="flex items-start gap-3.5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] bg-success/[0.12]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4 4L19 7" /></svg>
            </span>
            <span>
              <span class="block text-[15px] font-semibold text-text-primary">Every value read</span>
              <span class="block text-[13px] leading-relaxed text-text-tertiary">Everything parsed is charted here; you check the app-bound values before they are sent.</span>
            </span>
          </li>
          <li class="flex items-start gap-3.5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] bg-warning/[0.12]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FBBF24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2" /><path d="M11 18h2" /></svg>
            </span>
            <span>
              <span class="block text-[15px] font-semibold text-text-primary">The app&rsquo;s markers go to your phone</span>
              <span class="block text-[13px] leading-relaxed text-text-tertiary">Everything else stays charted here, with its own history.</span>
            </span>
          </li>
        </ul>
        <p class="hidden text-[13px] text-text-tertiary lg:block">The login is the one you use in the app.</p>
      </div>

      <!-- the card: one primary action, the alternative under a rule -->
      <div class="mt-6 rounded-[20px] border border-white/10 bg-white/[0.03] p-5 sm:p-7 lg:mt-0">
        <div class="flex w-full gap-1 rounded-full border border-white/10 bg-white/[0.04] p-1 sm:w-fit">
          <button type="button" data-mode="signin" class="min-h-10 flex-1 rounded-full px-4 py-1.5 text-[13px] font-bold sm:flex-none">Sign in</button>
          <button type="button" data-mode="signup" class="min-h-10 flex-1 rounded-full px-4 py-1.5 text-[13px] font-semibold sm:flex-none">Create account</button>
        </div>
        <p id="modenote" class="mt-3 hidden text-sm leading-relaxed text-text-secondary"></p>
        <!-- The door used last on this browser. Apple with a hidden address
             makes an account nothing else can join, so the card says which
             method worked before rather than leaving it to memory. -->
        <p id="lastmethod" class="mt-3 hidden text-[13px] leading-relaxed text-text-secondary"></p>

        <!-- Sign in with Apple, the same door the app has. Apple hands the
             website the identity it gave the app, so a person who signed up
             in the app with Apple, hidden address and all, lands in the same
             account here. The email code below cannot reach a hidden address:
             Apple's relay delivers only mail from senders it knows. -->
        <div id="oauth" class="mt-4 grid gap-2.5 sm:grid-cols-2">
          <button type="button" id="apple" data-provider="apple"
            class="flex min-h-11 w-full items-center justify-center gap-2.5 rounded-xl bg-white px-4 py-3 text-sm font-bold text-black transition-opacity hover:opacity-90">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.37 12.7c-.02-2.3 1.88-3.4 1.96-3.45-1.07-1.56-2.73-1.78-3.32-1.8-1.41-.14-2.76.83-3.48.83-.72 0-1.83-.81-3.01-.79-1.55.02-2.98.9-3.78 2.29-1.61 2.8-.41 6.94 1.16 9.21.77 1.11 1.68 2.36 2.87 2.31 1.15-.05 1.59-.75 2.98-.75 1.39 0 1.78.75 3 .72 1.24-.02 2.03-1.13 2.79-2.25.88-1.29 1.24-2.54 1.26-2.6-.03-.01-2.41-.93-2.43-3.72zM14.1 6.03c.63-.77 1.06-1.83.94-2.9-.91.04-2.02.61-2.67 1.38-.59.68-1.1 1.77-.96 2.82 1.02.08 2.06-.52 2.69-1.3z"/></svg>
            <span data-oauthlabel>Sign in with Apple</span>
          </button>
          <!-- Google: the same door for a Gmail address. Supabase joins it to an
               existing email-and-password account with the same address. -->
          <button type="button" id="google" data-provider="google"
            class="flex min-h-11 w-full items-center justify-center gap-2.5 rounded-xl border border-white/14 bg-white/[0.04] px-4 py-3 text-sm font-bold text-text-primary transition-colors hover:border-white/25">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5a5.6 5.6 0 0 1-2.4 3.7v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3a7.2 7.2 0 0 1-10.8-3.8H1.3v3.1A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.3a12 12 0 0 0 0 10.8l4-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.4.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1A7.2 7.2 0 0 1 12 4.8z"/></svg>
            <span data-oauthlabel>Sign in with Google</span>
          </button>
        </div>
        <div id="appleor" class="mt-4 flex items-center gap-3">
          <div class="h-px flex-1 bg-white/10"></div>
          <span class="text-xs text-text-muted">or with email</span>
          <div class="h-px flex-1 bg-white/10"></div>
        </div>

        <form id="pwform" class="mt-4 flex flex-col gap-4">
          <div id="namerow" class="hidden">
            <label for="fullname" class="mb-1.5 block text-xs font-semibold text-text-secondary">Your name</label>
            <input id="fullname" type="text" autocomplete="name" placeholder="How the app should greet you"
              class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-3 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none sm:text-sm" />
          </div>
          <div>
            <label for="email" class="mb-1.5 block text-xs font-semibold text-text-secondary">Email</label>
            <input id="email" type="email" required placeholder="you@example.com" autocomplete="email"
              class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-3 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none sm:text-sm" />
          </div>
          <div>
            <div class="mb-1.5 flex items-baseline justify-between">
              <label for="password" class="text-xs font-semibold text-text-secondary">Password</label>
              <button type="button" id="forgot" class="text-xs font-medium text-accent-light hover:underline">Forgot password</button>
            </div>
            <div class="relative">
              <input id="password" type="password" placeholder="Password" autocomplete="current-password"
                class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-3 pr-12 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none sm:text-sm" />
              <button type="button" data-eye="password" aria-label="Show password"
                class="absolute inset-y-0 right-0 flex w-12 items-center justify-center text-text-tertiary hover:text-text-primary">
                <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>
          <!-- consent, affirmative and unticked: an account is not a newsletter -->
          <label id="newsletterrow" class="hidden items-start gap-2.5 text-xs leading-relaxed text-text-secondary">
            <input id="newsletter" type="checkbox" class="mt-0.5 h-4 w-4 shrink-0 accent-[#818cf8]" />
            <span>Send me the Verve newsletter: an email now and then on the science, and what changed in the app. Unsubscribe any time.</span>
          </label>
          <button type="submit" id="authsubmit"
            class="min-h-11 rounded-xl bg-accent px-4 py-3 text-sm font-bold text-canvas transition-opacity hover:opacity-90">
            Sign in
          </button>
        </form>

        <div id="ordiv" class="mt-4 flex items-center gap-3">
          <div class="h-px flex-1 bg-white/10"></div>
          <span class="text-xs text-text-muted">or</span>
          <div class="h-px flex-1 bg-white/10"></div>
        </div>

        <button id="magic"
          class="mt-4 min-h-11 w-full rounded-xl border border-white/14 px-4 py-3 text-sm font-semibold text-text-primary transition-colors hover:border-white/25">
          Email me a code
        </button>
        <p id="applenote" class="mt-3 text-xs leading-relaxed text-text-tertiary">
          A code you can type on any device, so a code read on your phone signs
          you in on your Mac. Signed up with Apple in the app? Use the Apple
          button above: a code cannot reach an address Apple hides. A Gmail
          address works with either the Google button or the code.
        </p>

        <!-- ── the code step: the card flips to this once the email is sent ── -->
        <div id="codestep" class="hidden">
          <span class="font-mono text-[10.5px] font-semibold uppercase tracking-[0.14em] text-accent-light">Check your email</span>
          <h2 id="codehead" class="mt-2 text-[22px] font-bold tracking-[-0.02em] text-text-primary">Enter the code from the email</h2>
          <p id="codelead" class="mt-2 text-[13px] leading-relaxed text-text-secondary"></p>
          <form id="codeform" class="mt-4 flex flex-col gap-4">
            <label for="code" class="sr-only">Sign-in code</label>
            <input id="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="10"
              class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-4 py-3 text-center font-mono text-[26px] font-bold tracking-[0.25em] text-text-primary focus:border-accent focus:outline-none" />
            <button type="submit" id="verify"
              class="min-h-11 rounded-xl bg-accent px-4 py-3 text-sm font-bold text-canvas transition-opacity hover:opacity-90 disabled:opacity-50">
              Sign in
            </button>
          </form>
          <div class="mt-3 flex items-center justify-between gap-3">
            <button type="button" id="resend" class="text-xs font-medium text-text-tertiary hover:text-text-primary disabled:hover:text-text-tertiary" disabled></button>
            <button type="button" id="usepw" class="text-xs font-medium text-accent-light hover:underline"></button>
          </div>
          <p class="mt-3 text-xs leading-relaxed text-text-tertiary">The link in the same email still works, on the device it is opened on.</p>
        </div>

        <p id="authmsg" class="mh-status mt-4 hidden text-[13px] leading-relaxed"></p>
      </div>
      </div>
    </section>

    <!-- ── set a new password (arrived from a reset email) ──────────────── -->
    <section id="pwreset" class="mt-6 hidden max-w-md rounded-[20px] border border-white/10 bg-white/[0.03] p-5 sm:p-7 lg:mt-8">
      <span class="font-mono text-[10.5px] font-semibold uppercase tracking-[0.14em] text-accent-light">Reset your password</span>
      <h2 class="mt-2 text-[22px] font-bold tracking-[-0.02em] text-text-primary">Choose a new password</h2>
      <p class="mt-2 text-[13px] leading-relaxed text-text-secondary">It works here and in the Verve app. Eight characters or more.</p>
      <form id="pwform2" class="mt-4 flex flex-col gap-4">
        <div>
          <label for="newpw" class="mb-1.5 block text-xs font-semibold text-text-secondary">New password</label>
          <div class="relative">
            <input id="newpw" type="password" autocomplete="new-password"
              class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-3 pr-12 text-[15px] text-text-primary focus:border-accent focus:outline-none sm:text-sm" />
            <button type="button" data-eye="newpw" aria-label="Show password"
              class="absolute inset-y-0 right-0 flex w-12 items-center justify-center text-text-tertiary hover:text-text-primary">
              <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <div>
          <label for="newpw2" class="mb-1.5 block text-xs font-semibold text-text-secondary">Repeat it</label>
          <input id="newpw2" type="password" autocomplete="new-password"
            class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-3 text-[15px] text-text-primary focus:border-accent focus:outline-none sm:text-sm" />
        </div>
        <button type="submit" id="savepw" class="min-h-11 rounded-xl bg-accent px-4 py-3 text-sm font-bold text-canvas transition-opacity hover:opacity-90 disabled:opacity-50">
          Save password
        </button>
      </form>
      <p id="pwmsg" class="mh-status mt-4 hidden text-[13px] leading-relaxed"></p>
    </section>

    <!-- ── signed in ──────────────────────────────────────────────────── -->
    <section id="home" class="mt-2 hidden">
     <div class="lg:flex lg:items-start lg:gap-10">

      <!-- ═══ THE SIDEBAR ═══════════════════════════════════════════════════
           Whose page (the people), which view (the tabs), and who has
           access. One set of elements, two layouts: below lg they are the
           chip row and the tab pills across the top of the page, as they
           always were; from lg they are a column on the left that stays
           put while the page scrolls, so the page itself is only about the
           one person picked. -->
      <aside class="pt-5 lg:sticky lg:top-6 lg:flex lg:min-h-[72vh] lg:w-[248px] lg:shrink-0 lg:flex-col lg:gap-6 lg:pt-8">
        <div id="peoplewrap" class="hidden">
          <h3 class="mb-2 hidden px-3 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-text-tertiary lg:block">People</h3>
          <!-- one control: the name of whose page this is, with the menu under it -->
          <div id="people" class="relative"></div>
        </div>
        <nav id="tabbar" aria-label="Views" class="mt-4 flex gap-1.5 rounded-2xl border border-white/10 bg-white/[0.03] p-1.5 sm:w-fit lg:mt-0 lg:w-auto lg:flex-col lg:gap-0.5 lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0">
          <h3 id="tabhead" class="mb-2 hidden px-3 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-text-tertiary lg:block">Your page</h3>
          <button type="button" data-tab="overview"><span class="w-2.5 shrink-0 font-mono text-[10px] font-semibold text-text-muted">1</span><svg class="hidden shrink-0 lg:block" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/></svg><span>Overview</span></button>
          <!-- the four sections, nested under Overview in the column; the phone's copy is under the pills -->
          <div data-ovsections class="mb-1 hidden flex-col gap-0.5 pl-3 lg:flex" style="display: none">
            
            <button type="button" data-section="fitness"><span class="h-1.5 w-1.5 shrink-0 rounded-full" style="background: #f97316"></span>Fitness</button>
            <button type="button" data-section="movement"><span class="h-1.5 w-1.5 shrink-0 rounded-full" style="background: #34d399"></span>Movement</button>
            <button type="button" data-section="heart"><span class="h-1.5 w-1.5 shrink-0 rounded-full" style="background: #818cf8"></span>Sleep &amp; heart</button>
            <button type="button" data-section="body"><span class="h-1.5 w-1.5 shrink-0 rounded-full" style="background: #FBBF24"></span>Body</button>
          </div>
          <button type="button" data-tab="depth"><span class="w-2.5 shrink-0 font-mono text-[10px] font-semibold text-text-muted">2</span><svg class="hidden shrink-0 lg:block" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>In depth</span></button>
          <button type="button" data-tab="labs"><span class="w-2.5 shrink-0 font-mono text-[10px] font-semibold text-text-muted">3</span><svg class="hidden shrink-0 lg:block" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v6l-5.5 9a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L14 9V3"/></svg><span>Labs</span><span data-count class="ml-auto hidden font-mono text-[10.5px] font-semibold text-text-tertiary lg:inline"></span></button>
          <button type="button" data-tab="reports"><span class="w-2.5 shrink-0 font-mono text-[10px] font-semibold text-text-muted">4</span><svg class="hidden shrink-0 lg:block" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg><span>Reports</span><span data-count class="ml-auto hidden font-mono text-[10.5px] font-semibold text-text-tertiary lg:inline"></span></button>
        </nav>
        <!-- the four sections under Overview: chips under the pills on a phone -->
        <div data-ovsections class="mt-3 flex flex-wrap gap-1.5 lg:hidden" style="display: none">
          
            <button type="button" data-section="fitness"><span class="h-1.5 w-1.5 shrink-0 rounded-full" style="background: #f97316"></span>Fitness</button>
            <button type="button" data-section="movement"><span class="h-1.5 w-1.5 shrink-0 rounded-full" style="background: #34d399"></span>Movement</button>
            <button type="button" data-section="heart"><span class="h-1.5 w-1.5 shrink-0 rounded-full" style="background: #818cf8"></span>Sleep &amp; heart</button>
            <button type="button" data-section="body"><span class="h-1.5 w-1.5 shrink-0 rounded-full" style="background: #FBBF24"></span>Body</button>
        </div>
        <!-- who can see this page: the entry here opens the panel on the page -->
        <div id="accesswrap" class="hidden">
          <button type="button" id="accessgophone" class="mt-3 flex min-h-9 items-center gap-1.5 text-[13px] font-semibold text-accent-light hover:text-text-primary lg:hidden">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Give access
          </button>
          <div class="hidden lg:block">
            <h3 class="mb-2 hidden px-3 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-text-tertiary lg:block">Access</h3>
            <button type="button" id="accessgo" class="flex w-full items-start gap-2.5 rounded-[10px] border-l-2 border-transparent px-3 py-2 text-left text-[13.5px] font-medium text-text-secondary transition-colors hover:bg-white/[0.04] hover:text-text-primary">
              <svg class="mt-0.5 shrink-0" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
              <span class="flex min-w-0 flex-col leading-snug"><span>Give access</span><span id="accesssub" class="text-[11.5px] font-normal text-text-tertiary"></span></span>
            </button>
          </div>
        </div>
        <p class="mt-auto hidden px-3 font-mono text-[10.5px] leading-relaxed text-text-muted lg:block">Drag a PDF anywhere on this page to add it.</p>
      </aside>

      <!-- ═══ THE PAGE: one person ═══════════════════════════════════════ -->
      <div class="min-w-0 flex-1">

      <!-- the greeting: the page's heading, first name from the same
           profile the app greets you with, and the one way to add a report -->
      <div id="pagehead" class="flex flex-wrap items-end justify-between gap-4 pt-5 sm:pt-8">
        <div class="min-w-0">
          <div class="flex items-center gap-2.5">
            <h1 id="greet" class="text-[28px] font-extrabold leading-[1.05] tracking-[-0.03em] text-text-primary sm:text-4xl"></h1>
            <button type="button" id="namechange" aria-label="Change your name" title="Change your name" class="hidden text-text-muted transition-colors hover:text-text-primary">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
            </button>
          </div>
          <!-- no name on the account yet: the greeting asks, prefilled when the
               email is clearly a name, and the answer goes to the app too -->
          <form id="nameform" class="mt-3 hidden flex-wrap items-center gap-2">
            <label for="namein" class="text-[13px] text-text-secondary">What should we call you?</label>
            <input id="namein" type="text" autocomplete="given-name" placeholder="Your first name"
              class="w-44 max-w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-2 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none sm:text-sm" />
            <button type="submit" class="min-h-10 rounded-xl bg-accent px-4 py-2 text-sm font-bold text-canvas transition-opacity hover:opacity-90">Save</button>
            <button type="button" id="namelater" class="text-xs font-medium text-text-tertiary hover:text-text-primary">Not now</button>
          </form>
          <!-- the newsletter, asked once of an account that never saw the box on
               the sign-up form (Apple and Google sign-ins). Either answer is
               written to the account, so the question is asked exactly once. -->
          <div id="newsask" class="mt-3 hidden max-w-3xl flex-wrap items-center gap-2">
            <span id="newstext" class="text-[13px] text-text-secondary">The Verve newsletter: an email now and then on the science, and what changed in the app. Send it to you?</span>
            <!-- signed in with Apple and "Hide my email": the account's address is a relay that
                 forwards only senders Apple has on file, so the letter needs one it can reach -->
            <span id="newsrelay" class="hidden basis-full text-[13px] text-text-secondary">Apple hides your address from Verve, so the letter needs one it can reach: where should it go?</span>
            <input id="newsemail" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" aria-label="The address to send the newsletter to"
              class="hidden w-60 max-w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-2 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none sm:text-sm" />
            <button type="button" id="newsyes" class="min-h-10 rounded-xl bg-accent px-4 py-2 text-sm font-bold text-canvas transition-opacity hover:opacity-90 disabled:opacity-60">Yes, send it</button>
            <button type="button" id="newsno" class="text-xs font-medium text-text-tertiary hover:text-text-primary">No thanks</button>
            <span id="newsmsg" class="hidden basis-full text-[12.5px] leading-snug text-text-primary" role="status" aria-live="polite"></span>
          </div>
        </div>
        <button
          id="addreport"
          class="inline-flex min-h-11 items-center gap-2 rounded-full border border-white/14 px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:border-white/25"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          Add a report
        </button>
      </div>

      <!-- ═══ PEOPLE: whose page this is ═══════════════════════════════════
           Every row belongs to a person: you, someone you look after, or
           someone who shares with you. The people are in the sidebar; what
           follows is about the one picked: adding or editing them, the
           note only you see, invitations, and who can see this page. -->
      <div id="personwrap" class="mt-3 hidden">
        <form id="personform" class="mt-3 hidden max-w-3xl flex-wrap items-end gap-2 rounded-2xl border border-white/10 bg-white/[0.03] p-4">
          <div id="personmodes" class="flex basis-full flex-wrap gap-1.5" role="group" aria-label="Who is this">
            <button type="button" data-pmode="care" class="min-h-9 rounded-full border px-3.5 py-1.5 text-[13px] font-semibold">Someone I look after</button>
            <button type="button" data-pmode="ask" class="min-h-9 rounded-full border px-3.5 py-1.5 text-[13px] font-semibold">Someone with their own email</button>
          </div>
          <label id="personnamewrap" class="flex flex-col gap-1 text-[12px] text-text-secondary">Their name
            <input id="personname" type="text" autocomplete="off" placeholder="Amma" maxlength="60" required
              class="w-48 max-w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-2 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none" />
          </label>
          <label id="personbornwrap" class="flex flex-col gap-1 text-[12px] text-text-secondary">Born, year (optional)
            <input id="personborn" type="number" inputmode="numeric" min="1900" max="2100" placeholder="1958"
              class="w-28 rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-2 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none" />
          </label>
          <label id="personemailwrap" class="hidden flex-col gap-1 text-[12px] text-text-secondary">Their email
            <input id="personemail" type="email" autocomplete="off" placeholder="umar@example.com"
              class="w-64 max-w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-2 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none" />
          </label>
          <button type="submit" id="personsave" class="min-h-10 rounded-xl bg-accent px-4 py-2 text-sm font-bold text-canvas transition-opacity hover:opacity-90">Add</button>
          <button type="button" id="personcancel" class="min-h-10 px-2 text-xs font-medium text-text-tertiary hover:text-text-primary">Cancel</button>
          <p id="personformnote" class="basis-full text-[12px] leading-relaxed text-text-tertiary"></p>
        </form>
        <div id="personhead" class="mt-3 hidden flex-wrap items-center gap-x-4 gap-y-1">
          <span id="personkicker" class="font-mono text-[10px] font-semibold tracking-[0.14em] text-accent-light"></span>
          <span id="personactions" class="flex items-center gap-3 text-[13px] font-medium"></span>
        </div>
        <div id="personnotewrap" class="mt-3 hidden max-w-3xl">
          <label for="personnote" class="font-mono text-[10px] font-semibold tracking-wider text-text-tertiary">NOTE &middot; ONLY YOU SEE THIS</label>
          <textarea id="personnote" rows="2" placeholder="On metformin since June. Next HbA1c due December."
            class="mt-1 w-full resize-none rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-2 text-[14px] leading-relaxed text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none"></textarea>
        </div>
        <!-- the note a coach or clinician keeps on a page shared with them: a
             copy for their convenience, exportable, and gone from here when
             the share stops (viewer_notes, readable only while active) -->
        <div id="viewernotewrap" class="mt-3 hidden max-w-3xl">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <label for="viewernote" class="font-mono text-[10px] font-semibold tracking-wider text-text-tertiary">YOUR NOTE &middot; A COPY, YOURS WHILE THEY SHARE</label>
            <button type="button" id="notesexport" class="text-[12px] font-medium text-text-tertiary hover:text-text-primary">Export all my notes</button>
          </div>
          <textarea id="viewernote" rows="2" placeholder="Seen 7 Oct. Walk test 540 m. Retest in eight weeks."
            class="mt-1 w-full resize-none rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-2 text-[14px] leading-relaxed text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none"></textarea>
        </div>

        <!-- the plan this account holds, and the way to the plans page; only once plans are open -->
        <p id="planline" class="mt-2 hidden text-[12px] text-text-tertiary"></p>
        <!-- over the plan's people: the next person is not added, and this says why -->
        <div id="planpeople" class="mt-3 hidden max-w-3xl flex-col gap-2 rounded-2xl border border-warning/50 bg-warning/[0.06] p-4"></div>
        <!-- invitations waiting for you: someone asked you to look at their page -->
        <div id="invites" class="mt-3 hidden max-w-3xl flex-col gap-3"></div>
        <!-- people you asked to share their page with you: waiting until they decide -->
        <p id="asked" class="mt-2 hidden max-w-3xl text-[12.5px] leading-relaxed text-text-tertiary"></p>
        <!-- someone asks to see your page: nothing is shared until you say so -->
        <div id="requests" class="mt-3 hidden max-w-3xl flex-col gap-3"></div>

      </div>

      <!-- reading in progress: shown on every tab, since the read carries on
           whichever tab is open; the bar eases toward the end and jumps when
           the reader answers -->
      <button id="busy" class="mt-5 hidden w-full items-center gap-3 rounded-2xl border border-accent/30 bg-accent/[0.06] px-4 py-3 text-left transition-colors hover:border-accent/50">
        <span id="busyicon" class="relative flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] bg-accent/[0.16]">
          <svg class="mh-spin h-4 w-4 text-accent-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9"/></svg>
        </span>
        <span class="min-w-0 flex-1">
          <span id="busytext" class="block text-[13px] font-semibold text-text-primary"></span>
          <span id="busysub" class="block text-xs text-text-tertiary"></span>
          <span class="mt-2 block h-1 w-full overflow-hidden rounded-full bg-white/[0.07]"><span id="busybar" class="block h-1 rounded-full bg-accent" style="width: 0%"></span></span>
        </span>
      </button>

      <p id="upmsg" class="mt-3 hidden text-sm"></p>
      <!-- search: on Reports, a report by its name, its date, a value read from it or its study;
           on Labs, a marker by name or section. Every word typed must land. -->
      <div id="mhsearchwrap" class="mt-3 hidden max-w-3xl">
        <label for="mhsearch" class="sr-only">Search reports and markers</label>
        <div class="flex items-center gap-2 rounded-xl border border-white/12 bg-white/[0.04] px-3 focus-within:border-accent/60">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shrink-0 text-text-muted" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="mhsearch" type="search" autocomplete="off" spellcheck="false" placeholder="Search: ApoB, echo, March 2024, a report's name…"
            class="min-h-10 w-full bg-transparent text-[14px] text-text-primary placeholder:text-text-muted focus:outline-none" />
          <button type="button" id="mhsearchclear" class="hidden shrink-0 text-xs font-semibold text-text-tertiary hover:text-text-primary">Clear</button>
        </div>
        <p id="mhsearchnote" class="mt-1.5 hidden text-[12px] text-text-tertiary"></p>
      </div>

      <!-- ═══ EVERYONE: one line per person you can see ═════════════════════
           Reached from the sidebar, only when there is more than you. A
           coach's clients and a family are the same table; the heading
           follows which you have. Tap a row to open that person. It used
           to sit at the top of your own Overview, above your own numbers. -->
      <div id="tab-group" class="hidden pt-5 sm:pt-8">
        <!-- the plan gate: the group view is on Max -->
        <div id="glancelocked" class="mb-7 hidden max-w-2xl flex-col gap-3 rounded-2xl border border-dashed border-accent/50 bg-accent/[0.05] p-5"></div>
        <!-- the coach's door with no one sharing yet: the ask, and the way to your own page -->
        <div id="glanceempty" class="hidden max-w-2xl rounded-2xl border border-dashed border-accent/40 bg-accent/[0.04] p-6">
          <div class="font-mono text-[10px] font-semibold tracking-[0.14em] text-accent-light">COACH · THE GROUP</div>
          <h1 class="mt-2 text-[24px] font-extrabold tracking-[-0.02em] text-text-primary">No one shares with you yet.</h1>
          <p class="mt-2 text-[13.5px] leading-relaxed text-text-secondary">Ask someone by email. They choose what you see, labs, imaging, activity, body or notes, and can stop at any time. Once they say yes they appear here, ranked by the week's movement.</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <button type="button" id="glanceask" class="min-h-11 rounded-xl bg-accent px-5 py-2.5 text-sm font-bold text-canvas transition-opacity hover:opacity-90">Ask someone to share</button>
            <button type="button" id="glanceself" class="min-h-11 rounded-xl border border-white/14 px-5 py-2.5 text-sm font-semibold text-text-primary transition-colors hover:border-white/25">Your own page</button>
          </div>
        </div>
        <section id="glance" class="hidden">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div class="min-w-0">
              <div id="glancekick" class="font-mono text-[10px] font-semibold tracking-[0.14em] text-accent-light"></div>
              <h1 id="glancetitle" class="mt-2 text-[28px] font-extrabold leading-[1.05] tracking-[-0.03em] text-text-primary sm:text-4xl">People</h1>
              <p id="glancesub" class="mt-2 text-[13px] text-text-tertiary"></p>
            </div>
            <p class="text-[12px] text-text-tertiary">People share with you at <span id="glanceaddr" class="font-mono text-[11px] text-text-secondary"></span></p>
          </div>
          <div class="mt-5 overflow-x-auto rounded-2xl border border-white/10 bg-white/[0.03]">
            <table class="w-full min-w-[880px] text-[13px]">
              <thead>
                <tr class="text-left font-mono text-[10px] tracking-wider text-text-tertiary">
                  <th class="px-3 py-2.5 font-semibold">PERSON</th>
                  <th class="px-3 py-2.5 font-semibold">SEES</th>
                  <th class="px-3 py-2.5 font-semibold">4-WEEK CHANGE</th>
                  <th class="px-3 py-2.5 font-semibold">THIS WEEK</th>
                  <th class="px-3 py-2.5 font-semibold">FITNESS</th>
                  <th class="px-3 py-2.5 font-semibold">LATEST LABS</th>
                  <th class="px-3 py-2.5 font-semibold">RETEST DUE</th>
                  <th class="px-3 py-2.5 font-semibold">LAST ACTIVE</th>
                  <th class="px-3 py-2.5 font-semibold">AT GOAL</th>
                </tr>
              </thead>
              <tbody id="glancerows" class="divide-y divide-white/[0.06]"></tbody>
            </table>
          </div>
          <div class="mt-3 grid gap-3 lg:grid-cols-[7fr_5fr]">
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
              <h3 class="text-[15px] font-extrabold text-text-primary">This week</h3>
              <div id="glanceweek" class="mt-2 flex flex-col gap-1.5 text-[13px] leading-relaxed text-text-secondary"></div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
              <h3 class="text-[15px] font-extrabold text-text-primary">Retest due</h3>
              <div id="glancedue" class="mt-2 flex flex-col gap-1.5 text-[13px] leading-relaxed text-text-secondary"></div>
              <p class="mt-2 text-[12px] text-text-muted">Lab cadences are the cited ones on the marker pages. A person sees the same due dates on their own In depth tab.</p>
            </div>
          </div>
          <p class="mt-2 text-[12px] text-text-muted">Consent decides what you see: nothing here shows without the person's tick, and they can stop at any time.</p>
        </section>
      </div>

      <!-- ═══ OVERVIEW ═══════════════════════════════════════════════════ -->
      <div id="tab-overview" class="mt-6 hidden">
       <!-- All: the person at a glance -->
       <div id="ovall">
        <!-- values for the app that were read but never sent: one line, until it is done -->
        <div id="tosend" class="mb-5 hidden flex-wrap items-center gap-3 rounded-2xl border border-accent/30 bg-accent/[0.06] px-4 py-3.5">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] bg-accent/[0.16]">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>
          </span>
          <span id="tosendtext" class="min-w-0 flex-1 text-[13px] leading-relaxed text-text-secondary"></span>
          <button id="tosendgo" class="min-h-10 rounded-full bg-accent px-4 py-2 text-[13px] font-semibold text-canvas transition-opacity hover:opacity-90">Review and send &rarr;</button>
        </div>
        <!-- nothing yet: the one call to action, since the drop zone lives on Reports -->
        <div id="emptycard" class="hidden max-w-3xl rounded-2xl border border-dashed border-accent/40 bg-accent/[0.04] p-6">
          <p class="text-sm font-semibold text-text-primary">No reports yet</p>
          <p class="mt-1 text-[13px] leading-relaxed text-text-tertiary">
            Drop your first lab report and every value in it becomes a trend you keep. A PDF or a photo, several at once, or the JSON file your Verve app exports.
          </p>
          <button id="emptyadd" class="mt-4 min-h-11 rounded-xl bg-accent px-5 py-2.5 text-sm font-bold text-canvas transition-opacity hover:opacity-90">Add a report</button>
        </div>

        <!-- ═══ THE GLANCE: four cards, one a section ═══════════════════════
             One number, two words of context and one sentence each; a line
             under the greeting that says the week in a breath. The lab values
             stay on Labs; the Body card carries the count and what is due.
             A card opens its section. -->
        <p id="ovline" class="mb-5 min-h-[22px] text-[14px] leading-relaxed text-text-secondary"></p>
        <!-- the four cards are a view (src/my-health/views/Overview): their frames are mounted
             before any request leaves, so the page has its height from the first paint -->
        <div id="ovglance" class="grid min-h-[150px] gap-4 sm:grid-cols-2"></div>

        <p class="mt-7 font-mono text-[10.5px] text-text-muted lg:hidden">Drag a PDF anywhere on this page to add it.</p>
       </div>

       <!-- ═══ ONE SECTION: its markers as tiles, one of them open ═════════
            Fitness, Movement, Sleep & heart or Body, picked in the sidebar.
            A view (src/my-health/views/Overview) of the document; nothing
            is fetched for it. -->
       <div id="ovsection" class="hidden"></div>
        <!-- the next step in the chain: picture, what moved, values, paper -->
        <button type="button" data-goto="depth" class="mt-8 flex w-full max-w-3xl items-center justify-between gap-4 rounded-2xl border border-white/12 bg-white/[0.03] px-5 py-4 text-left transition-colors hover:border-white/25 hover:bg-white/[0.05]">
          <span class="min-w-0"><span class="block font-mono text-[10px] font-semibold tracking-[0.14em] text-text-tertiary">NEXT · 2 OF 4</span><span class="mt-1 block text-[14.5px] font-bold text-text-primary">In depth: why the week read that way</span></span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>

      <!-- ═══ LABS ═══════════════════════════════════════════════════════ -->
      <!-- ═══ IN DEPTH: one person, at the depth a coach wants ═══════════════
           Four answers to "how is this person doing" as one strip, then six
           chapters with the working: rhythm, load, sessions, fitness, sleep
           and heart, labs and body and what is due. Every number
           here is computed from rows the page already reads, so a person
           you look after gets the same page from their exports, and a
           client's page shows only what their scopes let you read. -->
      <div id="tab-depth" class="mt-6 hidden">
        <p class="mb-5 max-w-3xl text-[13.5px] leading-relaxed text-text-secondary"><span class="font-semibold text-text-primary">This page:</span> why the week read the way the Overview said. The same four cards, with the working shown.</p>
        <!-- "In Verve's words": a short reading of this page, written by Claude from the page's own working -->
        <section id="dp-ai" class="mb-5 hidden flex-col gap-3 rounded-2xl border border-accent/50 bg-accent/[0.07] p-5"></section>
        <!-- a view (src/my-health/views/Depth): the plan gate, the head, the four answers, the six chapters, what changed -->
        <div id="depthroot"></div>
        <p class="mt-2 text-[12px] text-text-muted">Ranges are each lab's own. Cadences are the cited ones on the marker pages in the science section; the fitness-test and body-assessment cadences are the app's. None of it is a diagnosis.</p>
        <!-- the next step in the chain: picture, what moved, values, paper -->
        <button type="button" data-goto="labs" class="mt-8 flex w-full max-w-3xl items-center justify-between gap-4 rounded-2xl border border-white/12 bg-white/[0.03] px-5 py-4 text-left transition-colors hover:border-white/25 hover:bg-white/[0.05]">
          <span class="min-w-0"><span class="block font-mono text-[10px] font-semibold tracking-[0.14em] text-text-tertiary">NEXT · 3 OF 4</span><span class="mt-1 block text-[14.5px] font-bold text-text-primary">Labs: the values behind the Body card</span></span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>

      <div id="tab-labs" class="mt-6 hidden">
        <p class="mb-5 max-w-3xl text-[13.5px] leading-relaxed text-text-secondary"><span class="font-semibold text-text-primary">This page:</span> the values. Every marker, its band, its history and when it is next due; the Body card's number comes from here.</p>
        <!-- a view (src/my-health/views/Labs): the rail, the section, the charts -->
        <div id="labsroot"></div>
        <!-- the next step in the chain: picture, what moved, values, paper -->
        <button type="button" data-goto="reports" class="mt-8 flex w-full max-w-3xl items-center justify-between gap-4 rounded-2xl border border-white/12 bg-white/[0.03] px-5 py-4 text-left transition-colors hover:border-white/25 hover:bg-white/[0.05]">
          <span class="min-w-0"><span class="block font-mono text-[10px] font-semibold tracking-[0.14em] text-text-tertiary">NEXT · 4 OF 4</span><span class="mt-1 block text-[14.5px] font-bold text-text-primary">Reports: the paper every value came from</span></span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>

      <!-- ═══ REPORTS ════════════════════════════════════════════════════ -->
      <div id="tab-reports" class="mt-6 hidden">
        <p class="mb-5 max-w-3xl text-[13.5px] leading-relaxed text-text-secondary"><span class="font-semibold text-text-primary">This page:</span> the paper, and the years. The files every value came from, by year and month, and the history you brought in: the app's exports and workout CSVs. Every row stays on the Overview, however far back it reaches.</p>
        <!-- ── the archive first: a timeline, one card per original PDF, a year and a month at a time ── -->
        <div id="repcards" class="flex max-w-3xl flex-col gap-3"></div>

        <!-- the app's exports dropped here: one line each, rebuilt from the rows they left, with the way back -->
        <div id="appimportsroot"></div>

        <!-- every year with movement on file, a column each: what the history you brought in reaches back to -->
        <div id="yearsonfileroot"></div>

        <!-- ── then the one place to add a report; dragging anywhere on the page lands here too ── -->
        <label id="drop" for="file"
          class="mt-6 flex max-w-3xl cursor-pointer items-center gap-4 rounded-2xl border-[1.5px] border-dashed border-accent/45 bg-accent/[0.05] px-5 py-4 transition-colors hover:border-accent/70">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/[0.14]">
            <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/>
