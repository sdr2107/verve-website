                  <th class="px-3 py-2.5 font-semibold">4-WEEK CHANGE</th>
                  <th class="px-3 py-2.5 font-semibold">THIS WEEK</th>
                  <th class="px-3 py-2.5 font-semibold">FITNESS</th>
                  <th class="px-3 py-2.5 font-semibold">LATEST LABS</th>
                  <th class="px-3 py-2.5 font-semibold">RETEST DUE</th>
                  <th class="px-3 py-2.5 font-semibold">LAST ACTIVE</th>
                  <th class="px-3 py-2.5 font-semibold">AT GOAL</th>
                </tr>
              </thead>
              <tbody id="glancerows" class="divide-y divide-white/[0.06]"></tbody>
            </table>
          </div>
          <div class="mt-3 grid gap-3 lg:grid-cols-[7fr_5fr]">
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
              <h3 class="text-[15px] font-extrabold text-text-primary">This week</h3>
              <div id="glanceweek" class="mt-2 flex flex-col gap-1.5 text-[13px] leading-relaxed text-text-secondary"></div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
              <h3 class="text-[15px] font-extrabold text-text-primary">Retest due</h3>
              <div id="glancedue" class="mt-2 flex flex-col gap-1.5 text-[13px] leading-relaxed text-text-secondary"></div>
              <p class="mt-2 text-[12px] text-text-muted">Lab cadences are the cited ones on the marker pages. A person sees the same due dates on their own In depth tab.</p>
            </div>
          </div>
          <p class="mt-2 text-[12px] text-text-muted">Consent decides what you see: nothing here shows without the person's tick, and they can stop at any time.</p>
        </section>
      </div>

      <!-- ═══ OVERVIEW ═══════════════════════════════════════════════════ -->
      <div id="tab-overview" class="mt-6 hidden">
       <!-- All: the person at a glance -->
       <div id="ovall">
        <!-- values for the app that were read but never sent: one line, until it is done -->
        <div id="tosend" class="mb-5 hidden flex-wrap items-center gap-3 rounded-2xl border border-accent/30 bg-accent/[0.06] px-4 py-3.5">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] bg-accent/[0.16]">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>
          </span>
          <span id="tosendtext" class="min-w-0 flex-1 text-[13px] leading-relaxed text-text-secondary"></span>
          <button id="tosendgo" class="min-h-10 rounded-full bg-accent px-4 py-2 text-[13px] font-semibold text-canvas transition-opacity hover:opacity-90">Review and send &rarr;</button>
        </div>
        <!-- nothing yet: the one call to action, since the drop zone lives on Reports -->
        <div id="emptycard" class="hidden max-w-3xl rounded-2xl border border-dashed border-accent/40 bg-accent/[0.04] p-6">
          <p class="text-sm font-semibold text-text-primary">No reports yet</p>
          <p class="mt-1 text-[13px] leading-relaxed text-text-tertiary">
            Drop your first lab report and every value in it becomes a trend you keep. A PDF or a photo, several at once, or the JSON file your Verve app exports.
          </p>
          <button id="emptyadd" class="mt-4 min-h-11 rounded-xl bg-accent px-5 py-2.5 text-sm font-bold text-canvas transition-opacity hover:opacity-90">Add a report</button>
        </div>

        <!-- ═══ WORTH A LOOK: what moved, first ═══════════════════════════
             Two rows. Today is the app's daily read (resting heart rate,
             sleep, steps, recovery), judged against the person's own normal;
             This week is the app's week against the goal, the latest lab
             values outside their range, and the nearest retest. Each card
             opens where it came from. -->
        <section id="worthwrap" class="mb-7 hidden">
          <div class="flex flex-wrap items-end justify-between gap-2">
            <div>
              <h2 class="text-[17px] font-bold tracking-tight text-text-primary">Worth a look</h2>
              <p class="mt-0.5 text-[12.5px] text-text-tertiary">What moved, from the app and from the labs. Each card opens where it came from.</p>
            </div>
            <button id="worthall" data-goto="labs" class="text-[13px] font-medium text-accent-light hover:text-text-primary"></button>
          </div>
          <div id="worthtoday" class="mt-4 hidden">
            <div class="flex items-center gap-3">
              <span id="worthtodaykick" class="font-mono text-[10px] font-semibold tracking-[0.14em] text-text-tertiary"></span>
              <span class="h-px flex-1 bg-white/[0.07]" aria-hidden="true"></span>
              <span class="text-[12px] text-text-muted">from the app</span>
            </div>
            <div id="worthtodaycards" class="mt-2.5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4"></div>
          </div>
          <div id="worthweek" class="mt-4 hidden">
            <div class="flex items-center gap-3">
              <span id="worthweekkick" class="font-mono text-[10px] font-semibold tracking-[0.14em] text-text-tertiary"></span>
              <span class="h-px flex-1 bg-white/[0.07]" aria-hidden="true"></span>
              <span class="text-[12px] text-text-muted">the app&rsquo;s week, and the labs</span>
            </div>
            <div id="worth" class="mt-2.5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4"></div>
          </div>
        </section>

        <!-- your sections: the same split as Labs, each a way in -->
        <section id="secwrap" class="hidden">
          <h2 class="text-[17px] font-bold tracking-tight text-text-primary">Your sections</h2>
          <p class="mt-0.5 text-[12.5px] text-text-tertiary">In range against each lab&rsquo;s own printed range. Tap one to open it in Labs.</p>
          <div id="sections" class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4"></div>
        </section>

        <!-- ═══ ACTIVITY AND FITNESS: the app's weeks, with a marker on top ═══ -->
        <section id="activitywrap" class="mt-7 hidden">
          <div class="flex flex-wrap items-end justify-between gap-2">
            <div>
              <h2 class="text-[17px] font-bold tracking-tight text-text-primary">Fitness and a marker</h2>
              <p id="activitysub" class="mt-0.5 text-[12.5px] text-text-tertiary"></p>
            </div>
            <p id="markercount" class="text-[12.5px] text-text-tertiary"></p>
          </div>
          <!-- the 21 markers in their three sections; a dashed chip has no reading yet -->
          <div id="markerpick" class="mt-3 flex flex-col gap-2"></div>
          <div class="mt-3 overflow-x-auto rounded-2xl border border-white/10 bg-white/[0.03] p-4">
            <svg id="activitychart" viewBox="0 0 1150 352" class="block h-auto w-full min-w-[640px]" role="img" aria-label="A marker's readings in their own lane, the lab's range shaded, above weekly MET-hours as bars"></svg>
          </div>
          <div id="activitylegend" class="mt-2.5 flex flex-wrap gap-x-7 gap-y-1.5 text-[12.5px] text-text-tertiary"></div>
          <div id="activitystats" class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-[12.5px] text-text-tertiary"></div>
          <p class="mt-1 text-[12px] text-text-muted">Two things on one timeline, with no claim about which moved the other.</p>
        </section>

        <section id="latestwrap" class="mt-7 hidden">
          <h2 class="text-[17px] font-bold tracking-tight text-text-primary">Latest report</h2>
          <div id="latestcard" class="mt-3 rounded-2xl border border-white/10 bg-white/[0.03] p-4 sm:p-5"></div>
        </section>

        <p class="mt-7 font-mono text-[10.5px] text-text-muted lg:hidden">Drag a PDF anywhere on this page to add it.</p>
       </div>

       <!-- ═══ ONE SECTION: its markers as tiles, one of them open ═════════
            Fitness, Movement, Sleep & heart or Body, picked in the sidebar.
            Everything here is drawn by renderSection() from rows the page
            already holds; nothing is fetched for it. -->
       <div id="ovsection" class="hidden">
         <div class="flex flex-wrap items-end justify-between gap-4">
           <div class="min-w-0">
             <div id="seckick" class="font-mono text-[10px] font-semibold tracking-[0.14em] text-text-tertiary"></div>
             <h2 class="mt-1.5 flex items-center gap-2.5 text-[24px] font-extrabold tracking-[-0.02em] text-text-primary"><span id="secdot" class="h-2.5 w-2.5 shrink-0 rounded-full"></span><span id="secname"></span></h2>
             <p id="secsub" class="mt-1.5 text-[13px] text-text-tertiary"></p>
           </div>
           <a id="seclink" href="/science" class="text-[13px] font-medium text-accent-light hover:text-text-primary">The science behind these &rarr;</a>
         </div>
         <div id="sectiles" class="mt-5 grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-6"></div>
         <div id="secopen" class="mt-4"></div>
       </div>
      </div>

      <!-- ═══ LABS ═══════════════════════════════════════════════════════ -->
      <!-- ═══ IN DEPTH: one person, at the depth a coach wants ═══════════════
           Four cards that answer "how is this person doing", then the four
           panels behind them: activity, fitness, labs, body. Every number
           here is computed from rows the page already reads, so a person
           you look after gets the same page from their exports, and a
           client's page shows only what their scopes let you read. -->
      <div id="tab-depth" class="mt-6 hidden">
        <!-- the plan gate: in depth is on Pro for yourself, on Max for everyone you see -->
        <div id="dp-locked" class="hidden max-w-2xl flex-col gap-3 rounded-2xl border border-dashed border-accent/50 bg-accent/[0.05] p-5"></div>
        <!-- "In Verve's words": a short reading of this page, written by Claude from the page's own working -->
        <section id="dp-ai" class="mb-5 hidden flex-col gap-3 rounded-2xl border border-accent/50 bg-accent/[0.07] p-5"></section>
        <p id="dp-empty" class="hidden max-w-3xl text-[13.5px] leading-relaxed text-text-tertiary"></p>
        <div id="dp-cards" class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4"></div>
        <div id="dp-panels" class="mt-5 grid gap-4 lg:grid-cols-2">
          <section id="dp-activity" class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"></section>
          <section id="dp-fitness" class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"></section>
          <section id="dp-labs" class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"></section>
          <section id="dp-body" class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"></section>
          <section id="dp-heart" class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 lg:col-span-2"></section>
        </div>
        <div id="dp-changed" class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 rounded-2xl border border-white/10 px-5 py-3.5 text-[13px] text-text-secondary"></div>
        <p class="mt-2 text-[12px] text-text-muted">Ranges are each lab's own. Cadences are the cited ones on the marker pages in the science section; the fitness-test and body-assessment cadences are the app's. None of it is a diagnosis.</p>
      </div>

      <div id="tab-labs" class="mt-6 hidden">
        <div id="labsempty" class="mt-6 hidden rounded-2xl border border-white/10 bg-white/[0.03] p-6 text-sm text-text-tertiary">
          Nothing here yet — drop a report on the <button data-goto="reports" class="font-semibold text-accent-light hover:underline">Reports</button> tab and every value in it lands here.
        </div>
        <p id="labsnomatch" class="mt-6 hidden rounded-2xl border border-white/10 bg-white/[0.03] p-6 text-sm text-text-tertiary"></p>
        <div class="mt-4 flex flex-col gap-4 md:flex-row">
          <nav id="labsrail" class="flex flex-col gap-1.5 md:w-56 md:shrink-0"></nav>
          <div id="labspanel" class="hidden min-w-0 flex-1 rounded-2xl border border-white/10 bg-white/[0.03] p-5 md:block"></div>
        </div>
      </div>

      <!-- ═══ REPORTS ════════════════════════════════════════════════════ -->
      <div id="tab-reports" class="mt-6 hidden">
        <!-- ── the archive first: a timeline, one card per original PDF, a year and a month at a time ── -->
        <div id="repcards" class="flex max-w-3xl flex-col gap-3"></div>

        <!-- the app's exports dropped here: one line each, rebuilt from the rows they left, with the way back -->
        <section id="appimports" class="mt-6 hidden max-w-3xl rounded-2xl border border-white/10 bg-white/[0.03] p-4">
          <div class="font-mono text-[10px] font-semibold tracking-widest text-text-tertiary">FROM THE VERVE APP</div>
          <div id="appimportrows" class="mt-2 flex flex-col gap-2"></div>
          <p class="mt-2 text-[12px] text-text-muted">The weeks, fitness tests and waist readings are on the Overview; the lab values are on Labs with everything else.</p>
        </section>

        <!-- ── then the one place to add a report; dragging anywhere on the page lands here too ── -->
        <label id="drop" for="file"
          class="mt-6 flex max-w-3xl cursor-pointer items-center gap-4 rounded-2xl border-[1.5px] border-dashed border-accent/45 bg-accent/[0.05] px-5 py-4 transition-colors hover:border-accent/70">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/[0.14]">
            <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/>
            </svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-semibold text-text-primary">Add older reports: drop them here, or tap to choose</span>
            <span class="mt-0.5 block text-xs leading-relaxed text-text-tertiary">A PDF, a photo of the report as JPG, PNG or WebP, or the JSON your Verve app exports &middot; up to 15 MB each &middot; several at once &middot; originals stay in your private archive &middot; a file you already have is spotted before it is filed</span>
          </span>
          <span class="hidden shrink-0 rounded-lg border border-accent/40 bg-accent/10 px-3 py-2 text-xs font-bold text-accent-light sm:inline-block">Choose files</span>
          <input id="file" type="file" accept="application/pdf,image/jpeg,image/png,image/webp,image/heic,image/heif,application/json,.json" multiple class="hidden" />
        </label>

        <!-- the report names someone else: held here, nothing filed, until you say whose it is -->
        <div id="namecheck" class="mt-6 hidden max-w-3xl flex-col gap-3 rounded-2xl border border-warning/50 bg-warning/[0.06] p-5"></div>

        <!-- the batch queue: one row per dropped file, each with its stage -->
        <div id="upqueue" class="mt-6 hidden max-w-3xl flex-col gap-2"></div>
        <!-- an import of the app's export: what came in, and the way back -->
        <div id="importcard" class="mt-3 hidden max-w-3xl flex-wrap items-center gap-x-3 gap-y-1 rounded-2xl border border-success/40 bg-success/[0.06] px-4 py-3 text-[13px] text-text-secondary"></div>

        <!-- ── the review: two tiers ─────────────────────────────────────── -->
        <div id="review" class="mt-6 hidden flex-col gap-4">
          <div class="flex flex-wrap items-center gap-3">
            <h2 id="rvtitle" class="text-base font-extrabold"></h2>
            <span id="rvcount" class="rounded-md bg-warning/15 px-2 py-0.5 font-mono text-[10px] font-semibold tracking-wider text-warning"></span>
            <span id="rvpos" class="hidden rounded-md bg-white/[0.06] px-2 py-0.5 font-mono text-[10px] font-semibold tracking-wider text-text-secondary"></span>
            <div class="ml-auto flex items-center gap-2">
              <span class="font-mono text-[10px] uppercase tracking-wider text-text-tertiary">Report date</span>
              <input id="rvdate" type="date"
                class="rounded-lg border border-white/12 bg-white/[0.04] px-3 py-1.5 text-sm text-text-primary focus:border-accent focus:outline-none" />
            </div>
          </div>

          <!-- tier 1: app-bound -->
          <div class="rounded-2xl border border-accent/40 bg-white/[0.03] p-5">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[10px] font-semibold tracking-widest text-accent-light">GOES TO YOUR APP</span>
              <span class="text-xs text-text-tertiary">Metabolic · Heart · Muscle — check anything Verve misread</span>
            </div>
            <div id="rvapp" class="mt-2 divide-y divide-white/[0.06]"></div>
            <div class="mt-4 flex flex-wrap items-center gap-3">
              <button id="confirm"
                class="rounded-xl bg-accent px-5 py-3 text-sm font-bold text-canvas transition-opacity hover:opacity-90 disabled:opacity-50"></button>
              <span class="text-xs text-text-muted">
                Duplicates — same marker, same date, same value — are never sent twice.
              </span>
            </div>
            <p id="rvmsg" class="mt-3 hidden text-sm"></p>
          </div>

          <!-- tier 2: website archive -->
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[10px] font-semibold tracking-widest text-text-secondary">STAYS ON THE WEBSITE</span>
              <span id="rvwebnote" class="text-xs text-text-tertiary"></span>
            </div>
            <div id="rvweb" class="mt-2"></div>
          </div>

          <div class="flex items-center gap-3">
            <button id="discard" class="rounded-xl border border-white/14 px-4 py-2.5 text-sm font-semibold text-text-secondary transition-colors hover:border-white/25">
              Close review
            </button>
            <span class="text-xs text-text-muted">Everything above is already on your Labs tab — closing loses nothing.</span>
          </div>
        </div>

        <!-- ── echo review: numbers → Labs, the doctor's words kept apart ── -->
        <div id="echoreview" class="mt-6 hidden rounded-2xl border border-accent/40 bg-white/[0.03] p-5"></div>

      </div>

      <p class="mt-10 text-xs leading-5 text-text-muted">
        Wellness screening, not a diagnosis — parsing can misread a report, which is
        why you confirm app-bound values. Reports and values are private to your account.
      </p>
      </div>
     </div>
    </section>

    <p id="loading" class="mt-10 text-sm text-text-tertiary">Checking your session…</p>
  </main>

  <!-- ═══ GIVE ACCESS ═══════════════════════════════════════════════════
       Who can see the open person's page, and the way to let someone new.
       A panel over the page, opened from the sidebar (or the small button
       under the tabs on a phone), since it is about the account's trust
       rather than about any one tab. Each grant can be changed here, not
       only stopped: the ticks are re-saved on the same row. -->
  <div id="sharewrap" class="fixed inset-0 z-40 hidden items-start justify-center overflow-y-auto bg-canvas-3/70 p-4 backdrop-blur-sm sm:p-8" role="dialog" aria-modal="true" aria-labelledby="sharetitle">
    <div class="mh-open mt-4 w-full max-w-2xl rounded-[20px] border border-white/12 bg-[#15151f] p-5 shadow-2xl shadow-black/50 sm:mt-8 sm:p-7">
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <span id="sharekick" class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-accent-light">Access · your page</span>
          <h2 id="sharetitle" class="mt-2 text-[22px] font-extrabold tracking-[-0.02em] text-text-primary sm:text-2xl">Give access to your page</h2>
          <p class="mt-1.5 text-[13px] leading-relaxed text-text-secondary">They can look, not change. You choose what they see, and you can stop, or change it, at any time.</p>
        </div>
        <button type="button" id="shareclose" aria-label="Close" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/12 text-text-secondary transition-colors hover:border-white/25 hover:text-text-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      <div class="mt-5">
        <div class="font-mono text-[10px] font-semibold tracking-[0.14em] text-text-tertiary">HAS ACCESS</div>
        <div id="sharelist" class="mt-2 flex flex-col gap-2"></div>
      </div>

      <form id="shareform" class="mt-5 flex flex-col gap-3 border-t border-white/[0.07] pt-5">
        <div class="font-mono text-[10px] font-semibold tracking-[0.14em] text-text-tertiary">GIVE ACCESS TO SOMEONE NEW</div>
        <label class="flex flex-col gap-1 text-[12px] text-text-secondary">Their email
          <input id="shareemail" type="email" required autocomplete="off" placeholder="coach@example.com"
            class="w-80 max-w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-2 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none" />
        </label>
        <fieldset class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[13.5px] text-text-primary">
          <legend class="mb-1 text-[12px] text-text-secondary">What they see</legend>
          <label class="flex min-h-9 items-center gap-2"><input type="checkbox" data-scope="labs" class="h-4 w-4 accent-[#818cf8]" />Labs</label>
          <label class="flex min-h-9 items-center gap-2"><input type="checkbox" data-scope="imaging" class="h-4 w-4 accent-[#818cf8]" />Imaging</label>
          <label class="flex min-h-9 items-center gap-2"><input type="checkbox" data-scope="activity" class="h-4 w-4 accent-[#818cf8]" />Activity and fitness</label>
          <label class="flex min-h-9 items-center gap-2"><input type="checkbox" data-scope="body" class="h-4 w-4 accent-[#818cf8]" />Body measurements</label>
          <label class="flex min-h-9 items-center gap-2"><input type="checkbox" data-scope="heart" class="h-4 w-4 accent-[#818cf8]" />Sleep and heart</label>
        </fieldset>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <button type="submit" class="min-h-10 rounded-xl bg-accent px-4 py-2 text-sm font-bold text-canvas transition-opacity hover:opacity-90">Send the invitation</button>
          <p class="text-[12px] leading-relaxed text-text-tertiary">They get an email with a link that signs them in. Nothing is shared until they open it.</p>
        </div>
        <p class="text-[12px] leading-relaxed text-text-tertiary">Activity, body measurements, and sleep and heart come from the app, so they are offered only for a person with an account.</p>
      </form>
      <p id="sharemsg" class="mt-3 hidden text-[13px]"></p>
    </div>
  </div>

  <!-- ── the veil: any page, the moment a file is dragged over it ──────── -->
  <div id="veil" class="pointer-events-none fixed inset-0 z-50 hidden items-center justify-center bg-canvas-3/75 p-6 backdrop-blur-sm">
    <div class="flex w-full max-w-[560px] flex-col items-center gap-3.5 rounded-3xl border-2 border-dashed border-accent/70 bg-canvas/85 px-8 py-11 text-center">
      <span class="flex h-16 w-16 items-center justify-center rounded-[18px] bg-accent/[0.16]">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
      </span>
      <p class="text-[26px] font-extrabold tracking-[-0.02em] text-text-primary">Drop to add</p>
      <p class="max-w-[380px] text-[13px] leading-relaxed text-text-secondary">
        PDF reports, or photos of them, several at once. They land on the Reports tab, and any that you already have is spotted before it is filed.
      </p>
    </div>
  </div>

  <Footer />
</Layout>

<style is:global>
  /* Motion has one job here: to say what just changed and where to look.
     Six moments move; nothing else does. Every entry eases out and is under
     a third of a second, and all of it is off under reduced motion. */
  @keyframes mh-rise { to { opacity: 1; transform: translateY(0); } }
  @keyframes mh-draw { to { stroke-dashoffset: 0; } }
  @keyframes mh-fade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes mh-veil { from { opacity: 0; } to { opacity: 1; } }
  @keyframes mh-frame { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: scale(1); } }
  @keyframes mh-pulse { 0%, 100% { background-color: transparent; } 40% { background-color: rgba(251, 191, 36, 0.22); } }

  /* the page opens: the greeting fades up, tiles and cards rise in, staggered by --i */
  .mh-rise { opacity: 0; transform: translateY(6px); animation: mh-rise 0.32s cubic-bezier(0.2, 0.7, 0.2, 1) forwards; animation-delay: calc(var(--i, 0) * 60ms); }
  /* a section ring draws itself: --len is the arc, set where the ring is drawn */
  .mh-ring { stroke-dashoffset: var(--len, 0); animation: mh-draw 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards; animation-delay: calc(var(--i, 0) * 60ms + 0.2s); }
  /* a tab switch, and a chart opening */
  .mh-fade { animation: mh-fade 0.18s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .mh-open { animation: mh-fade 0.22s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  /* a file dragged over the page */
  #veil.flex { animation: mh-veil 0.15s ease-out both; }
  #veil.flex > div { animation: mh-frame 0.18s cubic-bezier(0.2, 0.7, 0.2, 1) 0.05s both; }
  /* a value outside its range, the moment a report is read: one pulse, then it settles */
  .mh-pulse { border-radius: 6px; animation: mh-pulse 0.6s ease-out 0.3s 1; }

  /* the reader at work: a turning arc, and a bar that eases toward the end
     over the time a read usually takes, then jumps when the answer comes */
  @keyframes mh-spin { to { transform: rotate(360deg); } }
  .mh-spin { animation: mh-spin 0.9s linear infinite; transform-origin: center; }
  #busybar { transition: width 0.4s ease-out; }
  #busybar.mh-creep { transition: width 40s cubic-bezier(0.1, 0.6, 0.2, 1); }
  @media (prefers-reduced-motion: reduce) {
    .mh-spin { animation: none; }
    #busybar, #busybar.mh-creep { transition: none; }
  }

  /* the sign-in card's status line: a quiet row, tinted only when something went wrong */
  .mh-status { border-radius: 10px; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03); padding: 9px 13px; }
  .mh-status.text-danger { border-color: rgba(248,113,113,0.30); background: rgba(248,113,113,0.06); }

  @media (prefers-reduced-motion: reduce) {
    .mh-rise, .mh-ring, .mh-fade, .mh-open, #veil.flex, #veil.flex > div, .mh-pulse {
      animation: none; opacity: 1; transform: none; stroke-dashoffset: 0;
    }
  }
</style>

<script>
  import { supabase, SUPABASE_URL, SUPABASE_ANON_KEY } from "../lib/supabase";
  import { canonName, unitKey } from "../lib/canon.js";
  import { AUTO_SEND_TO_APP } from "../data/site";
  import { PLANS_ENFORCED, PLANS_OPEN, AI_SUMMARY_OPEN, entitlements, planOf, type PlanKey } from "../data/plans";

  // ── tiny DOM helpers ───────────────────────────────────────────────────
  const $ = (id: string) => document.getElementById(id)!;
  const show = (id: string, on: boolean) => $(id).classList.toggle("hidden", !on);
  /** A status line: grey while something is happening, tinted when it went wrong. */
  const msg = (id: string, text: string, bad = false) => {
    const el = $(id);
    el.textContent = text;
    el.classList.toggle("hidden", !text);
    el.classList.toggle("text-danger", bad);
    el.classList.toggle("text-text-secondary", !bad);
  };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]!));
  const fmtDay = (d: string) =>
    new Date(d + "T00:00:00").toLocaleDateString(undefined, { day: "numeric", month: "short", year: "numeric" });

  // ── the app markers, keyed by lab_readings COLUMNS ─────────────────────
  const LABELS: Record<string, { label: string; unit: string; section: "metabolic" | "heart" | "sarcopenia" }> = {
    glucose_mgdl:           { label: "Fasting glucose",   unit: "mg/dL",  section: "metabolic" },
    hba1c_pct:              { label: "HbA1c",             unit: "%",      section: "metabolic" },
    post_meal_glucose_mgdl: { label: "Post-meal glucose", unit: "mg/dL",  section: "metabolic" },
    fasting_insulin_uiuml:  { label: "Fasting insulin",   unit: "uIU/mL", section: "metabolic" },
    triglycerides_mgdl:     { label: "Triglycerides",     unit: "mg/dL",  section: "metabolic" },
    hdl_mgdl:               { label: "HDL",               unit: "mg/dL",  section: "metabolic" },
    waist_cm:               { label: "Waist",             unit: "cm",     section: "metabolic" },
    sbp:                    { label: "Systolic BP",       unit: "mmHg",   section: "metabolic" },
    dbp:                    { label: "Diastolic BP",      unit: "mmHg",   section: "metabolic" },
    apo_b_mgdl:             { label: "ApoB",              unit: "mg/dL",  section: "heart" },
    ldl_mgdl:               { label: "LDL",               unit: "mg/dL",  section: "heart" },
    lpa_value:              { label: "Lp(a)",             unit: "",       section: "heart" },
    hs_crp_mgl:             { label: "hs-CRP",            unit: "mg/L",   section: "heart" },
    body_fat_pct:           { label: "Body fat",          unit: "%",      section: "sarcopenia" },
    skel_musc_pct:          { label: "Skeletal muscle",   unit: "%",      section: "sarcopenia" },
    alm_kg:                     { label: "Lean mass, arms and legs", unit: "kg",  section: "sarcopenia" },
    ffm_kg:                     { label: "Whole-body lean mass",     unit: "kg",  section: "sarcopenia" },
    handgrip_kg:                { label: "Grip strength",            unit: "kg",  section: "sarcopenia" },
    single_leg_balance_seconds: { label: "Single-leg balance",       unit: "s",   section: "sarcopenia" },
    chair_stand_seconds:        { label: "Chair stand",              unit: "s",   section: "sarcopenia" },
    gait_speed_ms:              { label: "Walk speed",               unit: "m/s", section: "sarcopenia" },
  };

  const SECTIONS: Record<string, string> = {
    metabolic: "Metabolic", heart: "Heart", muscle: "Muscle",
    haematology: "Haematology", lipids: "Lipids", liver: "Liver", kidney: "Kidney",
    thyroid: "Thyroid", vitamins_iron: "Vitamins & iron", hormones: "Hormones",
    inflammation: "Inflammation", urine: "Urine", imaging: "Imaging", other: "Other",
  };
  const SECTION_ORDER = Object.keys(SECTIONS);

  let userId = "";
  let userEmail = "";
  /** The name on the account, and its first word for the greeting; "" when there is none. */
  let fullName = "";
  let firstName = "";
  let parsed: { path: string; lpa_unit: string | null; dupKeys: Set<string> } | null = null;

  // ── the plan this account holds ─────────────────────────────────────────
  // One login, three plans. The plan sits on whoever pays and decides how
  // many people they can see and how deep; consent is free on every plan.
  // Read once at sign-in from my_plan(), which folds in the grace period
  // and the VIP list. Nothing is held to a plan until PLANS_ENFORCED is on;
  // the owner can preview the gate with sessionStorage mh-plans-enforce=1,
  // which can only make the page stricter, never looser.
  let plan: PlanKey = "free";
  let ent = entitlements("free");
  const enforced = (() => { try { return PLANS_ENFORCED || sessionStorage.getItem("mh-plans-enforce") === "1"; } catch { return PLANS_ENFORCED; } })();
  async function loadPlan() {
    plan = "free";
    try {
      const { data, error } = await supabase.rpc("my_plan");
      const row = Array.isArray(data) ? data[0] : data;
      if (!error && row?.plan && ["free", "pro", "max", "enterprise"].includes(row.plan)) plan = row.plan;
    } catch { /* the function may not exist yet: free */ }
    ent = entitlements(plan);
    show("planline", PLANS_OPEN);
    if (PLANS_OPEN) $("planline").innerHTML = plan === "free"
      ? `Free plan · <a href="/plans" class="font-semibold text-accent-light hover:text-text-primary">see the plans</a>`
      : `${esc(planOf(plan).name)} plan · <a href="/plans" class="font-semibold text-accent-light hover:text-text-primary">plans</a>`;
  }
  const lockCard = (title: string, body: string, cta = "See the plans") => `
    <div class="text-[17px] font-extrabold text-text-primary">${title}</div>
    <p class="text-[13.5px] leading-relaxed text-text-secondary">${body}</p>
    <div class="flex flex-wrap gap-2"><a href="/plans" class="inline-flex min-h-10 items-center rounded-xl bg-accent px-4 text-sm font-bold text-canvas">${cta}</a><button type="button" data-goto="overview" class="min-h-10 px-3 text-sm font-semibold text-text-secondary hover:text-text-primary">Not now</button></div>`;
  /** People besides you that count against the plan: looked after, or sharing with you. */
  const peopleCount = () => people.filter((p) => p.id && !p.self).length;
  /** Whether one more person may be added, and if not, why. */
  function roomForOneMore(): { ok: boolean; why: string } {
    if (!enforced) return { ok: true, why: "" };
    const max = ent.peopleMax;
    const n = peopleCount() + 1;   // you included
    if (max != null && n >= max) {
      const name = planOf(plan).name;
      return { ok: false, why: plan === "free"
        ? `The free plan lets you see one other person. Pro is the same; Max holds five in all, and Enterprise has no family limit.`
        : `${name} holds ${max} people, and you have ${n}. To add another, remove someone, or move to ${plan === "max" ? "Enterprise, which has no family limit" : "Max"}.` };
    }
    return { ok: true, why: "" };
  }

  // ── people: whose page this is ─────────────────────────────────────────
  // Every row belongs to a person. A person is one of three things: your own
  // self (account_id = you), someone you look after (no account of their
  // own; owner_id = you), or someone else's self seen through a grant they
  // accepted. Before the people table exists the page runs as before, with
  // a stand-in self whose id is empty: queries then fall back to user_id.
  type Person = { id: string; owner_id: string; account_id: string | null; name: string; born_year: number | null; mine: boolean; self: boolean; scopes: string[] };
  let people: Person[] = [];
  let person: Person | null = null;
  const PERSON_KEY = "mh-person";
  const ALL_SCOPES = ["labs", "imaging", "activity", "body", "notes"];
  /** Where a person's files live: an account's own at <account>/, someone looked after at <account>/people/<id>/. */
  const folderOf = (p: Person) => p.account_id ? p.account_id : `${p.owner_id}/people/${p.id}`;
  const folder = () => folderOf(person!);
  const canWrite = () => !!person?.mine;
  const isSelf = () => !!person?.self;
  /** A query on web_labs / imaging_reports, scoped to one person (or, before the table exists, to the account). */
  const scopeRows = (q: any, who: Person | null = person) => who?.id ? q.eq("person_id", who.id) : q.eq("user_id", userId);
  const personCol = (who: Person | null = person) => who?.id ? { person_id: who.id } : {};
  const standIn = (): Person => ({ id: "", owner_id: userId, account_id: userId, name: fullName, born_year: null, mine: true, self: true, scopes: ALL_SCOPES });

  async function loadPeople() {
    const [{ data: rows, error }, { data: grants }] = await Promise.all([
      supabase.from("people").select("id, owner_id, account_id, name, born_year").order("created_at", { ascending: true }),
      supabase.from("grants").select("person_id, scopes").eq("viewer_id", userId).eq("status", "active"),
    ]);
    let list = (error ? [] : rows ?? []) as any[];
    if (!error && !list.some((p) => p.account_id === userId)) {
      // the account's own person, when the database has not made one yet
      const { data: made } = await supabase.from("people")
        .insert({ owner_id: userId, account_id: userId, name: fullName })
        .select("id, owner_id, account_id, name, born_year").maybeSingle();
      if (made) list = [made, ...list];
    }
    const mine = list.find((p) => p.account_id === userId);
    if (mine && !mine.name && fullName) { mine.name = fullName; supabase.from("people").update({ name: fullName }).eq("id", mine.id).then(() => {}); }
    const scopesBy = new Map<string, string[]>((grants ?? []).map((g: any) => [g.person_id, g.scopes ?? []]));
    people = list.map((p) => ({
      ...p, name: p.name ?? "", born_year: p.born_year ?? null,
      mine: p.owner_id === userId, self: p.account_id === userId,
      scopes: p.owner_id === userId ? ALL_SCOPES : (scopesBy.get(p.id) ?? []),
    }));
    if (!people.some((p) => p.self)) people = [standIn(), ...people];
    // you first, then the people you look after, then those who share with you
    people.sort((a, b) => Number(b.self) - Number(a.self) || Number(b.mine) - Number(a.mine) || a.name.localeCompare(b.name));
    let wanted = "";
    try { wanted = sessionStorage.getItem(PERSON_KEY) ?? ""; } catch { /* fine */ }
    person = people.find((p) => p.id && p.id === wanted) ?? people.find((p) => p.self) ?? people[0];
  }

  /** What the page lets you do depends on whose page it is. */
  function applyPersonMode() {
    const w = canWrite(), self = isSelf();
    show("addreport", w); show("drop", w); show("emptyadd", w);
    show("personnotewrap", w && !self && !!person?.id);
    show("accesswrap", w && !!person?.id); if (!(w && person?.id)) closeAccess();
    show("namechange", self && !!firstName);
    if (!self) hideNameForm();
    renderPeople();
  }

  function renderPeople() {
    const has = people.some((p) => !!p.id);   // the people table exists
    show("peoplewrap", has); show("personwrap", has && activeTab !== "group");
    if (!has) return;
    const others = people.filter((x) => x.id && !x.self);
    // a chip on a phone, a row in the sidebar from lg: the same button
    $("people").innerHTML = people.map((p) => {
      const on = p.id === person?.id && activeTab !== "group";
      const label = p.self ? "You" : esc(p.name || "Unnamed");
      const hint = p.self ? "Your own page" : p.mine ? "You look after" : `Shares ${scopeList(p.scopes).toLowerCase() || "nothing yet"}`;
      const tag = p.mine || p.self ? "" : `<span class="ml-1.5 font-mono text-[9px] tracking-wider text-accent-light lg:hidden">SHARED</span>`;
      const initial = esc((p.self ? (firstName || "You") : (p.name || "?")).trim().charAt(0).toUpperCase());
      return `<button type="button" data-person="${p.id}" title="${esc(hint)}" aria-current="${on ? "page" : "false"}"
        class="flex min-h-9 items-center gap-2.5 rounded-full border px-3.5 py-1.5 text-[13px] font-semibold transition-colors lg:min-h-10 lg:w-full lg:rounded-[10px] lg:border-0 lg:border-l-2 lg:px-3 lg:py-1.5 lg:text-left lg:text-[13.5px] ${on
          ? "border-accent/70 bg-accent/15 text-text-primary lg:border-accent lg:bg-white/6"
          : "border-white/14 text-text-secondary hover:border-white/30 hover:text-text-primary lg:border-transparent lg:hover:bg-white/[0.04]"}">
        <span class="hidden h-[26px] w-[26px] shrink-0 items-center justify-center rounded-full text-[11px] font-bold lg:flex ${on ? "bg-accent/25 text-accent-light" : "bg-white/8 text-text-secondary"}">${initial}</span>
        <span class="min-w-0 lg:flex lg:flex-col lg:leading-tight"><span class="truncate">${label}${tag}</span><span class="hidden text-[11px] font-normal text-text-tertiary lg:block">${esc(hint)}</span></span></button>`;
    }).join("") + `<button type="button" id="personadd" class="flex min-h-9 items-center gap-1.5 rounded-full px-3 py-1.5 text-[13px] font-bold text-accent-light hover:text-text-primary lg:min-h-10 lg:w-full lg:text-left lg:text-[13.5px] lg:font-semibold"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>Add a person</button>` + (others.length ? `
      <span class="mx-3 my-2 hidden h-px bg-white/[0.07] lg:block" aria-hidden="true"></span>
      <button type="button" id="everyone" aria-current="${activeTab === "group" ? "page" : "false"}"
        class="flex min-h-9 items-center gap-2.5 rounded-full border border-dashed px-3.5 py-1.5 text-[13px] font-semibold transition-colors lg:min-h-10 lg:w-full lg:rounded-[10px] lg:border-0 lg:border-l-2 lg:border-solid lg:px-3 lg:py-2 lg:text-left lg:text-[13.5px] ${activeTab === "group"
          ? "border-accent/70 bg-accent/15 text-text-primary lg:border-accent lg:bg-white/6"
          : "border-white/14 text-text-secondary hover:border-white/30 hover:text-text-primary lg:border-transparent lg:hover:bg-white/[0.04]"}">
        <svg class="hidden shrink-0 lg:block" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M21.5 20a6.5 6.5 0 0 0-5-6.3"/></svg>
        <span class="min-w-0 flex-1 truncate">Everyone</span>
        <span class="hidden font-mono text-[10.5px] font-medium text-text-tertiary lg:inline">${others.length}</span></button>` : "");
    $("people").querySelectorAll("[data-person]").forEach((b) =>
      b.addEventListener("click", () => switchPerson((b as HTMLElement).dataset.person!)));
    $("personadd").addEventListener("click", () => openPersonForm(null));
    document.getElementById("everyone")?.addEventListener("click", () => setTab("group"));

    // the line under the chips: whose page, and what you may do here
    const p = person!;
    $("tabhead").textContent = p.self ? "Your page" : `${p.name || "Their"}’s page`;
    show("personhead", !p.self); $("personhead").classList.toggle("flex", !p.self);
    if (p.self) { $("personkicker").textContent = ""; $("personactions").innerHTML = ""; return; }
    $("personkicker").textContent = p.mine
      ? `YOU LOOK AFTER${p.born_year ? ` · BORN ${p.born_year}` : ""}`
      : `SHARES WITH YOU · ${p.scopes.map((x) => x.toUpperCase()).join(" · ") || "NOTHING YET"} · YOU CAN LOOK, NOT CHANGE`;
    $("personactions").innerHTML = p.mine
      ? `<button type="button" data-pedit class="text-accent-light hover:text-text-primary">Edit details</button>
         <button type="button" data-premove class="text-text-tertiary hover:text-danger">Remove person</button>`
      : "";
    $("personactions").querySelector("[data-pedit]")?.addEventListener("click", () => openPersonForm(p));
    $("personactions").querySelector("[data-premove]")?.addEventListener("click", () => removePerson(p));
  }

  async function switchPerson(id: string) {
    const p = people.find((x) => x.id === id);
    if (!p) return;
    if (p.id === person?.id) { if (activeTab === "group") setTab("overview"); closePersonForm(); closeAccess(); return; }
    person = p;
    if (activeTab === "group") setTab("overview");
    syncSignals = []; syncActs = []; syncProfile = null; allWeeks = []; allCrf = []; allBody = [];   // the last person's, until loadActivity brings this one's
    try { sessionStorage.setItem(PERSON_KEY, id); } catch { /* fine */ }
    msg("upmsg", ""); msg("sharemsg", "");
    show("review", false); show("echoreview", false); show("namecheck", false);
    $("upqueue").innerHTML = ""; show("upqueue", false);
    applyPersonMode();
    if (!p.mine && p.id) supabase.rpc("note_grant_view", { person: p.id }).then(() => {}, () => {});   // they can see when you last looked
    await Promise.all([refresh(), loadPersonNote(), loadSharing(), loadGlance(), loadAiSummary()]);
  }

  // ── add, edit, remove someone you look after ──────────────────────────
  let editingPerson: Person | null = null;
  /**
   * Two ways to add a person. Someone you look after — a child, or anyone
   * without a login — is yours to add, since there is nobody else to ask.
   * Someone with their own email is asked: they get an email, sign in, and
   * choose what you may see, or decline. Nothing is shared until they do.
   */
  let personMode: "care" | "ask" = "care";
  function setPersonMode(mode: "care" | "ask") {
    personMode = mode;
    $("personform").querySelectorAll<HTMLButtonElement>("[data-pmode]").forEach((b) => {
      const on = b.dataset.pmode === mode;
      b.className = `min-h-9 rounded-full border px-3.5 py-1.5 text-[13px] font-semibold transition-colors ${
        on ? "border-accent/70 bg-accent/15 text-text-primary" : "border-white/14 text-text-secondary hover:text-text-primary"}`;
    });
    const care = mode === "care";
    show("personnamewrap", care); $("personnamewrap").classList.toggle("flex", care);
    show("personbornwrap", care); $("personbornwrap").classList.toggle("flex", care);
    show("personemailwrap", !care); $("personemailwrap").classList.toggle("flex", !care);
    ($("personname") as HTMLInputElement).required = care;
    ($("personemail") as HTMLInputElement).required = !care;
    $("personsave").textContent = editingPerson ? "Save" : care ? "Add" : "Ask them";
    $("personformnote").textContent = editingPerson ? "" : care
      ? "A child, or anyone without a login of their own. Their reports are filed under their name, and only you can see them."
      : "An adult with their own email. They get an email, sign in, and choose what you may see, or decline. Nothing is shared until they say so.";
    show("personformnote", !editingPerson);
  }
  $("personform").querySelectorAll("[data-pmode]").forEach((b) =>
    b.addEventListener("click", () => setPersonMode((b as HTMLElement).dataset.pmode as "care" | "ask")));

  function openPersonForm(p: Person | null) {
    editingPerson = p;
    ($("personname") as HTMLInputElement).value = p?.name ?? "";
    ($("personborn") as HTMLInputElement).value = p?.born_year ? String(p.born_year) : "";
    ($("personemail") as HTMLInputElement).value = "";
    show("personmodes", !p);
    setPersonMode("care");
    show("personform", true); $("personform").classList.add("flex");
    $("personname").focus();
  }
  function closePersonForm() { show("personform", false); $("personform").classList.remove("flex"); editingPerson = null; }
  // a click anywhere else closes the add-a-person form
  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement | null;
    if (!t) return;
    if (!$("personform").classList.contains("hidden") && !t.closest("#personform") && !t.closest("#personadd") && !t.closest("[data-pedit]")) closePersonForm();
  });
  // ── the Give access panel: open from the sidebar, close by the button, the backdrop or Escape ──
  function openAccess() {
    const p = person;
    if (!p?.id) return;
    $("sharekick").textContent = p.self ? "Access · your page" : `Access · ${p.name || "their"}’s page`;
    $("sharetitle").textContent = p.self ? "Give access to your page" : `Give access to ${p.name || "their"}’s page`;
    msg("sharemsg", "");
    show("sharewrap", true); $("sharewrap").classList.add("flex");
    document.body.style.overflow = "hidden";
    ($("shareemail") as HTMLInputElement).focus({ preventScroll: true });
  }
  function closeAccess() {
    if ($("sharewrap").classList.contains("hidden")) return;
    show("sharewrap", false); $("sharewrap").classList.remove("flex");
    document.body.style.overflow = "";
  }
  $("shareclose").addEventListener("click", closeAccess);
  $("sharewrap").addEventListener("click", (e) => { if (e.target === $("sharewrap")) closeAccess(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeAccess(); });
  $("personcancel").addEventListener("click", closePersonForm);
  function showPlanPeople(why: string) {
    $("planpeople").innerHTML = lockCard("No room on this plan for one more.", why, plan === "max" ? "See Enterprise" : "See the plans");
    show("planpeople", true); $("planpeople").classList.add("flex");
    $("planpeople").querySelector("[data-goto]")?.addEventListener("click", () => { show("planpeople", false); $("planpeople").classList.remove("flex"); });
  }
  $("personform").addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!editingPerson) { const room = roomForOneMore(); if (!room.ok) { closePersonForm(); showPlanPeople(room.why); return; } }
    if (!editingPerson && personMode === "ask") { await askToShare(($("personemail") as HTMLInputElement).value.trim().toLowerCase()); return; }
    const name = ($("personname") as HTMLInputElement).value.trim();
    const bornRaw = ($("personborn") as HTMLInputElement).value.trim();
    const born = bornRaw ? Number(bornRaw) : null;
    if (!name) return;
    if (editingPerson) {
      const { error } = await supabase.from("people").update({ name, born_year: born }).eq("id", editingPerson.id);
      if (error) { msg("upmsg", `Could not save: ${error.message}`, true); return; }
      closePersonForm();
      await loadPeople(); applyPersonMode(); renderOverview();
      return;
    }
    const made = await addPerson(name, born);
    closePersonForm();
    if (made) await switchPerson(made.id);
  });
  /** A new person you look after; returns them, or null with the reason shown. */
  async function addPerson(name: string, born: number | null): Promise<Person | null> {
    const { data, error } = await supabase.from("people")
      .insert({ owner_id: userId, account_id: null, name, born_year: born })
      .select("id, owner_id, account_id, name, born_year").maybeSingle();
    if (error || !data) { msg("upmsg", `Could not add ${name}: ${error?.message ?? "no row came back"}`, true); return null; }
    await loadPeople();
    renderPeople();
    return people.find((p) => p.id === data.id) ?? null;
  }
  async function removePerson(p: Person) {
    if (!confirm(`Remove ${p.name} and everything filed under them? Their reports and every value read from them are deleted. This cannot be undone.`)) return;
    const { data: files } = await supabase.storage.from("reports").list(folderOf(p), { limit: 500 });
    const names = (files ?? []).filter((f) => f.metadata).map((f) => `${folderOf(p)}/${f.name}`);
    if (names.length) await supabase.storage.from("reports").remove(names);
    const { error } = await supabase.from("people").delete().eq("id", p.id);
    if (error) { msg("upmsg", `Could not remove ${p.name}: ${error.message}`, true); return; }
    person = null;
    await loadPeople();
    const self = people.find((x) => x.self)!;
    person = self;
    try { sessionStorage.setItem(PERSON_KEY, self.id); } catch { /* fine */ }
    applyPersonMode();
    await refresh();
  }

  // ── the note on someone you look after: yours alone ───────────────────
  async function loadPersonNote() {
    const p = person;
    ($("personnote") as HTMLTextAreaElement).value = "";
    if (!p?.id || !p.mine || p.self) return;
    const { data } = await supabase.from("person_notes").select("note").eq("person_id", p.id).maybeSingle();
    if (person?.id === p.id) ($("personnote") as HTMLTextAreaElement).value = data?.note ?? "";
  }
  $("personnote").addEventListener("blur", async () => {
    const p = person;
    if (!p?.id || !p.mine || p.self) return;
    const note = ($("personnote") as HTMLTextAreaElement).value.trim();
    const { error } = await supabase.from("person_notes")
      .upsert({ person_id: p.id, owner_id: userId, note, updated_at: new Date().toISOString() }, { onConflict: "person_id" });
    if (error) msg("upmsg", `Could not save the note: ${error.message}`, true);
  });

  // ── the name printed on a report, against the person it is filed under ─
  const TITLES = new Set(["MR", "MRS", "MS", "MISS", "MX", "DR", "PROF", "MASTER", "BABY", "SHRI", "SRI", "SMT", "KUMARI", "KUMAR", "MOHD", "MD"]);
  const nameWords = (v: unknown) => String(v ?? "").toUpperCase().replace(/[^A-Z ]+/g, " ").split(/\s+/).filter((w) => w && !TITLES.has(w));
  /** Loose on purpose: "Sadiya" matches "MRS SADIYA ROPLEKAR". No name on either side is no verdict. */
  function nameVerdict(printed: unknown, p: Person): "match" | "mismatch" | "unknown" {
    const a = nameWords(printed), b = nameWords(p.name);
    if (!a.length || !b.length) return "unknown";
    const long = (w: string) => w.length >= 3;
    return b.some((w) => long(w) && a.includes(w)) || a.some((w) => long(w) && b.includes(w)) ? "match" : "mismatch";
  }
  const titleCase = (v: unknown) => nameWords(v).map((w) => w[0] + w.slice(1).toLowerCase()).join(" ");
  /**
   * The report names someone else: nothing is filed until the person says
   * whose it is. Resolves with what they chose; the card then closes.
   */
  function askWhose(printed: string, fileName: string): Promise<{ kind: "add"; name: string } | { kind: "file" } | { kind: "remove" }> {
    const who = person!;
    const first = titleCase(printed).split(" ")[0] || "them";
    $("namecheck").innerHTML = `
      <div class="flex items-center gap-2.5">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FBBF24" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3 22 20H2Z"/><path d="M12 9v5M12 17v.5"/></svg>
        <p class="text-[15px] font-extrabold text-text-primary">This report names ${esc(printed)}, not ${esc(who.self ? "you" : who.name)}.</p>
      </div>
      <p class="text-[13px] leading-relaxed text-text-secondary">${esc(fileName)} was read but not filed. Nothing has gone to any timeline. Whose is it?</p>
      <div class="flex flex-wrap gap-2">
        <button type="button" data-whose="add" class="min-h-10 rounded-xl bg-accent px-4 py-2 text-sm font-bold text-canvas">Add ${esc(first)} as a person</button>
        <button type="button" data-whose="file" class="min-h-10 rounded-xl border border-white/14 px-4 py-2 text-sm font-semibold text-text-primary">It is ${esc(who.self ? "mine" : who.name + "'s")}, file it</button>
        <button type="button" data-whose="remove" class="min-h-10 rounded-xl border border-white/14 px-4 py-2 text-sm font-semibold text-text-tertiary">Remove it</button>
      </div>`;
    show("namecheck", true); $("namecheck").classList.add("flex");
    $("namecheck").scrollIntoView({ block: "center", behavior: "smooth" });
    return new Promise((resolve) => {
      $("namecheck").querySelectorAll("[data-whose]").forEach((b) => b.addEventListener("click", () => {
        show("namecheck", false); $("namecheck").classList.remove("flex");
        const k = (b as HTMLElement).dataset.whose;
        resolve(k === "add" ? { kind: "add", name: titleCase(printed) } : k === "file" ? { kind: "file" } : { kind: "remove" });
      }));
    });
  }
  /** What the reader learned about the document itself, one row per stored report. */
  async function rememberReport(path: string, who: Person, out: any, match: string | null) {
    if (!who.id) return;   // no people table yet, so no web_reports either
    try {
      await supabase.from("web_reports").upsert({
        path, owner_id: userId, person_id: who.id,
        doc_type: out?.doc_type ?? null, kind: out?.kind ?? null, report_date: out?.report_date ?? null,
        patient_name: out?.patient_name ?? null, name_match: match, updated_at: new Date().toISOString(),
      }, { onConflict: "path" });
    } catch { /* the table may not exist yet */ }
  }

  // ── sharing: who can see this person, and invitations waiting for you ──
  const SCOPE_LABEL: Record<string, string> = { labs: "Labs", imaging: "Imaging", activity: "Activity and fitness", body: "Body measurements", heart: "Sleep and heart", notes: "Notes" };
  const scopeList = (xs: string[]) => xs.map((x) => SCOPE_LABEL[x] ?? x).join(" · ");
  const dayOf = (iso: string) => fmtDay(String(iso).slice(0, 10));

  /** The grants on the open person: theirs to see, stop or cancel. */
  async function loadSharing() {
    const p = person;
    if (!p?.id || !p.mine) return;
    // activity and body come from the app, which only a person with an account has
    $("shareform").querySelectorAll<HTMLInputElement>("[data-scope]").forEach((c) => {
      const appOnly = c.dataset.scope === "activity" || c.dataset.scope === "body" || c.dataset.scope === "heart";
      c.closest("label")!.classList.toggle("hidden", appOnly && !p.account_id);
      if (appOnly && !p.account_id) c.checked = false;
    });
    const { data, error } = await supabase.from("grants")
      .select("id, viewer_email, viewer_id, scopes, status, invited_at, accepted_at, last_viewed_at")
      .eq("person_id", p.id).neq("status", "stopped").order("invited_at", { ascending: true });
    if (person?.id !== p.id) return;   // switched away meanwhile
    const rows = error ? [] : (data ?? []);
    $("accesssub").textContent = rows.length ? `${rows.length} ${rows.length === 1 ? "person" : "people"} can see this page` : "Only you, so far";
    const APP_SCOPES = new Set(["activity", "body", "heart"]);
    const offered = Object.keys(SCOPE_LABEL).filter((k) => k !== "notes" && (p.account_id || !APP_SCOPES.has(k)));
    $("sharelist").innerHTML = rows.length ? rows.map((g: any) => `
      <div class="rounded-xl border border-white/[0.08] px-3.5 py-2.5 text-[13px]" data-grant="${g.id}">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/20 text-[11px] font-bold text-accent-light">${esc(String(g.viewer_email).charAt(0).toUpperCase())}</span>
          <span class="min-w-0 flex-1">
            <span class="flex flex-wrap items-center gap-2"><span class="truncate font-semibold text-text-primary">${esc(g.viewer_email)}</span>
              <span class="rounded-md px-1.5 py-0.5 font-mono text-[9px] tracking-wider ${g.status === "active" ? "bg-success/15 text-success-light" : "bg-warning/15 text-warning"}">${g.status === "active" ? "SEES" : "WAITING"}</span></span>
            <span class="block text-[12px] text-text-tertiary"><span data-scopes>${esc(scopeList(g.scopes ?? []) || "nothing yet")}</span> · ${g.status === "active"
              ? `since ${dayOf(g.accepted_at ?? g.invited_at)}${g.last_viewed_at ? `, last looked ${dayOf(g.last_viewed_at)}` : ", has not looked yet"}`
              : `invited ${dayOf(g.invited_at)}`}</span>
          </span>
          <button type="button" data-change="${g.id}" class="min-h-9 rounded-lg border border-white/12 px-3 text-[12px] font-semibold text-text-secondary transition-colors hover:border-white/25 hover:text-text-primary">Change</button>
          <button type="button" data-stop="${g.id}" class="min-h-9 rounded-lg border border-danger/35 px-3 text-[12px] font-semibold text-danger/90 transition-colors hover:border-danger/60 hover:text-danger">${g.status === "active" ? "Stop" : "Cancel"}</button>
        </div>
        <form data-edit="${g.id}" class="mt-3 hidden flex-wrap items-center gap-x-4 gap-y-1 border-t border-white/[0.06] pt-3 text-[13px] text-text-primary">
          ${offered.map((k) => `<label class="flex min-h-9 items-center gap-2"><input type="checkbox" value="${k}" ${(g.scopes ?? []).includes(k) ? "checked" : ""} class="h-4 w-4 accent-[#818cf8]" />${esc(SCOPE_LABEL[k])}</label>`).join("")}
          <span class="ml-auto flex items-center gap-3">
            <button type="button" data-editcancel class="text-[12px] font-medium text-text-tertiary hover:text-text-primary">Cancel</button>
            <button type="submit" class="min-h-9 rounded-lg bg-accent px-3.5 text-[12.5px] font-bold text-canvas transition-opacity hover:opacity-90">Save</button>
          </span>
        </form>
      </div>`).join("")
      : `<p class="text-[13px] text-text-tertiary">Nobody else. Invite a doctor or a coach below: they see what you tick, and nothing else.</p>`;
    $("sharelist").querySelectorAll("[data-stop]").forEach((b) => b.addEventListener("click", async () => {
      const { error: e } = await supabase.from("grants")
        .update({ status: "stopped", stopped_at: new Date().toISOString() }).eq("id", (b as HTMLElement).dataset.stop);
      if (e) msg("sharemsg", `Could not stop: ${e.message}`, true);
      else { msg("sharemsg", ""); await loadSharing(); }
    }));
    // Change: the ticks open under the row; Save writes them to the same grant
    $("sharelist").querySelectorAll("[data-change]").forEach((b) => b.addEventListener("click", () => {
      const f = $("sharelist").querySelector<HTMLFormElement>(`[data-edit="${(b as HTMLElement).dataset.change}"]`)!;
      const open = f.classList.contains("hidden");
      $("sharelist").querySelectorAll("[data-edit]").forEach((x) => { x.classList.add("hidden"); x.classList.remove("flex"); });
      if (open) { f.classList.remove("hidden"); f.classList.add("flex"); }
    }));
    $("sharelist").querySelectorAll("[data-editcancel]").forEach((b) => b.addEventListener("click", () => {
      const f = b.closest("form")!; f.classList.add("hidden"); f.classList.remove("flex");
    }));
    $("sharelist").querySelectorAll<HTMLFormElement>("[data-edit]").forEach((f) => f.addEventListener("submit", async (e) => {
      e.preventDefault();
      const scopes = [...f.querySelectorAll<HTMLInputElement>("input[type=checkbox]")].filter((c) => c.checked).map((c) => c.value);
      if (!scopes.length) { msg("sharemsg", "Tick at least one thing for them to see, or stop their access instead.", true); return; }
      const { error: e2 } = await supabase.from("grants").update({ scopes }).eq("id", f.dataset.edit);
      if (e2) { msg("sharemsg", `Could not change: ${e2.message}`, true); return; }
      msg("sharemsg", "Changed. They see the new set from their next look.");
      await loadSharing();
    }));
  }

  $("shareform").addEventListener("submit", async (e) => {
    e.preventDefault();
    const p = person;
    if (!p?.id || !p.mine) return;
    const email = ($("shareemail") as HTMLInputElement).value.trim().toLowerCase();
    const scopes = [...$("shareform").querySelectorAll<HTMLInputElement>("[data-scope]")]
      .filter((c) => c.checked && !c.closest("label")!.classList.contains("hidden")).map((c) => c.dataset.scope!);
    if (!email) return;
    if (email === userEmail.toLowerCase()) { msg("sharemsg", "That is you.", true); return; }
    if (!scopes.length) { msg("sharemsg", "Tick at least one thing for them to see.", true); return; }
    const { data, error } = await supabase.from("grants").insert({
      person_id: p.id, owner_id: userId, viewer_email: email, scopes,
      person_name: p.self ? (fullName || "their page") : p.name,
      inviter_name: fullName || userEmail,
    }).select("id").maybeSingle();
    if (error || !data) {
      msg("sharemsg", error?.code === "23505" ? `${email} already has an invitation to this page.` : `Could not invite: ${error?.message ?? "no row came back"}`, true);
      return;
    }
    ($("shareemail") as HTMLInputElement).value = "";
    const sent = await sendInvite({ grant_id: data.id });
    msg("sharemsg", sent
      ? `Invited. ${email} gets an email; the moment they accept, they see what you ticked, and you see it here.`
      : `Invited. The email could not be sent just now; ${email} still finds the invitation under their greeting when they sign in with that address.`);
    await loadSharing();
  });

  /** The email, through the share-invite function, for an invitation or a request; false when it could not go. */
  async function sendInvite(body: { grant_id?: string; request_id?: string }): Promise<boolean> {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      const resp = await fetch(`${SUPABASE_URL}/functions/v1/share-invite`, {
        method: "POST",
        headers: { "content-type": "application/json", authorization: `Bearer ${session?.access_token}`, apikey: SUPABASE_ANON_KEY },
        body: JSON.stringify(body),
      });
      return resp.ok;
    } catch { return false; }
  }

  /** Ask an adult to share their page with you. The grant is theirs to make, when they accept. */
  async function askToShare(email: string) {
    if (!email) return;
    if (email === userEmail.toLowerCase()) { msg("upmsg", "That is you.", true); return; }
    const { data, error } = await supabase.from("share_requests").insert({
      requester_id: userId, requester_email: userEmail.toLowerCase(), requester_name: fullName || userEmail, target_email: email,
    }).select("id").maybeSingle();
    if (error || !data) {
      msg("upmsg", error?.code === "23505" ? `You already asked ${email}; they have not answered yet.` : `Could not ask: ${error?.message ?? "no row came back"}`, true);
      return;
    }
    closePersonForm();
    const sent = await sendInvite({ request_id: data.id });
    msg("upmsg", sent
      ? `Asked. ${email} gets an email and decides what you may see; their page appears here when they do.`
      : `Asked. The email could not be sent just now; ${email} still finds the request under their greeting when they sign in with that address.`);
    await loadAsked();
  }

  /** The people you asked, still waiting. */
  async function loadAsked() {
    if (!people.some((p) => !!p.id)) return;
    const { data, error } = await supabase.from("share_requests").select("id, target_email, created_at")
      .eq("requester_id", userId).eq("status", "requested").order("created_at", { ascending: true });
    const rows = error ? [] : (data ?? []);
    show("asked", rows.length > 0);
    $("asked").innerHTML = rows.length ? "Asked to share their page with you: " + rows.map((r: any) =>
      `<span class="text-text-secondary">${esc(r.target_email)}</span> (waiting since ${esc(dayOf(r.created_at))}) <button type="button" data-unask="${r.id}" class="text-accent-light hover:text-danger">cancel</button>`).join(" · ") : "";
    $("asked").querySelectorAll("[data-unask]").forEach((b) => b.addEventListener("click", async () => {
      await supabase.from("share_requests").update({ status: "cancelled", answered_at: new Date().toISOString() }).eq("id", (b as HTMLElement).dataset.unask);
      await loadAsked();
    }));
  }

  /** Requests to see your page, answered through answer_share_request: nothing is shared until you tick and allow. */
  async function loadRequests() {
    if (!people.some((p) => !!p.id)) return;
    const { data, error } = await supabase.from("share_requests").select("id, requester_name, requester_email, created_at")
      .eq("status", "requested").eq("target_email", userEmail.toLowerCase());
    const rows = error ? [] : (data ?? []);
    show("requests", rows.length > 0); $("requests").classList.toggle("flex", rows.length > 0);
    $("requests").innerHTML = rows.map((r: any) => `
      <form data-request="${r.id}" class="flex flex-col gap-2.5 rounded-2xl border border-accent/40 bg-accent/[0.06] px-4 py-3.5">
        <p class="text-[14px] text-text-primary"><strong>${esc(r.requester_name || r.requester_email)}</strong> asks to see your My health page.</p>
        <p class="text-[12.5px] text-text-tertiary">Nothing is shared until you say so. Tick what they may see; you can change or stop it later under "Who can see this page".</p>
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-[13px] text-text-primary">
          <label class="flex min-h-9 items-center gap-1.5"><input type="checkbox" data-rscope="labs" class="h-4 w-4 accent-[#818cf8]" />Labs</label>
          <label class="flex min-h-9 items-center gap-1.5"><input type="checkbox" data-rscope="imaging" class="h-4 w-4 accent-[#818cf8]" />Imaging</label>
          <label class="flex min-h-9 items-center gap-1.5"><input type="checkbox" data-rscope="activity" class="h-4 w-4 accent-[#818cf8]" />Activity and fitness</label>
          <label class="flex min-h-9 items-center gap-1.5"><input type="checkbox" data-rscope="body" class="h-4 w-4 accent-[#818cf8]" />Body measurements</label>
        </div>
        <div class="flex gap-2">
          <button type="submit" class="min-h-10 rounded-xl bg-accent px-4 py-2 text-sm font-bold text-canvas">Allow</button>
          <button type="button" data-rdecline class="min-h-10 rounded-xl border border-white/14 px-4 py-2 text-sm font-semibold text-text-secondary">Decline</button>
        </div>
        <p data-rmsg class="hidden text-[12.5px] text-danger"></p>
      </form>`).join("");
    const clearNames = () => supabase.auth.updateUser({ data: { pending_share_from: null, pending_share_person: null, pending_share_scopes: null, pending_share_request: null } }).then(() => {}, () => {});
    $("requests").querySelectorAll("form[data-request]").forEach((f) => {
      const id = (f as HTMLElement).dataset.request!;
      const note = f.querySelector("[data-rmsg]") as HTMLElement;
      f.addEventListener("submit", async (e) => {
        e.preventDefault();
        const wanted = [...f.querySelectorAll<HTMLInputElement>("[data-rscope]")].filter((c) => c.checked).map((c) => c.dataset.rscope!);
        if (!wanted.length) { note.textContent = "Tick at least one thing for them to see, or decline."; note.classList.remove("hidden"); return; }
        const { error: e2 } = await supabase.rpc("answer_share_request", { request_id: id, allow: true, wanted });
        if (e2) { note.textContent = `Could not answer: ${e2.message}`; note.classList.remove("hidden"); return; }
        clearNames();
        msg("upmsg", "Allowed. They see what you ticked, and it is listed under \"Who can see this page\" on your own page.");
        await Promise.all([loadRequests(), loadSharing()]);
      });
      f.querySelector("[data-rdecline]")!.addEventListener("click", async () => {
        const { error: e2 } = await supabase.rpc("answer_share_request", { request_id: id, allow: false, wanted: [] });
        if (e2) { msg("upmsg", `Could not answer: ${e2.message}`, true); return; }
        clearNames();
        await loadRequests();
      });
    });
  }

  /** Invitations to your address, answered through respond_to_grant. */
  async function loadInvites() {
