    const path = dayRows.map((r) => r.report_path).filter(Boolean).pop() ?? "";
    const fromApp = path.startsWith("export:");   // brought by the app's export: no PDF behind it
    const repName = fromApp ? "From the Verve app" : path ? pretty(path.split("/").pop()!) : "";
    show("latestwrap", true);
    $("latestcard").innerHTML = `
      <div class="mh-rise flex flex-wrap items-center gap-3 sm:gap-4" style="--i: 7">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/[0.14]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>
        </span>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="truncate text-sm font-semibold text-text-primary">${esc(repName || fmtDay(lastDate))}</span>
            <span class="rounded-md bg-white/[0.06] px-2 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider text-text-secondary">${fmtDay(lastDate)}</span>
          </div>
          <div class="mt-1 text-xs text-text-tertiary">${dayRows.length} values · ${flaggedN ? `<span class="text-warning">${flaggedN} outside range</span>` : `<span class="text-success">all in range</span>`} · all on your Labs tab</div>
        </div>
        ${path && !fromApp ? `<button data-viewpath="${esc(path)}" class="rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-secondary transition-colors hover:border-white/25 hover:text-text-primary">View report</button>` : ""}
        <button data-goto="reports" class="rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-secondary transition-colors hover:border-white/25 hover:text-text-primary">All reports →</button>
      </div>`;
    const vp = $("latestcard").querySelector("[data-viewpath]");
    if (vp) vp.addEventListener("click", () => viewPdf((vp as HTMLElement).dataset.viewpath!));
    wireGoto();
  }

  function wireGoto() {
    document.querySelectorAll("[data-goto]").forEach((b) => {
      const el = b as HTMLElement;
      if (el.dataset.wired) return;
      el.dataset.wired = "1";
      el.addEventListener("click", () => setTab(el.dataset.goto!));
    });
  }

  /** Jump from Overview into one section of Labs. */
  function openSection(sec: string) {
    labSection = sec;
    expandedAnalyte = "";
    mobileSectionOpen = true;
    setTab("labs");
    renderLabsRail(); renderLabsPanel();
  }

  /** Jump from Overview straight to one marker's chart. */
  function openMarker(sec: string, name: string) {
    labSection = sec;
    expandedAnalyte = name;
    mobileSectionOpen = true;
    setTab("labs");
    renderLabsRail(); renderLabsPanel();
  }

  // ═══ LABS ═══════════════════════════════════════════════════════════════
  function renderLabsRail() {
    const empty = allLabs.length === 0;
    show("labsempty", empty);
    if (empty) { $("labsrail").innerHTML = ""; $("labspanel").innerHTML = ""; show("labsnomatch", false); wireGoto(); return; }
    const view = filteredSecs();
    const terms = searchTerms();
    if (terms.length) {
      const n = [...view.values()].reduce((t, m) => t + m.size, 0);
      if (activeTab === "labs") searchNote(n ? `${n} marker${n === 1 ? " matches" : "s match"}` : "");
      $("labsnomatch").textContent = `No marker matches "${searchQuery}". Try a section, like liver, or part of a name.`;
      show("labsnomatch", n === 0);
      if (n === 0) { $("labsrail").innerHTML = ""; $("labspanel").innerHTML = ""; return; }
    } else show("labsnomatch", false);
    if (!view.has(labSection)) labSection = SECTION_ORDER.find((x) => view.has(x)) ?? "";

    // phone: the section list IS the page until a section opens
    $("labsrail").className = `${mobileSectionOpen ? "hidden md:flex" : "flex"} flex-col gap-1.5 md:w-56 md:shrink-0`;
    $("labspanel").className = `${mobileSectionOpen ? "" : "hidden md:block"} min-w-0 flex-1 rounded-2xl border border-white/10 bg-white/[0.03] p-5`;

    $("labsrail").innerHTML = SECTION_ORDER.filter((s) => view.has(s)).map((s) => {
      const analytes = [...view.get(s)!.values()];
      const flagged = analytes.filter((rs) => inRange(rs[rs.length - 1]) === false).length;
      const on = s === labSection;
      return `
        <button data-sec="${s}" class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-left text-[13px] transition-colors ${on ? "bg-accent/15 font-bold text-text-primary" : "text-text-secondary hover:bg-white/[0.05]"}">
          <span class="flex-1">${SECTIONS[s]}</span>
          <span class="rounded-md ${flagged ? "bg-warning/15 text-warning" : "bg-white/[0.06] text-text-tertiary"} px-1.5 py-0.5 font-mono text-[9px] font-semibold tracking-wider">${analytes.length}${flagged ? ` · ${flagged}!` : ""}</span>
          <span class="text-text-muted md:hidden">›</span>
        </button>`;
    }).join("");
    $("labsrail").querySelectorAll("[data-sec]").forEach((b) =>
      b.addEventListener("click", () => {
        labSection = (b as HTMLElement).dataset.sec!;
        expandedAnalyte = "";
        mobileSectionOpen = true;
        renderLabsRail(); renderLabsPanel();
      }));
  }

  function renderLabsPanel() {
    const sec = filteredSecs().get(labSection);
    if (!sec) { $("labspanel").innerHTML = ""; return; }
    const analytes = [...sec.entries()];
    const flagged = analytes.filter(([, rs]) => inRange(rs[rs.length - 1]) === false).length;
    $("labspanel").innerHTML = `
      <button id="labsback" class="mb-2 flex items-center gap-1 text-sm font-semibold text-accent-light md:hidden">‹ All sections</button>
      <div class="flex flex-wrap items-baseline gap-3">
        <h3 class="text-base font-extrabold">${SECTIONS[labSection]}</h3>
        <span class="font-mono text-[10px] text-text-tertiary">${analytes.length} MARKER${analytes.length === 1 ? "" : "S"}</span>
        ${flagged ? `<span class="rounded-md bg-warning/15 px-2 py-0.5 font-mono text-[9px] tracking-wider text-warning">${flagged} OUT OF RANGE</span>` : ""}
      </div>
      <div class="mt-2 divide-y divide-white/[0.05]">
        ${analytes.map(([name, rs]) => labRow(name, rs)).join("")}
      </div>
      ${labSection === "imaging" && allImaging.length ? `
        <div class="mt-5 font-mono text-[10px] font-semibold uppercase tracking-widest text-text-tertiary">The reports' own conclusions</div>
        ${[...allImaging].reverse().map((im) => `
          <div class="mt-2 rounded-xl border border-white/[0.07] bg-white/[0.02] p-3">
            <div class="flex items-center gap-2">
              <span class="rounded-md bg-accent/15 px-1.5 py-0.5 font-mono text-[9px] font-semibold tracking-wider text-accent-light">${esc(String(im.modality).toUpperCase())}</span>
              <span class="font-mono text-[10px] text-text-tertiary">${fmtDay(im.report_date)}</span>
            </div>
            ${im.impression ? `<p class="mt-1.5 text-[13px] leading-5 text-text-secondary">${esc(im.impression)}</p>` : ""}
          </div>`).join("")}` : ""}`;
    $("labsback")?.addEventListener("click", () => {
      mobileSectionOpen = false;
      renderLabsRail(); renderLabsPanel();
    });
    $("labspanel").querySelectorAll("[data-an]").forEach((b) =>
      b.addEventListener("click", () => {
        const n = (b as HTMLElement).dataset.an!;
        expandedAnalyte = expandedAnalyte === n ? "" : n;
        renderLabsPanel();
        if (expandedAnalyte) $("labspanel").querySelector(`[data-an="${CSS.escape(n)}"]`)?.scrollIntoView({ block: "nearest" });
      }));
