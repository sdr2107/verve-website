        <td class="px-3 py-2.5 text-text-tertiary">${l.act.of ? `${l.act.atGoal} of ${l.act.of}` : "—"}</td>
      </tr>`;
    }).join("") + waiting.map((r: any) => `<tr><td class="px-3 py-2.5 font-semibold text-text-tertiary">${esc(r.target_email)}</td><td colspan="8" class="px-3 py-2.5 text-text-tertiary">Asked ${esc(dayOf(r.created_at))} · waiting. Nothing shows until they share.</td></tr>`).join("");
    $("glancerows").querySelectorAll("[data-open]").forEach((tr) =>
      tr.addEventListener("click", () => switchPerson((tr as HTMLElement).dataset.open!)));

    // this week, across everyone
    const feed = lines.flatMap((l) => l.events.map((e) => ({ ...e, who: l.p.self ? "You" : (l.p.name || "Unnamed") }))).sort((x, y) => y.d.localeCompare(x.d)).slice(0, 6);
    $("glanceweek").innerHTML = feed.length
      ? feed.map((e) => `<div><span class="font-mono text-[11px] text-text-muted">${esc(dayWord(e.d)).toUpperCase()}</span> &nbsp;<strong class="text-text-primary">${esc(e.who)}</strong>: ${e.text}</div>`).join("")
      : `<div class="text-text-tertiary">Nothing new this week.</div>`;

    // retest due, across everyone: overdue first, then the next 30 and 90 days
    const dueList = lines.flatMap((l) => l.dues.map((d) => ({ d, who: l.p.self ? "You" : (l.p.name || "Unnamed") }))).filter((x) => x.d.days <= 90).sort((x, y) => x.d.days - y.d.days).slice(0, 8);
    const group = (days: number) => days < 0 ? ["OVERDUE", "text-danger"] : days <= 30 ? ["NEXT 30 DAYS", "text-warning"] : ["NEXT 90 DAYS", "text-text-tertiary"];
    $("glancedue").innerHTML = dueList.length
      ? dueList.map(({ d, who }) => { const [g, tone] = group(d.days); return `<div><span class="font-mono text-[10px] tracking-[0.1em] ${tone}">${g}</span> &nbsp;${esc(who)} · ${esc(d.what)}, ${esc(d.days < 0 ? dueWord(d).replace("overdue", "overdue by") : dueWord(d))}</div>`; }).join("")
      : `<div class="text-text-tertiary">Nothing due in the next 90 days.</div>`;
  }

  // one fetch feeds Overview, Labs and the Reports cards
  let allLabs: any[] = [];
  let allImaging: any[] = [];   // imaging_reports — the narrative half of a study
  let allApp: any[] = [];       // lab_readings — what the app holds, to say what was sent
  // ── search: every word typed must land. The query is a signal: Labs is a
  // view of it; Reports still redraws on it from here ──────────────────────
  const searchTerms = () => searchTermsOf(searchQuerySignal.value);
  /** Jump from Overview into one section of Labs, or straight to one marker's chart. */
  const openSection = (sec: string) => openLabs(sec);
  const openMarker = (sec: string, name: string) => openLabs(sec, name);
  const searchNote = (text: string) => { const el = $("mhsearchnote"); el.textContent = text; el.classList.toggle("hidden", !text); };
  let searchTimer = 0;
  $("mhsearch").addEventListener("input", () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      searchQuerySignal.value = ($("mhsearch") as HTMLInputElement).value.trim();
      show("mhsearchclear", !!searchQuerySignal.value);
      if (!searchQuerySignal.value) searchNote("");
    }, 120);
  });
  $("mhsearchclear").addEventListener("click", () => { ($("mhsearch") as HTMLInputElement).value = ""; $("mhsearch").dispatchEvent(new Event("input")); $("mhsearch").focus(); });

  // ── tabs ───────────────────────────────────────────────────────────────
  let activeTab = "overview";
  function setTab(t: string) {
    if (marked.has("painted")) mark("interaction");
    // Everyone is a view of the account, not of a person: the greeting and
    // the person's own rows step aside, and no person is lit in the sidebar
    // a group with no one in it is still a page: the coach's door lands there with the ask
    const switching = activeTab !== t;
    const wasGroup = activeTab === "group", group = t === "group";
    activeTab = t; activeTabSignal.value = t;
    ["group", "overview", "labs", "reports", "depth"].forEach((x) => show("tab-" + x, x === t));
    show("pagehead", !group); show("personwrap", !group && people.some((x) => !!x.id));
    show("mhsearchwrap", t === "labs" || t === "reports");
    document.querySelectorAll<HTMLElement>("[data-ovsections]").forEach((el) => { el.style.display = t === "overview" ? "" : "none"; });
    if (group !== wasGroup && people.some((x) => !!x.id)) renderPeople();
    if (switching) {
      const el = $("tab-" + t);
      el.classList.remove("mh-fade");
      void el.offsetWidth;   // restart the animation
      el.classList.add("mh-fade");
    }
    $("tabbar").querySelectorAll("[data-tab]").forEach((b) => {
      const on = (b as HTMLElement).dataset.tab === t;
      b.className = `flex min-h-9 flex-1 items-center justify-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold transition-colors sm:flex-none lg:min-h-10 lg:w-full lg:justify-start lg:gap-2.5 lg:rounded-[10px] lg:border-l-2 lg:px-3 lg:py-2 lg:text-[13.5px] ${
        on ? "bg-accent/20 text-text-primary lg:border-accent lg:bg-white/6" : "text-text-tertiary hover:text-text-primary lg:border-transparent lg:text-text-secondary lg:hover:bg-white/[0.04]"}`;
    });
    history.replaceState(null, "", t === "overview" && ovSectionSignal.value !== "all" ? `#overview-${ovSectionSignal.value}` : "#" + t);
  }
  /** The small figure beside a tab in the sidebar: how many outside range, how many reports. */
  function setTabCount(t: string, text: string, tone = "text-text-tertiary") {
    const el = $("tabbar").querySelector(`[data-tab="${t}"] [data-count]`);
    if (!el) return;
    el.textContent = text;
    el.className = `ml-auto hidden font-mono text-[10.5px] font-semibold lg:inline ${tone}`;
  }
  $("accessgo").addEventListener("click", openAccess);
  $("accessgophone").addEventListener("click", openAccess);
  document.addEventListener("click", (e) => {
    const menu = document.getElementById("personmenu");
    if (menu && !menu.classList.contains("hidden") && !(e.target as Element).closest("[data-personmenu]")) { menu.classList.add("hidden"); menu.classList.remove("flex"); document.getElementById("personmenubtn")?.setAttribute("aria-expanded", "false"); }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const menu = document.getElementById("personmenu");
    if (menu) { menu.classList.add("hidden"); menu.classList.remove("flex"); document.getElementById("personmenubtn")?.setAttribute("aria-expanded", "false"); }
  });
  $("tabbar").querySelectorAll("[data-tab]").forEach((b) =>
    b.addEventListener("click", () => {
      const t = (b as HTMLElement).dataset.tab!;
      // Overview is the glance; a section stays open only while its own row is lit
      if (t === "overview") setSectionState("all");
      setTab(t);
    }));

  // ── session ────────────────────────────────────────────────────────────
  const appLink = document.querySelector('[data-nav="app"]') as HTMLElement | null;
  const signinLink = document.querySelector('[data-nav="signin"]') as HTMLElement | null;

  let bootedFor: string | null = null;   // the account the page is booted for; "" = signed out
  async function boot() {
    // an invitation's button: the link carries a token the site verifies
    // here, so it signs in the device it is opened on, from any device
    const url = new URL(location.href);
    const tokenHash = url.searchParams.get("token_hash"), linkType = url.searchParams.get("type");
    if (tokenHash && (linkType === "invite" || linkType === "magiclink" || linkType === "email")) {
      try { await supabase.auth.verifyOtp({ token_hash: tokenHash, type: linkType as any }); }
      catch { /* an old or used link: the sign-in card below still works */ }
      history.replaceState(null, "", location.pathname + location.hash);
    }
    // back from Apple: the client exchanges the code in the address for a
    // session on its own; what is left is to tidy the address, and to say
    // so if Apple or Supabase sent an error back instead
    const oauthError = url.searchParams.get("error_description") || url.searchParams.get("error");
    // /coach hands over here with the door named and, when a button was pressed
    // there, the method to start; the door is kept across the provider's round trip
    const door = url.searchParams.get("door"), start = url.searchParams.get("start");
    // the coach's and the clinician's doors both land on the group
    if (door === "coach" || door === "clinician") { try { localStorage.setItem(COACH_DOOR, door); } catch { /* private mode */ } }
    if (url.searchParams.has("code") || oauthError || door || start) history.replaceState(null, "", location.pathname + location.hash);
    const { data: { session } } = await supabase.auth.getSession();
    mark("session");
    // Once per signed-in account. boot() is called on load and again from
    // every auth event (INITIAL_SESSION, SIGNED_IN, TOKEN_REFRESHED), and
    // each run read every table again: three documents at once on a
    // reload. The same account, already booted, is a no-op; a sign-in or
    // a sign-out is a change and boots.
    const who = session?.user?.id ?? "";
    if (who === bootedFor) return;
    bootedFor = who;
    // signed in, the line stays until the numbers are drawn, so nothing is drawn twice
    if (!session?.user) show("loading", false);
    if (session?.user) {
      promotePendingDoor();
      let coachDoor = false;
      try { const d = localStorage.getItem(COACH_DOOR); coachDoor = d === "1" || d === "coach" || d === "clinician"; localStorage.removeItem(COACH_DOOR); } catch { /* private mode */ }
      userId = session.user.id;
      userEmail = session.user.email ?? "";
      askForNewsletter(session.user);
      appLink?.classList.add("hidden"); signinLink?.classList.add("hidden");
      show("signout", true); show("home", true); show("auth", false);
      const wanted = window.location.hash.replace("#", "") || (coachDoor ? "group" : "");
      if (wanted.startsWith("overview-") && SEC_ORDER.includes(wanted.slice(9) as SecKey)) setSectionState(wanted.slice(9) as SecKey);
      setTab(["overview", "labs", "reports", "depth"].includes(wanted) || wanted.startsWith("overview-") ? wanted.split("-")[0] : "overview");
      // The first round trip, one for everything the page needs before it
      // can say whose page this is: the name, the people, the plan, the
      // role, and the one-time merge of other accounts under this email.
      // These used to be three hops in a row (name, then people, then merge).
      // One request for everything: the document for the remembered person
      // (or the account's own) starts here, and every loader reads from it.
      // The account merge is a write and runs alongside, once.
      let remembered = ""; try { remembered = sessionStorage.getItem(PERSON_KEY) ?? ""; } catch { /* fine */ }
      const fromStore = await openDocument(remembered);
      // the line and the frames show only when nothing is in hand: a first visit
      if (fromStore) show("loading", false); else $("loading").textContent = "Reading your numbers…";
      // The merge is a write, once, and is not waited for: with a document in
      // hand the page paints now, and a merge that moved people redraws it.
      const merging = mergeOtherAccounts();
      const [, , , role] = await Promise.all([resolveFirstName(session.user), loadPeople(), loadPlan(), loadMyRole()]);
      myRole = role;
      mark("people");
      void merging.then(async (mergedFrom) => {
        if (!mergedFrom.length) return;
        try {
          invalidateDocument(); await loadPeople(); renderPeople();
          for (const other of mergedFrom) await moveReportFiles(other);   // people that were the other account's are now here
          await Promise.all([refresh(false), loadPersonNote(), loadSharing(), loadInvites(), loadAsked(), loadRequests(), loadGlance(), loadAiSummary()]);
        } catch { /* the merge is a courtesy; the page works without it */ }
      });
      fillOwnName();
      firstName = fullName.split(/\s+/)[0] ?? "";
      $("greet").textContent = greeting();
      $("greet").closest(".flex.flex-wrap")!.classList.add("mh-rise");
      show("namechange", !!firstName);
      if (!firstName) askForName(guessNameFromEmail(userEmail));
      else hideNameForm();
      void showRoleChip();
      applyPersonMode();
      if (wanted === "group") setTab("group");   // only once the people are known
      // The second round trip, and the last: every table of the person's
      // own at once. refresh() itself fetches labs, the app's rows and the
      // report folder together, then draws every tab once.
      await Promise.all([refresh(false).finally(() => show("loading", false)), loadPersonNote(), loadSharing(), loadInvites(), loadAsked(), loadRequests(), loadGlance(), loadAiSummary()]);
      void pruneDocuments(userId, people.map((p) => p.id).filter(Boolean));
      if (fromStore) void revalidate(person?.id ?? "");
    } else {
      firstName = "";
      people = []; person = null;
      show("peoplewrap", false);
      appLink?.classList.remove("hidden"); signinLink?.classList.add("hidden");
      show("auth", true); show("home", false); show("signout", false);
      if (oauthError) msg("authmsg", `Apple sign-in did not finish: ${oauthError.replace(/\+/g, " ")}.`, true);
      if (door === "coach") {
        $("authkick").textContent = "Coach · the coach's door";
        $("authtitle").textContent = "Everyone who shares with you.";
        $("authlede").textContent = "Sign in with the account you use in the app. You land on the group: who shares with you, ranked by this week's movement, with what is due.";
      } else if (door === "clinician") {
        $("authkick").textContent = "Clinician · the clinician's door";
        $("authtitle").textContent = "Everyone who shares with you.";
        $("authlede").textContent = "Sign in with the account you use in the app. You land on your patients: who shares a page with you, and what is due.";
      }
      if (start === "apple" || start === "google") startProvider(start);
      else if (start === "email") $("email").focus();
    }
  }
  // Apple's and Google's doors: Supabase sends the browser to the provider,
  // the provider back to Supabase, Supabase back here with a code the client
  // trades for a session. The landing address must be on Supabase's allowed list.
  async function startProvider(provider: "apple" | "google") {
    msg("authmsg", "");
    try { localStorage.setItem(PENDING_DOOR, provider); } catch { /* private mode */ }
    const { error } = await supabase.auth.signInWithOAuth({ provider, options: { redirectTo: `${location.origin}/my-health/` } });
    if (error) msg("authmsg", `Could not start ${provider === "apple" ? "Apple" : "Google"} sign-in: ${error.message}`, true);
  }
  document.querySelectorAll<HTMLElement>("[data-provider]").forEach((b) => b.addEventListener("click", () => startProvider(b.dataset.provider as "apple" | "google")));

  /**
   * The name the app greets you with, in the same order the app resolves
   * it: the profile name set in Settings, then the full name Apple gave,
   * then nothing. Never the email — "roplekarsudeep" is not a name.
   */
  /** The account's own profile row, read once at sign-in with the name; the first sync read takes it rather than asking again. */
  let ownProfile: any = null;
  async function resolveFirstName(user: { id: string; user_metadata?: Record<string, unknown> }): Promise<string> {
    let full = "";
    try {
      const d = await ensureDocument();
      ownProfile = d.me.profile ?? null;
      full = String(d.me.profile?.name ?? "").trim();
    } catch { /* no document yet: fall through to the account's own name */ }
    if (!full) full = String(user.user_metadata?.full_name ?? "").trim();
    fullName = full;
    return full.split(/\s+/)[0] ?? "";
  }

  /**
   * A first name from an email, only when the address is plainly a name:
   * "sadiya.naik@" gives Sadiya, "roplekarsudeep@" gives nothing, because a
   * wrong guess in a greeting is worse than a question. The guess is only
   * ever a prefilled field the person confirms with a tap.
   */
  /** The account's own person carries the profile's name: set once both are known, which with the reads side by side is after them. */
  function fillOwnName() {
    const mine = people.find((p) => p.self);
    if (!mine || mine.name || !fullName) return;
    mine.name = fullName;
    if (mine.id) supabase.from("people").update({ name: fullName }).eq("id", mine.id).then(() => {});
  }
  function guessNameFromEmail(email: string): string {
    const local = email.split("@")[0] ?? "";
    const parts = local.split(/[._-]/).filter(Boolean);
    if (parts.length < 2) return "";
    const first = parts[0];
    if (!/^[a-z]{2,20}$/i.test(first)) return "";
    return first[0].toUpperCase() + first.slice(1).toLowerCase();
  }

  /** "Good evening, Sudeep", or just "Good evening" when no name is known. */
  function greeting(): string {
    if (person && !person.self) return person.name || "Unnamed";
    const hour = new Date().getHours();
    const tod = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    return firstName ? `${tod}, ${firstName}` : tod;
  }

  // ── the reader at work, shown on every tab ─────────────────────────────
  // A read is a fetch: it carries on whichever tab is open, and even if the
  // page is scrolled away. What the person needs is to see that it is
  // happening and roughly how far along it is. Leaving the page is the one
  // thing that loses it, so the browser asks first while a read is on.
  let busyCount = 0;
  let busyTimer: number | undefined;
  const busyBar = () => $("busybar") as HTMLElement;
  function busyStart(text: string, sub = "Verve is reading every value and its printed range — usually 20 to 40 seconds. You can move around the site meanwhile.") {
    busyCount++;
    $("busytext").textContent = text;
    $("busysub").textContent = sub;
    show("busy", true); $("busy").classList.add("flex");
    $("busyicon").firstElementChild!.classList.add("mh-spin");
    if (busyTimer) { clearTimeout(busyTimer); busyTimer = undefined; }
    busyBar().classList.remove("mh-creep");
    busyBar().style.width = "0%";
    void busyBar().offsetWidth;
    busyBar().classList.add("mh-creep");
    busyBar().style.width = "90%";
  }
  function busyEnd(text: string, sub: string, ok: boolean) {
    busyCount = Math.max(0, busyCount - 1);
    if (busyCount > 0) return;
    busyBar().classList.remove("mh-creep");
    busyBar().style.width = "100%";
    $("busyicon").firstElementChild!.classList.remove("mh-spin");
    $("busytext").textContent = text;
    $("busysub").textContent = sub;
    busyBar().classList.toggle("bg-danger", !ok);
    busyBar().classList.toggle("bg-accent", ok);
    busyTimer = window.setTimeout(() => { show("busy", false); $("busy").classList.remove("flex"); }, ok ? 6000 : 12000);
  }
  $("busy").addEventListener("click", () => setTab("reports"));
  window.addEventListener("beforeunload", (e) => {
    if (busyCount > 0) { e.preventDefault(); e.returnValue = ""; }
  });

  /** The one way to add a report: the Reports tab, and its picker. */
  function pickReport() {
    setTab("reports");
    $("file").click();
  }
  $("addreport").addEventListener("click", pickReport);
  $("tosendgo").addEventListener("click", () => {
    const paths = pendingReports(allLabs, allApp, isSelf());
    if (!paths.length) return;
    setTab("reports");
    reviewPos = { n: 1, of: paths.length };
    reviewQueue = paths.slice(1).map((p) => () => reviewFromArchive(p));
    reviewFromArchive(paths[0]);
  });

  // ── a name for an account that has none: the greeting asks, once. The
  // answer is saved with the account (where the app's setup reads it) and
  // into the app's own profile when that has no name, so the app greets by
  // it too after its next sync. ──────────────────────────────────────────
  const LATER_KEY = "mh-name-later";
  function askForName(prefill: string) {
    let later = false;
    try { later = sessionStorage.getItem(LATER_KEY) === "1"; } catch { /* no storage: ask */ }
    if (later) return;
    ($("namein") as HTMLInputElement).value = prefill;
    $("nameform").classList.remove("hidden"); $("nameform").classList.add("flex");
  }
  function hideNameForm() { $("nameform").classList.add("hidden"); $("nameform").classList.remove("flex"); }
  $("namelater").addEventListener("click", () => {
    try { sessionStorage.setItem(LATER_KEY, "1"); } catch { /* fine */ }
    hideNameForm();
  });
  $("namechange").addEventListener("click", () => {
    ($("namein") as HTMLInputElement).value = fullName;
    $("nameform").classList.remove("hidden"); $("nameform").classList.add("flex");
    $("namein").focus();
  });
  $("nameform").addEventListener("submit", async (e) => {
    e.preventDefault();
    const name = ($("namein") as HTMLInputElement).value.trim().replace(/\s+/g, " ");
    if (!name) return;
    const { error } = await supabase.auth.updateUser({ data: { full_name: name } });
    if (error) { msg("upmsg", `Could not save your name: ${error.message}`, true); return; }
    // the app's profile, only where it has no name of its own
    try {
      await supabase.from("profiles").update({ name, updated_at: new Date().toISOString() })
        .eq("user_id", userId).or("name.is.null,name.eq.");
      if (person?.self && person.id) await supabase.from("people").update({ name }).eq("id", person.id);
    } catch { /* no profile row yet: the app's setup will read full_name */ }
    fullName = name;
    firstName = name.split(/\s+/)[0] ?? "";
    $("greet").textContent = greeting();
    show("namechange", true);
    hideNameForm();
  });
  // ── the newsletter, asked once. The sign-up form carries the box; an
  // account made through Apple or Google never saw it, so the greeting asks.
  // Either answer is saved with the account (where the sign-up box saves
  // its own), so nobody is asked twice: user_metadata.newsletter_opt_in. A
  // yes also writes the address to newsletter_signups, the one list the
  // welcome is sent from and the letters are exported from, and asks
  // newsletter-welcome to send the first letter, as the box on /start does.
  //
  // An account made with Apple's "Hide my email" signs in by a relay address
  // (…@privaterelay.appleid.com). Apple forwards mail to it only from senders
  // registered under the developer account, and drops the rest without a
  // word, so the question asks for an address Apple does not hide and the
  // letter goes there. user_metadata.newsletter_email keeps which one. ────
  const isRelay = (email: string) => /@privaterelay\.appleid\.com$/i.test(email);
  const newsSay = (text: string, bad = false) => {
    const el = $("newsmsg");
    el.textContent = text; el.classList.toggle("hidden", !text);
    el.classList.toggle("text-danger", bad); el.classList.toggle("text-text-primary", !bad);
  };
  function askForNewsletter(user: { user_metadata?: Record<string, unknown> }) {
    const answered = user.user_metadata?.newsletter_opt_in;
    if (answered !== undefined && answered !== null) return;
    const relay = isRelay(userEmail);
    show("newsrelay", relay); show("newsemail", relay);
    $("newsask").classList.remove("hidden"); $("newsask").classList.add("flex");
  }
  async function answerNewsletter(optIn: boolean) {
    const now = new Date().toISOString();
    let to = userEmail.trim().toLowerCase();
    if (optIn && isRelay(userEmail)) {
      to = ($("newsemail") as HTMLInputElement).value.trim().toLowerCase();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(to) || to.length > 254) { newsSay("That does not look like an email address.", true); $("newsemail").focus(); return; }
      if (isRelay(to)) { newsSay("That is a relay address too; Apple would not pass the letter on. One Apple does not hide, please.", true); $("newsemail").focus(); return; }
    }
    const yes = $("newsyes") as HTMLButtonElement;
    yes.disabled = true; newsSay(optIn ? "Saving…" : "");
    const { error } = await supabase.auth.updateUser({
      data: { newsletter_opt_in: optIn, newsletter_opt_in_at: optIn ? now : null, newsletter_asked_at: now, newsletter_email: optIn ? to : null },
    });
    yes.disabled = false;
    if (error) { newsSay(`Could not save that: ${error.message}`, true); return; }
    if (!optIn) { $("newsask").classList.add("hidden"); $("newsask").classList.remove("flex"); return; }
    // the row: the address, the sentence that was on screen when they said yes, and the account
    const consent = `${$("newstext").textContent?.trim() ?? ""}${isRelay(userEmail) ? ` ${$("newsrelay").textContent?.trim() ?? ""}` : ""} — Yes, send it.`;
    const { error: rowErr } = await supabase.from("newsletter_signups").insert({ email: to, consent_text: consent.slice(0, 600), source: "my-health", user_id: userId });
    if (rowErr && rowErr.code !== "23505") {     // 23505: already on the list, which is fine
      newsSay(`Saved with your account, but the list could not take ${to} just now: ${rowErr.message}. It is added by hand on the next export.`, true);
      return;
    }
    $("newsask").classList.add("hidden"); $("newsask").classList.remove("flex");
    // the first letter, after the answer is saved; never the gate
