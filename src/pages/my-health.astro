  /** One analyte row; tapping it opens the full chart underneath. */
  function labRow(name: string, rs: any[]): string {
    const latest = rs[rs.length - 1];
    const ok = inRange(latest);
    const vals = rs.map((r) => Number(r.value));
    const lo = Math.min(...vals), hi = Math.max(...vals);
    const y = (v: number) => hi === lo ? 14 : 24 - ((v - lo) / (hi - lo)) * 20;
    const x = (i: number) => rs.length === 1 ? 60 : 6 + (i / (rs.length - 1)) * 108;
    const pts = vals.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(" ");
    const dots = vals.map((v, i) => {
      const own = inRange(rs[i]);
      return `<circle cx="${x(i).toFixed(1)}" cy="${y(v).toFixed(1)}" r="${i === vals.length - 1 ? 3.5 : 2.5}" fill="${own === false ? "#FBBF24" : "#818cf8"}"><title>${rs[i].measured_on}: ${v}</title></circle>`;
    }).join("");
    const valColor = ok === false ? "text-warning" : ok === true ? "text-success" : "text-text-primary";
    const open = expandedAnalyte === name;
    return `
      <div>
        <button data-an="${esc(name)}" class="flex w-full items-center gap-3 py-2 text-left">
          <span class="min-w-0 flex-1 truncate text-[13px] font-semibold text-text-primary" title="${esc(name)}">${esc(name)}</span>
          <svg class="hidden shrink-0 sm:block" width="120" height="28" viewBox="0 0 120 28">${rs.length > 1 ? `<polyline points="${pts}" fill="none" stroke="#818cf8" stroke-width="1.5" opacity="0.6"/>` : ""}${dots}</svg>
          <span class="shrink-0 whitespace-nowrap text-right font-mono text-xs ${valColor}">${latest.value}${latest.unit ? ` ${esc(latest.unit)}` : ""}</span>
          <span class="hidden w-24 shrink-0 truncate text-right font-mono text-[10px] text-text-muted sm:inline" title="${esc(rangeLabel(latest))}">${esc(rangeLabel(latest))}</span>
          <span class="text-text-muted">${open ? "▾" : "▸"}</span>
        </button>
        ${open ? bigChart(name, rs) : ""}
      </div>`;
  }

  /**
   * The app-grade chart: every reading judged against ITS OWN printed range
   * (the green band re-shades per report), a ◆ where a different lab's range
   * enters the series, and the unit guard — readings in a different unit
   * are listed, never mixed onto the line.
   */
  function bigChart(name: string, rsAll: any[]): string {
    const latestUnit = unitKey(rsAll[rsAll.length - 1].unit);
    const rs = rsAll.filter((r) => unitKey(r.unit) === latestUnit);
    const offLine = rsAll.filter((r) => unitKey(r.unit) !== latestUnit);

    const W = 640, H = 200, L = 46, R = 16, T = 20, B = 30;
    const vals = rs.map((r) => Number(r.value));
    const bounds = [...vals];
    for (const r of rs) {
      if (r.ref_low != null) bounds.push(Number(r.ref_low));
      if (r.ref_high != null) bounds.push(Number(r.ref_high));
    }
    let lo = Math.min(...bounds), hi = Math.max(...bounds);
    const pad = (hi - lo || Math.abs(hi) || 1) * 0.15;
    lo -= pad; hi += pad;
    const X = (i: number) => rs.length === 1 ? L + (W - L - R) / 2 : L + (i / (rs.length - 1)) * (W - L - R);
    const Y = (v: number) => T + (1 - (v - lo) / (hi - lo)) * (H - T - B);
    const midX = (i: number) => i < 0 ? L : i >= rs.length - 1 ? W - R : (X(i) + X(i + 1)) / 2;

    // ① band segments — each reading's own range shades its neighbourhood
    const bands = rs.map((r, i) => {
      if (r.ref_low == null && r.ref_high == null) return "";
      const yTop = Y(r.ref_high != null ? Number(r.ref_high) : hi);
      const yBot = Y(r.ref_low != null ? Number(r.ref_low) : lo);
      return `<rect x="${midX(i - 1).toFixed(1)}" y="${yTop.toFixed(1)}" width="${(midX(i) - midX(i - 1)).toFixed(1)}" height="${Math.max(0, yBot - yTop).toFixed(1)}" fill="#10B981" opacity="0.09"/>`;
    }).join("");

    // ② range-change diamonds
    const rk = (r: any) => `${r.ref_low ?? ""}|${r.ref_high ?? ""}`;
    let diamonds = "";
    const changes: string[] = [];
    for (let i = 1; i < rs.length; i++) {
      if (rk(rs[i]) !== rk(rs[i - 1])) {
        diamonds += `<g transform="translate(${X(i).toFixed(1)},${T - 8})"><rect x="-4.5" y="-4.5" width="9" height="9" transform="rotate(45)" fill="#818cf8"><title>Different lab range from ${fmtDay(rs[i].measured_on)}: ${rangeLabel(rs[i - 1]) || "none"} → ${rangeLabel(rs[i]) || "none"}</title></rect></g>`;
        changes.push(`${rangeLabel(rs[i - 1]) || "no range"} → ${rangeLabel(rs[i]) || "no range"} from ${fmtDay(rs[i].measured_on)}`);
      }
    }

    // ③ line, dots (own-range verdicts), axis
    const line = rs.length > 1
      ? `<polyline points="${vals.map((v, i) => `${X(i).toFixed(1)},${Y(v).toFixed(1)}`).join(" ")}" fill="none" stroke="#818cf8" stroke-width="2"/>` : "";
    const dots = rs.map((r, i) => {
      const own = inRange(r);
      const c = own === false ? "#FBBF24" : own === true ? "#34D399" : "#94A3B8";
      return `<circle cx="${X(i).toFixed(1)}" cy="${Y(Number(r.value)).toFixed(1)}" r="4" fill="${c}" stroke="#0B0F1A" stroke-width="1.5"><title>${fmtDay(r.measured_on)}: ${r.value}${r.unit ? " " + r.unit : ""} (range ${rangeLabel(r) || "—"})</title></circle>`;
    }).join("");
    const step = Math.max(1, Math.ceil(rs.length / 6));
    const xlabels = rs.map((r, i) => (i % step === 0 || i === rs.length - 1)
      ? `<text x="${X(i).toFixed(1)}" y="${H - 8}" text-anchor="middle" font-size="9" fill="#64748B" font-family="ui-monospace,monospace">${new Date(r.measured_on + "T00:00:00").toLocaleDateString(undefined, { month: "short", year: "2-digit" })}</text>` : "").join("");
    const ticks = [0.15, 0.5, 0.85].map((f) => {
      const v = lo + (hi - lo) * (1 - f);
      const yy = T + f * (H - T - B);
      return `<line x1="${L}" y1="${yy}" x2="${W - R}" y2="${yy}" stroke="#FFFFFF" opacity="0.05"/><text x="${L - 6}" y="${yy + 3}" text-anchor="end" font-size="9" fill="#64748B" font-family="ui-monospace,monospace">${Number(v.toPrecision(3))}</text>`;
    }).join("");

    const unitLabel = rs[rs.length - 1].unit ? esc(String(rs[rs.length - 1].unit)) : "";
    return `
      <div class="mh-open mb-3 rounded-xl border border-white/[0.07] bg-white/[0.02] p-3">
        <svg viewBox="0 0 ${W} ${H}" class="w-full">${ticks}${bands}${line}${dots}${diamonds}${xlabels}</svg>
        <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-[10px] text-text-tertiary">
          <span><span class="text-success">●</span> in its lab's range</span>
          <span><span class="text-warning">●</span> outside</span>
          <span class="opacity-80">▩ the printed range, per report${unitLabel ? ` · ${unitLabel}` : ""}</span>
        </div>
        ${changes.map((c) => `<div class="mt-1.5 text-[10px] font-semibold text-accent-light">◆ DIFFERENT LAB RANGE · ${esc(c)}</div>`).join("")}
        ${offLine.length ? `
          <div class="mt-1.5 text-[10px] font-semibold text-warning">⚠ UNIT CHANGED — ${offLine.length} earlier reading${offLine.length === 1 ? "" : "s"} in a different unit, listed below, not on this line</div>
          ${offLine.map((r) => `<div class="mt-0.5 font-mono text-[10px] text-text-tertiary">${fmtDay(r.measured_on)} · ${r.value}${r.unit ? " " + esc(r.unit) : ""} (range ${esc(rangeLabel(r) || "—")})</div>`).join("")}` : ""}
        <div class="mt-2 divide-y divide-white/[0.04]">
          ${[...rs].reverse().map((r) => {
            const own = inRange(r);
            return `<div class="flex items-baseline gap-3 py-1">
              <span class="w-24 font-mono text-[10px] text-text-tertiary">${fmtDay(r.measured_on)}</span>
              <span class="flex-1 font-mono text-xs ${own === false ? "text-warning" : own === true ? "text-success" : "text-text-primary"}">${r.value}${r.unit ? ` ${esc(r.unit)}` : ""}</span>
              <span class="font-mono text-[10px] text-text-muted">${esc(rangeLabel(r) || "no printed range")}</span>
            </div>`;
          }).join("")}
        </div>
      </div>`;
  }

  // ═══ REPORTS ═════════════════════════════════════════════════════════════
  /** The kinds of file the archive holds: a PDF, or a photo of a report. */
  const REPORT_EXT = /\.(pdf|jpe?g|png|webp)$/i;
  const isPhotoName = (name: string) => /\.(jpe?g|png|webp)$/i.test(name);
  /** The stored name, as a title: the upload stamp off, underscores as spaces, no extension. */
  const pretty = (name: string | undefined) => (name ?? "").replace(/^\d+-/, "").replace(REPORT_EXT, "").replace(/_/g, " ");
  /** The upload time, from the stamp the upload put in front of the name. */
  const stampOf = (name: string) => Number((name.match(/^(\d+)-/) ?? [])[1] ?? 0);

  /** "Keep both" decisions, per file, kept in this browser. */
  const keptKey = "mh-keep-both";
  function keptSet(): Set<string> {
    try { return new Set(JSON.parse(localStorage.getItem(keptKey) ?? "[]")); } catch { return new Set(); }
  }
  function keepBoth(name: string) {
    try { localStorage.setItem(keptKey, JSON.stringify([...keptSet(), name])); } catch { /* private mode: the flag returns next visit */ }
  }

  /**
   * Which files are second copies of another. Storage gives each object an
   * eTag — a checksum of its bytes — so two uploads of the same PDF share
   * one; failing that, the same size and the same name is the same file.
   * The earliest upload is the original; the rest are its copies.
   */
  function findDuplicates(files: any[]): Map<string, string> {
    const dupOf = new Map<string, string>();
    const groups = new Map<string, any[]>();
    for (const f of files) {
      const tag = f.metadata?.eTag ? `etag:${f.metadata.eTag}` : `size:${f.metadata?.size ?? "?"}|${pretty(f.name).toLowerCase()}`;
      (groups.get(tag) ?? groups.set(tag, []).get(tag)!).push(f);
    }
    for (const g of groups.values()) {
      if (g.length < 2) continue;
      g.sort((x, y) => stampOf(x.name) - stampOf(y.name));
      for (const f of g.slice(1)) dupOf.set(f.name, g[0].name);
    }
    return dupOf;
  }

  async function renderReports() {
    const { data } = await supabase.storage.from("reports").list(folder(), {
      sortBy: { column: "created_at", order: "desc" }, limit: 200,
    });
    const files = (data ?? []).filter((f) => REPORT_EXT.test(f.name));
    setTabCount("reports", files.length ? String(files.length) : "");

    // what each report yielded, from the one web_labs fetch
    const outcomes = new Map<string, { date: string; n: number; flagged: number }>();
    for (const r of allLabs) {
      if (!r.report_path) continue;
      const o = outcomes.get(r.report_path) ?? { date: r.measured_on, n: 0, flagged: 0 };
      o.n++; if (inRange(r) === false) o.flagged++;
      o.date = r.measured_on;
      outcomes.set(r.report_path, o);
    }
    const imagingByPath = new Map(allImaging.map((im) => [im.report_path, im]));
    const dupOf = findDuplicates(files);
    const kept = keptSet();

    // each file's date: the report's own, else the imaging report's, else the
    // upload's. A copy has no filed values of its own, so it takes its
    // original's date and sits beside it.
    const dated = files.map((f) => {
      const path = `${folder()}/${f.name}`;
      const o = outcomes.get(path);
      const im = imagingByPath.get(path);
      const uploaded = stampOf(f.name) ? new Date(stampOf(f.name)).toISOString().slice(0, 10) : "";
      return { f, path, o, im, date: o?.date ?? im?.report_date ?? uploaded, uploaded };
    });
    const byName = new Map(dated.map((d) => [d.f.name, d]));
    for (const d of dated) {
      const orig = dupOf.get(d.f.name);
      if (orig && !d.o && !d.im && byName.get(orig)?.date) d.date = byName.get(orig)!.date;
    }
    dated.sort((x, y) => (y.date || "").localeCompare(x.date || "") || stampOf(y.f.name) - stampOf(x.f.name));

    // the search: a report matches when every word lands in its name, its date, a value read from it, or its study
    const terms = searchTerms();
    const hayByPath = new Map<string, string>();
    if (terms.length) {
      for (const r of allLabs) if (r.report_path) hayByPath.set(r.report_path, `${hayByPath.get(r.report_path) ?? ""} ${canonName(String(r.analyte))} ${r.value}${r.unit ? ` ${r.unit}` : ""}`.toLowerCase());
      for (const im of allImaging) if (im.report_path) hayByPath.set(im.report_path, `${hayByPath.get(im.report_path) ?? ""} ${im.modality} imaging ${im.modality === "echo" ? "2d echo echocardiogram" : ""} ${im.impression ?? ""}`.toLowerCase());
    }
    const shown = terms.length
      ? dated.filter((d) => landsAll(`${pretty(d.f.name)} ${dateHay(d.date)} ${hayByPath.get(d.path) ?? ""}${d.im ? "" : ""}`.toLowerCase(), terms))
      : dated;
    if (terms.length && activeTab === "reports") searchNote(`${shown.length} of ${dated.length} report${dated.length === 1 ? "" : "s"} ${shown.length === 1 ? "matches" : "match"}`);

    // a year at a time, newest first, every year closed until tapped; inside it, a month at a time
    const years = new Map<string, typeof dated>();
    for (const d of shown) {
      const y = d.date ? d.date.slice(0, 4) : "Undated";
      (years.get(y) ?? years.set(y, []).get(y)!).push(d);
    }
    const monthName = (d: string) => new Date(d.slice(0, 7) + "-01T00:00:00").toLocaleDateString(undefined, { month: "long" });
    const byMonth = (list: typeof dated) => {
      const months = new Map<string, typeof dated>();
      for (const d of list) {
        const m = d.date ? d.date.slice(0, 7) : "";
        (months.get(m) ?? months.set(m, []).get(m)!).push(d);
      }
      return [...months.entries()];
    };

    const card = (d: (typeof dated)[number]) => {
      const { f, o, im } = d;
      const original = dupOf.get(f.name);
      const flagged = original != null && !kept.has(f.name);
      const modChip = im ? `<span class="rounded-md bg-accent/15 px-2 py-0.5 font-mono text-[9px] font-semibold tracking-wider text-accent-light">${esc(String(im.modality).toUpperCase())}</span>` : "";
      const dateChip = d.date ? `<span class="rounded-md bg-white/[0.06] px-2 py-0.5 font-mono text-[9px] font-semibold tracking-wider text-text-secondary">${fmtDay(d.date).toUpperCase()}</span>` : "";
      const outcome = o
        ? `${o.n} values · ${o.flagged ? `<span class="text-warning">${o.flagged} outside range</span>` : `<span class="text-success">all in range</span>`}`
        : im ? "the report's own words, on Labs · Imaging"
        : flagged ? "" : `<span class="text-accent-light">not read yet</span>`;
      const app = o ? reportAppState(d.path) : null;
      const appLine = !app || app.total === 0 ? ""
        : app.pending.length === 0
          ? app.unchecked
            ? `<span class="text-warning">${app.total} in your app, ${app.unchecked} awaiting your check there</span>`
            : `<span class="text-success">${app.total} in your app</span>`
          : `<span class="text-warning">${app.pending.length} of ${app.total} for your app not sent</span> <button data-sendrep="${esc(f.name)}" class="ml-1 rounded-md border border-accent/40 bg-accent/10 px-2 py-0.5 text-[11px] font-bold text-accent-light hover:bg-accent/20">Send</button>`;
      return `
        <div class="rounded-2xl border ${flagged ? "border-warning/45" : "border-white/10"} bg-white/[0.03] p-4">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] bg-accent/[0.12]">
              ${isPhotoName(f.name)
                ? `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h3l2-2h6l2 2h3v12H4z"/><circle cx="12" cy="13" r="3.5"/></svg>`
                : `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>`}
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2" data-namewrap>
                <div class="truncate text-sm font-semibold text-text-primary">${esc(pretty(f.name))}</div>
                <button data-ren="${esc(f.name)}" title="Rename" aria-label="Rename report" class="shrink-0 text-text-muted transition-colors hover:text-text-primary">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                </button>
              </div>
              <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-text-tertiary">${dateChip}${modChip}${outcome ? `<span>${outcome}</span>` : ""}${appLine ? `<span>· ${appLine}</span>` : ""}</div>
            </div>
            <div class="hidden shrink-0 items-center gap-2 sm:flex">
              <button data-view="${esc(f.name)}" class="rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-secondary transition-colors hover:border-white/25 hover:text-text-primary">View</button>
              <button data-parse="${esc(f.name)}" class="rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-secondary transition-colors hover:border-white/25 hover:text-text-primary">${o || im ? "Read again" : "Read values"}</button>
              <button data-del="${esc(f.name)}" title="Delete" aria-label="Delete report" class="rounded-lg border border-white/12 px-2 py-1.5 text-text-tertiary transition-colors hover:border-danger/50 hover:text-danger">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
              </button>
            </div>
          </div>
          <div class="mt-3 flex flex-wrap gap-2 sm:hidden">
            <button data-view="${esc(f.name)}" class="rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-secondary">View</button>
            <button data-parse="${esc(f.name)}" class="rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-secondary">${o || im ? "Read again" : "Read values"}</button>
            <button data-del="${esc(f.name)}" class="ml-auto rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-tertiary">Delete</button>
          </div>
          ${flagged ? `
          <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-white/[0.06] pt-3">
            <span class="rounded-md bg-warning/15 px-2 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider text-warning">Duplicate</span>
            <span class="min-w-0 flex-1 text-xs leading-relaxed text-text-tertiary">The same file as <strong class="font-semibold text-text-secondary">${esc(pretty(original!))}</strong>. Its values were filed once; this PDF is a second copy.</span>
            <button data-del="${esc(f.name)}" data-quiet class="rounded-lg border border-accent/40 bg-accent/10 px-3 py-1.5 text-xs font-bold text-accent-light hover:bg-accent/20">Remove this copy</button>
            <button data-keep="${esc(f.name)}" class="rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-secondary hover:border-white/25">Keep both</button>
          </div>` : ""}
        </div>`;
    };

    $("repcards").innerHTML = (terms.length && !shown.length ? `<p class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 text-sm text-text-tertiary">No report matches "${esc(searchQuery)}". A report matches by its name, its date, a value read from it, or its study.</p>` : "") + [...years.entries()].map(([y, list]) => `
      <details class="group">
        <summary class="flex cursor-pointer list-none items-center gap-2.5 py-1 text-text-primary [&::-webkit-details-marker]:hidden">
          <span class="font-mono text-[13px] font-bold">${esc(y)}</span>
          <span class="text-xs text-text-tertiary">${list.length} report${list.length === 1 ? "" : "s"}</span>
          <svg class="h-3.5 w-3.5 text-text-tertiary transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </summary>
        <div class="mt-2 flex flex-col gap-2.5">
          ${byMonth(list).map(([m, cards]) => `
            ${m ? `<div class="mt-2 font-mono text-[10px] font-semibold uppercase tracking-widest text-text-tertiary first:mt-0">${esc(monthName(m))}</div>` : ""}
            ${cards.map(card).join("")}`).join("")}
        </div>
      </details>`).join("");

    if (!canWrite()) $("repcards").querySelectorAll("[data-parse],[data-del],[data-ren],[data-sendrep],[data-keep]").forEach((b) => b.remove());
    $("repcards").querySelectorAll("[data-parse]").forEach((b) =>
      b.addEventListener("click", () => parseReport((b as HTMLElement).dataset.parse!)));
    $("repcards").querySelectorAll("[data-view]").forEach((b) =>
      b.addEventListener("click", () => viewPdf(`${folder()}/${(b as HTMLElement).dataset.view}`)));
    $("repcards").querySelectorAll("[data-del]").forEach((b) =>
      b.addEventListener("click", async () => {
        const el = b as HTMLElement;
        // Removing a copy needs no question; deleting a report does. Its
        // values stay on Labs either way — only the PDF goes.
        if (el.dataset.quiet == null && !confirm(`Delete "${pretty(el.dataset.del!)}"? The PDF is removed; its values stay on your Labs tab.`)) return;
        await supabase.storage.from("reports").remove([`${folder()}/${el.dataset.del}`]);
        renderReports();
      }));
    $("repcards").querySelectorAll("[data-keep]").forEach((b) =>
      b.addEventListener("click", () => { keepBoth((b as HTMLElement).dataset.keep!); renderReports(); }));
    $("repcards").querySelectorAll("[data-sendrep]").forEach((b) =>
      b.addEventListener("click", () => { reviewQueue = []; reviewPos = { n: 0, of: 0 }; reviewFromArchive(`${folder()}/${(b as HTMLElement).dataset.sendrep}`); }));
    $("repcards").querySelectorAll("[data-ren]").forEach((b) =>
      b.addEventListener("click", () => renameUI(b as HTMLElement)));
  }

  async function viewPdf(path: string) {
    const { data: signed } = await supabase.storage.from("reports").createSignedUrl(path, 300);
    if (signed?.signedUrl) window.open(signed.signedUrl, "_blank");
  }

  /**
   * Rename a report. The filename IS the name — no separate label table to
   * drift out of sync — so a rename moves the stored PDF and re-points every
   * web_labs and imaging_reports row at the new path. The upload-time stamp
   * prefix is kept: it is what keeps two same-named uploads distinct.
   */
  async function renameReport(oldName: string, label: string) {
    const stamp = (oldName.match(/^(\d+)-/) ?? [, String(Date.now())])[1];
    const ext = (oldName.match(REPORT_EXT) ?? [, ".pdf"])[0];
    const safe = label.trim().replace(REPORT_EXT, "").replace(/[^\w.\- ]+/g, "").replace(/\s+/g, "_").slice(0, 80);
    if (!safe) { msg("upmsg", "Give the report a name first.", true); return; }
    const newName = `${stamp}-${safe}${ext}`;
    if (newName === oldName) { await renderReports(); return; }
    const oldPath = `${folder()}/${oldName}`, newPath = `${folder()}/${newName}`;
    const { error } = await supabase.storage.from("reports").move(oldPath, newPath);
    if (error) { msg("upmsg", `Could not rename: ${error.message}`, true); return; }
    const [{ error: e1 }, { error: e2 }] = await Promise.all([
      supabase.from("web_labs").update({ report_path: newPath }).eq("user_id", userId).eq("report_path", oldPath),
      supabase.from("imaging_reports").update({ report_path: newPath }).eq("user_id", userId).eq("report_path", oldPath),
    ]);
    if (e1 || e2) msg("upmsg", `Renamed, but some values still point at the old name (${(e1 ?? e2)!.message}).`, true);
    else msg("upmsg", "");
    await refresh();
  }

  function renameUI(btn: HTMLElement) {
    const name = btn.dataset.ren!;
    const wrap = btn.closest("[data-namewrap]") as HTMLElement;
    const current = pretty(name);
    wrap.innerHTML = `
      <input data-reninput value="${esc(current)}" maxlength="80"
        class="w-full min-w-0 flex-1 rounded-lg border border-accent/50 bg-white/[0.04] px-2.5 py-1 text-sm font-bold text-text-primary focus:outline-none" />
      <button data-rensave class="shrink-0 rounded-lg bg-accent px-2.5 py-1 text-xs font-bold text-canvas">Save</button>
      <button data-rencancel class="shrink-0 rounded-lg border border-white/12 px-2.5 py-1 text-xs font-semibold text-text-secondary">Cancel</button>`;
    const input = wrap.querySelector("[data-reninput]") as HTMLInputElement;
    input.focus(); input.select();
    const save = () => renameReport(name, input.value);
    wrap.querySelector("[data-rensave]")!.addEventListener("click", save);
    wrap.querySelector("[data-rencancel]")!.addEventListener("click", () => renderReports());
    input.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Enter") save();
      if ((e as KeyboardEvent).key === "Escape") renderReports();
    });
  }

  // ── upload — drop several at once; one visible queue, files read one
  // after another so a failure in one never takes the others down ────────
  const PHOTO_TYPES = new Set(["image/jpeg", "image/png", "image/webp", "image/heic", "image/heif"]);

  /**
   * A photo of a report, shrunk to 2048 px on its long edge and encoded as
   * a JPEG. The reader downsizes anything larger itself, so nothing it would
   * see is lost, and a 4 MB phone photo becomes a few hundred KB. HEIC from
   * an iPhone decodes in Safari; a browser that cannot decode it throws,
   * and the queue says to save it as a JPEG first.
   */
  async function shrinkPhoto(file: File): Promise<Blob> {
    const bmp = await createImageBitmap(file);
    const MAX = 2048;
    const scale = Math.min(1, MAX / Math.max(bmp.width, bmp.height));
    const w = Math.max(1, Math.round(bmp.width * scale)), h = Math.max(1, Math.round(bmp.height * scale));
    const canvas = document.createElement("canvas");
    canvas.width = w; canvas.height = h;
    canvas.getContext("2d")!.drawImage(bmp, 0, 0, w, h);
    bmp.close();
    return await new Promise<Blob>((res, rej) =>
      canvas.toBlob((b) => (b ? res(b) : rej(new Error("encode failed"))), "image/jpeg", 0.85));
  }
  function qset(id: string, chip: string, tone: "wait" | "busy" | "ok" | "bad", caption: string) {
    const row = document.getElementById(id);
    if (!row) return;
    const tones = {
      wait: "bg-white/[0.06] text-text-tertiary",
      busy: "bg-accent/15 text-accent-light animate-pulse",
      ok: "bg-success/15 text-success",
      bad: "bg-danger/15 text-danger",
    };
    row.querySelector("[data-qchip]")!.className = `rounded-md px-2 py-0.5 font-mono text-[9px] font-semibold tracking-wider ${tones[tone]}`;
    row.querySelector("[data-qchip]")!.textContent = chip;
    row.querySelector("[data-qcap]")!.textContent = caption;
  }

  async function uploadBatch(files: File[]) {
    if (files.length === 0) return;
    setTab("reports");
    msg("upmsg", "");
    show("review", false); show("echoreview", false);

    // Every batch is a block of its own, newest on top, and stays until
    // cleared: dropping a second report must not erase the first one's row.
    const batch = String(Date.now());
    const rowId = (i: number) => `q-${batch}-${i}`;
    const when = new Date().toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" });
    show("upqueue", true);
    $("upqueue").classList.add("flex");
    $("upqueue").insertAdjacentHTML("afterbegin", `
      <div data-batch="${batch}" class="flex flex-col gap-2">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[10px] font-semibold uppercase tracking-widest text-text-tertiary">${files.length} file${files.length === 1 ? "" : "s"} · ${esc(when)}</span>
          <button data-clearqueue class="text-xs font-medium text-text-tertiary hover:text-text-primary">Clear</button>
        </div>
        ${files.map((f, i) => `
        <div id="${rowId(i)}" class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3">
          <div class="min-w-0 flex-1">
            <div class="truncate text-[13px] font-bold">${esc(f.name)}</div>
            <div data-qcap class="mt-0.5 text-[11px] leading-relaxed text-text-tertiary">Waiting its turn</div>
          </div>
          <span data-qchip class="shrink-0 rounded-md bg-white/[0.06] px-2 py-0.5 font-mono text-[9px] font-semibold tracking-wider text-text-tertiary">QUEUED</span>
        </div>`).join("")}
        <p data-summary class="hidden text-xs text-text-tertiary"></p>
      </div>`);
    $("upqueue").querySelectorAll("[data-clearqueue]").forEach((b) =>
      b.addEventListener("click", () => { $("upqueue").innerHTML = ""; show("upqueue", false); }));
    $("upqueue").scrollIntoView({ block: "start", behavior: "smooth" });

    // the archive as it stands, so a file already in it is spotted before
    // it is uploaded again: same bytes (size) and the same name
    const { data: existing } = await supabase.storage.from("reports").list(folder(), { limit: 200 });
    const already = new Set((existing ?? []).map((e) => `${e.metadata?.size ?? "?"}|${pretty(e.name).toLowerCase()}`));

    let last: { name: string; out: any; path: string; filed: any } | null = null;
    const labsFiled: { name: string; out: any; path: string; filed: any }[] = [];
    let filedN = 0, failedN = 0, skippedN = 0;
    const kept = "The PDF is in your archive under this year, not read yet: its card's Read again retries, the bin deletes it.";
    for (let i = 0; i < files.length; i++) {
      const f = files[i];
      if (isExport(f)) {
        const r = await importExport(f, rowId(i));
        if (r === "ok") filedN++; else if (r === "bad") failedN++; else skippedN++;
        continue;
      }
      const isPdf = f.type === "application/pdf" || /\.pdf$/i.test(f.name);
      const isPhoto = PHOTO_TYPES.has(f.type) || /\.(jpe?g|png|webp|heic|heif)$/i.test(f.name);
      if (!isPdf && !isPhoto) { qset(rowId(i), "SKIPPED", "bad", "Not a PDF or a photo (JPG, PNG, WebP)"); skippedN++; continue; }
      if (f.size > 15 * 1024 * 1024) { qset(rowId(i), "SKIPPED", "bad", "Over 15 MB"); skippedN++; continue; }
      const asStored = `${f.size}|${pretty(f.name.replace(/[^\w.\-]+/g, "_")).toLowerCase()}`;
      if (isPdf && already.has(asStored)) { qset(rowId(i), "ALREADY HERE", "ok", "This file is in your archive. Its card's Read again re-reads it."); skippedN++; continue; }

      // a photo is shrunk to what the reader keeps anyway, and always lands as a JPEG
      let blob: Blob = f, ext = "pdf", contentType = "application/pdf";
      if (isPhoto) {
        qset(rowId(i), "PREPARING…", "busy", "Shrinking the photo to what the reader needs");
        try { blob = await shrinkPhoto(f); }
        catch { qset(rowId(i), "SKIPPED", "bad", "This browser cannot read that photo format — save it as a JPEG and try again"); skippedN++; continue; }
        ext = "jpg"; contentType = "image/jpeg";
      }

      qset(rowId(i), "UPLOADING…", "busy", "Saving the original to your private archive");
      const base = f.name.replace(/\.[^.]+$/, "").replace(/[^\w.\-]+/g, "_") || "report";
      let path = `${folder()}/${Date.now()}-${base}.${ext}`;
      const { error } = await supabase.storage.from("reports").upload(path, blob, { contentType });
      if (error) { qset(rowId(i), "FAILED", "bad", error.message); failedN++; continue; }

      qset(rowId(i), "READING…", "busy", "Verve is reading every value and its printed range — about 20 seconds");
      busyStart(files.length > 1 ? `Reading ${i + 1} of ${files.length}: ${f.name}` : `Reading ${f.name}…`);
      let out: any;
      try { out = await readReport(path); }
      catch (e: any) {
        busyEnd(`Could not read ${f.name}`, e.message ?? "Could not read this report", false);
        qset(rowId(i), "FAILED", "bad", `${e.message ?? "Could not read this report"} ${kept}`); failedN++; continue;
      }
      busyEnd(`Read ${f.name}`, "Filed — the queue on the Reports tab has the details.", true);

      // the name printed on it, against the person this page is about:
      // a mismatch holds the file until you say whose it is
      let filedUnder = person!;
      const verdict = nameVerdict(out.patient_name, filedUnder);
      let match: string | null = verdict;
      if (verdict === "mismatch") {
        qset(rowId(i), "WHOSE?", "wait", `This report names ${out.patient_name}. Waiting for your answer above.`);
        const choice = await askWhose(String(out.patient_name), f.name);
        if (choice.kind === "remove") {
          await supabase.storage.from("reports").remove([path]);
          qset(rowId(i), "REMOVED", "ok", "Not filed. The file is gone."); skippedN++; continue;
        }
        if (choice.kind === "add") {
          const room = roomForOneMore();
          const made = room.ok ? await addPerson(choice.name, null) : null;
          if (!room.ok) { showPlanPeople(room.why); qset(rowId(i), "FILED HERE", "ok", `${out.patient_name}: no room on your plan for one more person, so it is filed under ${person!.self ? "you" : person!.name}.`); }
          if (made) {
            const moved = `${folderOf(made)}/${path.split("/").pop()}`;
            const { error: mvErr } = await supabase.storage.from("reports").move(path, moved);
            if (!mvErr) { path = moved; filedUnder = made; }
          }
        }
        match = "confirmed";
      }
      await rememberReport(path, filedUnder, out, match);
      const under = filedUnder.id === person?.id ? "" : ` · filed under ${filedUnder.name}`;

      if (out.doc_type === "echo") {
        const filed = await archiveEcho(out, path, filedUnder);
        qset(rowId(i), "FILED ✓", "ok", `Echo report · ${filed.values.length} measurements → Labs · Imaging${under}`);
        filedN++; last = { name: f.name, out, path, filed };
      } else if (out.doc_type === "other") {
        qset(rowId(i), "ARCHIVED", "ok", `Read as: ${out.kind ?? "a medical document"} — kept as a PDF; its type is on the roadmap`);
      } else {
        const filed = await archiveLab(out, path, filedUnder);
        const auto = await autoSendToApp(filed, path, out.lpa_unit ?? null, filedUnder);
        auto.forEach((k) => filed.dupKeys.add(k));
        (filed as any).autoSent = auto;
        if (out.truncated)
          qset(rowId(i), "PART READ", "ok", `${filed.allValues.length} values read before the reader's budget ran out — the rest of this report was not read. Everything read is on Labs.`);
        else if (filed.allValues.length > 0 && filed.fresh.length === 0)
          qset(rowId(i), "A COPY", "ok", `${filed.allValues.length} values, every one already on your Labs tab from ${fmtDay(filed.date)} — this is a copy of a report you have`);
        else
          qset(rowId(i), "FILED ✓", "ok", `${filed.allValues.length} values → Labs · ${filed.fresh.length} new on ${filedUnder.self ? "your" : filedUnder.name + "'s"} trends${auto.size ? ` · ${auto.size} to your app, unchecked` : ""}`);
        filedN++; last = { name: f.name, out, path, filed };
        if (filedUnder.self) labsFiled.push(last);   // the app tier is yours alone
      }
    }

    // the batch's one-line result, under its rows
    const summary = $("upqueue").querySelector(`[data-batch="${batch}"] [data-summary]`) as HTMLElement | null;
    if (summary) {
      const parts = [`${filedN} of ${files.length} filed`];
      if (failedN) parts.push(`${failedN} failed`);
      if (skippedN) parts.push(`${skippedN} skipped`);
      summary.textContent = parts.join(" · ") + (filedN ? " · every filed value is on your Labs tab" : "");
      summary.classList.remove("hidden");
    }

    await refresh();
    // the report just filed: its card rises into the timeline
    if (last) {
      const card = $("repcards").querySelector(`[data-view="${CSS.escape(last.path.split("/").pop()!)}"]`)?.closest("details > div > div");
      card?.classList.add("mh-rise");
    }
    // every lab report with something for the app gets its review, one after
    // another; an echo report's review shows when it was the last file
    const toReview = labsFiled.filter((r) => r.filed.appValues.some((v: any) => !r.filed.dupKeys.has(v.key)));
    if (toReview.length) {
      reviewPos = { n: 1, of: toReview.length };
      reviewQueue = toReview.slice(1).map((r) => () => renderLabReview(r.out, r.path, r.name, r.filed));
      await renderLabReview(toReview[0].out, toReview[0].path, toReview[0].name, toReview[0].filed);
      if (toReview.length > 1) msg("upmsg", `${toReview.length} reports have values for your app — reviewing them one at a time below.`);
    } else if (last && last.out.doc_type === "echo") {
      renderEchoReview(last.out, last.path, last.name);
    }
  }

  $("file").addEventListener("change", () => {
    const fs = Array.from(($("file") as HTMLInputElement).files ?? []);
    ($("file") as HTMLInputElement).value = "";
    if (fs.length && person) uploadBatch(fs);
  });
  // Drag a file over ANY part of the page and the veil says where it will
  // land. dragenter/dragleave fire for every element crossed, so a depth
  // counter tells a real leave from a move between children.
  let dragDepth = 0;
  const veil = (on: boolean) => { $("veil").classList.toggle("hidden", !on); $("veil").classList.toggle("flex", on); };
  const hasFiles = (e: Event) => Array.from((e as DragEvent).dataTransfer?.types ?? []).includes("Files");
  document.addEventListener("dragenter", (e) => {
    if (!userId || !canWrite() || !hasFiles(e)) return;
    e.preventDefault();
    if (dragDepth++ === 0) veil(true);
  });
  document.addEventListener("dragover", (e) => {
    if (!userId || !canWrite() || !hasFiles(e)) return;
    e.preventDefault();
  });
  document.addEventListener("dragleave", (e) => {
    if (!userId || !canWrite() || !hasFiles(e)) return;
    if (--dragDepth <= 0) { dragDepth = 0; veil(false); }
  });
  document.addEventListener("drop", (e) => {
    if (!userId) return;
    e.preventDefault();
    dragDepth = 0; veil(false);
    const fs = Array.from((e as DragEvent).dataTransfer?.files ?? []);
    if (fs.length) uploadBatch(fs);
  });

  // ── the pipeline: read (the edge function) → file (the archive writes)
  // → review (DOM only). The batch queue and the Read values button share
  // every stage instead of each doing it their own way. ──────────────────

  /** Call the parser. Throws with a user-facing message on any failure. */
  async function readReport(path: string): Promise<any> {
    const { data: { session } } = await supabase.auth.getSession();
    const resp = await fetch(`${SUPABASE_URL}/functions/v1/report-parser`, {
      method: "POST",
      headers: { "content-type": "application/json", authorization: `Bearer ${session?.access_token}`, apikey: SUPABASE_ANON_KEY },
      body: JSON.stringify({ path }),
    });
    const out = await resp.json().catch(() => ({ error: "Unreadable response" }));
    if (!resp.ok || out.error) {
      throw new Error(
        out.error === "not_a_lab_report" || out.error === "not_a_medical_report" ? "That file doesn't look like a medical report." :
        out.error === "report_too_dense" ? (out.detail ?? "The report is too long to read in one go.") :
        out.error === "unsupported_type" || out.error === "photo_too_large" ? (out.detail ?? "That file type cannot be read.") :
        out.error === "subscription_required" ? (out.detail ?? "Your free reports are used — a subscription keeps the drop zone open.") :
        `Could not read it${out.detail ? ` — ${out.detail}` : `: ${out.error ?? resp.status}`}`);
    }
    return out;
  }

  /** Single-file path — the cards' Read values button. */
  async function parseReport(name: string) {
    setTab("reports");
    msg("upmsg", "");
    show("review", false); show("echoreview", false);
    const btns = Array.from($("repcards").querySelectorAll("[data-parse]")) as HTMLButtonElement[];
    btns.forEach((b) => { b.disabled = true; if (b.dataset.parse === name) b.textContent = "Reading…"; });
    busyStart(`Reading ${pretty(name)}…`);
    const path = `${folder()}/${name}`;
    let out: any;
    try { out = await readReport(path); }
    catch (e: any) {
      btns.forEach((b) => { b.disabled = false; if (b.dataset.parse === name) b.textContent = "Read values"; });
      busyEnd(`Could not read ${pretty(name)}`, e.message ?? "Could not read this report", false);
      msg("upmsg", e.message ?? "Could not read this report", true);
      return;
    }
    btns.forEach((b) => { b.disabled = false; if (b.dataset.parse === name) b.textContent = "Read values"; });
    const n = out.doc_type === "lab" ? (out.all_values?.length ?? 0) : out.doc_type === "echo" ? (out.echo_values?.length ?? 0) : 0;
    busyEnd(`Read ${pretty(name)}`, n ? `${n} value${n === 1 ? "" : "s"} read${out.truncated ? ", then the reader's budget ran out" : ""} — the review is on the Reports tab.` : "Filed. The review is on the Reports tab.", true);
    await rememberReport(path, person!, out, nameVerdict(out.patient_name, person!));
    if (out.doc_type === "echo") {
      await archiveEcho(out, path);
      renderEchoReview(out, path, name);
      await refresh();
      return;
    }
    if (out.doc_type === "other") {
      msg("upmsg", `Read as: ${out.kind ?? "a medical document"}. Verve files echo reports and lab panels today — this PDF stays safe in your archive, and its type is on the roadmap.`);
      return;
    }
    const filed = await archiveLab(out, path);
    const auto = await autoSendToApp(filed, path, out.lpa_unit ?? null);
    auto.forEach((k) => filed.dupKeys.add(k));
    (filed as any).autoSent = auto;
    if (out.truncated) msg("upmsg", `${filed.allValues.length} values read before the reader's budget ran out — the rest of this report was not read.`);
    await refresh();
    if (isSelf()) await renderLabReview(out, path, name, filed);
  }

  /**
   * The same-day and near-day check against the app's rows, shared by a
   * fresh parse and a review opened from the archive.
   */
  async function appDuplicates(date: string, appValues: { key: string; value: number }[], who: Person = person!) {
    if (!who?.account_id) return { dupKeys: new Set<string>(), nearDays: new Map<string, number>() };
    const day0 = new Date(date + "T00:00:00").getTime();
    const winStart = new Date(day0 - 7 * 86400000).toISOString();
    const winEnd = new Date(day0 + 8 * 86400000).toISOString();
    const { data: appExisting } = await supabase.from("lab_readings")
      .select("*").eq("user_id", who.account_id).gte("measured_at", winStart).lt("measured_at", winEnd).is("deleted_at", null);
    const dupKeys = new Set<string>();
    const nearDays = new Map<string, number>();
    for (const v of appValues) {
      for (const r of appExisting ?? []) {
        if (Number(r[v.key]) !== v.value) continue;
        const dd = Math.round((new Date(r.measured_at).getTime() - day0) / 86400000);
        if (dd === 0) { dupKeys.add(v.key); nearDays.delete(v.key); break; }
        const prev = nearDays.get(v.key);
        if (prev == null || Math.abs(dd) < Math.abs(prev)) nearDays.set(v.key, dd);
      }
    }
    return { dupKeys, nearDays };
  }

  /** Reviews still to open after this one — the rest of a batch, or of the Overview's list. */
  let reviewQueue: Array<() => Promise<void> | void> = [];
  let reviewPos = { n: 0, of: 0 };

  /**
   * A report's review built from what is already filed: its app-bound
   * values against the app's rows, and its full list. Nothing is read
   * again, so it costs nothing and needs no PDF.
   */
  async function reviewFromArchive(path: string) {
    setTab("reports");
    const { date, values } = appBoundFor(path);
    const rows = allLabs.filter((r) => r.report_path === path);
    if (!date || rows.length === 0) { msg("upmsg", "Nothing filed from this report yet — Read again reads it.", true); return; }
    const appValues = values.map((v) => ({ key: v.key, value: v.value, unit: v.unit, label: v.name }));
    const allValues = rows.map((r) => ({ name: r.analyte, value: Number(r.value), unit: r.unit, ref_low: r.ref_low, ref_high: r.ref_high, ref_text: r.ref_text, section: r.section }));
    const { dupKeys, nearDays } = await appDuplicates(date, appValues);
    const lpa = values.find((v) => v.key === "lpa_value");
    await renderLabReview({ lpa_unit: lpa?.unit ?? null }, path, path.split("/")[1] ?? path,
      { date, appValues, allValues, fresh: [], dupKeys, nearDays, fromArchive: true });
  }

  /**
   * Stage 2: the app's markers go to the app the moment they are read,
   * marked unchecked with the report they came from, and the app asks the
   * person to look. A same-day duplicate is not sent; a near-day match is
   * left to the review, where the person decides. Returns how many went.
   */
  async function autoSendToApp(
    filed: { date: string; appValues: any[]; dupKeys: Set<string>; nearDays: Map<string, number> },
    path: string, lpaUnit: string | null, who: Person = person!,
  ): Promise<Set<string>> {
    const sent = new Set<string>();
    if (!AUTO_SEND_TO_APP || !who?.self) return sent;
    const bySection: Record<string, Record<string, number | string>> = {};
    for (const v of filed.appValues) {
      if (filed.dupKeys.has(v.key) || filed.nearDays.has(v.key)) continue;
      (bySection[LABELS[v.key].section] ??= {})[v.key] = v.value;
      sent.add(v.key);
    }
    if (sent.size === 0) return sent;
    if (bySection.heart?.lpa_value != null && lpaUnit) bySection.heart.lpa_unit = lpaUnit;
    const m = bySection.metabolic;
    if (m && typeof m.glucose_mgdl === "number" && typeof m.fasting_insulin_uiuml === "number") {
      m.homa_ir = Math.round((m.glucose_mgdl * m.fasting_insulin_uiuml) / 405 * 100) / 100;
    }
    const now = new Date().toISOString();
    const measuredAt = new Date(filed.date + "T09:00:00").toISOString();
    const rows = Object.entries(bySection).map(([section, cols]) => ({
      id: crypto.randomUUID(), user_id: userId, source: section,
      measured_at: measuredAt, updated_at: now,
      review_status: "unchecked", report_path: path, ...cols,
    }));
    const { error } = await supabase.from("lab_readings").insert(rows);
    if (error) { msg("upmsg", `Filed here, but could not send to the app: ${error.message}`, true); return new Set(); }
    return sent;
  }

  /** Archive a lab report's values — the writes, no DOM. */
  async function archiveLab(out: any, path: string, who: Person = person!) {
    const date = out.report_date ?? new Date().toISOString().slice(0, 10);
    const appValues = (out.values ?? []).filter((v: any) => LABELS[v.key] && Number.isFinite(v.value));
    const allValues = (out.all_values ?? [])
      .filter((v: any) => typeof v?.name === "string" && Number.isFinite(v?.value))
      .map((v: any) => ({ ...v, name: canonName(v.name) }));

    // ① EVERYTHING → the website's own archive, deduped against what is
    // already there (same canonical analyte + date + value). The unique
    // index in the database is the backstop.
    const { data: existing } = await scopeRows(supabase.from("web_labs")
      .select("analyte, value"), who).eq("measured_on", date);
    const have = new Set((existing ?? []).map((r) => `${canonName(String(r.analyte)).toLowerCase()}|${r.value}`));
    const fresh = allValues.filter((v: any) => !have.has(`${v.name.toLowerCase()}|${v.value}`));
    if (fresh.length > 0) {
      await supabase.from("web_labs").insert(fresh.map((v: any) => ({
        id: crypto.randomUUID(), user_id: userId, ...personCol(who),
        analyte: v.name, value: v.value, unit: v.unit ?? null,
        ref_low: Number.isFinite(v.ref_low) ? v.ref_low : null,
        ref_high: Number.isFinite(v.ref_high) ? v.ref_high : null,
        ref_text: v.ref_text ?? null,
        section: SECTIONS[v.section] ? v.section : "other",
        measured_on: date, report_path: path,
      })));
    }

    // ② the app tier. Same date + same value = a duplicate, never sent.
    // Same value on a NEARBY date (±7 days) is the hand-entered-then-uploaded
    // case — the row a user typed on Aug 1 from a Jul 31 report — so those
    // start UNTICKED with a note, and the user decides.
    const { dupKeys, nearDays } = await appDuplicates(date, appValues, who);
    return { date, appValues, allValues, fresh, dupKeys, nearDays };
  }

  /** The two-tier review — DOM only; `filed` comes from archiveLab. */
  async function renderLabReview(out: any, path: string, name: string,
    filed: { date: string; appValues: any[]; allValues: any[]; fresh: any[]; dupKeys: Set<string>; nearDays: Map<string, number>; fromArchive?: boolean }) {
    const { date, appValues, allValues, fresh, dupKeys, nearDays } = filed;
    parsed = { path, lpa_unit: out.lpa_unit ?? null, dupKeys };
    $("rvtitle").textContent = pretty(name);
    $("rvcount").textContent = filed.fromArchive ? `${allValues.length} VALUES ON LABS` : `${allValues.length} VALUES READ${out.truncated ? " · CUT SHORT" : ""}`;
    show("rvpos", reviewPos.of > 1);
    $("rvpos").textContent = `REPORT ${reviewPos.n} OF ${reviewPos.of}`;
    $("discard").textContent = reviewQueue.length ? "Next report →" : "Close review";
    ($("rvdate") as HTMLInputElement).value = date;

    // tier 1 rows — duplicates struck through, excluded from the send
    $("rvapp").innerHTML = appValues.map((v: any) => {
      const meta = LABELS[v.key];
      const unit = v.key === "lpa_value" ? (out.lpa_unit ?? v.unit ?? "") : meta.unit;
      const autoSent: Set<string> = (filed as any).autoSent ?? new Set();
      if (autoSent.has(v.key)) return `
        <div class="flex items-center gap-3 py-2">
          <span class="w-20 font-mono text-[10px] uppercase tracking-wider text-text-tertiary">${meta.section}</span>
          <span class="flex-1 text-sm font-semibold">${esc(meta.label)} · ${v.value} ${esc(unit)}</span>
          <span class="rounded-md bg-accent/15 px-2 py-0.5 font-mono text-[9px] tracking-wider text-accent-light">IN YOUR APP · CHECK IT THERE</span>
        </div>`;
      if (dupKeys.has(v.key)) return `
        <div class="flex items-center gap-3 py-2 opacity-50">
          <span class="w-20 font-mono text-[10px] uppercase tracking-wider text-text-tertiary">${meta.section}</span>
          <span class="flex-1 text-sm font-semibold line-through">${esc(meta.label)} · ${v.value} ${esc(unit)}</span>
          <span class="rounded-md bg-white/[0.06] px-2 py-0.5 font-mono text-[9px] tracking-wider text-text-tertiary">ALREADY IN YOUR APP</span>
        </div>`;
      const near = nearDays.get(v.key);
      const nearChip = near != null
        ? `<span class="rounded-md bg-warning/15 px-2 py-0.5 font-mono text-[9px] tracking-wider text-warning" title="Your app already holds this exact value on a date ${Math.abs(near)} day${Math.abs(near) === 1 ? "" : "s"} ${near > 0 ? "after" : "before"} this report — likely the same lab, entered by hand. Tick to send anyway.">SAME VALUE ${Math.abs(near)}D AWAY</span>`
        : "";
      return `
        <div class="flex items-center gap-3 py-2">
          <span class="w-20 font-mono text-[10px] uppercase tracking-wider text-text-tertiary">${meta.section}</span>
          <span class="min-w-0 flex-1 text-sm font-semibold">${esc(meta.label)} ${nearChip}</span>
          <input data-key="${v.key}" type="number" step="any" value="${v.value}"
            class="w-28 rounded-lg border border-white/12 bg-white/[0.04] px-3 py-1.5 text-right font-mono text-sm text-text-primary focus:border-accent focus:outline-none" />
          <span class="w-14 text-xs text-text-tertiary">${esc(unit)}</span>
          <input data-drop="${v.key}" type="checkbox" ${near != null ? "" : "checked"} title="${near != null ? "Unticked — the same value sits nearby in your app; tick to send anyway" : "Untick to leave this value out"}" class="h-4 w-4 accent-[#818cf8]" />
        </div>`;
    }).join("") || `<p class="py-2 text-sm text-text-tertiary">None of the app's markers were in this report.</p>`;

    const sendable = appValues.filter((v: any) => !dupKeys.has(v.key) && nearDays.get(v.key) == null).length;
    const nearOnly = sendable === 0 && [...nearDays.keys()].some((k) => !dupKeys.has(k));
    const autoCount = ((filed as any).autoSent as Set<string> | undefined)?.size ?? 0;
    $("confirm").textContent = sendable > 0
      ? `Send ${sendable} value${sendable === 1 ? "" : "s"} to the app →`
      : nearOnly ? "Send ticked values →" : autoCount ? "Everything is in your app" : "Nothing new to send";
    ($("confirm") as HTMLButtonElement).disabled = sendable === 0 && !nearOnly;

    // tier 2 — grouped by section, each value against its lab's own range
    const webOnly = allValues.filter((v: any) => !["metabolic", "heart", "muscle"].includes(v.section));
    const bySec = new Map<string, any[]>();
    for (const v of webOnly) {
      const s = SECTIONS[v.section] ? v.section : "other";
      (bySec.get(s) ?? bySec.set(s, []).get(s)!).push(v);
    }
    $("rvwebnote").textContent = filed.fromArchive
      ? `${webOnly.length} value${webOnly.length === 1 ? "" : "s"}, all on your Labs tab`
      : `${webOnly.length} values · ${fresh.length} new saved to your dashboard${allValues.length - fresh.length > 0 ? ` · ${allValues.length - fresh.length} already there` : ""}`;
    $("rvweb").innerHTML = SECTION_ORDER.filter((s) => bySec.has(s)).map((s) => `
      <div class="mt-3 font-mono text-[10px] uppercase tracking-widest text-text-tertiary">${SECTIONS[s]}</div>
      <div class="divide-y divide-white/[0.05]">
        ${bySec.get(s)!.map((v: any) => `
          <div class="flex items-baseline gap-3 py-1.5">
            <span class="flex-1 text-[13px] text-text-primary">${esc(v.name)}</span>
            <span class="font-mono text-xs ${inRange(v) === false ? "mh-pulse px-1 text-warning" : "text-success"}">${v.value}${v.unit ? ` ${esc(v.unit)}` : ""}</span>
            <span class="w-24 text-right font-mono text-[10px] text-text-muted">${esc(rangeLabel(v))}</span>
          </div>`).join("")}
      </div>`).join("");

    show("review", true);
    $("review").classList.add("flex");
    $("review").scrollIntoView({ block: "start", behavior: "smooth" });
  }

  /**
   * An echo report: the numeric parameters become web_labs rows (section
   * "imaging" — trendable like any analyte, judged ONLY against ranges the
   * report itself printed), and the doctor's impression + per-structure
   * findings go to imaging_reports VERBATIM. Numbers and prose never mix.
   */
  /** An echo's numeric parameters, canonical-named — shared by both halves. */
  function echoValues(out: any): any[] {
    return (out.echo_values ?? [])
      .filter((v: any) => typeof v?.name === "string" && Number.isFinite(v?.value))
      .map((v: any) => ({ ...v, name: canonName(v.name) }));
  }

  async function archiveEcho(out: any, path: string, who: Person = person!) {
    const date = out.report_date ?? new Date().toISOString().slice(0, 10);
    const values = echoValues(out);

    // dedup + archive, same contract as lab analytes
    const { data: existing } = await scopeRows(supabase.from("web_labs")
      .select("analyte, value"), who).eq("measured_on", date);
    const have = new Set((existing ?? []).map((r) => `${canonName(String(r.analyte)).toLowerCase()}|${r.value}`));
    const fresh = values.filter((v: any) => !have.has(`${v.name.toLowerCase()}|${v.value}`));
    if (fresh.length > 0) {
      await supabase.from("web_labs").insert(fresh.map((v: any) => ({
        id: crypto.randomUUID(), user_id: userId, ...personCol(who),
        analyte: v.name, value: v.value, unit: v.unit ?? null,
        ref_low: Number.isFinite(v.ref_low) ? v.ref_low : null,
        ref_high: Number.isFinite(v.ref_high) ? v.ref_high : null,
        ref_text: v.ref_text ?? null,
        section: "imaging", measured_on: date, report_path: path,
      })));
    }

    // one narrative row per PDF — re-reading replaces, never stacks
    const { error: imgErr } = await supabase.from("imaging_reports").upsert({
      id: crypto.randomUUID(), user_id: userId, ...personCol(who), modality: "echo",
      report_date: date, report_path: path,
      impression: out.impression ?? null, findings: out.findings ?? null,
    }, { onConflict: "user_id,report_path" });
    if (imgErr) { msg("upmsg", `Could not save the report's narrative: ${imgErr.message}`, true); }
    return { date, values };
  }

  /** The echo review — DOM only; the writes happened in archiveEcho. */
  function renderEchoReview(out: any, path: string, name: string) {
    const date = out.report_date ?? new Date().toISOString().slice(0, 10);
    const values = echoValues(out);
    const findings = Array.isArray(out.findings) ? out.findings : [];
    $("echoreview").innerHTML = `
      <div class="flex flex-wrap items-center gap-3">
        <h2 class="text-base font-extrabold">${esc(name.replace(/^\d+-/, ""))}</h2>
        <span class="rounded-md bg-accent/15 px-2 py-0.5 font-mono text-[10px] font-semibold tracking-wider text-accent-light">ECHO REPORT</span>
        <span class="font-mono text-[10px] tracking-wider text-text-tertiary">${fmtDay(date).toUpperCase()}</span>
      </div>
      ${values.length ? `
        <div class="mt-3 font-mono text-[10px] font-semibold uppercase tracking-widest text-text-tertiary">Measurements → Labs · Imaging</div>
        <div class="mt-1 divide-y divide-white/[0.05]">
          ${values.map((v: any) => `
            <div class="flex items-baseline gap-3 py-1.5">
              <span class="flex-1 text-[13px] text-text-primary">${esc(v.name)}</span>
              <span class="font-mono text-xs ${inRange(v) === false ? "text-warning" : inRange(v) === true ? "text-success" : "text-text-primary"}">${v.value}${v.unit ? ` ${esc(v.unit)}` : ""}</span>
              <span class="w-24 text-right font-mono text-[10px] text-text-muted">${esc(rangeLabel(v))}</span>
            </div>`).join("")}
        </div>` : ""}
      ${out.impression ? `
        <div class="mt-4 font-mono text-[10px] font-semibold uppercase tracking-widest text-text-tertiary">Impression — the report's own words</div>
        <p class="mt-1 rounded-xl border border-white/[0.07] bg-white/[0.02] p-3 text-sm leading-6 text-text-secondary">${esc(out.impression)}</p>` : ""}
      ${findings.length ? `
        <div class="mt-4 font-mono text-[10px] font-semibold uppercase tracking-widest text-text-tertiary">Findings</div>
        <div class="mt-1 divide-y divide-white/[0.05]">
          ${findings.map((f: any) => `
            <div class="flex gap-3 py-1.5 text-[13px]">
              <span class="w-32 shrink-0 font-semibold text-text-primary">${esc(String(f.structure ?? ""))}</span>
              <span class="text-text-secondary">${esc(String(f.statement ?? ""))}</span>
            </div>`).join("")}
        </div>` : ""}
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button id="echoclose" class="rounded-xl border border-white/14 px-4 py-2.5 text-sm font-semibold text-text-secondary transition-colors hover:border-white/25">Close</button>
        <span class="text-xs text-text-muted">Numbers are read from the report's printed text — never measured from images. Ranges shown only when the report prints them.</span>
      </div>`;
    show("echoreview", true);
    $("echoreview").scrollIntoView({ block: "start", behavior: "smooth" });
    $("echoclose").addEventListener("click", () => show("echoreview", false));
  }

  // ── send the app tier → lab_readings, the app's own table ──────────────
  /** Close, or open the next review in the run. */
  function closeReview() {
    show("review", false); $("review").classList.remove("flex"); parsed = null;
    const next = reviewQueue.shift();
    if (next) { reviewPos = { n: reviewPos.n + 1, of: reviewPos.of }; next(); }
    else reviewPos = { n: 0, of: 0 };
  }
  $("discard").addEventListener("click", closeReview);

  $("confirm").addEventListener("click", async () => {
    if (!parsed) return;
    const btn = $("confirm") as HTMLButtonElement;
    if (btn.disabled) return;
    btn.disabled = true;   // a double-click was how one report sent twice
    const reEnable = () => { btn.disabled = false; };
    const date = ($("rvdate") as HTMLInputElement).value;
    if (!date) { msg("rvmsg", "Set the report date first.", true); reEnable(); return; }

    const bySection: Record<string, Record<string, number | string>> = {};
    $("rvapp").querySelectorAll("[data-key]").forEach((input) => {
      const key = (input as HTMLElement).dataset.key!;
      const keep = ($("rvapp").querySelector(`[data-drop="${key}"]`) as HTMLInputElement)?.checked;
      const v = parseFloat((input as HTMLInputElement).value);
      if (!keep || !Number.isFinite(v) || parsed!.dupKeys.has(key)) return;
      const section = LABELS[key].section;
      (bySection[section] ??= {})[key] = v;
    });

    if (bySection.heart?.lpa_value != null && parsed.lpa_unit) bySection.heart.lpa_unit = parsed.lpa_unit;
    const m = bySection.metabolic;
    if (m && typeof m.glucose_mgdl === "number" && typeof m.fasting_insulin_uiuml === "number") {
      m.homa_ir = Math.round((m.glucose_mgdl * m.fasting_insulin_uiuml) / 405 * 100) / 100;
    }

    if (Object.keys(bySection).length === 0) { msg("rvmsg", "Nothing ticked to send.", true); reEnable(); return; }

    // Freshly re-check the app's same-date rows RIGHT before inserting —
    // the parse-time check can be minutes stale by the time this is tapped.
    const ckStart = new Date(date + "T00:00:00").toISOString();
    const ckEnd = new Date(new Date(date + "T00:00:00").getTime() + 86400000).toISOString();
    const { data: nowThere } = await supabase.from("lab_readings")
      .select("*").eq("user_id", userId).gte("measured_at", ckStart).lt("measured_at", ckEnd).is("deleted_at", null);
    for (const [section, cols] of Object.entries(bySection)) {
      for (const [k, v] of Object.entries(cols)) {
        if (typeof v === "number" && (nowThere ?? []).some((r: any) => Number(r[k]) === v)) delete cols[k];
      }
      if (Object.keys(cols).length === 0) delete bySection[section];
    }

    const now = new Date().toISOString();
    const measuredAt = new Date(date + "T09:00:00").toISOString();
    // Sent by a person who has just read them here: checked, with the report they came from.
    const rows = Object.entries(bySection).map(([section, cols]) => ({
      id: crypto.randomUUID(), user_id: userId, source: section,
      measured_at: measuredAt, updated_at: now,
      review_status: "checked", reviewed_at: now, report_path: parsed!.path, ...cols,
    }));
    if (rows.length === 0) { msg("rvmsg", "Nothing new to send — these values are already in your app.", true); reEnable(); return; }

    const { error } = await supabase.from("lab_readings").insert(rows);
    if (error) { msg("rvmsg", `Could not send: ${error.message}`, true); reEnable(); return; }
    msg("rvmsg", reviewQueue.length ? "Sent. Open the Verve app and these values will be there. Next report below." : "Sent. Open the Verve app and these values will be there.");
    ($("confirm") as HTMLButtonElement).disabled = true;
    $("confirm").textContent = "Sent to the app ✓";
    // the cards and the Overview's line follow what the app holds now
    refresh();
  });

  boot();
  supabase.auth.onAuthStateChange((event) => {
    // A reset link lands with a recovery session, and a recovery code signs
    // in as it is checked: either way the reset card stays in front of the
    // dashboard until the new password is saved.
    if (event === "PASSWORD_RECOVERY" || recovering) {
      showReset();
      return;
    }
    boot();
  });
</script>
