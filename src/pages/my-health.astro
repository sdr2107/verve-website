  // ═══ OVERVIEW ═══════════════════════════════════════════════════════════
  /** A section's ring: latest readings in range, out of those with a printed range. */
  function ringSvg(ok: number, judged: number, i = 0): string {
    const C = 2 * Math.PI * 22;
    const frac = judged ? ok / judged : 0;
    const len = (frac * C).toFixed(1);
    const color = judged === 0 ? "#64748b" : ok === judged ? "#34d399" : "#FBBF24";
    return `
      <svg width="52" height="52" viewBox="0 0 56 56" aria-hidden="true">
        <circle cx="28" cy="28" r="22" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="5"/>
        <circle class="mh-ring" style="--len: ${len}; --i: ${i}" cx="28" cy="28" r="22" fill="none" stroke="${color}" stroke-width="5" stroke-linecap="round"
          stroke-dasharray="${len} ${C.toFixed(1)}" transform="rotate(-90 28 28)"/>
        <text x="28" y="26.5" text-anchor="middle" font-size="13" font-weight="800" fill="#f1f5f9">${judged ? ok : "–"}</text>
        <text x="28" y="37" text-anchor="middle" font-size="7.5" fill="#64748b">${judged ? `of ${judged}` : "no range"}</text>
      </svg>`;
  }

  /** A tiny trend line for a card: the series on its own scale, last point marked. */
  function sparkline(rs: any[], color: string): string {
    const vals = rs.map((r) => Number(r.value));
    if (vals.length < 2) return "";
    const lo = Math.min(...vals), hi = Math.max(...vals);
    const x = (i: number) => 3 + (i / (vals.length - 1)) * 74;
    const y = (v: number) => hi === lo ? 13 : 23 - ((v - lo) / (hi - lo)) * 20;
    const pts = vals.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(" ");
    const last = vals.length - 1;
    return `<svg width="80" height="26" viewBox="0 0 80 26" class="shrink-0" aria-hidden="true">
      <polyline points="${pts}" fill="none" stroke="${color}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="${x(last).toFixed(1)}" cy="${y(vals[last]).toFixed(1)}" r="2.6" fill="${color}"/></svg>`;
  }

  // ── the glance and the sections are views now ──────────────────────────
  // src/my-health/views/Overview renders the line under the greeting, the
  // four cards and one section with its tiles and the open marker, from
  // the document signal; a tap or a fresh document changes only the nodes
  // whose values changed. What stays here is the page's chrome around
  // them: the Labs tab's count, the empty card, the goto buttons, the
  // sidebar's lit section and the hash.
  function renderGlance() {
    const { outside } = labsJudged(allLabs);
    setTabCount("labs", outside ? `${outside} outside` : "", outside ? "text-warning" : "text-text-tertiary");
    show("emptycard", !allLabs.length && !allWeeks.length && !syncSignals.length);
    wireGoto();
  }
  function renderSection() { /* the section is a view of ovSectionSignal; nothing to draw here */ }
  effect(() => {
    const sec = ovSectionSignal.value;
    show("ovall", sec === "all"); show("ovsection", sec !== "all");
    document.querySelectorAll<HTMLElement>("[data-section]").forEach((b) => {
      const on = b.dataset.section === sec;
