  // Cloud Sync in the app is free and automatic, and it already carries
  // every workout, fitness test and waist reading. For a person with an
  // account those rows are read straight from the app's tables, yours
  // through your own policies and a client's through the activity and
  // body scopes they ticked. An export is then only for what sync does
  // not have: weeks from before sync was on, or a person with no account.
  /**
   * Every row a query would return, a thousand at a time. Supabase answers
   * one request with at most 1,000 rows whatever .limit() says, and a read
   * of every workout oldest-first stopped in May for an account with 1,254
   * rows: the site then said 141 days without a workout. The builder is a
   * function because a query is spent once it runs.
   */
  // The API hands back 1,000 rows a call. A full first page means more:
  // the next pages are asked for three at a time, together, so a table of
  // 1,300 or 3,000 rows costs two round trips, not two or four in a row.
  async function pageAll(build: () => any, maxPages = 10): Promise<{ data: any[]; error: any }> {
    const first = await build().range(0, 999);
    if (first.error) return { data: [], error: first.error };
    const out: any[] = [...(first.data ?? [])];
    if (out.length < 1000) return { data: out, error: null };
    for (let page = 1; page < maxPages; page += 3) {
      const pages = [page, page + 1, page + 2].filter((i) => i < maxPages);
      const got = await Promise.all(pages.map((i) => build().range(i * 1000, i * 1000 + 999)));
      let short = false;
      for (const { data, error } of got) {
        if (error) return { data: out, error };
        out.push(...(data ?? []));
        if (!data || data.length < 1000) { short = true; break; }
      }
      if (short) break;
    }
    return { data: out, error: null };
  }

