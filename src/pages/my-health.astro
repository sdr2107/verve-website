    const { data, error } = await supabase.from("grants")
      .select("id, person_id, person_name, inviter_name, scopes, invited_at")
      .eq("status", "invited").eq("viewer_email", userEmail.toLowerCase());
    const rows = error ? [] : (data ?? []);
