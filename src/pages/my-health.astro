---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<!--
  My health — the website's signed-in corner, in three tabs.

  · Overview — a greeting, the handful of findings worth a look, the latest
    report, and a slim drop bar. The answer-at-a-glance page.
  · Labs — every value from every report, section rail on the left, one
    section at a time on the right. A row expands into the full chart:
    band-shaded by each reading's OWN printed range, a diamond where a
    different lab's range enters the series, and readings in a different
    unit never share the line.
  · Reports — the drop zone and the archive: one card per original PDF
    with what came out of it. Review-and-send lives here too.

  The standing rules: app-bound markers go to lab_readings only on the
  user's explicit send, deduped; EVERYTHING parsed lands in web_labs with
  the lab's own printed range (a unique index backs the dedup); analyte
  names are canonicalised by lib/canon.js so "SGPT (ALT)" and "ALT" share
  one trend line; nothing is ever discarded.
-->

<Layout
  title="My health — Verve"
  description="Sign in with your Verve account, drop old lab reports, and their values file themselves into your app and your own lab dashboard."
  cardType="summary"
>
  <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6 sm:px-10">
    <a href="/" class="flex items-center gap-2.5">
      <img src="/app-icon.png" alt="" class="h-8 w-8 rounded-lg" />
      <span class="text-lg font-semibold tracking-tight text-text-primary">Verve</span>
    </a>
    <div class="flex items-center gap-3">
      <!-- No email in the header — a greeting, the way the app does it.
           (The old span carried sm:inline, which OVERRODE `hidden` at
           desktop widths — the address stayed visible after sign-out.) -->
      <span id="who" class="hidden text-sm font-semibold text-text-secondary"></span>
      <button
        id="signout"
        class="hidden rounded-full border border-white/14 px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:border-white/25"
      >Sign out</button>
    </div>
  </header>

  <main class="vrv-glow relative mx-auto max-w-6xl px-6 pb-24 sm:px-10">

    <!-- ── signed out ─────────────────────────────────────────────────── -->
    <section id="auth" class="mt-6 hidden max-w-3xl rounded-2xl border border-white/10 bg-white/[0.03] p-7">
      <h1 class="text-2xl font-extrabold tracking-tight">My health</h1>
      <p class="mt-2 text-sm leading-6 text-text-secondary">
        Drop an old lab report — Verve reads every value. The markers the app tracks
        go to your app on one tap; everything else is kept and charted here.
      </p>
      <div class="mt-6 flex w-fit gap-1 rounded-full border border-white/10 bg-white/[0.04] p-1">
        <button type="button" data-mode="signin" class="rounded-full px-4 py-1.5 text-[13px] font-bold">Sign in</button>
        <button type="button" data-mode="signup" class="rounded-full px-4 py-1.5 text-[13px] font-semibold">Create account</button>
      </div>
      <p id="modenote" class="mt-3 text-sm text-text-secondary"></p>

      <form id="pwform" class="mt-4 flex flex-col gap-3">
        <input id="email" type="email" required placeholder="you@example.com" autocomplete="email"
          class="rounded-xl border border-white/12 bg-white/[0.04] px-4 py-3 text-sm text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none" />
        <div class="relative">
          <input id="password" type="password" placeholder="Password" autocomplete="current-password"
            class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-4 py-3 pr-12 text-sm text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none" />
          <button type="button" data-eye="password" aria-label="Show password"
            class="absolute inset-y-0 right-0 flex w-12 items-center justify-center text-text-tertiary hover:text-text-primary">
            <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
        <button type="submit" id="authsubmit"
          class="rounded-xl bg-accent px-4 py-3 text-sm font-bold text-canvas transition-opacity hover:opacity-90">
          Sign in
        </button>
        <button type="button" id="forgot" class="self-end text-xs font-medium text-accent-light hover:underline">
          Forgot password?
        </button>
      </form>

      <div id="ordiv" class="mt-4 flex items-center gap-3">
        <div class="h-px flex-1 bg-white/10"></div>
        <span class="text-xs text-text-muted">or</span>
        <div class="h-px flex-1 bg-white/10"></div>
      </div>

      <button id="magic"
        class="mt-4 w-full rounded-xl border border-white/14 px-4 py-3 text-sm font-semibold text-text-primary transition-colors hover:border-white/25">
        Email me a sign-in link
      </button>

      <p id="authmsg" class="mt-4 hidden text-sm"></p>
    </section>

    <!-- ── set a new password (arrived from a reset email) ──────────────── -->
    <section id="pwreset" class="mt-6 hidden max-w-3xl rounded-2xl border border-accent/40 bg-white/[0.03] p-7">
      <h2 class="text-lg font-bold">Set a new password</h2>
      <p class="mt-1 text-sm text-text-secondary">You followed a reset link — choose the password you'll use in the app and here.</p>
      <div class="relative mt-5">
        <input id="newpw" type="password" placeholder="New password (8+ characters)" autocomplete="new-password"
          class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-4 py-3 pr-12 text-sm text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none" />
        <button type="button" data-eye="newpw" aria-label="Show password"
          class="absolute inset-y-0 right-0 flex w-12 items-center justify-center text-text-tertiary hover:text-text-primary">
          <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
      </div>
      <button id="savepw" class="mt-3 w-full rounded-xl bg-accent px-4 py-3 text-sm font-bold text-canvas transition-opacity hover:opacity-90">
        Save password
      </button>
      <p id="pwmsg" class="mt-4 hidden text-sm"></p>
    </section>

    <!-- ── signed in ──────────────────────────────────────────────────── -->
    <section id="home" class="mt-2 hidden">

      <!-- tab pills -->
      <nav id="tabbar" class="flex gap-1.5 rounded-2xl border border-white/10 bg-white/[0.03] p-1.5 sm:w-fit">
        <button data-tab="overview" class="flex-1 rounded-xl px-4 py-2 text-sm font-semibold sm:flex-none">Overview</button>
        <button data-tab="labs" class="flex-1 rounded-xl px-4 py-2 text-sm font-semibold sm:flex-none">Labs</button>
        <button data-tab="reports" class="flex-1 rounded-xl px-4 py-2 text-sm font-semibold sm:flex-none">Reports</button>
      </nav>
      <p id="upmsg" class="mt-3 hidden text-sm"></p>

      <!-- ═══ OVERVIEW ═══════════════════════════════════════════════════ -->
      <div id="tab-overview" class="mt-6 hidden">
        <h1 id="greet" class="text-2xl font-extrabold tracking-tight"></h1>
        <p id="greetsub" class="mt-1 text-sm text-text-secondary"></p>

        <div id="worthwrap" class="mt-6 hidden">
          <div class="font-mono text-[10px] font-semibold uppercase tracking-widest text-text-tertiary">Worth a look</div>
          <div id="worth" class="mt-2 grid gap-3 sm:grid-cols-2"></div>
        </div>

        <div id="latestcard" class="mt-6 hidden rounded-2xl border border-white/10 bg-white/[0.03] p-5"></div>

        <label for="file"
          class="mt-6 flex max-w-3xl cursor-pointer items-center gap-3 rounded-2xl border-[1.5px] border-dashed border-accent/40 bg-accent/[0.04] px-5 py-4 transition-colors hover:border-accent/70">
          <svg class="h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/>
          </svg>
          <span class="text-sm font-semibold">Drop a report anywhere on this page</span>
          <span class="ml-auto hidden text-xs text-text-tertiary sm:inline">PDF · or tap to choose</span>
        </label>
      </div>

      <!-- ═══ LABS ═══════════════════════════════════════════════════════ -->
      <div id="tab-labs" class="mt-6 hidden">
        <div class="flex items-baseline justify-between">
          <h1 class="text-xl font-extrabold tracking-tight">Your labs</h1>
          <span id="labsspan" class="font-mono text-[10px] uppercase tracking-wider text-text-tertiary"></span>
        </div>
        <p class="mt-1 text-xs leading-5 text-text-tertiary">
          Every value from every report, sorted by report date. Tap a marker for its
          chart — each dot is judged against the lab's own printed range, and a
          <span class="text-accent-light">◆</span> marks where a different lab's range enters the series.
        </p>
        <div id="labsempty" class="mt-6 hidden rounded-2xl border border-white/10 bg-white/[0.03] p-6 text-sm text-text-tertiary">
          Nothing here yet — drop a report on the <button data-goto="reports" class="font-semibold text-accent-light hover:underline">Reports</button> tab and every value in it lands here.
        </div>
        <div class="mt-4 flex flex-col gap-4 md:flex-row">
          <nav id="labsrail" class="flex flex-col gap-1.5 md:w-56 md:shrink-0"></nav>
          <div id="labspanel" class="hidden min-w-0 flex-1 rounded-2xl border border-white/10 bg-white/[0.03] p-5 md:block"></div>
        </div>
      </div>

      <!-- ═══ REPORTS ════════════════════════════════════════════════════ -->
      <div id="tab-reports" class="mt-6 hidden">
        <label id="drop" for="file"
          class="flex max-w-3xl cursor-pointer flex-col items-center gap-2 rounded-2xl border-[1.5px] border-dashed border-accent/45 bg-accent/[0.05] px-6 py-10 transition-colors">
          <svg class="h-8 w-8 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/>
          </svg>
          <span class="text-sm font-bold">Drag reports here, or tap to choose</span>
          <span class="text-xs text-text-tertiary">PDF · several at once is fine · originals stay in your private archive</span>
          <input id="file" type="file" accept="application/pdf" multiple class="hidden" />
        </label>

        <!-- the batch queue: one row per dropped file, each with its stage -->
        <div id="upqueue" class="mt-6 hidden max-w-3xl flex-col gap-2"></div>

        <!-- ── the review: two tiers ─────────────────────────────────────── -->
        <div id="review" class="mt-6 hidden flex-col gap-4">
          <div class="flex flex-wrap items-center gap-3">
            <h2 id="rvtitle" class="text-base font-extrabold"></h2>
            <span id="rvcount" class="rounded-md bg-warning/15 px-2 py-0.5 font-mono text-[10px] font-semibold tracking-wider text-warning"></span>
            <div class="ml-auto flex items-center gap-2">
              <span class="font-mono text-[10px] uppercase tracking-wider text-text-tertiary">Report date</span>
              <input id="rvdate" type="date"
                class="rounded-lg border border-white/12 bg-white/[0.04] px-3 py-1.5 text-sm text-text-primary focus:border-accent focus:outline-none" />
            </div>
          </div>

          <!-- tier 1: app-bound -->
          <div class="rounded-2xl border border-accent/40 bg-white/[0.03] p-5">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[10px] font-semibold tracking-widest text-accent-light">GOES TO YOUR APP</span>
              <span class="text-xs text-text-tertiary">Metabolic · Heart · Muscle — check anything Verve misread</span>
            </div>
            <div id="rvapp" class="mt-2 divide-y divide-white/[0.06]"></div>
            <div class="mt-4 flex flex-wrap items-center gap-3">
              <button id="confirm"
                class="rounded-xl bg-accent px-5 py-3 text-sm font-bold text-canvas transition-opacity hover:opacity-90 disabled:opacity-50"></button>
              <span class="text-xs text-text-muted">
                Duplicates — same marker, same date, same value — are never sent twice.
              </span>
            </div>
            <p id="rvmsg" class="mt-3 hidden text-sm"></p>
          </div>

          <!-- tier 2: website archive -->
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[10px] font-semibold tracking-widest text-text-secondary">STAYS ON THE WEBSITE</span>
              <span id="rvwebnote" class="text-xs text-text-tertiary"></span>
            </div>
            <div id="rvweb" class="mt-2"></div>
          </div>

          <div class="flex items-center gap-3">
            <button id="discard" class="rounded-xl border border-white/14 px-4 py-2.5 text-sm font-semibold text-text-secondary transition-colors hover:border-white/25">
              Close review
            </button>
            <span class="text-xs text-text-muted">Everything above is already on your Labs tab — closing loses nothing.</span>
          </div>
        </div>

        <!-- ── echo review: numbers → Labs, the doctor's words kept apart ── -->
        <div id="echoreview" class="mt-6 hidden rounded-2xl border border-accent/40 bg-white/[0.03] p-5"></div>

        <!-- ── the archive: one card per original PDF ────────────────────── -->
        <div id="repcards" class="mt-6 grid max-w-3xl gap-3"></div>
      </div>

      <p class="mt-10 text-xs leading-5 text-text-muted">
        Wellness screening, not a diagnosis — parsing can misread a report, which is
        why you confirm app-bound values. Reports and values are private to your account.
      </p>
    </section>

    <p id="loading" class="mt-10 text-sm text-text-tertiary">Checking your session…</p>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase, SUPABASE_URL, SUPABASE_ANON_KEY } from "../lib/supabase";
  import { canonName, unitKey } from "../lib/canon.js";

  // ── tiny DOM helpers ───────────────────────────────────────────────────
  const $ = (id: string) => document.getElementById(id)!;
  const show = (id: string, on: boolean) => $(id).classList.toggle("hidden", !on);
  const msg = (id: string, text: string, bad = false) => {
    const el = $(id);
    el.textContent = text;
    el.classList.toggle("hidden", !text);
    el.classList.toggle("text-danger", bad);
    el.classList.toggle("text-success", !bad);
  };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]!));
  const fmtDay = (d: string) =>
    new Date(d + "T00:00:00").toLocaleDateString(undefined, { day: "numeric", month: "short", year: "numeric" });

  // ── the app markers, keyed by lab_readings COLUMNS ─────────────────────
  const LABELS: Record<string, { label: string; unit: string; section: "metabolic" | "heart" | "sarcopenia" }> = {
    glucose_mgdl:           { label: "Fasting glucose",   unit: "mg/dL",  section: "metabolic" },
    hba1c_pct:              { label: "HbA1c",             unit: "%",      section: "metabolic" },
    post_meal_glucose_mgdl: { label: "Post-meal glucose", unit: "mg/dL",  section: "metabolic" },
    fasting_insulin_uiuml:  { label: "Fasting insulin",   unit: "uIU/mL", section: "metabolic" },
    triglycerides_mgdl:     { label: "Triglycerides",     unit: "mg/dL",  section: "metabolic" },
    hdl_mgdl:               { label: "HDL",               unit: "mg/dL",  section: "metabolic" },
    waist_cm:               { label: "Waist",             unit: "cm",     section: "metabolic" },
    sbp:                    { label: "Systolic BP",       unit: "mmHg",   section: "metabolic" },
    dbp:                    { label: "Diastolic BP",      unit: "mmHg",   section: "metabolic" },
    apo_b_mgdl:             { label: "ApoB",              unit: "mg/dL",  section: "heart" },
    ldl_mgdl:               { label: "LDL",               unit: "mg/dL",  section: "heart" },
    lpa_value:              { label: "Lp(a)",             unit: "",       section: "heart" },
    hs_crp_mgl:             { label: "hs-CRP",            unit: "mg/L",   section: "heart" },
    body_fat_pct:           { label: "Body fat",          unit: "%",      section: "sarcopenia" },
    skel_musc_pct:          { label: "Skeletal muscle",   unit: "%",      section: "sarcopenia" },
  };

  const SECTIONS: Record<string, string> = {
    metabolic: "Metabolic", heart: "Heart", muscle: "Muscle",
    haematology: "Haematology", lipids: "Lipids", liver: "Liver", kidney: "Kidney",
    thyroid: "Thyroid", vitamins_iron: "Vitamins & iron", hormones: "Hormones",
    inflammation: "Inflammation", urine: "Urine", imaging: "Imaging", other: "Other",
  };
  const SECTION_ORDER = Object.keys(SECTIONS);

  let userId = "";
  let userEmail = "";
  let parsed: { path: string; lpa_unit: string | null; dupKeys: Set<string> } | null = null;

  // one fetch feeds Overview, Labs and the Reports cards
  let allLabs: any[] = [];
  let allImaging: any[] = [];   // imaging_reports — the narrative half of a study
  let labSecs: Map<string, Map<string, any[]>> = new Map();
  let labSection = "";
  let expandedAnalyte = "";          // one chart open at a time
  let mobileSectionOpen = false;     // phone: section list ⇄ section page

  // ── tabs ───────────────────────────────────────────────────────────────
  let activeTab = "overview";
  function setTab(t: string) {
    activeTab = t;
    ["overview", "labs", "reports"].forEach((x) => show("tab-" + x, x === t));
    $("tabbar").querySelectorAll("[data-tab]").forEach((b) => {
      const on = (b as HTMLElement).dataset.tab === t;
      b.className = `flex-1 rounded-xl px-4 py-2 text-sm font-semibold sm:flex-none transition-colors ${
        on ? "bg-accent/20 text-text-primary" : "text-text-tertiary hover:text-text-primary"}`;
    });
    history.replaceState(null, "", "#" + t);
  }
  $("tabbar").querySelectorAll("[data-tab]").forEach((b) =>
    b.addEventListener("click", () => setTab((b as HTMLElement).dataset.tab!)));

  // ── session ────────────────────────────────────────────────────────────
  async function boot() {
    const { data: { session } } = await supabase.auth.getSession();
    show("loading", false);
    if (session?.user) {
      userId = session.user.id;
      userEmail = session.user.email ?? "";
      $("who").textContent = greeting();
      show("who", true); show("signout", true); show("home", true); show("auth", false);
      const wanted = window.location.hash.replace("#", "");
      setTab(["overview", "labs", "reports"].includes(wanted) ? wanted : "overview");
      await refresh();
    } else {
      $("who").textContent = "";
      show("auth", true); show("home", false); show("who", false); show("signout", false);
    }
  }

  /** "Good evening, Sudeep" — the app's greeting, from the account's name part. */
  function greeting(): string {
    const hour = new Date().getHours();
    const tod = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    const name = userEmail.split("@")[0].replace(/[._]/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
    return `${tod}, ${name}`;
  }

  /** Refetch web_labs + imaging_reports once; every surface renders from them. */
  async function refresh() {
    const [{ data: rows }, { data: imaging }] = await Promise.all([
      supabase.from("web_labs")
        .select("analyte, value, unit, ref_low, ref_high, ref_text, section, measured_on, report_path")
        .eq("user_id", userId).order("measured_on", { ascending: true }).limit(4000),
      supabase.from("imaging_reports")
        .select("modality, report_date, report_path, impression, findings")
        .eq("user_id", userId).order("report_date", { ascending: true }).limit(200),
    ]);
    allLabs = rows ?? [];
    allImaging = imaging ?? [];
    groupLabs();
    renderOverview();
    renderLabsRail(); renderLabsPanel();
    await renderReports();
  }

  // ── two modes, one card: the same account works here and in the app ────
  let authMode: "signin" | "signup" = "signin";
  function setAuthMode(m: "signin" | "signup") {
    authMode = m;
    document.querySelectorAll("[data-mode]").forEach((b) => {
      const on = (b as HTMLElement).dataset.mode === m;
      b.className = `rounded-full px-4 py-1.5 text-[13px] ${on ? "bg-accent/20 font-bold text-text-primary" : "font-semibold text-text-tertiary hover:text-text-primary"}`;
    });
    $("modenote").textContent = m === "signin"
      ? "The login you use in the app. Signed up with Apple? Use the email link below — it goes to the address on your Apple ID."
      : "No app needed to start — this account works here today and signs into the Verve app whenever you get it.";
    $("authsubmit").textContent = m === "signin" ? "Sign in" : "Create my account";
    ($("password") as HTMLInputElement).placeholder = m === "signin" ? "Password" : "Choose a password (8+ characters)";
    show("forgot", m === "signin");
    show("magic", m === "signin");
    show("ordiv", m === "signin");
    msg("authmsg", "");
  }
  document.querySelectorAll("[data-mode]").forEach((b) =>
    b.addEventListener("click", () => setAuthMode((b as HTMLElement).dataset.mode as any)));
  setAuthMode("signin");

  $("pwform").addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = ($("email") as HTMLInputElement).value.trim();
    const password = ($("password") as HTMLInputElement).value;
    if (authMode === "signup") {
      if (password.length < 8) { msg("authmsg", "Choose a password of at least 8 characters.", true); return; }
      msg("authmsg", "Creating your account…");
      const { data, error } = await supabase.auth.signUp({
        email, password,
        options: { emailRedirectTo: window.location.origin + "/my-health/" },
      });
      if (error) { msg("authmsg", error.message, true); return; }
      // Supabase answers an existing address with a userless success — say so
      // honestly instead of promising an email that will never come.
      if (data.user && (data.user.identities?.length ?? 1) === 0) {
        msg("authmsg", "That address already has a Verve account — switch to Sign in.", true);
        return;
      }
      if (data.session) { msg("authmsg", ""); boot(); return; }
      msg("authmsg", "Almost there — confirm from the email we just sent, and the link lands you back here, signed in.");
      return;
    }
    msg("authmsg", "Signing in…");
    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) msg("authmsg", error.message, true);
    else { msg("authmsg", ""); boot(); }
  });

  $("magic").addEventListener("click", async () => {
    const email = ($("email") as HTMLInputElement).value.trim();
    if (!email) { msg("authmsg", "Type your email above first.", true); return; }
    msg("authmsg", "Sending…");
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: { shouldCreateUser: false, emailRedirectTo: window.location.origin + "/my-health/" },
    });
    if (error) msg("authmsg", error.message, true);
    else msg("authmsg", "Sent — open the link in that email and you'll land back here, signed in.");
  });

  $("signout").addEventListener("click", async () => {
    await supabase.auth.signOut();
    boot();
  });

  // ── show/hide password — the eye at the end of the bar ────────────────
  document.querySelectorAll("[data-eye]").forEach((b) =>
    b.addEventListener("click", () => {
      const input = $((b as HTMLElement).dataset.eye!) as HTMLInputElement;
      const showing = input.type === "text";
      input.type = showing ? "password" : "text";
      b.setAttribute("aria-label", showing ? "Show password" : "Hide password");
      (b as HTMLElement).classList.toggle("text-accent-light", !showing);
    }));

  // ── forgot password → reset email → the set-a-new-password card ───────
  $("forgot").addEventListener("click", async () => {
    const email = ($("email") as HTMLInputElement).value.trim();
    if (!email) { msg("authmsg", "Type your email above first.", true); return; }
    msg("authmsg", "Sending a reset link…");
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: window.location.origin + "/my-health/",
    });
    if (error) msg("authmsg", error.message, true);
    else msg("authmsg", "Sent — the link in that email brings you back here to set a new password.");
  });

  $("savepw").addEventListener("click", async () => {
    const pw = ($("newpw") as HTMLInputElement).value;
    if (pw.length < 8) { msg("pwmsg", "At least 8 characters.", true); return; }
    msg("pwmsg", "Saving…");
    const { error } = await supabase.auth.updateUser({ password: pw });
    if (error) { msg("pwmsg", error.message, true); return; }
    msg("pwmsg", "Saved — this password now works in the app and here.");
    setTimeout(() => { show("pwreset", false); boot(); }, 1800);
  });

  // ── range helpers — every value against ITS OWN printed range ─────────
  function inRange(v: { value: number; ref_low?: number | null; ref_high?: number | null }): boolean | null {
    const lo = v.ref_low, hi = v.ref_high;
    if (lo == null && hi == null) return null;
    if (lo != null && v.value < lo) return false;
    if (hi != null && v.value > hi) return false;
    return true;
  }
  function rangeLabel(v: { ref_low?: number | null; ref_high?: number | null; ref_text?: string | null }): string {
    if (v.ref_text) return v.ref_text;
    if (v.ref_low != null && v.ref_high != null) return `${v.ref_low}–${v.ref_high}`;
    if (v.ref_high != null) return `<${v.ref_high}`;
    if (v.ref_low != null) return `>${v.ref_low}`;
    return "";
  }

  // ── grouping: section → canonical analyte → readings by date ──────────
  function groupLabs() {
    labSecs = new Map();
    for (const r of allLabs) {
      const s = SECTIONS[r.section] ? r.section : "other";
      const sec = labSecs.get(s) ?? labSecs.set(s, new Map()).get(s)!;
      const key = canonName(String(r.analyte));
      (sec.get(key) ?? sec.set(key, []).get(key)!).push(r);
    }
    if (!labSecs.has(labSection)) labSection = SECTION_ORDER.find((s) => labSecs.has(s)) ?? "";
  }

  // ═══ OVERVIEW ═══════════════════════════════════════════════════════════
  function renderOverview() {
    $("greet").textContent = greeting();

    const dates = [...new Set(allLabs.map((r) => r.measured_on))].sort();
    if (dates.length === 0) {
      $("greetsub").textContent = "Drop your first lab report and every value in it becomes a trend you keep.";
      show("worthwrap", false); show("latestcard", false);
      return;
    }
    const markers = [...labSecs.values()].reduce((n, m) => n + m.size, 0);
    $("greetsub").textContent =
      `${allLabs.length} values across ${dates.length} report date${dates.length === 1 ? "" : "s"} · ${markers} markers · ${fmtDay(dates[0])} → ${fmtDay(dates[dates.length - 1])}`;

    // Worth a look — latest reading out of its own range, worst first
    type Finding = { sec: string; name: string; latest: any; n: number; first: any; sev: number };
    const findings: Finding[] = [];
    let inCount = 0, judged = 0;
    for (const [sec, m] of labSecs) for (const [name2, rs] of m) {
      const latest = rs[rs.length - 1];
      const ok = inRange(latest);
      if (ok !== null) judged++;
      if (ok === true) inCount++;
      if (ok !== false) continue;
      const lo = latest.ref_low, hi = latest.ref_high;
      const width = lo != null && hi != null ? hi - lo : Math.abs(hi ?? lo ?? 1) || 1;
      const dist = lo != null && latest.value < lo ? lo - latest.value : latest.value - (hi ?? 0);
      findings.push({ sec, name: name2, latest, n: rs.length, first: rs[0], sev: dist / (width || 1) });
    }
    findings.sort((a, b) => b.sev - a.sev);
    const top = findings.slice(0, 4);

    show("worthwrap", true);
    const cards = top.map((f) => {
      const dir = f.latest.ref_low != null && f.latest.value < f.latest.ref_low ? "below" : "above";
      const trend = f.n > 1 ? `${f.first.value} → ${f.latest.value} across ${f.n} reports` : `from ${fmtDay(f.latest.measured_on)}`;
      return `
        <button data-worth="${esc(f.sec)}|${esc(f.name)}" class="rounded-2xl border border-warning/30 bg-warning/[0.05] p-4 text-left transition-colors hover:border-warning/60">
          <div class="flex items-baseline justify-between gap-2">
            <span class="min-w-0 truncate text-sm font-bold">${esc(f.name)}</span>
            <span class="shrink-0 font-mono text-[9px] uppercase tracking-wider text-text-tertiary">${esc(SECTIONS[f.sec])}</span>
          </div>
          <div class="mt-1 font-mono text-lg font-bold text-warning">${f.latest.value}${f.latest.unit ? ` <span class="text-xs font-semibold">${esc(f.latest.unit)}</span>` : ""}</div>
          <div class="mt-0.5 text-xs text-text-tertiary">${dir} the lab's range ${esc(rangeLabel(f.latest))} · ${esc(trend)}</div>
        </button>`;
    });
    if (judged > 0) cards.push(`
      <button data-goto="labs" class="rounded-2xl border border-success/25 bg-success/[0.05] p-4 text-left transition-colors hover:border-success/50">
        <div class="text-sm font-bold text-success">${inCount} of ${judged} markers in range</div>
        <div class="mt-1 text-xs text-text-tertiary">Latest reading of every marker, each judged against its own lab's printed range. Open Labs for all of them.</div>
      </button>`);
    $("worth").innerHTML = cards.join("");
    $("worth").querySelectorAll("[data-worth]").forEach((b) =>
      b.addEventListener("click", () => {
        const [sec, name3] = (b as HTMLElement).dataset.worth!.split("|");
        openMarker(sec, name3);
      }));

    // latest report card
    const lastDate = dates[dates.length - 1];
    const dayRows = allLabs.filter((r) => r.measured_on === lastDate);
    const flaggedN = dayRows.filter((r) => inRange(r) === false).length;
    const path = dayRows.map((r) => r.report_path).filter(Boolean).pop() ?? "";
    const repName = path ? path.split("/").pop()!.replace(/^\d+-/, "") : "";
    show("latestcard", true);
    $("latestcard").innerHTML = `
      <div class="flex flex-wrap items-center gap-3">
        <div class="min-w-0 flex-1">
          <div class="font-mono text-[10px] font-semibold uppercase tracking-widest text-text-tertiary">Latest report</div>
          <div class="mt-1 truncate text-sm font-bold">${esc(repName || fmtDay(lastDate))}</div>
          <div class="mt-0.5 text-xs text-text-tertiary">${fmtDay(lastDate)} · ${dayRows.length} values · ${flaggedN ? `<span class="text-warning">${flaggedN} out of range</span>` : `<span class="text-success">all in range</span>`}</div>
        </div>
        <button data-goto="labs" class="rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-secondary hover:border-white/25">Open in Labs</button>
        ${path ? `<button data-viewpath="${esc(path)}" class="rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-secondary hover:border-white/25">View PDF</button>` : ""}
      </div>`;
    const vp = $("latestcard").querySelector("[data-viewpath]");
    if (vp) vp.addEventListener("click", () => viewPdf((vp as HTMLElement).dataset.viewpath!));
    wireGoto();
  }

  function wireGoto() {
    document.querySelectorAll("[data-goto]").forEach((b) => {
      const el = b as HTMLElement;
      if (el.dataset.wired) return;
      el.dataset.wired = "1";
      el.addEventListener("click", () => setTab(el.dataset.goto!));
    });
  }

  /** Jump from Overview straight to one marker's chart. */
  function openMarker(sec: string, name: string) {
    labSection = sec;
    expandedAnalyte = name;
    mobileSectionOpen = true;
    setTab("labs");
    renderLabsRail(); renderLabsPanel();
  }

  // ═══ LABS ═══════════════════════════════════════════════════════════════
  function renderLabsRail() {
    const empty = allLabs.length === 0;
    show("labsempty", empty);
    if (empty) { $("labsrail").innerHTML = ""; $("labspanel").innerHTML = ""; $("labsspan").textContent = ""; wireGoto(); return; }
    const dates = [...new Set(allLabs.map((r) => r.measured_on))].sort();
    const fmt = (d: string) => new Date(d + "T00:00:00").toLocaleDateString(undefined, { month: "short", year: "2-digit" });
    $("labsspan").textContent = `${dates.length} REPORT DATE${dates.length === 1 ? "" : "S"} · ${fmt(dates[0])} → ${fmt(dates[dates.length - 1])}`;

    // phone: the section list IS the page until a section opens
    $("labsrail").className = `${mobileSectionOpen ? "hidden md:flex" : "flex"} flex-col gap-1.5 md:w-56 md:shrink-0`;
    $("labspanel").className = `${mobileSectionOpen ? "" : "hidden md:block"} min-w-0 flex-1 rounded-2xl border border-white/10 bg-white/[0.03] p-5`;

    $("labsrail").innerHTML = SECTION_ORDER.filter((s) => labSecs.has(s)).map((s) => {
      const analytes = [...labSecs.get(s)!.values()];
      const flagged = analytes.filter((rs) => inRange(rs[rs.length - 1]) === false).length;
      const on = s === labSection;
      return `
        <button data-sec="${s}" class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-left text-[13px] transition-colors ${on ? "bg-accent/15 font-bold text-text-primary" : "text-text-secondary hover:bg-white/[0.05]"}">
          <span class="flex-1">${SECTIONS[s]}</span>
          <span class="rounded-md ${flagged ? "bg-warning/15 text-warning" : "bg-white/[0.06] text-text-tertiary"} px-1.5 py-0.5 font-mono text-[9px] font-semibold tracking-wider">${analytes.length}${flagged ? ` · ${flagged}!` : ""}</span>
          <span class="text-text-muted md:hidden">›</span>
        </button>`;
    }).join("");
    $("labsrail").querySelectorAll("[data-sec]").forEach((b) =>
      b.addEventListener("click", () => {
        labSection = (b as HTMLElement).dataset.sec!;
        expandedAnalyte = "";
        mobileSectionOpen = true;
        renderLabsRail(); renderLabsPanel();
      }));
  }

  function renderLabsPanel() {
    const sec = labSecs.get(labSection);
    if (!sec) { $("labspanel").innerHTML = ""; return; }
    const analytes = [...sec.entries()];
    const flagged = analytes.filter(([, rs]) => inRange(rs[rs.length - 1]) === false).length;
    $("labspanel").innerHTML = `
      <button id="labsback" class="mb-2 flex items-center gap-1 text-sm font-semibold text-accent-light md:hidden">‹ All sections</button>
      <div class="flex flex-wrap items-baseline gap-3">
        <h3 class="text-base font-extrabold">${SECTIONS[labSection]}</h3>
        <span class="font-mono text-[10px] text-text-tertiary">${analytes.length} MARKER${analytes.length === 1 ? "" : "S"}</span>
        ${flagged ? `<span class="rounded-md bg-warning/15 px-2 py-0.5 font-mono text-[9px] tracking-wider text-warning">${flagged} OUT OF RANGE</span>` : ""}
      </div>
      <div class="mt-2 divide-y divide-white/[0.05]">
        ${analytes.map(([name, rs]) => labRow(name, rs)).join("")}
      </div>
      ${labSection === "imaging" && allImaging.length ? `
        <div class="mt-5 font-mono text-[10px] font-semibold uppercase tracking-widest text-text-tertiary">The reports' own conclusions</div>
        ${[...allImaging].reverse().map((im) => `
          <div class="mt-2 rounded-xl border border-white/[0.07] bg-white/[0.02] p-3">
            <div class="flex items-center gap-2">
              <span class="rounded-md bg-accent/15 px-1.5 py-0.5 font-mono text-[9px] font-semibold tracking-wider text-accent-light">${esc(String(im.modality).toUpperCase())}</span>
              <span class="font-mono text-[10px] text-text-tertiary">${fmtDay(im.report_date)}</span>
            </div>
            ${im.impression ? `<p class="mt-1.5 text-[13px] leading-5 text-text-secondary">${esc(im.impression)}</p>` : ""}
          </div>`).join("")}` : ""}`;
    $("labsback")?.addEventListener("click", () => {
      mobileSectionOpen = false;
      renderLabsRail(); renderLabsPanel();
    });
    $("labspanel").querySelectorAll("[data-an]").forEach((b) =>
      b.addEventListener("click", () => {
        const n = (b as HTMLElement).dataset.an!;
        expandedAnalyte = expandedAnalyte === n ? "" : n;
        renderLabsPanel();
        if (expandedAnalyte) $("labspanel").querySelector(`[data-an="${CSS.escape(n)}"]`)?.scrollIntoView({ block: "nearest" });
      }));
  }

  /** One analyte row; tapping it opens the full chart underneath. */
  function labRow(name: string, rs: any[]): string {
    const latest = rs[rs.length - 1];
    const ok = inRange(latest);
    const vals = rs.map((r) => Number(r.value));
    const lo = Math.min(...vals), hi = Math.max(...vals);
    const y = (v: number) => hi === lo ? 14 : 24 - ((v - lo) / (hi - lo)) * 20;
    const x = (i: number) => rs.length === 1 ? 60 : 6 + (i / (rs.length - 1)) * 108;
    const pts = vals.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(" ");
    const dots = vals.map((v, i) => {
      const own = inRange(rs[i]);
      return `<circle cx="${x(i).toFixed(1)}" cy="${y(v).toFixed(1)}" r="${i === vals.length - 1 ? 3.5 : 2.5}" fill="${own === false ? "#FBBF24" : "#818cf8"}"><title>${rs[i].measured_on}: ${v}</title></circle>`;
    }).join("");
    const valColor = ok === false ? "text-warning" : ok === true ? "text-success" : "text-text-primary";
    const open = expandedAnalyte === name;
    return `
      <div>
        <button data-an="${esc(name)}" class="flex w-full items-center gap-3 py-2 text-left">
          <span class="min-w-0 flex-1 truncate text-[13px] font-semibold text-text-primary" title="${esc(name)}">${esc(name)}</span>
          <svg class="hidden shrink-0 sm:block" width="120" height="28" viewBox="0 0 120 28">${rs.length > 1 ? `<polyline points="${pts}" fill="none" stroke="#818cf8" stroke-width="1.5" opacity="0.6"/>` : ""}${dots}</svg>
          <span class="shrink-0 whitespace-nowrap text-right font-mono text-xs ${valColor}">${latest.value}${latest.unit ? ` ${esc(latest.unit)}` : ""}</span>
          <span class="hidden w-24 shrink-0 truncate text-right font-mono text-[10px] text-text-muted sm:inline" title="${esc(rangeLabel(latest))}">${esc(rangeLabel(latest))}</span>
          <span class="text-text-muted">${open ? "▾" : "▸"}</span>
        </button>
        ${open ? bigChart(name, rs) : ""}
      </div>`;
  }

  /**
   * The app-grade chart: every reading judged against ITS OWN printed range
   * (the green band re-shades per report), a ◆ where a different lab's range
   * enters the series, and the unit guard — readings in a different unit
   * are listed, never mixed onto the line.
   */
  function bigChart(name: string, rsAll: any[]): string {
    const latestUnit = unitKey(rsAll[rsAll.length - 1].unit);
    const rs = rsAll.filter((r) => unitKey(r.unit) === latestUnit);
    const offLine = rsAll.filter((r) => unitKey(r.unit) !== latestUnit);

    const W = 640, H = 200, L = 46, R = 16, T = 20, B = 30;
    const vals = rs.map((r) => Number(r.value));
    const bounds = [...vals];
    for (const r of rs) {
      if (r.ref_low != null) bounds.push(Number(r.ref_low));
      if (r.ref_high != null) bounds.push(Number(r.ref_high));
    }
    let lo = Math.min(...bounds), hi = Math.max(...bounds);
    const pad = (hi - lo || Math.abs(hi) || 1) * 0.15;
    lo -= pad; hi += pad;
    const X = (i: number) => rs.length === 1 ? L + (W - L - R) / 2 : L + (i / (rs.length - 1)) * (W - L - R);
    const Y = (v: number) => T + (1 - (v - lo) / (hi - lo)) * (H - T - B);
    const midX = (i: number) => i < 0 ? L : i >= rs.length - 1 ? W - R : (X(i) + X(i + 1)) / 2;

    // ① band segments — each reading's own range shades its neighbourhood
    const bands = rs.map((r, i) => {
      if (r.ref_low == null && r.ref_high == null) return "";
      const yTop = Y(r.ref_high != null ? Number(r.ref_high) : hi);
      const yBot = Y(r.ref_low != null ? Number(r.ref_low) : lo);
      return `<rect x="${midX(i - 1).toFixed(1)}" y="${yTop.toFixed(1)}" width="${(midX(i) - midX(i - 1)).toFixed(1)}" height="${Math.max(0, yBot - yTop).toFixed(1)}" fill="#10B981" opacity="0.09"/>`;
    }).join("");

    // ② range-change diamonds
    const rk = (r: any) => `${r.ref_low ?? ""}|${r.ref_high ?? ""}`;
    let diamonds = "";
    const changes: string[] = [];
    for (let i = 1; i < rs.length; i++) {
      if (rk(rs[i]) !== rk(rs[i - 1])) {
        diamonds += `<g transform="translate(${X(i).toFixed(1)},${T - 8})"><rect x="-4.5" y="-4.5" width="9" height="9" transform="rotate(45)" fill="#818cf8"><title>Different lab range from ${fmtDay(rs[i].measured_on)}: ${rangeLabel(rs[i - 1]) || "none"} → ${rangeLabel(rs[i]) || "none"}</title></rect></g>`;
        changes.push(`${rangeLabel(rs[i - 1]) || "no range"} → ${rangeLabel(rs[i]) || "no range"} from ${fmtDay(rs[i].measured_on)}`);
      }
    }

    // ③ line, dots (own-range verdicts), axis
    const line = rs.length > 1
      ? `<polyline points="${vals.map((v, i) => `${X(i).toFixed(1)},${Y(v).toFixed(1)}`).join(" ")}" fill="none" stroke="#818cf8" stroke-width="2"/>` : "";
    const dots = rs.map((r, i) => {
      const own = inRange(r);
      const c = own === false ? "#FBBF24" : own === true ? "#34D399" : "#94A3B8";
      return `<circle cx="${X(i).toFixed(1)}" cy="${Y(Number(r.value)).toFixed(1)}" r="4" fill="${c}" stroke="#0B0F1A" stroke-width="1.5"><title>${fmtDay(r.measured_on)}: ${r.value}${r.unit ? " " + r.unit : ""} (range ${rangeLabel(r) || "—"})</title></circle>`;
    }).join("");
    const step = Math.max(1, Math.ceil(rs.length / 6));
    const xlabels = rs.map((r, i) => (i % step === 0 || i === rs.length - 1)
      ? `<text x="${X(i).toFixed(1)}" y="${H - 8}" text-anchor="middle" font-size="9" fill="#64748B" font-family="ui-monospace,monospace">${new Date(r.measured_on + "T00:00:00").toLocaleDateString(undefined, { month: "short", year: "2-digit" })}</text>` : "").join("");
    const ticks = [0.15, 0.5, 0.85].map((f) => {
      const v = lo + (hi - lo) * (1 - f);
      const yy = T + f * (H - T - B);
      return `<line x1="${L}" y1="${yy}" x2="${W - R}" y2="${yy}" stroke="#FFFFFF" opacity="0.05"/><text x="${L - 6}" y="${yy + 3}" text-anchor="end" font-size="9" fill="#64748B" font-family="ui-monospace,monospace">${Number(v.toPrecision(3))}</text>`;
    }).join("");

    const unitLabel = rs[rs.length - 1].unit ? esc(String(rs[rs.length - 1].unit)) : "";
    return `
      <div class="mb-3 rounded-xl border border-white/[0.07] bg-white/[0.02] p-3">
        <svg viewBox="0 0 ${W} ${H}" class="w-full">${ticks}${bands}${line}${dots}${diamonds}${xlabels}</svg>
        <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-[10px] text-text-tertiary">
          <span><span class="text-success">●</span> in its lab's range</span>
          <span><span class="text-warning">●</span> outside</span>
          <span class="opacity-80">▩ the printed range, per report${unitLabel ? ` · ${unitLabel}` : ""}</span>
        </div>
        ${changes.map((c) => `<div class="mt-1.5 text-[10px] font-semibold text-accent-light">◆ DIFFERENT LAB RANGE · ${esc(c)}</div>`).join("")}
        ${offLine.length ? `
          <div class="mt-1.5 text-[10px] font-semibold text-warning">⚠ UNIT CHANGED — ${offLine.length} earlier reading${offLine.length === 1 ? "" : "s"} in a different unit, listed below, not on this line</div>
          ${offLine.map((r) => `<div class="mt-0.5 font-mono text-[10px] text-text-tertiary">${fmtDay(r.measured_on)} · ${r.value}${r.unit ? " " + esc(r.unit) : ""} (range ${esc(rangeLabel(r) || "—")})</div>`).join("")}` : ""}
        <div class="mt-2 divide-y divide-white/[0.04]">
          ${[...rs].reverse().map((r) => {
            const own = inRange(r);
            return `<div class="flex items-baseline gap-3 py-1">
              <span class="w-24 font-mono text-[10px] text-text-tertiary">${fmtDay(r.measured_on)}</span>
              <span class="flex-1 font-mono text-xs ${own === false ? "text-warning" : own === true ? "text-success" : "text-text-primary"}">${r.value}${r.unit ? ` ${esc(r.unit)}` : ""}</span>
              <span class="font-mono text-[10px] text-text-muted">${esc(rangeLabel(r) || "no printed range")}</span>
            </div>`;
          }).join("")}
        </div>
      </div>`;
  }

  // ═══ REPORTS ═════════════════════════════════════════════════════════════
  async function renderReports() {
    const { data } = await supabase.storage.from("reports").list(userId, {
      sortBy: { column: "created_at", order: "desc" }, limit: 50,
    });
    const files = (data ?? []).filter((f) => f.name.toLowerCase().endsWith(".pdf"));

    // what each report yielded, from the one web_labs fetch
    const outcomes = new Map<string, { date: string; n: number; flagged: number }>();
    for (const r of allLabs) {
      if (!r.report_path) continue;
      const o = outcomes.get(r.report_path) ?? { date: r.measured_on, n: 0, flagged: 0 };
      o.n++; if (inRange(r) === false) o.flagged++;
      o.date = r.measured_on;
      outcomes.set(r.report_path, o);
    }

    const imagingByPath = new Map(allImaging.map((im) => [im.report_path, im]));
    $("repcards").innerHTML = files.map((f) => {
      const o = outcomes.get(`${userId}/${f.name}`);
      const im = imagingByPath.get(`${userId}/${f.name}`);
      const modChip = im ? `<span class="rounded-md bg-accent/15 px-2 py-0.5 font-mono text-[9px] font-semibold tracking-wider text-accent-light">${esc(String(im.modality).toUpperCase())}</span>` : "";
      const chips = modChip + (o
        ? `<span class="rounded-md bg-white/[0.06] px-2 py-0.5 font-mono text-[9px] font-semibold tracking-wider text-text-secondary">${o.n} VALUES</span>
           ${o.flagged ? `<span class="rounded-md bg-warning/15 px-2 py-0.5 font-mono text-[9px] font-semibold tracking-wider text-warning">${o.flagged} OUT OF RANGE</span>` : `<span class="rounded-md bg-success/15 px-2 py-0.5 font-mono text-[9px] font-semibold tracking-wider text-success">ALL IN RANGE</span>`}
           <span class="font-mono text-[9px] tracking-wider text-text-tertiary">${fmtDay(o.date).toUpperCase()}</span>`
        : `<span class="rounded-md bg-accent/15 px-2 py-0.5 font-mono text-[9px] font-semibold tracking-wider text-accent-light">NOT READ YET</span>`);
      return `
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
          <div class="flex items-center gap-3">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2" data-namewrap>
                <div class="truncate text-sm font-bold">${esc(f.name.replace(/^\d+-/, ""))}</div>
                <button data-ren="${esc(f.name)}" title="Rename" aria-label="Rename report" class="shrink-0 text-text-muted transition-colors hover:text-text-primary">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                </button>
              </div>
              <div class="mt-1 flex flex-wrap items-center gap-1.5">${chips}</div>
            </div>
          </div>
          <div class="mt-3 flex flex-wrap gap-2">
            <button data-parse="${esc(f.name)}" class="rounded-lg border border-accent/40 bg-accent/10 px-3 py-1.5 text-xs font-bold text-accent-light hover:bg-accent/20">${o ? "Read again" : "Read values"}</button>
            <button data-view="${esc(f.name)}" class="rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-secondary transition-colors hover:border-white/40 hover:bg-white/[0.07] hover:text-text-primary">View PDF</button>
            <button data-del="${esc(f.name)}" class="ml-auto rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-tertiary transition-colors hover:border-danger/50 hover:bg-danger/10 hover:text-danger">Delete</button>
          </div>
        </div>`;
    }).join("");

    $("repcards").querySelectorAll("[data-parse]").forEach((b) =>
      b.addEventListener("click", () => parseReport((b as HTMLElement).dataset.parse!)));
    $("repcards").querySelectorAll("[data-view]").forEach((b) =>
      b.addEventListener("click", () => viewPdf(`${userId}/${(b as HTMLElement).dataset.view}`)));
    $("repcards").querySelectorAll("[data-del]").forEach((b) =>
      b.addEventListener("click", async () => {
        await supabase.storage.from("reports").remove([`${userId}/${(b as HTMLElement).dataset.del}`]);
        renderReports();
      }));
    $("repcards").querySelectorAll("[data-ren]").forEach((b) =>
      b.addEventListener("click", () => renameUI(b as HTMLElement)));
  }

  async function viewPdf(path: string) {
    const { data: signed } = await supabase.storage.from("reports").createSignedUrl(path, 300);
    if (signed?.signedUrl) window.open(signed.signedUrl, "_blank");
  }

  /**
   * Rename a report. The filename IS the name — no separate label table to
   * drift out of sync — so a rename moves the stored PDF and re-points every
   * web_labs and imaging_reports row at the new path. The upload-time stamp
   * prefix is kept: it is what keeps two same-named uploads distinct.
   */
  async function renameReport(oldName: string, label: string) {
    const stamp = (oldName.match(/^(\d+)-/) ?? [, String(Date.now())])[1];
    const safe = label.trim().replace(/\.pdf$/i, "").replace(/[^\w.\- ]+/g, "").replace(/\s+/g, "_").slice(0, 80);
    if (!safe) { msg("upmsg", "Give the report a name first.", true); return; }
    const newName = `${stamp}-${safe}.pdf`;
    if (newName === oldName) { await renderReports(); return; }
    const oldPath = `${userId}/${oldName}`, newPath = `${userId}/${newName}`;
    const { error } = await supabase.storage.from("reports").move(oldPath, newPath);
    if (error) { msg("upmsg", `Could not rename: ${error.message}`, true); return; }
    const [{ error: e1 }, { error: e2 }] = await Promise.all([
      supabase.from("web_labs").update({ report_path: newPath }).eq("user_id", userId).eq("report_path", oldPath),
      supabase.from("imaging_reports").update({ report_path: newPath }).eq("user_id", userId).eq("report_path", oldPath),
    ]);
    if (e1 || e2) msg("upmsg", `Renamed, but some values still point at the old name (${(e1 ?? e2)!.message}).`, true);
    else msg("upmsg", "");
    await refresh();
  }

  function renameUI(btn: HTMLElement) {
    const name = btn.dataset.ren!;
    const wrap = btn.closest("[data-namewrap]") as HTMLElement;
    const current = name.replace(/^\d+-/, "").replace(/\.pdf$/i, "").replace(/_/g, " ");
    wrap.innerHTML = `
      <input data-reninput value="${esc(current)}" maxlength="80"
        class="w-full min-w-0 flex-1 rounded-lg border border-accent/50 bg-white/[0.04] px-2.5 py-1 text-sm font-bold text-text-primary focus:outline-none" />
      <button data-rensave class="shrink-0 rounded-lg bg-accent px-2.5 py-1 text-xs font-bold text-canvas">Save</button>
      <button data-rencancel class="shrink-0 rounded-lg border border-white/12 px-2.5 py-1 text-xs font-semibold text-text-secondary">Cancel</button>`;
    const input = wrap.querySelector("[data-reninput]") as HTMLInputElement;
    input.focus(); input.select();
    const save = () => renameReport(name, input.value);
    wrap.querySelector("[data-rensave]")!.addEventListener("click", save);
    wrap.querySelector("[data-rencancel]")!.addEventListener("click", () => renderReports());
    input.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Enter") save();
      if ((e as KeyboardEvent).key === "Escape") renderReports();
    });
  }

  // ── upload — drop several at once; one visible queue, files read one
  // after another so a failure in one never takes the others down ────────
  function qset(i: number, chip: string, tone: "wait" | "busy" | "ok" | "bad", caption: string) {
    const row = document.getElementById(`q-${i}`);
    if (!row) return;
    const tones = {
      wait: "bg-white/[0.06] text-text-tertiary",
      busy: "bg-accent/15 text-accent-light animate-pulse",
      ok: "bg-success/15 text-success",
      bad: "bg-danger/15 text-danger",
    };
    row.querySelector("[data-qchip]")!.className = `rounded-md px-2 py-0.5 font-mono text-[9px] font-semibold tracking-wider ${tones[tone]}`;
    row.querySelector("[data-qchip]")!.textContent = chip;
    row.querySelector("[data-qcap]")!.textContent = caption;
  }

  async function uploadBatch(files: File[]) {
    if (files.length === 0) return;
    setTab("reports");
    msg("upmsg", "");
    show("review", false); show("echoreview", false);

    show("upqueue", true);
    $("upqueue").classList.add("flex");
    $("upqueue").innerHTML = files.map((f, i) => `
      <div id="q-${i}" class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3">
        <div class="min-w-0 flex-1">
          <div class="truncate text-[13px] font-bold">${esc(f.name)}</div>
          <div data-qcap class="mt-0.5 text-[11px] text-text-tertiary">Waiting its turn</div>
        </div>
        <span data-qchip class="rounded-md bg-white/[0.06] px-2 py-0.5 font-mono text-[9px] font-semibold tracking-wider text-text-tertiary">QUEUED</span>
      </div>`).join("");

    let last: { name: string; out: any; path: string; filed: any } | null = null;
    let filedN = 0;
    for (let i = 0; i < files.length; i++) {
      const f = files[i];
      if (f.type !== "application/pdf") { qset(i, "SKIPPED", "bad", "Not a PDF"); continue; }
      if (f.size > 15 * 1024 * 1024) { qset(i, "SKIPPED", "bad", "Over 15 MB"); continue; }

      qset(i, "UPLOADING…", "busy", "Saving the original to your private archive");
      const path = `${userId}/${Date.now()}-${f.name.replace(/[^\w.\-]+/g, "_")}`;
      const { error } = await supabase.storage.from("reports").upload(path, f, { contentType: "application/pdf" });
      if (error) { qset(i, "FAILED", "bad", error.message); continue; }

      qset(i, "READING…", "busy", "Verve is reading every value and its printed range — about 20 seconds");
      let out: any;
      try { out = await readReport(path.split("/")[1]); }
      catch (e: any) { qset(i, "FAILED", "bad", e.message ?? "Could not read this report"); continue; }

      if (out.doc_type === "echo") {
        const filed = await archiveEcho(out, path);
        qset(i, "FILED ✓", "ok", `Echo report · ${filed.values.length} measurements → Labs · Imaging`);
        filedN++; last = { name: f.name, out, path, filed };
      } else if (out.doc_type === "other") {
        qset(i, "ARCHIVED", "ok", `Read as: ${out.kind ?? "a medical document"} — kept as a PDF; its type is on the roadmap`);
      } else {
        const filed = await archiveLab(out, path);
        qset(i, "FILED ✓", "ok", `${filed.allValues.length} values → Labs · ${filed.fresh.length} new on your trends`);
        filedN++; last = { name: f.name, out, path, filed };
      }
    }

    await refresh();
    // the review opens once, for the last report that filed — every other
    // file's values are already on the Labs tab regardless
    if (last) {
      if (last.out.doc_type === "echo") renderEchoReview(last.out, last.path, last.name);
      else await renderLabReview(last.out, last.path, last.name, last.filed);
      if (files.length > 1) msg("upmsg", `${filedN} of ${files.length} reports filed — reviewing the last one below. Any card's "Read again" reopens its review.`);
    }
  }

  $("file").addEventListener("change", () => {
    const fs = Array.from(($("file") as HTMLInputElement).files ?? []);
    ($("file") as HTMLInputElement).value = "";
    if (fs.length) uploadBatch(fs);
  });
  ["dragover", "dragenter"].forEach((ev) => document.addEventListener(ev, (e) => {
    if (!userId) return;
    e.preventDefault();
    $("drop").classList.add("border-accent", "bg-accent/10");
  }));
  ["dragleave", "drop"].forEach((ev) => document.addEventListener(ev, (e) => {
    if (!userId) return;
    e.preventDefault();
    $("drop").classList.remove("border-accent", "bg-accent/10");
  }));
  document.addEventListener("drop", (e) => {
    if (!userId) return;
    const fs = Array.from((e as DragEvent).dataTransfer?.files ?? []);
    if (fs.length) uploadBatch(fs);
  });

  // ── the pipeline: read (the edge function) → file (the archive writes)
  // → review (DOM only). The batch queue and the Read values button share
  // every stage instead of each doing it their own way. ──────────────────

  /** Call the parser. Throws with a user-facing message on any failure. */
  async function readReport(name: string): Promise<any> {
    const { data: { session } } = await supabase.auth.getSession();
    const resp = await fetch(`${SUPABASE_URL}/functions/v1/report-parser`, {
      method: "POST",
      headers: { "content-type": "application/json", authorization: `Bearer ${session?.access_token}`, apikey: SUPABASE_ANON_KEY },
      body: JSON.stringify({ path: `${userId}/${name}` }),
    });
    const out = await resp.json().catch(() => ({ error: "Unreadable response" }));
    if (!resp.ok || out.error) {
      throw new Error(
        out.error === "not_a_lab_report" || out.error === "not_a_medical_report" ? "That file doesn't look like a medical report." :
        out.error === "report_too_dense" ? (out.detail ?? "The report is too long to read in one go.") :
        out.error === "subscription_required" ? (out.detail ?? "Your free reports are used — a subscription keeps the drop zone open.") :
        `Could not read it${out.detail ? ` — ${out.detail}` : `: ${out.error ?? resp.status}`}`);
    }
    return out;
  }

  /** Single-file path — the cards' Read values button. */
  async function parseReport(name: string) {
    setTab("reports");
    msg("upmsg", "Reading the report — this takes a few seconds…");
    show("review", false); show("echoreview", false);
    const btns = Array.from($("repcards").querySelectorAll("[data-parse]")) as HTMLButtonElement[];
    btns.forEach((b) => { b.disabled = true; if (b.dataset.parse === name) b.textContent = "Reading…"; });
    let out: any;
    try { out = await readReport(name); }
    catch (e: any) {
      btns.forEach((b) => { b.disabled = false; if (b.dataset.parse === name) b.textContent = "Read values"; });
      msg("upmsg", e.message ?? "Could not read this report", true);
      return;
    }
    btns.forEach((b) => { b.disabled = false; if (b.dataset.parse === name) b.textContent = "Read values"; });
    msg("upmsg", "");
    const path = `${userId}/${name}`;
    if (out.doc_type === "echo") {
      await archiveEcho(out, path);
      renderEchoReview(out, path, name);
      await refresh();
      return;
    }
    if (out.doc_type === "other") {
      msg("upmsg", `Read as: ${out.kind ?? "a medical document"}. Verve files echo reports and lab panels today — this PDF stays safe in your archive, and its type is on the roadmap.`);
      return;
    }
    const filed = await archiveLab(out, path);
    await refresh();
    await renderLabReview(out, path, name, filed);
  }

  /** Archive a lab report's values — the writes, no DOM. */
  async function archiveLab(out: any, path: string) {
    const date = out.report_date ?? new Date().toISOString().slice(0, 10);
    const appValues = (out.values ?? []).filter((v: any) => LABELS[v.key] && Number.isFinite(v.value));
    const allValues = (out.all_values ?? [])
      .filter((v: any) => typeof v?.name === "string" && Number.isFinite(v?.value))
      .map((v: any) => ({ ...v, name: canonName(v.name) }));

    // ① EVERYTHING → the website's own archive, deduped against what is
    // already there (same canonical analyte + date + value). The unique
    // index in the database is the backstop.
    const { data: existing } = await supabase.from("web_labs")
      .select("analyte, value").eq("user_id", userId).eq("measured_on", date);
    const have = new Set((existing ?? []).map((r) => `${canonName(String(r.analyte)).toLowerCase()}|${r.value}`));
    const fresh = allValues.filter((v: any) => !have.has(`${v.name.toLowerCase()}|${v.value}`));
    if (fresh.length > 0) {
      await supabase.from("web_labs").insert(fresh.map((v: any) => ({
        id: crypto.randomUUID(), user_id: userId,
        analyte: v.name, value: v.value, unit: v.unit ?? null,
        ref_low: Number.isFinite(v.ref_low) ? v.ref_low : null,
        ref_high: Number.isFinite(v.ref_high) ? v.ref_high : null,
        ref_text: v.ref_text ?? null,
        section: SECTIONS[v.section] ? v.section : "other",
        measured_on: date, report_path: path,
      })));
    }

    // ② the app tier. Same date + same value = a duplicate, never sent.
    // Same value on a NEARBY date (±7 days) is the hand-entered-then-uploaded
    // case — the row a user typed on Aug 1 from a Jul 31 report — so those
    // start UNTICKED with a note, and the user decides.
    const day0 = new Date(date + "T00:00:00").getTime();
    const winStart = new Date(day0 - 7 * 86400000).toISOString();
    const winEnd = new Date(day0 + 8 * 86400000).toISOString();
    const { data: appExisting } = await supabase.from("lab_readings")
      .select("*").eq("user_id", userId).gte("measured_at", winStart).lt("measured_at", winEnd).is("deleted_at", null);
    const dupKeys = new Set<string>();
    const nearDays = new Map<string, number>();
    for (const v of appValues) {
      for (const r of appExisting ?? []) {
        if (Number(r[v.key]) !== v.value) continue;
        const dd = Math.round((new Date(r.measured_at).getTime() - day0) / 86400000);
        if (dd === 0) { dupKeys.add(v.key); nearDays.delete(v.key); break; }
        const prev = nearDays.get(v.key);
        if (prev == null || Math.abs(dd) < Math.abs(prev)) nearDays.set(v.key, dd);
      }
    }
    return { date, appValues, allValues, fresh, dupKeys, nearDays };
  }

  /** The two-tier review — DOM only; `filed` comes from archiveLab. */
  async function renderLabReview(out: any, path: string, name: string,
    filed: { date: string; appValues: any[]; allValues: any[]; fresh: any[]; dupKeys: Set<string>; nearDays: Map<string, number> }) {
    const { date, appValues, allValues, fresh, dupKeys, nearDays } = filed;
    parsed = { path, lpa_unit: out.lpa_unit ?? null, dupKeys };
    $("rvtitle").textContent = name.replace(/^\d+-/, "");
    $("rvcount").textContent = `${allValues.length} VALUES READ`;
    ($("rvdate") as HTMLInputElement).value = date;

    // tier 1 rows — duplicates struck through, excluded from the send
    $("rvapp").innerHTML = appValues.map((v: any) => {
      const meta = LABELS[v.key];
      const unit = v.key === "lpa_value" ? (out.lpa_unit ?? v.unit ?? "") : meta.unit;
      if (dupKeys.has(v.key)) return `
        <div class="flex items-center gap-3 py-2 opacity-50">
          <span class="w-20 font-mono text-[10px] uppercase tracking-wider text-text-tertiary">${meta.section}</span>
          <span class="flex-1 text-sm font-semibold line-through">${esc(meta.label)} · ${v.value} ${esc(unit)}</span>
          <span class="rounded-md bg-white/[0.06] px-2 py-0.5 font-mono text-[9px] tracking-wider text-text-tertiary">ALREADY IN YOUR APP</span>
        </div>`;
      const near = nearDays.get(v.key);
      const nearChip = near != null
        ? `<span class="rounded-md bg-warning/15 px-2 py-0.5 font-mono text-[9px] tracking-wider text-warning" title="Your app already holds this exact value on a date ${Math.abs(near)} day${Math.abs(near) === 1 ? "" : "s"} ${near > 0 ? "after" : "before"} this report — likely the same lab, entered by hand. Tick to send anyway.">SAME VALUE ${Math.abs(near)}D AWAY</span>`
        : "";
      return `
        <div class="flex items-center gap-3 py-2">
          <span class="w-20 font-mono text-[10px] uppercase tracking-wider text-text-tertiary">${meta.section}</span>
          <span class="min-w-0 flex-1 text-sm font-semibold">${esc(meta.label)} ${nearChip}</span>
          <input data-key="${v.key}" type="number" step="any" value="${v.value}"
            class="w-28 rounded-lg border border-white/12 bg-white/[0.04] px-3 py-1.5 text-right font-mono text-sm text-text-primary focus:border-accent focus:outline-none" />
          <span class="w-14 text-xs text-text-tertiary">${esc(unit)}</span>
          <input data-drop="${v.key}" type="checkbox" ${near != null ? "" : "checked"} title="${near != null ? "Unticked — the same value sits nearby in your app; tick to send anyway" : "Untick to leave this value out"}" class="h-4 w-4 accent-[#818cf8]" />
        </div>`;
    }).join("") || `<p class="py-2 text-sm text-text-tertiary">None of the app's markers were in this report.</p>`;

    const sendable = appValues.filter((v: any) => !dupKeys.has(v.key) && nearDays.get(v.key) == null).length;
    const nearOnly = sendable === 0 && [...nearDays.keys()].some((k) => !dupKeys.has(k));
    $("confirm").textContent = sendable > 0
      ? `Send ${sendable} value${sendable === 1 ? "" : "s"} to the app →`
      : nearOnly ? "Send ticked values →" : "Nothing new to send";
    ($("confirm") as HTMLButtonElement).disabled = sendable === 0 && !nearOnly;

    // tier 2 — grouped by section, each value against its lab's own range
    const webOnly = allValues.filter((v: any) => !["metabolic", "heart", "muscle"].includes(v.section));
    const bySec = new Map<string, any[]>();
    for (const v of webOnly) {
      const s = SECTIONS[v.section] ? v.section : "other";
      (bySec.get(s) ?? bySec.set(s, []).get(s)!).push(v);
    }
    $("rvwebnote").textContent =
      `${webOnly.length} values · ${fresh.length} new saved to your dashboard${allValues.length - fresh.length > 0 ? ` · ${allValues.length - fresh.length} already there` : ""}`;
    $("rvweb").innerHTML = SECTION_ORDER.filter((s) => bySec.has(s)).map((s) => `
      <div class="mt-3 font-mono text-[10px] uppercase tracking-widest text-text-tertiary">${SECTIONS[s]}</div>
      <div class="divide-y divide-white/[0.05]">
        ${bySec.get(s)!.map((v: any) => `
          <div class="flex items-baseline gap-3 py-1.5">
            <span class="flex-1 text-[13px] text-text-primary">${esc(v.name)}</span>
            <span class="font-mono text-xs ${inRange(v) === false ? "text-warning" : "text-success"}">${v.value}${v.unit ? ` ${esc(v.unit)}` : ""}</span>
            <span class="w-24 text-right font-mono text-[10px] text-text-muted">${esc(rangeLabel(v))}</span>
          </div>`).join("")}
      </div>`).join("");

    show("review", true);
    $("review").classList.add("flex");
  }

  /**
   * An echo report: the numeric parameters become web_labs rows (section
   * "imaging" — trendable like any analyte, judged ONLY against ranges the
   * report itself printed), and the doctor's impression + per-structure
   * findings go to imaging_reports VERBATIM. Numbers and prose never mix.
   */
  /** An echo's numeric parameters, canonical-named — shared by both halves. */
  function echoValues(out: any): any[] {
    return (out.echo_values ?? [])
      .filter((v: any) => typeof v?.name === "string" && Number.isFinite(v?.value))
      .map((v: any) => ({ ...v, name: canonName(v.name) }));
  }

  async function archiveEcho(out: any, path: string) {
    const date = out.report_date ?? new Date().toISOString().slice(0, 10);
    const values = echoValues(out);

    // dedup + archive, same contract as lab analytes
    const { data: existing } = await supabase.from("web_labs")
      .select("analyte, value").eq("user_id", userId).eq("measured_on", date);
    const have = new Set((existing ?? []).map((r) => `${canonName(String(r.analyte)).toLowerCase()}|${r.value}`));
    const fresh = values.filter((v: any) => !have.has(`${v.name.toLowerCase()}|${v.value}`));
    if (fresh.length > 0) {
      await supabase.from("web_labs").insert(fresh.map((v: any) => ({
        id: crypto.randomUUID(), user_id: userId,
        analyte: v.name, value: v.value, unit: v.unit ?? null,
        ref_low: Number.isFinite(v.ref_low) ? v.ref_low : null,
        ref_high: Number.isFinite(v.ref_high) ? v.ref_high : null,
        ref_text: v.ref_text ?? null,
        section: "imaging", measured_on: date, report_path: path,
      })));
    }

    // one narrative row per PDF — re-reading replaces, never stacks
    const { error: imgErr } = await supabase.from("imaging_reports").upsert({
      id: crypto.randomUUID(), user_id: userId, modality: "echo",
      report_date: date, report_path: path,
      impression: out.impression ?? null, findings: out.findings ?? null,
    }, { onConflict: "user_id,report_path" });
    if (imgErr) { msg("upmsg", `Could not save the report's narrative: ${imgErr.message}`, true); }
    return { date, values };
  }

  /** The echo review — DOM only; the writes happened in archiveEcho. */
  function renderEchoReview(out: any, path: string, name: string) {
    const date = out.report_date ?? new Date().toISOString().slice(0, 10);
    const values = echoValues(out);
    const findings = Array.isArray(out.findings) ? out.findings : [];
    $("echoreview").innerHTML = `
      <div class="flex flex-wrap items-center gap-3">
        <h2 class="text-base font-extrabold">${esc(name.replace(/^\d+-/, ""))}</h2>
        <span class="rounded-md bg-accent/15 px-2 py-0.5 font-mono text-[10px] font-semibold tracking-wider text-accent-light">ECHO REPORT</span>
        <span class="font-mono text-[10px] tracking-wider text-text-tertiary">${fmtDay(date).toUpperCase()}</span>
      </div>
      ${values.length ? `
        <div class="mt-3 font-mono text-[10px] font-semibold uppercase tracking-widest text-text-tertiary">Measurements → Labs · Imaging</div>
        <div class="mt-1 divide-y divide-white/[0.05]">
          ${values.map((v: any) => `
            <div class="flex items-baseline gap-3 py-1.5">
              <span class="flex-1 text-[13px] text-text-primary">${esc(v.name)}</span>
              <span class="font-mono text-xs ${inRange(v) === false ? "text-warning" : inRange(v) === true ? "text-success" : "text-text-primary"}">${v.value}${v.unit ? ` ${esc(v.unit)}` : ""}</span>
              <span class="w-24 text-right font-mono text-[10px] text-text-muted">${esc(rangeLabel(v))}</span>
            </div>`).join("")}
        </div>` : ""}
      ${out.impression ? `
        <div class="mt-4 font-mono text-[10px] font-semibold uppercase tracking-widest text-text-tertiary">Impression — the report's own words</div>
        <p class="mt-1 rounded-xl border border-white/[0.07] bg-white/[0.02] p-3 text-sm leading-6 text-text-secondary">${esc(out.impression)}</p>` : ""}
      ${findings.length ? `
        <div class="mt-4 font-mono text-[10px] font-semibold uppercase tracking-widest text-text-tertiary">Findings</div>
        <div class="mt-1 divide-y divide-white/[0.05]">
          ${findings.map((f: any) => `
            <div class="flex gap-3 py-1.5 text-[13px]">
              <span class="w-32 shrink-0 font-semibold text-text-primary">${esc(String(f.structure ?? ""))}</span>
              <span class="text-text-secondary">${esc(String(f.statement ?? ""))}</span>
            </div>`).join("")}
        </div>` : ""}
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button id="echoclose" class="rounded-xl border border-white/14 px-4 py-2.5 text-sm font-semibold text-text-secondary transition-colors hover:border-white/25">Close</button>
        <span class="text-xs text-text-muted">Numbers are read from the report's printed text — never measured from images. Ranges shown only when the report prints them.</span>
      </div>`;
    show("echoreview", true);
    $("echoclose").addEventListener("click", () => show("echoreview", false));
  }

  // ── send the app tier → lab_readings, the app's own table ──────────────
  $("discard").addEventListener("click", () => { show("review", false); $("review").classList.remove("flex"); parsed = null; });

  $("confirm").addEventListener("click", async () => {
    if (!parsed) return;
    const btn = $("confirm") as HTMLButtonElement;
    if (btn.disabled) return;
    btn.disabled = true;   // a double-click was how one report sent twice
    const reEnable = () => { btn.disabled = false; };
    const date = ($("rvdate") as HTMLInputElement).value;
    if (!date) { msg("rvmsg", "Set the report date first.", true); reEnable(); return; }

    const bySection: Record<string, Record<string, number | string>> = {};
    $("rvapp").querySelectorAll("[data-key]").forEach((input) => {
      const key = (input as HTMLElement).dataset.key!;
      const keep = ($("rvapp").querySelector(`[data-drop="${key}"]`) as HTMLInputElement)?.checked;
      const v = parseFloat((input as HTMLInputElement).value);
      if (!keep || !Number.isFinite(v) || parsed!.dupKeys.has(key)) return;
      const section = LABELS[key].section;
      (bySection[section] ??= {})[key] = v;
    });

    if (bySection.heart?.lpa_value != null && parsed.lpa_unit) bySection.heart.lpa_unit = parsed.lpa_unit;
    const m = bySection.metabolic;
    if (m && typeof m.glucose_mgdl === "number" && typeof m.fasting_insulin_uiuml === "number") {
      m.homa_ir = Math.round((m.glucose_mgdl * m.fasting_insulin_uiuml) / 405 * 100) / 100;
    }

    if (Object.keys(bySection).length === 0) { msg("rvmsg", "Nothing ticked to send.", true); reEnable(); return; }

    // Freshly re-check the app's same-date rows RIGHT before inserting —
    // the parse-time check can be minutes stale by the time this is tapped.
    const ckStart = new Date(date + "T00:00:00").toISOString();
    const ckEnd = new Date(new Date(date + "T00:00:00").getTime() + 86400000).toISOString();
    const { data: nowThere } = await supabase.from("lab_readings")
      .select("*").eq("user_id", userId).gte("measured_at", ckStart).lt("measured_at", ckEnd).is("deleted_at", null);
    for (const [section, cols] of Object.entries(bySection)) {
      for (const [k, v] of Object.entries(cols)) {
        if (typeof v === "number" && (nowThere ?? []).some((r: any) => Number(r[k]) === v)) delete cols[k];
      }
      if (Object.keys(cols).length === 0) delete bySection[section];
    }

    const now = new Date().toISOString();
    const measuredAt = new Date(date + "T09:00:00").toISOString();
    const rows = Object.entries(bySection).map(([section, cols]) => ({
      id: crypto.randomUUID(), user_id: userId, source: section,
      measured_at: measuredAt, updated_at: now, ...cols,
    }));
    if (rows.length === 0) { msg("rvmsg", "Nothing new to send — these values are already in your app.", true); reEnable(); return; }

    const { error } = await supabase.from("lab_readings").insert(rows);
    if (error) { msg("rvmsg", `Could not send: ${error.message}`, true); reEnable(); return; }
    msg("rvmsg", "Sent. Open the Verve app and these values will be there.");
    ($("confirm") as HTMLButtonElement).disabled = true;
    $("confirm").textContent = "Sent to the app ✓";
  });

  boot();
  supabase.auth.onAuthStateChange((event) => {
    // A reset link lands with a recovery session: show the new-password card
    // instead of dropping the user on the dashboard mid-reset.
    if (event === "PASSWORD_RECOVERY") {
      show("loading", false); show("auth", false); show("home", false);
      show("pwreset", true);
      return;
    }
    boot();
  });
</script>
