          ${fat || musc ? `<div class="text-[13px] leading-relaxed text-text-secondary">${fat ? `Body fat <strong class="text-text-primary">${fat.v}%</strong>` : ""}${fat && musc ? " · " : ""}${musc ? `muscle mass <strong class="text-text-primary">${musc.v}%</strong>` : ""}${method ? ` · ${esc(String(method).toUpperCase())}` : ""}, ${esc(fmtDay((fat ?? musc)!.d))}</div>` : ""}
        </div>
