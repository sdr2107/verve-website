          </div>
        </div>
        ${dr ? `
        <div class="mt-4 flex flex-wrap items-end justify-between gap-3">
          <div class="flex items-baseline gap-2.5"><span class="font-mono text-[38px] font-bold leading-none" style="color: ${open.color}">${dr.headline}</span><span class="text-[13.5px] text-text-secondary">${dr.caption}</span></div>
          <div class="flex flex-wrap gap-4 text-[12px] text-text-secondary">
            ${band ? `<span><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-sm border border-success/50 bg-success/20 align-[-1px]"></span>${esc(band.why)}</span>` : ""}
            ${openRange === "week" && open.goal?.() ? `<span><span class="mr-1.5 inline-block h-0.5 w-3 bg-accent-light align-[3px]"></span>the week's running total, against the goal</span>` : ""}
          </div>
        </div>
        <div class="mt-2 overflow-x-auto"><svg viewBox="0 0 820 200" class="block h-auto w-full min-w-[560px]" role="img" aria-label="${esc(open.label)}, ${RANGE_LABEL[openRange as Rng].toLowerCase()} view">${chartSvg(open, openRange as Rng, dr)}</svg></div>` : `<p class="mt-4 text-[13px] text-text-tertiary">Nothing read yet for ${esc(open.label.toLowerCase())}.${open.section === "heart" || open.key === "steps" ? " The app sends it on every sync once Apple Health is on." : ""}</p>`}
        <div class="mt-4 grid gap-4 border-t border-white/[0.07] pt-4 lg:grid-cols-2">
