  const PRESETS: Record<string, string[]> = { coach: ["activity", "body", "heart"], clinician: ["labs", "imaging", "body", "heart"] };
  $("shareform").querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((b) => b.addEventListener("click", () => {
