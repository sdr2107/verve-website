---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<!--
  My health — the website's signed-in corner, in three tabs. Signed out,
  it says what the page is for before it asks for a password.

  · Overview — a greeting, the handful of findings worth a look, the latest
    report, and a slim drop bar. The answer-at-a-glance page.
  · Labs — every value from every report, section rail on the left, one
    section at a time on the right. A row expands into the full chart:
    band-shaded by each reading's OWN printed range, a diamond where a
    different lab's range enters the series, and readings in a different
    unit never share the line.
  · Reports — the drop zone and the archive: one card per original PDF
    with what came out of it. Review-and-send lives here too.

  The standing rules: app-bound markers go to lab_readings only on the
  user's explicit send, deduped; EVERYTHING parsed lands in web_labs with
  the lab's own printed range (a unique index backs the dedup); analyte
  names are canonicalised by lib/canon.js so "SGPT (ALT)" and "ALT" share
  one trend line; nothing is ever discarded.
-->

<Layout
  title="My health — Verve"
  description="Sign in with your Verve account, drop old lab reports, and their values file themselves into your app and your own lab dashboard."
  cardType="summary"
>
  <SiteHeader current="my-health">
    <!-- Signed in, Sign out takes the app button's place; the greeting is
         the page's heading, not a header ornament. Hidden until a session
         is found. -->
    <button
      slot="extra"
      id="signout"
      class="hidden rounded-full border border-white/14 px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:border-white/25"
    >Sign out</button>
  </SiteHeader>

  <main class="vrv-glow relative mx-auto max-w-6xl px-6 pb-24 sm:px-10">

    <!-- ── signed out: what My health is for, then the way in ────────────
         The page says why you would sign in before it asks you to: three
         lines on the left, one card on the right with one primary action.
         Every id the script wires is kept. ───────────────────────────── -->
    <section id="auth" class="mt-4 hidden max-w-[1120px] lg:mt-8">
      <!-- The grid lives on an inner div, not on #auth: the script hides
           #auth by adding `hidden`, and a responsive display class on the
           same element (`lg:grid`) would win over it on a desktop — which
           is how the sign-in card stayed on screen after signing in. -->
      <div class="gap-10 lg:grid lg:grid-cols-[minmax(0,1.1fr)_440px] lg:items-center lg:gap-16">
      <div class="flex flex-col gap-4 lg:gap-[22px]">
        <span class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-accent-light">My health</span>
        <h1 class="text-[30px] font-bold leading-[1.1] tracking-[-0.025em] text-text-primary sm:text-[46px] sm:leading-[1.06] sm:tracking-[-0.03em]">
          Your lab reports, read and filed for you.
        </h1>
        <p class="max-w-[520px] text-[14.5px] leading-[1.6] text-text-secondary sm:text-base sm:leading-[1.65]">
          Drop a PDF from any lab. Verve reads every value, sends the markers
          the app tracks to your phone on one tap, and keeps the rest charted
          here.
        </p>
        <ul class="mt-1 hidden flex-col gap-3.5 lg:flex">
          <li class="flex items-start gap-3.5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] bg-accent/[0.14]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg>
            </span>
            <span>
              <span class="block text-[15px] font-semibold text-text-primary">Drop a report</span>
              <span class="block text-[13px] leading-relaxed text-text-tertiary">Any lab, any year. Imaging reports too.</span>
            </span>
          </li>
          <li class="flex items-start gap-3.5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] bg-success/[0.12]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4 4L19 7" /></svg>
            </span>
            <span>
              <span class="block text-[15px] font-semibold text-text-primary">Every value read</span>
              <span class="block text-[13px] leading-relaxed text-text-tertiary">Everything parsed is charted here; you check the app-bound values before they are sent.</span>
            </span>
          </li>
          <li class="flex items-start gap-3.5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] bg-warning/[0.12]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FBBF24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2" /><path d="M11 18h2" /></svg>
            </span>
            <span>
              <span class="block text-[15px] font-semibold text-text-primary">The app&rsquo;s markers go to your phone</span>
              <span class="block text-[13px] leading-relaxed text-text-tertiary">Everything else stays charted here, with its own history.</span>
            </span>
          </li>
        </ul>
        <p class="hidden text-[13px] text-text-tertiary lg:block">The login is the one you use in the app.</p>
      </div>

      <!-- the card: one primary action, the alternative under a rule -->
      <div class="mt-6 rounded-[20px] border border-white/10 bg-white/[0.03] p-5 sm:p-7 lg:mt-0">
        <div class="flex w-full gap-1 rounded-full border border-white/10 bg-white/[0.04] p-1 sm:w-fit">
          <button type="button" data-mode="signin" class="min-h-10 flex-1 rounded-full px-4 py-1.5 text-[13px] font-bold sm:flex-none">Sign in</button>
          <button type="button" data-mode="signup" class="min-h-10 flex-1 rounded-full px-4 py-1.5 text-[13px] font-semibold sm:flex-none">Create account</button>
        </div>
        <p id="modenote" class="mt-3 hidden text-sm leading-relaxed text-text-secondary"></p>

        <form id="pwform" class="mt-4 flex flex-col gap-4">
          <div>
            <label for="email" class="mb-1.5 block text-xs font-semibold text-text-secondary">Email</label>
            <input id="email" type="email" required placeholder="you@example.com" autocomplete="email"
              class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-3 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none sm:text-sm" />
          </div>
          <div>
            <div class="mb-1.5 flex items-baseline justify-between">
              <label for="password" class="text-xs font-semibold text-text-secondary">Password</label>
              <button type="button" id="forgot" class="text-xs font-medium text-accent-light hover:underline">Forgot?</button>
            </div>
            <div class="relative">
              <input id="password" type="password" placeholder="Password" autocomplete="current-password"
                class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-3.5 py-3 pr-12 text-[15px] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none sm:text-sm" />
              <button type="button" data-eye="password" aria-label="Show password"
                class="absolute inset-y-0 right-0 flex w-12 items-center justify-center text-text-tertiary hover:text-text-primary">
                <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>
          <button type="submit" id="authsubmit"
            class="min-h-11 rounded-xl bg-accent px-4 py-3 text-sm font-bold text-canvas transition-opacity hover:opacity-90">
            Sign in
          </button>
        </form>

        <div id="ordiv" class="mt-4 flex items-center gap-3">
          <div class="h-px flex-1 bg-white/10"></div>
          <span class="text-xs text-text-muted">or</span>
          <div class="h-px flex-1 bg-white/10"></div>
        </div>

        <button id="magic"
          class="mt-4 min-h-11 w-full rounded-xl border border-white/14 px-4 py-3 text-sm font-semibold text-text-primary transition-colors hover:border-white/25">
          Email me a code
        </button>
        <p id="applenote" class="mt-3 text-xs leading-relaxed text-text-tertiary">
          A six-digit code you can type on any device, so a code read on your phone
          signs you in on your Mac. Signed up with Apple? The code goes to the
          address on your Apple ID.
        </p>

        <!-- ── the code step: the card flips to this once the email is sent ── -->
        <div id="codestep" class="hidden">
          <span class="font-mono text-[10.5px] font-semibold uppercase tracking-[0.14em] text-accent-light">Check your email</span>
          <h2 class="mt-2 text-[22px] font-bold tracking-[-0.02em] text-text-primary">Enter the six-digit code</h2>
          <p class="mt-2 text-[13px] leading-relaxed text-text-secondary">
            Sent to <strong id="codeto" class="font-semibold text-text-primary"></strong>. It works on any device: read it on your phone, type it here.
          </p>
          <form id="codeform" class="mt-4 flex flex-col gap-4">
            <label for="code" class="sr-only">Six-digit code</label>
            <input id="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" placeholder="000000"
              class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-4 py-3 text-center font-mono text-[28px] font-bold tracking-[0.35em] text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none" />
            <button type="submit" id="verify"
              class="min-h-11 rounded-xl bg-accent px-4 py-3 text-sm font-bold text-canvas transition-opacity hover:opacity-90 disabled:opacity-50">
              Sign in
            </button>
          </form>
          <div class="mt-3 flex items-center justify-between gap-3">
            <button type="button" id="resend" class="text-xs font-medium text-text-tertiary hover:text-text-primary disabled:hover:text-text-tertiary" disabled></button>
            <button type="button" id="usepw" class="text-xs font-medium text-accent-light hover:underline">Use a password instead</button>
          </div>
          <p class="mt-3 text-xs leading-relaxed text-text-tertiary">The link in the same email still works, on the device it is opened on.</p>
        </div>

        <p id="authmsg" class="mt-4 hidden text-sm"></p>
      </div>
      </div>
    </section>

    <!-- ── set a new password (arrived from a reset email) ──────────────── -->
    <section id="pwreset" class="mt-6 hidden max-w-3xl rounded-2xl border border-accent/40 bg-white/[0.03] p-7">
      <h2 class="text-lg font-bold">Set a new password</h2>
      <p class="mt-1 text-sm text-text-secondary">You followed a reset link — choose the password you'll use in the app and here.</p>
      <div class="relative mt-5">
        <input id="newpw" type="password" placeholder="New password (8+ characters)" autocomplete="new-password"
          class="w-full rounded-xl border border-white/12 bg-white/[0.04] px-4 py-3 pr-12 text-sm text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none" />
        <button type="button" data-eye="newpw" aria-label="Show password"
          class="absolute inset-y-0 right-0 flex w-12 items-center justify-center text-text-tertiary hover:text-text-primary">
          <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
      </div>
      <button id="savepw" class="mt-3 w-full rounded-xl bg-accent px-4 py-3 text-sm font-bold text-canvas transition-opacity hover:opacity-90">
        Save password
      </button>
      <p id="pwmsg" class="mt-4 hidden text-sm"></p>
    </section>

    <!-- ── signed in ──────────────────────────────────────────────────── -->
    <section id="home" class="mt-2 hidden">

      <!-- the greeting: the page's heading, first name from the same
           profile the app greets you with, and the one way to add a report -->
      <div class="flex flex-wrap items-end justify-between gap-4 pt-5 sm:pt-8">
        <div class="min-w-0">
          <h1 id="greet" class="text-[28px] font-extrabold leading-[1.05] tracking-[-0.03em] text-text-primary sm:text-4xl"></h1>
        </div>
        <button
          id="addreport"
          class="inline-flex min-h-11 items-center gap-2 rounded-full border border-white/14 px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:border-white/25"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          Add a report
        </button>
      </div>

      <!-- tab pills -->
      <nav id="tabbar" class="mt-5 flex gap-1.5 rounded-2xl border border-white/10 bg-white/[0.03] p-1.5 sm:w-fit">
        <button data-tab="overview" class="flex-1 rounded-xl px-4 py-2 text-sm font-semibold sm:flex-none">Overview</button>
        <button data-tab="labs" class="flex-1 rounded-xl px-4 py-2 text-sm font-semibold sm:flex-none">Labs</button>
        <button data-tab="reports" class="flex-1 rounded-xl px-4 py-2 text-sm font-semibold sm:flex-none">Reports</button>
      </nav>
      <p id="upmsg" class="mt-3 hidden text-sm"></p>

      <!-- ═══ OVERVIEW ═══════════════════════════════════════════════════ -->
      <div id="tab-overview" class="mt-6 hidden">
        <!-- nothing yet: the one call to action, since the drop zone lives on Reports -->
        <div id="emptycard" class="hidden max-w-3xl rounded-2xl border border-dashed border-accent/40 bg-accent/[0.04] p-6">
          <p class="text-sm font-semibold text-text-primary">No reports yet</p>
          <p class="mt-1 text-[13px] leading-relaxed text-text-tertiary">
            Drop your first lab report and every value in it becomes a trend you keep. PDF, several at once.
          </p>
          <button id="emptyadd" class="mt-4 min-h-11 rounded-xl bg-accent px-5 py-2.5 text-sm font-bold text-canvas transition-opacity hover:opacity-90">Add a report</button>
        </div>

        <!-- your sections: the same split as Labs, each a way in -->
        <section id="secwrap" class="hidden">
          <h2 class="text-[17px] font-bold tracking-tight text-text-primary">Your sections</h2>
          <p class="mt-0.5 text-[12.5px] text-text-tertiary">In range against each lab&rsquo;s own printed range. Tap one to open it in Labs.</p>
          <div id="sections" class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4"></div>
        </section>

        <section id="worthwrap" class="mt-7 hidden">
          <div class="flex flex-wrap items-end justify-between gap-2">
            <div>
              <h2 class="text-[17px] font-bold tracking-tight text-text-primary">Worth a look</h2>
              <p class="mt-0.5 text-[12.5px] text-text-tertiary">The latest reading outside its range, worst first.</p>
            </div>
            <button id="worthall" data-goto="labs" class="text-[13px] font-medium text-accent-light hover:text-text-primary"></button>
          </div>
          <div id="worth" class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
        </section>

        <section id="latestwrap" class="mt-7 hidden">
          <h2 class="text-[17px] font-bold tracking-tight text-text-primary">Latest report</h2>
          <div id="latestcard" class="mt-3 rounded-2xl border border-white/10 bg-white/[0.03] p-4 sm:p-5"></div>
        </section>

        <p class="mt-7 font-mono text-[10.5px] text-text-muted">Drag a PDF anywhere on this page to add it.</p>
      </div>

      <!-- ═══ LABS ═══════════════════════════════════════════════════════ -->
      <div id="tab-labs" class="mt-6 hidden">
        <div id="labsempty" class="mt-6 hidden rounded-2xl border border-white/10 bg-white/[0.03] p-6 text-sm text-text-tertiary">
          Nothing here yet — drop a report on the <button data-goto="reports" class="font-semibold text-accent-light hover:underline">Reports</button> tab and every value in it lands here.
        </div>
        <div class="mt-4 flex flex-col gap-4 md:flex-row">
          <nav id="labsrail" class="flex flex-col gap-1.5 md:w-56 md:shrink-0"></nav>
          <div id="labspanel" class="hidden min-w-0 flex-1 rounded-2xl border border-white/10 bg-white/[0.03] p-5 md:block"></div>
        </div>
      </div>

      <!-- ═══ REPORTS ════════════════════════════════════════════════════ -->
      <div id="tab-reports" class="mt-6 hidden">
        <!-- the one place to add a report; dragging anywhere on the page lands here too -->
        <label id="drop" for="file"
          class="flex max-w-3xl cursor-pointer items-center gap-4 rounded-2xl border-[1.5px] border-dashed border-accent/45 bg-accent/[0.05] px-5 py-4 transition-colors hover:border-accent/70">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/[0.14]">
            <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/>
            </svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-semibold text-text-primary">Drop old reports here, or tap to choose</span>
            <span class="mt-0.5 block text-xs leading-relaxed text-text-tertiary">PDF &middot; several at once is fine &middot; originals stay in your private archive &middot; a file you already have is spotted before it is filed</span>
          </span>
          <span class="hidden shrink-0 rounded-lg border border-accent/40 bg-accent/10 px-3 py-2 text-xs font-bold text-accent-light sm:inline-block">Choose files</span>
          <input id="file" type="file" accept="application/pdf" multiple class="hidden" />
        </label>

        <!-- the batch queue: one row per dropped file, each with its stage -->
        <div id="upqueue" class="mt-6 hidden max-w-3xl flex-col gap-2"></div>

        <!-- ── the review: two tiers ─────────────────────────────────────── -->
        <div id="review" class="mt-6 hidden flex-col gap-4">
          <div class="flex flex-wrap items-center gap-3">
            <h2 id="rvtitle" class="text-base font-extrabold"></h2>
            <span id="rvcount" class="rounded-md bg-warning/15 px-2 py-0.5 font-mono text-[10px] font-semibold tracking-wider text-warning"></span>
            <div class="ml-auto flex items-center gap-2">
              <span class="font-mono text-[10px] uppercase tracking-wider text-text-tertiary">Report date</span>
              <input id="rvdate" type="date"
                class="rounded-lg border border-white/12 bg-white/[0.04] px-3 py-1.5 text-sm text-text-primary focus:border-accent focus:outline-none" />
            </div>
          </div>

          <!-- tier 1: app-bound -->
          <div class="rounded-2xl border border-accent/40 bg-white/[0.03] p-5">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[10px] font-semibold tracking-widest text-accent-light">GOES TO YOUR APP</span>
              <span class="text-xs text-text-tertiary">Metabolic · Heart · Muscle — check anything Verve misread</span>
            </div>
            <div id="rvapp" class="mt-2 divide-y divide-white/[0.06]"></div>
            <div class="mt-4 flex flex-wrap items-center gap-3">
              <button id="confirm"
                class="rounded-xl bg-accent px-5 py-3 text-sm font-bold text-canvas transition-opacity hover:opacity-90 disabled:opacity-50"></button>
              <span class="text-xs text-text-muted">
                Duplicates — same marker, same date, same value — are never sent twice.
              </span>
            </div>
            <p id="rvmsg" class="mt-3 hidden text-sm"></p>
          </div>

          <!-- tier 2: website archive -->
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[10px] font-semibold tracking-widest text-text-secondary">STAYS ON THE WEBSITE</span>
              <span id="rvwebnote" class="text-xs text-text-tertiary"></span>
            </div>
            <div id="rvweb" class="mt-2"></div>
          </div>

          <div class="flex items-center gap-3">
            <button id="discard" class="rounded-xl border border-white/14 px-4 py-2.5 text-sm font-semibold text-text-secondary transition-colors hover:border-white/25">
              Close review
            </button>
            <span class="text-xs text-text-muted">Everything above is already on your Labs tab — closing loses nothing.</span>
          </div>
        </div>

        <!-- ── echo review: numbers → Labs, the doctor's words kept apart ── -->
        <div id="echoreview" class="mt-6 hidden rounded-2xl border border-accent/40 bg-white/[0.03] p-5"></div>

        <!-- ── the archive: a timeline, one card per original PDF, a year at a time ── -->
        <div id="repcards" class="mt-6 flex max-w-3xl flex-col gap-3"></div>
      </div>

      <p class="mt-10 text-xs leading-5 text-text-muted">
        Wellness screening, not a diagnosis — parsing can misread a report, which is
        why you confirm app-bound values. Reports and values are private to your account.
      </p>
    </section>

    <p id="loading" class="mt-10 text-sm text-text-tertiary">Checking your session…</p>
  </main>

  <!-- ── the veil: any page, the moment a file is dragged over it ──────── -->
  <div id="veil" class="pointer-events-none fixed inset-0 z-50 hidden items-center justify-center bg-canvas-3/75 p-6 backdrop-blur-sm">
    <div class="flex w-full max-w-[560px] flex-col items-center gap-3.5 rounded-3xl border-2 border-dashed border-accent/70 bg-canvas/85 px-8 py-11 text-center">
      <span class="flex h-16 w-16 items-center justify-center rounded-[18px] bg-accent/[0.16]">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
      </span>
      <p class="text-[26px] font-extrabold tracking-[-0.02em] text-text-primary">Drop to add</p>
      <p class="max-w-[380px] text-[13px] leading-relaxed text-text-secondary">
        PDF reports, several at once. They land on the Reports tab, and any that you already have is spotted before it is filed.
      </p>
    </div>
  </div>

  <Footer />
</Layout>

<style is:global>
  /* Motion has one job here: to say what just changed and where to look.
     Six moments move; nothing else does. Every entry eases out and is under
     a third of a second, and all of it is off under reduced motion. */
  @keyframes mh-rise { to { opacity: 1; transform: translateY(0); } }
  @keyframes mh-draw { to { stroke-dashoffset: 0; } }
  @keyframes mh-fade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes mh-veil { from { opacity: 0; } to { opacity: 1; } }
  @keyframes mh-frame { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: scale(1); } }
  @keyframes mh-pulse { 0%, 100% { background-color: transparent; } 40% { background-color: rgba(251, 191, 36, 0.22); } }

  /* the page opens: the greeting fades up, tiles and cards rise in, staggered by --i */
  .mh-rise { opacity: 0; transform: translateY(6px); animation: mh-rise 0.32s cubic-bezier(0.2, 0.7, 0.2, 1) forwards; animation-delay: calc(var(--i, 0) * 60ms); }
  /* a section ring draws itself: --len is the arc, set where the ring is drawn */
  .mh-ring { stroke-dashoffset: var(--len, 0); animation: mh-draw 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards; animation-delay: calc(var(--i, 0) * 60ms + 0.2s); }
  /* a tab switch, and a chart opening */
  .mh-fade { animation: mh-fade 0.18s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .mh-open { animation: mh-fade 0.22s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  /* a file dragged over the page */
  #veil.flex { animation: mh-veil 0.15s ease-out both; }
  #veil.flex > div { animation: mh-frame 0.18s cubic-bezier(0.2, 0.7, 0.2, 1) 0.05s both; }
  /* a value outside its range, the moment a report is read: one pulse, then it settles */
  .mh-pulse { border-radius: 6px; animation: mh-pulse 0.6s ease-out 0.3s 1; }

  @media (prefers-reduced-motion: reduce) {
    .mh-rise, .mh-ring, .mh-fade, .mh-open, #veil.flex, #veil.flex > div, .mh-pulse {
      animation: none; opacity: 1; transform: none; stroke-dashoffset: 0;
    }
  }
</style>

<script>
  import { supabase, SUPABASE_URL, SUPABASE_ANON_KEY } from "../lib/supabase";
  import { canonName, unitKey } from "../lib/canon.js";

  // ── tiny DOM helpers ───────────────────────────────────────────────────
  const $ = (id: string) => document.getElementById(id)!;
  const show = (id: string, on: boolean) => $(id).classList.toggle("hidden", !on);
  const msg = (id: string, text: string, bad = false) => {
    const el = $(id);
    el.textContent = text;
    el.classList.toggle("hidden", !text);
    el.classList.toggle("text-danger", bad);
    el.classList.toggle("text-success", !bad);
  };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]!));
  const fmtDay = (d: string) =>
    new Date(d + "T00:00:00").toLocaleDateString(undefined, { day: "numeric", month: "short", year: "numeric" });

  // ── the app markers, keyed by lab_readings COLUMNS ─────────────────────
  const LABELS: Record<string, { label: string; unit: string; section: "metabolic" | "heart" | "sarcopenia" }> = {
    glucose_mgdl:           { label: "Fasting glucose",   unit: "mg/dL",  section: "metabolic" },
    hba1c_pct:              { label: "HbA1c",             unit: "%",      section: "metabolic" },
    post_meal_glucose_mgdl: { label: "Post-meal glucose", unit: "mg/dL",  section: "metabolic" },
    fasting_insulin_uiuml:  { label: "Fasting insulin",   unit: "uIU/mL", section: "metabolic" },
    triglycerides_mgdl:     { label: "Triglycerides",     unit: "mg/dL",  section: "metabolic" },
    hdl_mgdl:               { label: "HDL",               unit: "mg/dL",  section: "metabolic" },
    waist_cm:               { label: "Waist",             unit: "cm",     section: "metabolic" },
    sbp:                    { label: "Systolic BP",       unit: "mmHg",   section: "metabolic" },
    dbp:                    { label: "Diastolic BP",      unit: "mmHg",   section: "metabolic" },
    apo_b_mgdl:             { label: "ApoB",              unit: "mg/dL",  section: "heart" },
    ldl_mgdl:               { label: "LDL",               unit: "mg/dL",  section: "heart" },
    lpa_value:              { label: "Lp(a)",             unit: "",       section: "heart" },
    hs_crp_mgl:             { label: "hs-CRP",            unit: "mg/L",   section: "heart" },
    body_fat_pct:           { label: "Body fat",          unit: "%",      section: "sarcopenia" },
    skel_musc_pct:          { label: "Skeletal muscle",   unit: "%",      section: "sarcopenia" },
  };

  const SECTIONS: Record<string, string> = {
    metabolic: "Metabolic", heart: "Heart", muscle: "Muscle",
    haematology: "Haematology", lipids: "Lipids", liver: "Liver", kidney: "Kidney",
    thyroid: "Thyroid", vitamins_iron: "Vitamins & iron", hormones: "Hormones",
    inflammation: "Inflammation", urine: "Urine", imaging: "Imaging", other: "Other",
  };
  const SECTION_ORDER = Object.keys(SECTIONS);

  let userId = "";
  let userEmail = "";
  /** First name for the greeting, resolved once per session; "" when there is none. */
  let firstName = "";
  let parsed: { path: string; lpa_unit: string | null; dupKeys: Set<string> } | null = null;

  // one fetch feeds Overview, Labs and the Reports cards
  let allLabs: any[] = [];
  let allImaging: any[] = [];   // imaging_reports — the narrative half of a study
  let labSecs: Map<string, Map<string, any[]>> = new Map();
  let labSection = "";
  let expandedAnalyte = "";          // one chart open at a time
  let mobileSectionOpen = false;     // phone: section list ⇄ section page

  // ── tabs ───────────────────────────────────────────────────────────────
  let activeTab = "overview";
  function setTab(t: string) {
    const switching = activeTab !== t;
    activeTab = t;
    ["overview", "labs", "reports"].forEach((x) => show("tab-" + x, x === t));
    if (switching) {
      const el = $("tab-" + t);
      el.classList.remove("mh-fade");
      void el.offsetWidth;   // restart the animation
      el.classList.add("mh-fade");
    }
    $("tabbar").querySelectorAll("[data-tab]").forEach((b) => {
      const on = (b as HTMLElement).dataset.tab === t;
      b.className = `flex-1 rounded-xl px-4 py-2 text-sm font-semibold sm:flex-none transition-colors ${
        on ? "bg-accent/20 text-text-primary" : "text-text-tertiary hover:text-text-primary"}`;
    });
    history.replaceState(null, "", "#" + t);
  }
  $("tabbar").querySelectorAll("[data-tab]").forEach((b) =>
    b.addEventListener("click", () => setTab((b as HTMLElement).dataset.tab!)));

  // ── session ────────────────────────────────────────────────────────────
  const appLink = document.querySelector('[data-nav="app"]') as HTMLElement | null;

  async function boot() {
    const { data: { session } } = await supabase.auth.getSession();
    show("loading", false);
    if (session?.user) {
      userId = session.user.id;
      userEmail = session.user.email ?? "";
      firstName = await resolveFirstName(session.user);
      $("greet").textContent = greeting();
      $("greet").parentElement!.parentElement!.classList.add("mh-rise");
      appLink?.classList.add("hidden");
      show("signout", true); show("home", true); show("auth", false);
      const wanted = window.location.hash.replace("#", "");
      setTab(["overview", "labs", "reports"].includes(wanted) ? wanted : "overview");
      await refresh();
    } else {
      firstName = "";
      appLink?.classList.remove("hidden");
      show("auth", true); show("home", false); show("signout", false);
    }
  }

  /**
   * The name the app greets you with, in the same order the app resolves
   * it: the profile name set in Settings, then the full name Apple gave,
   * then nothing. Never the email — "roplekarsudeep" is not a name.
   */
  async function resolveFirstName(user: { id: string; user_metadata?: Record<string, unknown> }): Promise<string> {
    let full = "";
    try {
      const { data } = await supabase.from("profiles").select("name").eq("user_id", user.id).maybeSingle();
      full = String(data?.name ?? "").trim();
    } catch { /* no profile row, or none we may read: fall through */ }
    if (!full) full = String(user.user_metadata?.full_name ?? "").trim();
    return full.split(/\s+/)[0] ?? "";
  }

  /** "Good evening, Sudeep", or just "Good evening" when no name is known. */
  function greeting(): string {
    const hour = new Date().getHours();
    const tod = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    return firstName ? `${tod}, ${firstName}` : tod;
  }

  /** The one way to add a report: the Reports tab, and its picker. */
  function pickReport() {
    setTab("reports");
    $("file").click();
  }
  $("addreport").addEventListener("click", pickReport);
  $("emptyadd").addEventListener("click", pickReport);

  /** Refetch web_labs + imaging_reports once; every surface renders from them. */
  async function refresh() {
    const [{ data: rows }, { data: imaging }] = await Promise.all([
      supabase.from("web_labs")
        .select("analyte, value, unit, ref_low, ref_high, ref_text, section, measured_on, report_path")
        .eq("user_id", userId).order("measured_on", { ascending: true }).limit(4000),
      supabase.from("imaging_reports")
        .select("modality, report_date, report_path, impression, findings")
        .eq("user_id", userId).order("report_date", { ascending: true }).limit(200),
    ]);
    allLabs = rows ?? [];
    allImaging = imaging ?? [];
    groupLabs();
    renderOverview();
    renderLabsRail(); renderLabsPanel();
    await renderReports();
  }

  // ── two modes, one card: the same account works here and in the app ────
  let authMode: "signin" | "signup" = "signin";
  function setAuthMode(m: "signin" | "signup") {
    authMode = m;
    document.querySelectorAll("[data-mode]").forEach((b) => {
      const on = (b as HTMLElement).dataset.mode === m;
      b.className = `rounded-full px-4 py-1.5 text-[13px] ${on ? "bg-accent/20 font-bold text-text-primary" : "font-semibold text-text-tertiary hover:text-text-primary"}`;
    });
    // Sign-in needs no note: the left column says whose login it is, and
    // the Apple line sits under the email link it is about.
    const note = m === "signin"
      ? ""
      : "No app needed to start — this account works here today and signs into the Verve app whenever you get it.";
    $("modenote").textContent = note;
    show("modenote", !!note);
    $("authsubmit").textContent = m === "signin" ? "Sign in" : "Create my account";
    ($("password") as HTMLInputElement).placeholder = m === "signin" ? "Password" : "Choose a password (8+ characters)";
    ($("password") as HTMLInputElement).autocomplete = m === "signin" ? "current-password" : "new-password";
    show("forgot", m === "signin");
    show("magic", m === "signin");
    show("ordiv", m === "signin");
    show("applenote", m === "signin");
    msg("authmsg", "");
  }
  document.querySelectorAll("[data-mode]").forEach((b) =>
    b.addEventListener("click", () => setAuthMode((b as HTMLElement).dataset.mode as any)));
  setAuthMode("signin");

  $("pwform").addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = ($("email") as HTMLInputElement).value.trim();
    const password = ($("password") as HTMLInputElement).value;
    if (authMode === "signup") {
      if (password.length < 8) { msg("authmsg", "Choose a password of at least 8 characters.", true); return; }
      msg("authmsg", "Creating your account…");
      const { data, error } = await supabase.auth.signUp({
        email, password,
        options: { emailRedirectTo: window.location.origin + "/my-health/" },
      });
      if (error) { msg("authmsg", error.message, true); return; }
      // Supabase answers an existing address with a userless success — say so
      // honestly instead of promising an email that will never come.
      if (data.user && (data.user.identities?.length ?? 1) === 0) {
        msg("authmsg", "That address already has a Verve account — switch to Sign in.", true);
        return;
      }
      if (data.session) { msg("authmsg", ""); boot(); return; }
      msg("authmsg", "Almost there — confirm from the email we just sent, and the link lands you back here, signed in.");
      return;
    }
    msg("authmsg", "Signing in…");
    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) msg("authmsg", error.message, true);
    else { msg("authmsg", ""); boot(); }
  });

  // ── the code: one email carries a six-digit code and the link. The code
  // signs in whichever device it is typed on; the link, the one it is
  // opened on. Both come from the same Supabase call. ────────────────────
  let otpEmail = "";
  let resendTimer: number | undefined;

  async function sendCode(email: string): Promise<boolean> {
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: { shouldCreateUser: false, emailRedirectTo: window.location.origin + "/my-health/" },
    });
    if (error) { msg("authmsg", error.message, true); return false; }
    return true;
  }

  /** The card flips: the email is out, the six boxes are what is left. */
  function enterCodeStep(email: string) {
    otpEmail = email;
    $("codeto").textContent = email;
    ["modenote", "pwform", "ordiv", "magic", "applenote"].forEach((id) => show(id, false));
    document.querySelectorAll("[data-mode]").forEach((b) => (b as HTMLElement).parentElement!.classList.add("hidden"));
    show("codestep", true);
    ($("code") as HTMLInputElement).value = "";
    msg("authmsg", "");
    $("code").focus();
    startResendCountdown();
  }

  function leaveCodeStep() {
    if (resendTimer) { clearInterval(resendTimer); resendTimer = undefined; }
    otpEmail = "";
    show("codestep", false);
    document.querySelectorAll("[data-mode]").forEach((b) => (b as HTMLElement).parentElement!.classList.remove("hidden"));
    show("pwform", true);
    setAuthMode(authMode);
  }

  function startResendCountdown() {
    if (resendTimer) clearInterval(resendTimer);
    let left = 30;
    const btn = $("resend") as HTMLButtonElement;
    const tick = () => {
      if (left > 0) { btn.disabled = true; btn.textContent = `Resend in 0:${String(left).padStart(2, "0")}`; left--; }
      else { btn.disabled = false; btn.textContent = "Resend the code"; clearInterval(resendTimer); resendTimer = undefined; }
    };
    tick();
    resendTimer = window.setInterval(tick, 1000);
  }

  $("magic").addEventListener("click", async () => {
    const email = ($("email") as HTMLInputElement).value.trim();
    if (!email) { msg("authmsg", "Type your email above first.", true); return; }
    msg("authmsg", "Sending…");
    if (await sendCode(email)) enterCodeStep(email);
  });

  $("resend").addEventListener("click", async () => {
    msg("authmsg", "Sending again…");
    if (await sendCode(otpEmail)) { msg("authmsg", "Sent again."); startResendCountdown(); }
  });

  $("usepw").addEventListener("click", () => leaveCodeStep());

  $("code").addEventListener("input", () => {
    const el = $("code") as HTMLInputElement;
    el.value = el.value.replace(/\D/g, "").slice(0, 6);
  });

  $("codeform").addEventListener("submit", async (e) => {
    e.preventDefault();
    const token = ($("code") as HTMLInputElement).value.replace(/\D/g, "");
    if (token.length !== 6) { msg("authmsg", "The code is six digits.", true); return; }
    const btn = $("verify") as HTMLButtonElement;
    btn.disabled = true;
    msg("authmsg", "Checking…");
    const { error } = await supabase.auth.verifyOtp({ email: otpEmail, token, type: "email" });
    btn.disabled = false;
    // Supabase answers a wrong code and a stale one with the same message.
    if (error) { msg("authmsg", "That code did not match, or has expired. Check it, or send a new one.", true); return; }
    msg("authmsg", "");
    leaveCodeStep();
    boot();
  });

  $("signout").addEventListener("click", async () => {
    await supabase.auth.signOut();
    boot();
  });

  // ── show/hide password — the eye at the end of the bar ────────────────
  document.querySelectorAll("[data-eye]").forEach((b) =>
    b.addEventListener("click", () => {
      const input = $((b as HTMLElement).dataset.eye!) as HTMLInputElement;
      const showing = input.type === "text";
      input.type = showing ? "password" : "text";
      b.setAttribute("aria-label", showing ? "Show password" : "Hide password");
      (b as HTMLElement).classList.toggle("text-accent-light", !showing);
    }));

  // ── forgot password → reset email → the set-a-new-password card ───────
  $("forgot").addEventListener("click", async () => {
    const email = ($("email") as HTMLInputElement).value.trim();
    if (!email) { msg("authmsg", "Type your email above first.", true); return; }
    msg("authmsg", "Sending a reset link…");
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: window.location.origin + "/my-health/",
    });
    if (error) msg("authmsg", error.message, true);
    else msg("authmsg", "Sent — the link in that email brings you back here to set a new password.");
  });

  $("savepw").addEventListener("click", async () => {
    const pw = ($("newpw") as HTMLInputElement).value;
    if (pw.length < 8) { msg("pwmsg", "At least 8 characters.", true); return; }
    msg("pwmsg", "Saving…");
    const { error } = await supabase.auth.updateUser({ password: pw });
    if (error) { msg("pwmsg", error.message, true); return; }
    msg("pwmsg", "Saved — this password now works in the app and here.");
    setTimeout(() => { show("pwreset", false); boot(); }, 1800);
  });

  // ── range helpers — every value against ITS OWN printed range ─────────
  function inRange(v: { value: number; ref_low?: number | null; ref_high?: number | null }): boolean | null {
    const lo = v.ref_low, hi = v.ref_high;
    if (lo == null && hi == null) return null;
    if (lo != null && v.value < lo) return false;
    if (hi != null && v.value > hi) return false;
    return true;
  }
  function rangeLabel(v: { ref_low?: number | null; ref_high?: number | null; ref_text?: string | null }): string {
    if (v.ref_text) return v.ref_text;
    if (v.ref_low != null && v.ref_high != null) return `${v.ref_low}–${v.ref_high}`;
    if (v.ref_high != null) return `<${v.ref_high}`;
    if (v.ref_low != null) return `>${v.ref_low}`;
    return "";
  }

  // ── grouping: section → canonical analyte → readings by date ──────────
  function groupLabs() {
    labSecs = new Map();
    for (const r of allLabs) {
      const s = SECTIONS[r.section] ? r.section : "other";
      const sec = labSecs.get(s) ?? labSecs.set(s, new Map()).get(s)!;
      const key = canonName(String(r.analyte));
      (sec.get(key) ?? sec.set(key, []).get(key)!).push(r);
    }
    if (!labSecs.has(labSection)) labSection = SECTION_ORDER.find((s) => labSecs.has(s)) ?? "";
  }

  // ═══ OVERVIEW ═══════════════════════════════════════════════════════════
  /** A section's ring: latest readings in range, out of those with a printed range. */
  function ringSvg(ok: number, judged: number, i = 0): string {
    const C = 2 * Math.PI * 22;
    const frac = judged ? ok / judged : 0;
    const len = (frac * C).toFixed(1);
    const color = judged === 0 ? "#64748b" : ok === judged ? "#34d399" : "#FBBF24";
    return `
      <svg width="52" height="52" viewBox="0 0 56 56" aria-hidden="true">
        <circle cx="28" cy="28" r="22" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="5"/>
        <circle class="mh-ring" style="--len: ${len}; --i: ${i}" cx="28" cy="28" r="22" fill="none" stroke="${color}" stroke-width="5" stroke-linecap="round"
          stroke-dasharray="${len} ${C.toFixed(1)}" transform="rotate(-90 28 28)"/>
        <text x="28" y="26.5" text-anchor="middle" font-size="13" font-weight="800" fill="#f1f5f9">${judged ? ok : "–"}</text>
        <text x="28" y="37" text-anchor="middle" font-size="7.5" fill="#64748b">${judged ? `of ${judged}` : "no range"}</text>
      </svg>`;
  }

  /** A tiny trend line for a card: the series on its own scale, last point marked. */
  function sparkline(rs: any[], color: string): string {
    const vals = rs.map((r) => Number(r.value));
    if (vals.length < 2) return "";
    const lo = Math.min(...vals), hi = Math.max(...vals);
    const x = (i: number) => 3 + (i / (vals.length - 1)) * 74;
    const y = (v: number) => hi === lo ? 13 : 23 - ((v - lo) / (hi - lo)) * 20;
    const pts = vals.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(" ");
    const last = vals.length - 1;
    return `<svg width="80" height="26" viewBox="0 0 80 26" class="shrink-0" aria-hidden="true">
      <polyline points="${pts}" fill="none" stroke="${color}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="${x(last).toFixed(1)}" cy="${y(vals[last]).toFixed(1)}" r="2.6" fill="${color}"/></svg>`;
  }

  function renderOverview() {
    $("greet").textContent = greeting();

    const dates = [...new Set(allLabs.map((r) => r.measured_on))].sort();
    if (dates.length === 0) {
      show("emptycard", true); show("secwrap", false); show("worthwrap", false); show("latestwrap", false);
      return;
    }
    show("emptycard", false);

    // ── your sections: the same split as Labs, each a way in ─────────────
    show("secwrap", true);
    $("sections").innerHTML = SECTION_ORDER.filter((s) => labSecs.has(s)).map((s, i) => {
      const series = [...labSecs.get(s)!.values()];
      let ok = 0, judged = 0;
      for (const rs of series) {
        const v = inRange(rs[rs.length - 1]);
        if (v !== null) judged++;
        if (v === true) ok++;
      }
      const flagged = judged - ok;
      const status = flagged
        ? `<span class="text-warning">${flagged} outside range</span>`
        : judged ? `<span class="text-success">all in range</span>` : `<span class="text-text-tertiary">no printed ranges</span>`;
      return `
        <button data-opensec="${s}" style="--i: ${i}" class="mh-rise flex items-center gap-3 rounded-2xl border border-white/8 bg-white/4 px-3.5 py-3 text-left transition-colors hover:border-white/16">
          ${ringSvg(ok, judged, i)}
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-semibold text-text-primary">${SECTIONS[s]}</span>
            <span class="block text-xs leading-snug">${series.length} marker${series.length === 1 ? "" : "s"} · ${status}</span>
          </span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>`;
    }).join("");
    $("sections").querySelectorAll("[data-opensec]").forEach((b) =>
      b.addEventListener("click", () => openSection((b as HTMLElement).dataset.opensec!)));

    // ── worth a look: the latest reading out of its own range, worst first ──
    type Finding = { sec: string; name: string; rs: any[]; latest: any; n: number; first: any; sev: number };
    const findings: Finding[] = [];
    let inCount = 0, judged = 0;
    for (const [sec, m] of labSecs) for (const [name2, rs] of m) {
      const latest = rs[rs.length - 1];
      const ok = inRange(latest);
      if (ok !== null) judged++;
      if (ok === true) inCount++;
      if (ok !== false) continue;
      const lo = latest.ref_low, hi = latest.ref_high;
      const width = lo != null && hi != null ? hi - lo : Math.abs(hi ?? lo ?? 1) || 1;
      const dist = lo != null && latest.value < lo ? lo - latest.value : latest.value - (hi ?? 0);
      findings.push({ sec, name: name2, rs, latest, n: rs.length, first: rs[0], sev: dist / (width || 1) });
    }
    findings.sort((a, b) => b.sev - a.sev);
    const top = findings.slice(0, 3);

    show("worthwrap", true);
    $("worthall").textContent = findings.length > top.length
      ? `All ${findings.length} outside range in Labs →` : findings.length ? "Open in Labs →" : "";
    show("worthall", findings.length > 0);
    $("worth").innerHTML = top.length ? top.map((f, i) => {
      const dir = f.latest.ref_low != null && f.latest.value < f.latest.ref_low ? "below" : "above";
      const trend = f.n > 1 ? `${f.first.value} → ${f.latest.value} across ${f.n} reports` : `from ${fmtDay(f.latest.measured_on)}`;
      return `
        <button data-worth="${esc(f.sec)}|${esc(f.name)}" style="--i: ${i + 4}" class="mh-rise flex flex-col gap-1.5 rounded-2xl border border-white/8 bg-white/4 p-4 text-left transition-colors hover:border-warning/40">
          <span class="flex w-full items-center justify-between gap-2">
            <span class="min-w-0 truncate text-sm font-semibold text-text-primary">${esc(f.name)}</span>
            <span class="shrink-0 rounded-md bg-white/[0.06] px-2 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider text-text-secondary">${esc(SECTIONS[f.sec])}</span>
          </span>
          <span class="flex w-full items-end justify-between gap-3">
            <span class="font-mono text-[26px] font-bold leading-none text-warning">${f.latest.value}${f.latest.unit ? ` <span class="text-xs font-semibold">${esc(f.latest.unit)}</span>` : ""}</span>
            ${sparkline(f.rs, "#FBBF24")}
          </span>
          <span class="text-xs leading-snug text-text-tertiary">${dir} the lab&rsquo;s range ${esc(rangeLabel(f.latest))} · ${esc(trend)}</span>
        </button>`;
    }).join("") : `
      <div class="rounded-2xl border border-success/25 bg-success/[0.05] p-4 sm:col-span-2 lg:col-span-3">
        <div class="text-sm font-semibold text-success">${inCount} of ${judged} markers in range</div>
        <div class="mt-1 text-xs leading-relaxed text-text-tertiary">Nothing is outside its lab&rsquo;s printed range right now. The full list is in Labs.</div>
      </div>`;
    $("worth").querySelectorAll("[data-worth]").forEach((b) =>
      b.addEventListener("click", () => {
        const [sec, name3] = (b as HTMLElement).dataset.worth!.split("|");
        openMarker(sec, name3);
      }));

    // ── the latest report ───────────────────────────────────────────────
    const lastDate = dates[dates.length - 1];
    const dayRows = allLabs.filter((r) => r.measured_on === lastDate);
    const flaggedN = dayRows.filter((r) => inRange(r) === false).length;
    const path = dayRows.map((r) => r.report_path).filter(Boolean).pop() ?? "";
    const repName = path ? path.split("/").pop()!.replace(/^\d+-/, "").replace(/\.pdf$/i, "").replace(/_/g, " ") : "";
    show("latestwrap", true);
    $("latestcard").innerHTML = `
      <div class="mh-rise flex flex-wrap items-center gap-3 sm:gap-4" style="--i: 7">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/[0.14]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>
        </span>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="truncate text-sm font-semibold text-text-primary">${esc(repName || fmtDay(lastDate))}</span>
            <span class="rounded-md bg-white/[0.06] px-2 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider text-text-secondary">${fmtDay(lastDate)}</span>
          </div>
          <div class="mt-1 text-xs text-text-tertiary">${dayRows.length} values · ${flaggedN ? `<span class="text-warning">${flaggedN} outside range</span>` : `<span class="text-success">all in range</span>`} · all on your Labs tab</div>
        </div>
        ${path ? `<button data-viewpath="${esc(path)}" class="rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-secondary transition-colors hover:border-white/25 hover:text-text-primary">View PDF</button>` : ""}
        <button data-goto="reports" class="rounded-lg border border-white/12 px-3 py-1.5 text-xs font-semibold text-text-secondary transition-colors hover:border-white/25 hover:text-text-primary">All reports →</button>
      </div>`;
    const vp = $("latestcard").querySelector("[data-viewpath]");
    if (vp) vp.addEventListener("click", () => viewPdf((vp as HTMLElement).dataset.viewpath!));
    wireGoto();
  }

  function wireGoto() {
    document.querySelectorAll("[data-goto]").forEach((b) => {
      const el = b as HTMLElement;
      if (el.dataset.wired) return;
      el.dataset.wired = "1";
      el.addEventListener("click", () => setTab(el.dataset.goto!));
    });
  }

  /** Jump from Overview into one section of Labs. */
  function openSection(sec: string) {
    labSection = sec;
    expandedAnalyte = "";
    mobileSectionOpen = true;
    setTab("labs");
    renderLabsRail(); renderLabsPanel();
  }

  /** Jump from Overview straight to one marker's chart. */
  function openMarker(sec: string, name: string) {
    labSection = sec;
    expandedAnalyte = name;
    mobileSectionOpen = true;
    setTab("labs");
    renderLabsRail(); renderLabsPanel();
  }

  // ═══ LABS ═══════════════════════════════════════════════════════════════
  function renderLabsRail() {
    const empty = allLabs.length === 0;
    show("labsempty", empty);
    if (empty) { $("labsrail").innerHTML = ""; $("labspanel").innerHTML = ""; wireGoto(); return; }

    // phone: the section list IS the page until a section opens
    $("labsrail").className = `${mobileSectionOpen ? "hidden md:flex" : "flex"} flex-col gap-1.5 md:w-56 md:shrink-0`;
    $("labspanel").className = `${mobileSectionOpen ? "" : "hidden md:block"} min-w-0 flex-1 rounded-2xl border border-white/10 bg-white/[0.03] p-5`;

    $("labsrail").innerHTML = SECTION_ORDER.filter((s) => labSecs.has(s)).map((s) => {
      const analytes = [...labSecs.get(s)!.values()];
      const flagged = analytes.filter((rs) => inRange(rs[rs.length - 1]) === false).length;
      const on = s === labSection;
      return `
        <button data-sec="${s}" class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-left text-[13px] transition-colors ${on ? "bg-accent/15 font-bold text-text-primary" : "text-text-secondary hover:bg-white/[0.05]"}">
          <span class="flex-1">${SECTIONS[s]}</span>
          <span class="rounded-md ${flagged ? "bg-warning/15 text-warning" : "bg-white/[0.06] text-text-tertiary"} px-1.5 py-0.5 font-mono text-[9px] font-semibold tracking-wider">${analytes.length}${flagged ? ` · ${flagged}!` : ""}</span>
          <span class="text-text-muted md:hidden">›</span>
        </button>`;
    }).join("");
    $("labsrail").querySelectorAll("[data-sec]").forEach((b) =>
      b.addEventListener("click", () => {
        labSection = (b as HTMLElement).dataset.sec!;
        expandedAnalyte = "";
        mobileSectionOpen = true;
        renderLabsRail(); renderLabsPanel();
      }));
  }

  function renderLabsPanel() {
    const sec = labSecs.get(labSection);
    if (!sec) { $("labspanel").innerHTML = ""; return; }
    const analytes = [...sec.entries()];
    const flagged = analytes.filter(([, rs]) => inRange(rs[rs.length - 1]) === false).length;
    $("labspanel").innerHTML = `
      <button id="labsback" class="mb-2 flex items-center gap-1 text-sm font-semibold text-accent-light md:hidden">‹ All sections</button>
      <div class="flex flex-wrap items-baseline gap-3">
        <h3 class="text-base font-extrabold">${SECTIONS[labSection]}</h3>
        <span class="font-mono text-[10px] text-text-tertiary">${analytes.length} MARKER${analytes.length === 1 ? "" : "S"}</span>
        ${flagged ? `<span class="rounded-md bg-warning/15 px-2 py-0.5 font-mono text-[9px] tracking-wider text-warning">${flagged} OUT OF RANGE</span>` : ""}
      </div>
      <div class="mt-2 divide-y divide-white/[0.05]">
        ${analytes.map(([name, rs]) => labRow(name, rs)).join("")}
      </div>
      ${labSection === "imaging" && allImaging.length ? `
        <div class="mt-5 font-mono text-[10px] font-semibold uppercase tracking-widest text-text-tertiary">The reports' own conclusions</div>
        ${[...allImaging].reverse().map((im) => `
          <div class="mt-2 rounded-xl border border-white/[0.07] bg-white/[0.02] p-3">
            <div class="flex items-center gap-2">
              <span class="rounded-md bg-accent/15 px-1.5 py-0.5 font-mono text-[9px] font-semibold tracking-wider text-accent-light">${esc(String(im.modality).toUpperCase())}</span>
              <span class="font-mono text-[10px] text-text-tertiary">${fmtDay(im.report_date)}</span>
            </div>
            ${im.impression ? `<p class="mt-1.5 text-[13px] leading-5 text-text-secondary">${esc(im.impression)}</p>` : ""}
          </div>`).join("")}` : ""}`;
    $("labsback")?.addEventListener("click", () => {
      mobileSectionOpen = false;
      renderLabsRail(); renderLabsPanel();
    });
    $("labspanel").querySelectorAll("[data-an]").forEach((b) =>
      b.addEventListener("click", () => {
        const n = (b as HTMLElement).dataset.an!;
        expandedAnalyte = expandedAnalyte === n ? "" : n;
        renderLabsPanel();
        if (expandedAnalyte) $("labspanel").querySelector(`[data-an="${CSS.escape(n)}"]`)?.scrollIntoView({ block: "nearest" });
      }));
