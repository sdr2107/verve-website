        <div>${minutes ? `Vigorous share <strong class="text-text-primary">${Math.round((vig / minutes) * 100)}%</strong>` : "No minutes on file"}${zone2 != null ? ` · Zone 2 <strong class="text-text-primary">${Math.round(zone2)} min</strong> a week, scored against each day's own band` : ""}</div>
