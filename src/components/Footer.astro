---
/**
 * Footer — shared across every page, My health included (11 November
 * 2026, board 05; the accounts as icons and the app block, the same day,
 * from the founder's reference: its structure, not its look).
 *
 * Three rows. The name line, the page links (the bar's three, then the two
 * addresses that left the bar: Videos, the free sheet), and "Get the app":
 * the App Store link, and for Android the plain words until there is a
 * listing. Then the accounts: five circles, each one account, the app's
 * three first and the founder's two after, with one quiet line under them
 * that says whose the last two are. (The line also wrote the app's handle
 * until 11 November 2026; the founder asked why, and each circle already
 * names its account, so it went.) No
 * brand colours: the glyphs take the page's text colour, in either theme.
 * Then the company: name, CIN and registered office, as the Companies Act
 * asks and as anyone verifying the site expects to find, with the privacy
 * policy and the terms beside it. All addresses come from data/site.ts.
 *
 * Appearance (11 November 2026, canvas "Verve on the web, refined", board
 * 02): Light, Dark or System, on every page, for someone who is not signed
 * in. It is the same choice as Settings, Appearance: src/lib/theme.ts keeps
 * it and both controls hear each other. The lit option is drawn from the
 * page's own data-theme (global.css), so it is right from the first paint.
 */
interface Props {
  /** Kept for the pages that pass it; the name at the left is the way home. */
  showHome?: boolean;
  /** Omit the Science link on the Science page itself. */
  showScience?: boolean;
}
const { showScience = true } = Astro.props;

import { FOOTER_LINKS, APP_SOCIAL, FOUNDER_SOCIAL, APP_STORE_URL, PLAY_STORE_URL, PRIVACY_URL, TERMS_URL, COMPANY } from "../data/site";
import SocialIcon from "./SocialIcon.astro";
import StoreBadge from "./StoreBadge.astro";

const THEMES = [["light", "Light"], ["dark", "Dark"], ["system", "System"]] as const;
const links = FOOTER_LINKS.filter((l) => showScience || l.href !== "/science");
/** The app's accounts are Verve's; X and Substack are the founder's own, and the label says so. */
const accounts = [
  ...APP_SOCIAL.map((s) => ({ ...s, name: `Verve on ${s.label}` })),
  ...FOUNDER_SOCIAL.map((s) => ({ ...s, name: `The founder on ${s.label}` })),
];
---

<footer class="border-t border-border bg-card px-6 py-10 sm:px-10">
  <div class="mx-auto flex max-w-6xl flex-col gap-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between md:gap-10">
      <div class="flex shrink-0 flex-col gap-2">
        <a href="/" class="flex min-h-11 items-center gap-2.5 self-start" aria-label="Verve, home">
          <img src="/app-icon.png" alt="" width="28" height="28" class="h-7 w-7 rounded-lg" loading="lazy" />
          <span class="text-[16px] font-semibold tracking-[-0.01em] text-text-primary">Verve</span>
        </a>
        <p class="whitespace-nowrap text-[13.5px] text-text-secondary">Evidence-based fitness tracking</p>
      </div>

      <nav class="flex flex-wrap gap-x-6 gap-y-1 text-[14px] text-text-secondary md:justify-center" aria-label="Pages">
        {links.map((l) => (
          <a href={l.href} class="inline-flex min-h-9 items-center whitespace-nowrap transition-colors hover:text-text-primary">{l.label}</a>
        ))}
      </nav>

      <section class="flex shrink-0 flex-col gap-2.5" aria-labelledby="vrv-get-app">
        <h2 id="vrv-get-app" class="text-[13.5px] font-semibold text-text-primary">Get the app</h2>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <StoreBadge store="app-store" href={APP_STORE_URL} />
          {PLAY_STORE_URL ? <StoreBadge store="google-play" href={PLAY_STORE_URL} /> : <span class="text-[13.5px] text-text-tertiary">Android &middot; soon</span>}
        </div>
      </section>
    </div>

    <div class="flex flex-col gap-2.5">
      <ul class="flex flex-wrap gap-3" role="list">
        {accounts.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="me noopener"
              aria-label={s.name}
              title={s.name}
              class="flex h-10 w-10 items-center justify-center rounded-full border border-border-strong text-text transition-colors hover:border-accent-border hover:bg-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <SocialIcon name={s.key} size={18} />
            </a>
          </li>
        ))}
      </ul>
      <p class="text-[13px] text-text-secondary">The founder writes on X and Substack.</p>
    </div>

    <div class="flex flex-col gap-3 border-t border-border pt-5 text-[12px] leading-relaxed text-text-tertiary md:flex-row md:items-start md:justify-between md:gap-10">
      <p>
        &copy; {new Date().getFullYear()} {COMPANY.name}, CIN {COMPANY.cin}. Registered office: {COMPANY.registeredOffice}.
        {" "}<a href={`mailto:${COMPANY.email}`} class="whitespace-nowrap hover:text-text-primary">{COMPANY.email}</a>
      </p>
      <div class="flex shrink-0 flex-col gap-3 md:items-end">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <span id="vrv-appearance" class="text-[13px] text-text-secondary">Appearance</span>
          <div role="radiogroup" aria-labelledby="vrv-appearance" class="vrv-appearance flex gap-1 rounded-[10px] border border-border bg-alt p-1">
            {THEMES.map(([k, label]) => (
              <button type="button" role="radio" aria-checked="false" data-theme-choice={k} class="min-h-10 rounded-[8px] px-3.5 text-[13px] font-medium text-text-2 transition-colors hover:text-text md:min-h-8">{label}</button>
            ))}
          </div>
        </div>
        <p class="flex gap-5 text-[13px] text-text-secondary">
          <a href={PRIVACY_URL} class="inline-flex min-h-9 items-center transition-colors hover:text-text-primary md:min-h-0">Privacy</a>
          <a href={TERMS_URL} class="inline-flex min-h-9 items-center transition-colors hover:text-text-primary md:min-h-0">Terms</a>
        </p>
      </div>
    </div>
  </div>
</footer>

<script>
  import { getTheme, setTheme, THEME_EVENT, type ThemeChoice } from "../lib/theme.ts";
  // One listener on the document, so it holds on the pages that arrive without a full load.
  const mark = () => {
    const now = getTheme();
    document.querySelectorAll<HTMLElement>("[data-theme-choice]").forEach((b) => b.setAttribute("aria-checked", String(b.dataset.themeChoice === now)));
  };
  document.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement | null)?.closest?.<HTMLElement>("[data-theme-choice]");
    if (b) setTheme(b.dataset.themeChoice as ThemeChoice);
  });
  document.addEventListener(THEME_EVENT, mark);
  document.addEventListener("astro:page-load", mark);
  mark();
</script>
