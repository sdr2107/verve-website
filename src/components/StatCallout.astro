---
interface Props {
  value: string;
  label: string;
  source: string;
}
const { value, label, source } = Astro.props;
---

<div class="flex flex-col gap-1">
  <span class="font-mono text-4xl font-bold text-text-primary sm:text-5xl">{value}</span>
  <span class="text-sm text-text-secondary sm:text-base">{label}</span>
  <span class="font-mono text-xs uppercase tracking-wide text-text-muted">{source}</span>
</div>
