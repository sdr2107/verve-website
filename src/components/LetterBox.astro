---
/**
 * The box that takes an address for the letter (canvas "Verve, Horizon as a programme", board 27).
 *
 * On submit the address, the sentence beside the button, the page and the word on the link that brought the
 * reader (../data/letter.ts tagOf) go into newsletter_signups: anyone may add a row, and nobody reads the table
 * through the page. The page then says what happens next and asks the newsletter-welcome function to send the
 * first letter from hello@. The letter is never the gate: everything it links to is on this page at once, and a
 * first letter that fails is tried again within a day.
 *
 * An address that is on the list already is answered too (../data/letter.ts afterKind, 21 November 2026): the
 * function says whether it switched the letter on, sent the note with the press, or sent nothing, and the box
 * says that. It names a letter as on its way only when one went.
 *
 * The weekly letter starts only on a press made inside that first letter, so an address typed here by someone
 * else gets one email and no more.
 *
 * Two doors use it (board 34, 21 November 2026). On the Horizon page it carries its own heading and offers a third
 * thing to do: the five questions below it. On the newsletter page (../pages/newsletter.astro) the page is the
 * heading and the third is left out: that page says nothing about Horizon while the Horizon page is unlinked.
 * Both keep the word on a post's link: since 22 November 2026 the videos' closing card and captions send readers
 * to /newsletter?from=<word> (the founder: the weekly newsletter link should open the newsletter, not Horizon).
 */
import { LETTER_CONSENT, LETTER_PRESS } from "../data/letter";
import { SHEET_PDF } from "../data/fitness-tiers";
import { GET_APP_PATH, PRIVACY_URL } from "../data/site";

interface Props {
  /** Which page the box is on: the row's source, so the list can count each door. */
  door?: "horizon" | "newsletter";
  /** Where the third thing to do while waiting leads: the questions further down the page. */
  questions?: string;
}
const { door = "horizon", questions = "#questions" } = Astro.props;
const own = door === "horizon";
const step = "inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-accent-border bg-accent-fill font-mono text-[11px] font-semibold text-accent-text";
const go = "min-h-8 self-start text-[13px] font-semibold text-accent-text hover:text-text";
---

<section class="flex flex-col gap-3 rounded-[16px] border border-accent-border bg-accent-fill p-5" data-letterbox data-door={door} data-places={own ? "Three" : "Two"} aria-labelledby={own ? "letterhead" : undefined} aria-label={own ? undefined : "The Verve letter"}>
  <form class="flex flex-col gap-3" data-letter-form novalidate>
    {own && <div class="flex flex-col gap-1">
      <h2 id="letterhead" class="m-0 text-[17px] font-semibold text-text">Get the first letter</h2>
      <p class="m-0 text-[14px] leading-relaxed text-text-2">What Verve is, your first fitness number on one sheet of A4, and where to begin.</p>
    </div>}
    <div class="flex flex-wrap gap-2.5">
      <label for="letteremail" class="sr-only">Your email</label>
      <input id="letteremail" name="email" type="email" required autocomplete="email" inputmode="email" placeholder="you@example.com"
        class="min-h-12 min-w-[200px] flex-1 rounded-[10px] border border-border-strong bg-card px-4 text-[16px] text-text outline-none placeholder:text-text-3 focus:border-accent-border" />
      <button type="submit" data-letter-submit class="min-h-12 rounded-[10px] bg-accent px-5 text-[15px] font-semibold text-canvas transition-opacity hover:opacity-90 disabled:opacity-60">Send me the first letter</button>
    </div>
    <p class="m-0 text-[12.5px] leading-relaxed text-text-3">{LETTER_CONSENT} <a href={PRIVACY_URL} class="font-semibold text-accent-text hover:text-text">Privacy policy</a></p>
    <p class="m-0 hidden text-[13.5px] leading-relaxed text-text" data-letter-msg role="status" aria-live="polite"></p>
  </form>
  <div class="hidden flex-col gap-3" data-letter-done>
    <div class="flex flex-col gap-1">
      <h2 class="m-0 text-[17px] font-semibold text-text" tabindex="-1" data-letter-done-head>The first letter is on its way.</h2>
      <p class="m-0 text-[14px] leading-relaxed text-text-2" data-letter-where aria-live="polite">From hello@verve-app.health. {LETTER_PRESS}</p>
    </div>
    <p class="m-0 text-[14px] font-semibold text-text" data-letter-while>While you wait</p>
    <div class="flex gap-3"><span class={step}>1</span><div class="flex flex-col gap-1"><p class="m-0 text-[14px] leading-relaxed text-text">Take the six-minute walk and get your first number.</p><a href={SHEET_PDF} target="_blank" rel="noopener" class={go}>Open the sheet (PDF)</a></div></div>
    <div class="flex gap-3"><span class={step}>2</span><div class="flex flex-col gap-1"><p class="m-0 text-[14px] leading-relaxed text-text">Get the app. It reads your watch or your phone and keeps the week.</p><a href={GET_APP_PATH} target="_blank" rel="noopener" class={go}>Get the app</a></div></div>
    {own && <div class="flex gap-3"><span class={step}>3</span><div class="flex flex-col gap-1"><p class="m-0 text-[14px] leading-relaxed text-text">Answer five questions, and set a horizon.</p><a href={questions} class={go}>Begin</a></div></div>}
  </div>
</section>

<script>
  import { supabase } from "../lib/supabase";
  import { LETTER_CONSENT, afterKind, letterAfter, letterComing, tagOf, type AfterKind } from "../data/letter";

  const box = document.querySelector<HTMLElement>("[data-letterbox]");
  if (box) {
    const form = box.querySelector<HTMLFormElement>("[data-letter-form]")!;
    const input = box.querySelector<HTMLInputElement>("#letteremail")!;
    const button = box.querySelector<HTMLButtonElement>("[data-letter-submit]")!;
    const msg = box.querySelector<HTMLElement>("[data-letter-msg]")!;
    const done = box.querySelector<HTMLElement>("[data-letter-done]")!;
    const where = box.querySelector<HTMLElement>("[data-letter-where]")!;
    const head = box.querySelector<HTMLElement>("[data-letter-done-head]")!;
    const waiting = box.querySelector<HTMLElement>("[data-letter-while]")!;
    const say = (text: string) => { msg.textContent = text; msg.classList.toggle("hidden", !text); };
    // the page the box is on; only the Horizon page keeps the word on a post's link
    const door = box.dataset.door === "newsletter" ? "newsletter" : "horizon";
    const begin = `${box.dataset.places ?? "Three"} places to begin`;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = input.value.trim().toLowerCase();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) || email.length > 254) { say("That does not look like an email address."); input.focus(); return; }
      button.disabled = true;
      say("Saving…");
      let userId: string | null = null;
      try { userId = (await supabase.auth.getSession()).data.session?.user.id ?? null; } catch { /* not signed in */ }
      const { error } = await supabase.from("newsletter_signups").insert({ email, consent_text: LETTER_CONSENT, source: door, user_id: userId, tag: tagOf(location.search) });
      button.disabled = false;
      // 23505: the address is on the list already. Its row is not written again; the function says what it needs.
      const returning = error?.code === "23505";
      if (error && !returning) { say("That could not be saved just now. Nothing was sent. Try again in a minute."); return; }
      const show = (kind: AfterKind, days?: number) => {
        const a = letterAfter(email, kind, days);
        head.textContent = a.head; where.textContent = a.text;
        waiting.textContent = letterComing(kind) ? "While you wait" : begin;
      };
      say("");
      form.classList.add("hidden");
      done.classList.remove("hidden"); done.classList.add("flex");
      // a new address: the first letter is asked for now. One on the list already: nothing is promised until the answer.
      if (returning) { head.textContent = "This address is on the list already."; where.textContent = "Checking what it needs…"; waiting.textContent = begin; }
      else show("first");
      head.focus();
      // the letter, after the page has already said what to do; never the gate
      try {
        const { data, error: fnErr } = await supabase.functions.invoke("newsletter-welcome", { body: { email } });
        const kind = afterKind(data, !!fnErr);
        // only a first letter is tried again within a day
        show(returning && kind === "later" ? "failed" : kind, data?.days);
      } catch { show(returning ? "failed" : "later"); }
    });
  }
</script>
