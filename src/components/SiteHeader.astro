---
/**
 * The header, the same on every page (11 November 2026, the canvas "Verve
 * on the web, rethought", board 05): the mark and the name, three places,
 * then the way in and the app.
 *
 * The account entry reads "Sign in" to a stranger and "My health" to a
 * person this browser has a session for; both lead to /my-health. It is
 * decided from localStorage by the inline script below, before the bar
 * paints, with no request. The app button opens /get in a new tab, which
 * sends the visitor to the store for their device.
 *
 * My health's own script finds two elements here by attribute and hides or
 * swaps them for Sign out by adding the class `hidden`: data-nav="signin"
 * (the account entry) and data-nav="app" (the app button). Neither carries
 * a display utility, so `hidden` always wins. The "extra" slot sits
 * between them.
 *
 * On a phone the three places sit in a row under the name rather than
 * behind a menu icon: a hidden menu is the one place a first-time visitor
 * will not look for the science.
 *
 * Deeper pages pass a breadcrumb, which follows the name on a desktop; a
 * link already in the breadcrumb is not repeated in the nav. A topic page
 * also passes `back`, and on a phone the row becomes a back link and the
 * topic's place in its subject, which is what a reader mid-way through a
 * subject needs from the top of the screen.
 */
import { NAV, GET_APP_PATH, ACCOUNT_PATH, type NavKey } from "../data/site";
import { SUPABASE_URL } from "../lib/supabase";

interface Crumb {
  /** No href: the current page, rendered as text. */
  href?: string;
  label: string;
}

interface Props {
  /** Which nav link is the page you are on. */
  current?: NavKey;
  /** Items after the name, desktop only. */
  crumb?: Crumb[];
  /** Phone only: replaces the name's row with a back link. */
  back?: { href: string; label: string };
  /** Phone only, beside the back link: "1 of 5". */
  position?: string;
}

const { current, crumb = [], back, position } = Astro.props;

const inCrumb = new Set(crumb.map((c) => c.href));
const links = NAV.filter((l) => !inCrumb.has(l.href));

const link = (key: NavKey) =>
  key === current ? "text-text-primary" : "text-text-secondary";

/** The key Supabase keeps the session under: "sb-<project>-auth-token". */
const sessionKey = `sb-${SUPABASE_URL.replace("https://", "").split(".")[0]}-auth-token`;
---

<header class="relative z-40 border-b border-border bg-canvas" transition:name="site-header" transition:animate="none">
  <div class="mx-auto max-w-6xl px-6 sm:px-10">
    <div class="flex min-h-[64px] items-center justify-between gap-4 py-3 md:min-h-[76px] md:gap-6">
      <div class:list={["min-w-0 items-center gap-2.5 text-sm", back ? "hidden md:flex" : "flex"]}>
        <a href="/" class="flex min-h-11 shrink-0 items-center gap-2.5" aria-label="Verve, home">
          <img src="/app-icon.png" alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
          <span class="text-[18px] font-semibold tracking-[-0.01em] text-text-primary">Verve</span>
        </a>
        {crumb.map((c) => (
          <span class="hidden min-w-0 items-center gap-2.5 md:flex">
            <span class="text-text-4" aria-hidden="true">/</span>
            {c.href ? (
              <a href={c.href} class="truncate text-text-secondary transition-colors hover:text-text-primary">
                {c.label}
              </a>
            ) : (
              <span class="truncate font-medium text-text-primary" aria-current="page">{c.label}</span>
            )}
          </span>
        ))}
      </div>

      {back && (
        <a
          href={back.href}
          class="flex min-h-11 items-center gap-1.5 text-sm font-semibold text-accent-light md:hidden"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
          {back.label}
        </a>
      )}

      <nav class="hidden items-center gap-7 md:flex" aria-label="Site">
        {links.map((l) => (
          <a
            href={l.href}
            data-astro-prefetch="hover"
            aria-current={l.key === current ? "page" : undefined}
            class:list={["inline-flex min-h-11 items-center text-[14.5px] font-medium transition-colors hover:text-text-primary", link(l.key)]}
          >
            {l.label}
          </a>
        ))}
      </nav>

      <div class="flex shrink-0 items-center gap-3 md:gap-[18px]">
        <a
          href={ACCOUNT_PATH}
          data-nav="signin"
          data-account
          aria-current={current === "my-health" ? "page" : undefined}
          class:list={[
            "vrv-nav-item gap-2 whitespace-nowrap text-[14.5px] font-medium text-text-primary transition-colors hover:text-accent-text",
            back && "max-md:hidden",
          ]}
        ><span data-account-initial class="hidden h-7 w-7 items-center justify-center rounded-full bg-accent-fill font-mono text-[12px] font-semibold text-accent-text" aria-hidden="true"></span><span data-account-label>Sign in</span></a>
        <slot name="extra" />
        <a
          href={GET_APP_PATH}
          target="_blank"
          rel="noopener"
          data-nav="app"
          class:list={[
            "vrv-nav-item whitespace-nowrap rounded-full border border-border-strong bg-card px-[18px] text-sm font-semibold text-text-primary transition-colors hover:border-text-3",
            back && "max-md:hidden",
          ]}
        >
          Get the app
        </a>
        {back && position && (
          <span class="font-mono text-[11px] text-text-tertiary md:hidden">{position}</span>
        )}
      </div>
    </div>

    {!back && (
      <nav class="flex flex-wrap items-center gap-x-6 gap-y-1 pb-2.5 md:hidden" aria-label="Site">
        {NAV.map((l) => (
          <a
            href={l.href}
            data-astro-prefetch="hover"
            aria-current={l.key === current ? "page" : undefined}
            class:list={["inline-flex min-h-9 items-center text-[13.5px] font-medium transition-colors hover:text-text-primary", link(l.key)]}
          >
            {l.label}
          </a>
        ))}
      </nav>
    )}
  </div>
</header>

<style is:global>
  /* The account entry and the app button: laid out here, in the components layer, and never by a display
     utility. My health hides them by adding `hidden`, and a utility must be able to win over this. */
  @layer components {
    .vrv-nav-item { display: inline-flex; align-items: center; min-height: 2.75rem; }
  }
</style>

<!-- Who is this? Read from the device, before the bar paints, with no request: a kept session means "My health". -->
<script is:inline define:vars={{ sessionKey }}>
  (function () {
    function name() {
      var signed = false, initial = "";
      try {
        var raw = localStorage.getItem(sessionKey);
        if (raw) {
          var s = JSON.parse(raw);
          signed = !!(s && s.refresh_token);
          var meta = s && s.user && s.user.user_metadata;
          var full = meta && (meta.full_name || meta.name);
          if (signed && typeof full === "string" && full.trim()) initial = full.trim().charAt(0).toUpperCase();
        }
      } catch (e) { /* no storage, or not a session: a stranger */ }
      var entries = document.querySelectorAll("[data-account]");
      for (var i = 0; i < entries.length; i++) {
        var label = entries[i].querySelector("[data-account-label]");
        var dot = entries[i].querySelector("[data-account-initial]");
        if (label) label.textContent = signed ? "My health" : "Sign in";
        if (dot) {
          dot.textContent = initial;
          dot.classList.toggle("hidden", !initial);
          dot.classList.toggle("inline-flex", !!initial);
        }
      }
    }
    name();
    document.addEventListener("astro:page-load", name);
  })();
</script>
