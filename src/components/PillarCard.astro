---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  accent?: string;
}
const { eyebrow, title, description, accent = "var(--color-accent)" } = Astro.props;
---

<div class="rounded-2xl border border-white/8 bg-white/4 p-6 transition-colors hover:border-white/14">
  <span
    class="font-mono text-xs font-semibold uppercase tracking-wider"
    style={{ color: accent }}
  >
    {eyebrow}
  </span>
  <h3 class="mt-2 text-lg font-semibold text-text-primary">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-text-secondary">{description}</p>
</div>
