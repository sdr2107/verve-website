---
/**
 * A section within a topic page: a hairline, a heading, a line saying what
 * the section actually answers, then the section's own content.
 *
 * Every topic used to be one of these on a subject page. Now each topic is a
 * page and its heading is the page's h1, so this is left for the sub-anchors
 * that ride inside a topic — the marker table under Body phenotyping — where
 * the id is still an address the app links to.
 *
 * The subtitle is not decoration. A reader skimming for the bit they came
 * for has only the heading to go on otherwise; a sentence — "One is how
 * hard, the other is how much" — is often the whole answer.
 */
interface Props {
  id: string;
  title: string;
  /** What this section answers, in one line. */
  sub?: string;
}

const { id, title, sub } = Astro.props;
---

<section id={id} class="vrv-anchor scroll-mt-8 border-t border-white/[0.07] pt-7">
  <h2 class="text-[26px] font-bold tracking-tight text-text-primary">{title}</h2>
  {sub && <p class="mt-1.5 text-[13px] text-text-tertiary">{sub}</p>}
  <slot />
</section>
