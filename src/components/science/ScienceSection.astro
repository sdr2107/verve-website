---
/**
 * One topic on a subject page: a hairline, a heading, a line saying what the
 * section actually answers, then the section's own content.
 *
 * The subtitle is not decoration. On the old single page every section opened
 * with a heading and went straight into prose, so a reader skimming for the
 * bit they came for had only the heading to go on. The board gives each one a
 * sentence — "One is how hard, the other is how much" — which is often the
 * whole answer for someone who does not need the rest.
 *
 * The id is the anchor. The app links to several of these and the hub's
 * forwarding map is built from the same list, so it must match the registry.
 */
interface Props {
  id: string;
  title: string;
  /** What this section answers, in one line. */
  sub?: string;
}

const { id, title, sub } = Astro.props;
---

<section id={id} class="scroll-mt-8 border-t border-white/[0.07] pt-7">
  <h2 class="text-[26px] font-bold tracking-tight text-text-primary">{title}</h2>
  {sub && <p class="mt-1.5 text-[13px] text-text-tertiary">{sub}</p>}
  <slot />
</section>
