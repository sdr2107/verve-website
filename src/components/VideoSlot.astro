---
/**
 * VideoSlot — an honest placeholder for the explainer video each science
 * section will eventually carry. Text content ships immediately (the data
 * already exists); video is recorded and slotted in later without changing
 * this component's structure — just replace the placeholder body with a
 * real <video>/embed when the recording for `topic` exists.
 */
interface Props {
  topic: string;
}
const { topic } = Astro.props;
---

<div class="flex items-center gap-4 rounded-xl border border-dashed border-white/12 bg-white/2 px-5 py-4">
  <div class="flex shrink-0 items-center justify-center rounded-full bg-white/6" style="width: 40px; height: 40px;">
    <svg width="16" height="16" class="text-text-tertiary" style="width: 16px; height: 16px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polygon points="5 3 19 12 5 21 5 3" />
    </svg>
  </div>
  <div>
    <p class="text-sm font-medium text-text-secondary">Video walkthrough — {topic}</p>
    <p class="text-xs text-text-muted">In production, coming soon</p>
  </div>
</div>
