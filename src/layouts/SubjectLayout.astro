---
/**
 * The chrome around each of the four subject pages.
 *
 * Everything here that could drift — the topic list in the rail, the position
 * ("Subject 2 of 4"), the prev/next links at the foot, the citation count —
 * is read from scienceTopics.ts rather than written into the page, so the
 * four pages cannot disagree with the hub or with each other.
 */
import Layout from "./Layout.astro";
import Footer from "../components/Footer.astro";
import SiteHeader from "../components/SiteHeader.astro";
import {
  SUBJECTS,
  topicsFor,
  subjectFor,
  subjectIndex,
  subjectNeighbours,
  subjectCounts,
  type SubjectSlug,
} from "../data/scienceTopics";

interface Props {
  subject: SubjectSlug;
  /** Card image for link previews. Falls back to the site default. */
  image?: string;
}

const { subject, image } = Astro.props;

const meta = subjectFor(subject);
const topics = topicsFor(subject);
const counts = subjectCounts(subject);
const { prev, next } = subjectNeighbours(subject);
const position = subjectIndex(subject) + 1;
---

<Layout title={meta.metaTitle} description={meta.metaDescription} image={image}>
  <SiteHeader current="science" crumb={[{ href: "/science", label: "Science" }, { label: meta.label }]} />

  <div class="mx-auto flex max-w-6xl gap-12 px-6 pb-28 sm:px-10">
    <!-- ── The rail. Sticky on desktop, gone on a phone, where the page is a
         single column and a duplicate index above the content is just an
         obstacle between the reader and the first paragraph. ────────────── -->
    <aside class="hidden w-56 shrink-0 lg:block">
      <div class="sticky top-8 space-y-8">
        <nav aria-label="On this page">
          <h2 class="font-mono text-[11px] font-semibold uppercase tracking-widest text-text-muted">
            On this page
          </h2>
          <ul class="mt-3 space-y-0.5">
            {topics.map((t) => (
              <li>
                <a
                  href={`#${t.slug}`}
                  data-rail={t.slug}
                  class="block rounded-lg border-l-2 border-transparent px-3 py-[7px] text-[13px] leading-snug text-text-tertiary transition-colors hover:text-text-primary"
                >
                  {t.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <slot name="rail" />

        <nav class="space-y-2.5 border-t border-white/8 pt-6" aria-label="Other subjects">
          {prev && (
            <a
              href={`/science/${prev.slug}`}
              class="block text-sm text-text-secondary transition-colors hover:text-text-primary"
            >
              &larr; {prev.label}
            </a>
          )}
          {next && (
            <a
              href={`/science/${next.slug}`}
              class="block text-sm text-text-secondary transition-colors hover:text-text-primary"
            >
              {next.label} &rarr;
            </a>
          )}
          <a
            href="/science"
            class="block text-sm text-text-tertiary transition-colors hover:text-text-primary"
          >
            All subjects
          </a>
        </nav>
      </div>
    </aside>

    <main class="min-w-0 flex-1">
      <div class="pb-4">
        <span class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-light">
          Subject {position} of {SUBJECTS.length}
        </span>
        <h1
          class="mt-3 text-4xl font-bold tracking-tight text-text-primary sm:text-5xl"
        >{meta.label}</h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-text-secondary">
          {meta.blurb}
        </p>
        <p class="mt-3 font-mono text-xs text-text-muted">
          {counts.topics} topics &middot; {counts.citations} citations
        </p>
      </div>

      <!-- On a phone the rail is hidden, so the index rides here instead. -->
      <nav class="mt-8 flex flex-wrap gap-2 lg:hidden" aria-label="On this page">
        {topics.map((t) => (
          <a
            href={`#${t.slug}`}
            class="rounded-full border border-white/8 bg-white/4 px-4 py-2 text-xs font-medium text-text-secondary transition-colors hover:border-white/16 hover:text-text-primary"
          >
            {t.label}
          </a>
        ))}
      </nav>

      <div class="mt-14 space-y-20">
        <slot />
      </div>

      {next && (
        <a
          href={`/science/${next.slug}`}
          class="group mt-11 flex flex-col gap-4 rounded-2xl border border-accent/25 bg-accent/[0.06] p-[22px] transition-colors hover:border-accent/45 sm:flex-row sm:items-center sm:gap-5 sm:px-6"
        >
          <span class="flex-1">
            <span class="block text-base font-semibold text-text-primary">Next: {next.label}</span>
            <span class="mt-1 block text-[12.5px] leading-relaxed text-text-tertiary">
              {next.teaser}
            </span>
          </span>
          <span class="shrink-0 rounded-full bg-accent px-[18px] py-2.5 text-[13.5px] font-semibold text-canvas transition-colors group-hover:bg-accent-light">
            Read it &rarr;
          </span>
        </a>
      )}

      {!next && (
        <a
          href="/science"
          class="mt-11 block rounded-2xl border border-accent/25 bg-accent/[0.06] p-[22px] transition-colors hover:border-accent/45 sm:px-6"
        >
          <span class="font-mono text-[11px] font-semibold uppercase tracking-widest text-accent-light">
            That is all four
          </span>
          <span class="mt-2 block text-lg font-semibold text-text-primary">
            Back to the hub
          </span>
          <span class="mt-1 block text-sm leading-relaxed text-text-secondary">
            The other three subjects, the whole topic index, and the AHA map.
          </span>
          <span class="mt-3 block text-sm text-accent-light">&larr; All subjects</span>
        </a>
      )}
    </main>
  </div>

  {/* Which topic the reader is in. The board draws one rail item lit; that
      only means anything if it follows the scroll, so an observer watches the
      section headings and lights whichever crossed the top most recently.
      Progressive: without JS every item stays in its resting state and the
      rail is still a working list of links. */}
  <script is:inline>
    (function () {
      var links = document.querySelectorAll("[data-rail]");
      if (!links.length || !("IntersectionObserver" in window)) return;
      var LIT = ["border-accent", "bg-white/6", "text-text-primary"];
      var DIM = ["border-transparent", "text-text-tertiary"];
      var seen = new Set();

      function light(slug) {
        links.forEach(function (a) {
          var on = a.getAttribute("data-rail") === slug;
          a.classList.remove.apply(a.classList, on ? DIM : LIT);
          a.classList.add.apply(a.classList, on ? LIT : DIM);
        });
      }

      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) seen.add(e.target.id);
            else seen.delete(e.target.id);
          });
          // The topmost section still on screen is the one being read.
          for (var i = 0; i < links.length; i++) {
            var slug = links[i].getAttribute("data-rail");
            if (seen.has(slug)) return light(slug);
          }
        },
        { rootMargin: "-10% 0px -70% 0px" }
      );

      links.forEach(function (a) {
        var el = document.getElementById(a.getAttribute("data-rail"));
        if (el) io.observe(el);
      });
    })();
  </script>

  <Footer />
</Layout>
