---
/**
 * The chrome around each of the four subject pages.
 *
 * Everything here that could drift — the topic list in the rail, the position
 * ("Subject 2 of 4"), the prev/next links at the foot, the citation count —
 * is read from scienceTopics.ts rather than written into the page, so the
 * four pages cannot disagree with the hub or with each other.
 */
import Layout from "./Layout.astro";
import Footer from "../components/Footer.astro";
import {
  SUBJECTS,
  topicsFor,
  subjectFor,
  subjectIndex,
  subjectNeighbours,
  subjectCounts,
  type SubjectSlug,
} from "../data/scienceTopics";

interface Props {
  subject: SubjectSlug;
  /** Card image for link previews. Falls back to the site default. */
  image?: string;
}

const { subject, image } = Astro.props;

const meta = subjectFor(subject);
const topics = topicsFor(subject);
const counts = subjectCounts(subject);
const { prev, next } = subjectNeighbours(subject);
const position = subjectIndex(subject) + 1;
---

<Layout title={meta.metaTitle} description={meta.metaDescription} image={image}>
  <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6 sm:px-10">
    <nav class="flex items-center gap-2.5 text-sm" aria-label="Breadcrumb">
      <a href="/" class="flex items-center gap-2.5">
        <img src="/app-icon.png" alt="" class="h-8 w-8 rounded-lg" />
        <span class="font-semibold tracking-tight text-text-primary">Verve</span>
      </a>
      <span class="text-text-muted" aria-hidden="true">/</span>
      <a href="/science" class="text-text-secondary transition-colors hover:text-text-primary">
        Science
      </a>
      <span class="text-text-muted" aria-hidden="true">/</span>
      <span class="font-medium text-text-primary" aria-current="page">{meta.label}</span>
    </nav>
    <a
      href="https://apps.apple.com/app/id6760022278"
      class="shrink-0 whitespace-nowrap rounded-full border border-white/14 px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:border-white/25"
    >
      Get the app
    </a>
  </header>

  <div class="mx-auto flex max-w-6xl gap-12 px-6 pb-28 sm:px-10">
    <!-- ── The rail. Sticky on desktop, gone on a phone, where the page is a
         single column and a duplicate index above the content is just an
         obstacle between the reader and the first paragraph. ────────────── -->
    <aside class="hidden w-56 shrink-0 lg:block">
      <div class="sticky top-8 space-y-8">
        <nav aria-label="On this page">
          <h2 class="font-mono text-[11px] font-semibold uppercase tracking-widest text-text-muted">
            On this page
          </h2>
          <ul class="mt-4 space-y-2.5">
            {topics.map((t) => (
              <li>
                <a
                  href={`#${t.slug}`}
                  class="block text-sm leading-snug text-text-secondary transition-colors hover:text-text-primary"
                >
                  {t.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <slot name="rail" />

        <nav class="space-y-2.5 border-t border-white/8 pt-6" aria-label="Other subjects">
          {prev && (
            <a
              href={`/science/${prev.slug}`}
              class="block text-sm text-text-secondary transition-colors hover:text-text-primary"
            >
              &larr; {prev.label}
            </a>
          )}
          {next && (
            <a
              href={`/science/${next.slug}`}
              class="block text-sm text-text-secondary transition-colors hover:text-text-primary"
            >
              {next.label} &rarr;
            </a>
          )}
          <a
            href="/science"
            class="block text-sm text-text-tertiary transition-colors hover:text-text-primary"
          >
            All subjects
          </a>
        </nav>
      </div>
    </aside>

    <main class="min-w-0 flex-1">
      <div class="pb-4">
        <span class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-light">
          Subject {position} of {SUBJECTS.length}
        </span>
        <h1
          class="mt-3 text-4xl font-bold tracking-tight text-text-primary sm:text-5xl"
        >{meta.label}</h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-text-secondary">
          {meta.blurb}
        </p>
        <p class="mt-3 font-mono text-xs text-text-muted">
          {counts.topics} topics &middot; {counts.citations} citations
        </p>
      </div>

      <!-- On a phone the rail is hidden, so the index rides here instead. -->
      <nav class="mt-8 flex flex-wrap gap-2 lg:hidden" aria-label="On this page">
        {topics.map((t) => (
          <a
            href={`#${t.slug}`}
            class="rounded-full border border-white/8 bg-white/4 px-4 py-2 text-xs font-medium text-text-secondary transition-colors hover:border-white/16 hover:text-text-primary"
          >
            {t.label}
          </a>
        ))}
      </nav>

      <div class="mt-14 space-y-20">
        <slot />
      </div>

      {next && (
        <a
          href={`/science/${next.slug}`}
          class="mt-20 block rounded-2xl border border-white/10 bg-white/4 px-6 py-5 transition-colors hover:border-white/22"
        >
          <span class="font-mono text-[11px] font-semibold uppercase tracking-widest text-accent-light">
            Next
          </span>
          <span class="mt-2 block text-lg font-semibold text-text-primary">{next.label}</span>
          <span class="mt-1 block text-sm leading-relaxed text-text-secondary">
            {next.teaser}
          </span>
          <span class="mt-3 block text-sm text-accent-light">Read it &rarr;</span>
        </a>
      )}

      {!next && (
        <a
          href="/science"
          class="mt-20 block rounded-2xl border border-white/10 bg-white/4 px-6 py-5 transition-colors hover:border-white/22"
        >
          <span class="font-mono text-[11px] font-semibold uppercase tracking-widest text-accent-light">
            That is all four
          </span>
          <span class="mt-2 block text-lg font-semibold text-text-primary">
            Back to the hub
          </span>
          <span class="mt-1 block text-sm leading-relaxed text-text-secondary">
            The other three subjects, the whole topic index, and the AHA map.
          </span>
          <span class="mt-3 block text-sm text-accent-light">&larr; All subjects</span>
        </a>
      )}
    </main>
  </div>

  <Footer />
</Layout>
