---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  /**
   * Move between pages without a full load, so a part of the page that
   * stays (a sidebar) stays and the rest crossfades. Only for pages with
   * no inline script that must run again on arrival: a page's scripts do
   * not re-run when it is reached this way.
   */
  router?: boolean;
  /** Card image for X / iMessage / Slack previews. Absolute path from site root. */
  image?: string;
  /** "summary_large_image" gives the full-bleed card; "summary" the small square. */
  cardType?: "summary_large_image" | "summary";
}

const SITE = "https://verve-app.health";
const {
  title,
  description,
  image = "/og-default.png",
  cardType = "summary_large_image",
  router = false,
} = Astro.props;

// The two grounds, for the browser's own chrome (the address bar on a phone). The page's colours are
// src/styles/global.css; which set a person sees is their one choice, read in the head below.
const GROUND = { light: "#EFE8DB", dark: "#0D0D15" };

// Absolute URLs — X and iMessage both refuse relative og:image paths.
const canonical = new URL(Astro.url.pathname, SITE).href;
const imageAbs  = new URL(image, SITE).href;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={GROUND.light} />
    <script is:inline>
      // One choice for the whole site, read before anything paints (src/lib/theme.ts writes it). Until a
      // person chooses, every page is light; anything unreadable or unknown is light too. "system" follows
      // the device. A page reached without a full load (the Science pages) arrives with the markup's own
      // attribute, so the choice is put back after every swap.
      (function () {
        var mq = window.matchMedia ? matchMedia("(prefers-color-scheme: dark)") : null;
        function choice() {
          try { var v = localStorage.getItem("verve-theme"); if (v === "light" || v === "dark" || v === "system") return v; } catch (e) {}
          return "light";
        }
        function apply() {
          var c = choice();
          document.documentElement.dataset.theme = c;
          var dark = c === "dark" || (c === "system" && mq && mq.matches);
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute("content", dark ? "#0D0D15" : "#EFE8DB");
        }
        apply();
        if (mq && mq.addEventListener) mq.addEventListener("change", apply);
        document.addEventListener("astro:after-swap", apply);
        // the choice made in another tab of this browser reaches this one
        addEventListener("storage", function (e) { if (e.key === "verve-theme") { apply(); document.dispatchEvent(new CustomEvent("verve-theme")); } });
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/app-icon.png" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph — iMessage, Slack, LinkedIn, Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Verve" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- X -->
    <meta name="twitter:card" content={cardType} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageAbs} />
    <meta name="twitter:site" content="@RoplekarSudeep" />
    <meta name="twitter:creator" content="@RoplekarSudeep" />

    <title>{title}</title>
    {router && <ClientRouter />}
  </head>
  <body class="vrv-canvas min-h-screen antialiased">
    <!-- the service worker: the hashed bundles read from the device on every visit after the first (public/sw.js) -->
    <script is:inline>
      if ("serviceWorker" in navigator) addEventListener("load", () => { navigator.serviceWorker.register("/sw.js").catch(() => {}); });
    </script>
    <slot />
  </body>
</html>
